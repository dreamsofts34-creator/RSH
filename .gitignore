# Rust build outputs. Cargo.lock is intentionally NOT ignored — it is committed.
target/
**/target/

# Node / frontend build outputs.
node_modules/
*.tsbuildinfo
# Vite build output — ALL of it, including index.html (v1.0.2, bug 6):
# the old committed `frontend/dist/index.html` pointed at hashed
# assets that were never in the repo, so any build that skipped
# `npm run build` served a broken shell. `vite build` regenerates
# dist from scratch (`emptyOutDir: true`) on every Tauri build
# (`beforeBuildCommand`), so nothing in dist is ever committed.
frontend/dist/*

# Firmware / embedded build outputs.
.pio/

# Build / staging outputs that must never be committed (deep-scan Round 2, M7).
# src-tauri/binaries/ holds the staged HIDMaestro sidecar exe (fetched +
# hash-verified at build time — never committed); release-staging/ holds the
# release assets (installers, SBOMs, SHA256SUMS); bom.json / *.cdx.json are
# cargo-cyclonedx outputs (per-crate files next to each member Cargo.toml).
src-tauri/binaries/
release-staging/
bom.json
crates/*/*.cdx.json
tools/*/*.cdx.json
src-tauri/*.cdx.json

# Secrets — never commit.
*.pem
signing-keys/
.env

# OS / editor leftovers.
.DS_Store
Thumbs.db
__pycache__/
*.pyc
