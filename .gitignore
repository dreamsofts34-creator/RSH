# Rust build outputs. Cargo.lock is intentionally NOT ignored — it is committed.
target/
**/target/

# Node / frontend build outputs.
node_modules/
*.tsbuildinfo
# Vite build output — except the committed static shell placeholder
# (frontend/dist/index.html), which the Tauri shell serves until Phase E.
frontend/dist/*
!frontend/dist/index.html

# Firmware / embedded build outputs.
.pio/

# Build / staging outputs that must never be committed (deep-scan Round 2, M7).
# src-tauri/binaries/ holds the staged HIDMaestro sidecar exe (fetched +
# hash-verified at build time — never committed); release-staging/ holds the
# release assets (installers, SBOMs, SHA256SUMS); bom.json / *.cdx.json are
# cargo-cyclonedx outputs (per-crate files next to each member Cargo.toml).
src-tauri/binaries/
release-staging/
bom.json
crates/*/*.cdx.json
tools/*/*.cdx.json
src-tauri/*.cdx.json

# Secrets — never commit.
*.pem
signing-keys/
.env

# OS / editor leftovers.
.DS_Store
Thumbs.db
__pycache__/
*.pyc
