<Project>
  <!-- RSH stability rules: har build bilkul waisa hi jo test hua tha.
       Nullable + warnings-as-errors production code mein; packages lock-file
       se restore hote hain (koi floating version nahi). -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <LangVersion>latest</LangVersion>
    <!-- Product version (T13): har assembly isi version se print hoti hai —
         benchmarks date/version chhapte hain; RSH.App.csproj mein wahi
         version dobara likha hai (release workflow wahan se parhta hai). -->
    <Version>2.0.4</Version>
  </PropertyGroup>
</Project>
