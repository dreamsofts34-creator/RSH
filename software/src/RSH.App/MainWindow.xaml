<ui:FluentWindow x:Class="RSH.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="RSH — Real Sim Hub" Height="700" Width="1100" MinHeight="580" MinWidth="920"
        WindowBackdropType="None" ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource RSHFontFamily}" FontSize="14"
        Background="{DynamicResource RSHBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/RSHTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="RSH — Real Sim Hub" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="206" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource RSHSidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource RSHBorderBrush}"
                    BorderThickness="0,0,1,0" Padding="14,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="6,0,0,18">
                                <Border Width="32" Height="32" CornerRadius="10"
                                        Background="{StaticResource RSHAccentBrush}">
                                    <TextBlock Text="R" Foreground="{StaticResource RSHOnAccentBrush}"
                                               FontWeight="Bold" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="RSH" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource RSHTextBrush}" />
                                    <TextBlock Text="Real Sim Hub" FontSize="11"
                                               Foreground="{DynamicResource RSHSecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 8 screens, spec §0.2 order — faltu tabs nahi -->
                            <RadioButton x:Name="NavDashboard" Content="Dashboard" Tag="Dashboard" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavTuning" Content="Tuning" Tag="Tuning" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavSetup" Content="Setup" Tag="Setup" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavButtons" Content="Buttons" Tag="Buttons" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavOutput" Content="Output" Tag="Output" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavProfiles" Content="Profiles" Tag="Profiles" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavMonitor" Content="Monitor" Tag="Monitor" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                        </StackPanel>
                    </ScrollViewer>
                    <RadioButton Grid.Row="1" x:Name="NavSettings" Content="Settings" Tag="Settings" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                </Grid>
            </Border>

            <ContentControl Grid.Column="1" x:Name="PageHost" Focusable="False"
                            Foreground="{DynamicResource RSHTextBrush}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
