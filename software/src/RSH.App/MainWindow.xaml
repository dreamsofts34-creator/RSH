<ui:FluentWindow x:Class="RSH.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:RSH.App.Resources"
        Title="{Binding RSHRealSimHub, Source={x:Static res:UiStrings.Instance}}" Height="700" Width="1100" MinHeight="580" MinWidth="920"
        WindowBackdropType="None" ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource RSHFontFamily}" FontSize="14"
        Background="{DynamicResource RSHBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/RSHTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" Title="{Binding RSHRealSimHub, Source={x:Static res:UiStrings.Instance}}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="206" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" x:Name="SidebarBorder" Background="{DynamicResource RSHSidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource RSHBorderBrush}"
                    BorderThickness="0,0,1,0" Padding="14,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="6,0,0,18">
                                <Border x:Name="LogoBadge" Width="32" Height="32" CornerRadius="10"
                                        Background="{StaticResource RSHAccentBrush}">
                                    <TextBlock x:Name="LogoLetter" Text="{Binding R, Source={x:Static res:UiStrings.Instance}}" Foreground="{StaticResource RSHOnAccentBrush}"
                                               FontWeight="Bold" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock x:Name="LogoTitle" Text="{Binding RSH, Source={x:Static res:UiStrings.Instance}}" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource RSHTextBrush}" />
                                    <TextBlock x:Name="LogoSubtitle" Text="{Binding RealSimHub, Source={x:Static res:UiStrings.Instance}}" FontSize="11"
                                               Foreground="{DynamicResource RSHSecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 8 screens, spec §0.2 order — faltu tabs nahi -->
                            <RadioButton x:Name="NavDashboard" Content="{Binding NavDashboard, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding NavDashboard, Source={x:Static res:UiStrings.Instance}}" Tag="Dashboard" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavTuning" Content="{Binding NavTuning, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding NavTuning, Source={x:Static res:UiStrings.Instance}}" Tag="Tuning" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavSetup" Content="{Binding NavSetup, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding NavSetup, Source={x:Static res:UiStrings.Instance}}" Tag="Setup" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavButtons" Content="{Binding NavButtons, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding NavButtons, Source={x:Static res:UiStrings.Instance}}" Tag="Buttons" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavOutput" Content="{Binding NavOutput, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding NavOutput, Source={x:Static res:UiStrings.Instance}}" Tag="Output" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavProfiles" Content="{Binding NavProfiles, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding NavProfiles, Source={x:Static res:UiStrings.Instance}}" Tag="Profiles" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavMonitor" Content="{Binding NavMonitor, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding NavMonitor, Source={x:Static res:UiStrings.Instance}}" Tag="Monitor" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                        </StackPanel>
                    </ScrollViewer>
                    <RadioButton Grid.Row="1" x:Name="NavSettings" Content="{Binding NavSettings, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding NavSettings, Source={x:Static res:UiStrings.Instance}}" Tag="Settings" GroupName="nav" Style="{StaticResource RSHNavStyle}" Checked="Nav_Checked" />
                </Grid>
            </Border>

            <ContentControl Grid.Column="1" x:Name="PageHost" Focusable="False"
                            Foreground="{DynamicResource RSHTextBrush}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
