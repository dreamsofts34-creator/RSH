<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- RSH dark palette (UI-1, spec §0.1). Theme-independent accent
         family RSHTheme.xaml mein hai; yahan sirf woh brushes hain jo
         theme ke saath badalte hain. Light counterpart: RSHTheme.Light.xaml.
         "Derived" values §0.1 mein nahi — dark surfaces par violet tint
         ke liye §0.1 accent se liye gaye hain (neeche marked). -->
    <SolidColorBrush x:Key="RSHBackgroundBrush" Color="#0B0E13" />
    <SolidColorBrush x:Key="RSHCardBackgroundBrush" Color="#14181F" />
    <SolidColorBrush x:Key="RSHRaisedBackgroundBrush" Color="#1A1F27" />
    <SolidColorBrush x:Key="RSHSidebarBackgroundBrush" Color="#14181F" />
    <SolidColorBrush x:Key="RSHBorderBrush" Color="#262C36" />
    <SolidColorBrush x:Key="RSHTextBrush" Color="#F2F4F7" />
    <SolidColorBrush x:Key="RSHSecondaryTextBrush" Color="#9AA3AF" />
    <!-- Derived: dark track — card (#14181F) aur border (#262C36) ke beech. -->
    <SolidColorBrush x:Key="RSHTrackBrush" Color="#232936" />
    <!-- Derived: dark active nav — accent ka gehri tint (light AccentSoft
         #EEE9FF ka dark counterpart). -->
    <SolidColorBrush x:Key="RSHNavActiveBackgroundBrush" Color="#2A2350" />
    <SolidColorBrush x:Key="RSHNavHoverBackgroundBrush" Color="#1A1F27" />
    <!-- Derived: dark active nav text — halka violet, dark tint par parhne layak. -->
    <SolidColorBrush x:Key="RSHNavActiveForegroundBrush" Color="#C4B5FD" />
    <SolidColorBrush x:Key="RSHNavDotBrush" Color="#4A445F" />
    <SolidColorBrush x:Key="RSHShadowColorBrush" Color="#000000" />
</ResourceDictionary>
