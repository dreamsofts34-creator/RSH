<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- RSH High Contrast palette (Phase F, a11y). Windows High Contrast
         mode mein app OS ke SystemColors istemal karti hai, hard-coded
         brushes nahi — taake user ki HC colour choices (aur forced-colors
         mode) ka ehteram ho. Har RSH brush/color key Light/Dark palettes
         wali hai; yahan values SystemColors se aati hain. Status text
         (error/warning/success) HC mein WindowText hai — HC mode mein
         rang se farq nahi, lafzon se pata chalta hai (WCAG: colour alone
         kabhi eklauta zariya nahi). Secondary text bhi WindowText hai
         (HC mein grey text na-parhne-layak hota hai).
         RSHThemeManager "HighContrast" chunta hai; "System" theme par
         SystemParameters.HighContrast on ho to ye palette khud lagti hai. -->
    <SolidColorBrush x:Key="RSHBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="RSHCardBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="RSHRaisedBackgroundBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="RSHSidebarBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="RSHBorderBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="RSHTextBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="RSHSecondaryTextBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="RSHTrackBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="RSHNavActiveBackgroundBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="RSHNavHoverBackgroundBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="RSHNavActiveForegroundBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="RSHNavDotBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="RSHShadowColorBrush" Color="{x:Static SystemColors.WindowColor}" />
    <!-- Theme-aware Color keys — RSHTheme.xaml mein Ax* / status brushes
         in se bante hain (DynamicResource, palette swap par live badalte hain). -->
    <x:Static Member="SystemColors.WindowColor" x:Key="RSHBackgroundColor" />
    <x:Static Member="SystemColors.WindowColor" x:Key="RSHCardColor" />
    <x:Static Member="SystemColors.WindowTextColor" x:Key="RSHTextColor" />
    <x:Static Member="SystemColors.WindowTextColor" x:Key="RSHSecondaryTextColor" />
    <x:Static Member="SystemColors.ControlColor" x:Key="RSHTrackColor" />
    <x:Static Member="SystemColors.WindowTextColor" x:Key="RSHBorderColor" />
    <x:Static Member="SystemColors.ControlColor" x:Key="RSHAccentSoftColor" />
    <x:Static Member="SystemColors.WindowTextColor" x:Key="RSHAccentDeepColor" />
    <x:Static Member="SystemColors.HighlightColor" x:Key="RSHAccentColor" />
    <x:Static Member="SystemColors.HighlightColor" x:Key="RSHAccentHoverColor" />
    <x:Static Member="SystemColors.WindowTextColor" x:Key="RSHErrorColor" />
    <x:Static Member="SystemColors.WindowTextColor" x:Key="RSHWarningTextColor" />
    <x:Static Member="SystemColors.WindowColor" x:Key="RSHBannerColor" />
    <x:Static Member="SystemColors.WindowTextColor" x:Key="RSHSuccessTextColor" />
    <!-- Round 2 W1: pills HC mein ControlColor — WindowColor se alag nazar
         aayen, rang par inhisar kiye baghair. -->
    <x:Static Member="SystemColors.ControlColor" x:Key="RSHSuccessPillColor" />
    <x:Static Member="SystemColors.ControlColor" x:Key="RSHDangerPillColor" />
    <x:Static Member="SystemColors.ControlColor" x:Key="RSHMutedPillColor" />
</ResourceDictionary>
