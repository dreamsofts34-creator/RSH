<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- RSH light palette (UI-1, spec §0.1). Theme-independent accent
         family RSHTheme.xaml mein hai; yahan sirf woh brushes hain jo
         theme ke saath badalte hain. Dark counterpart: RSHTheme.Dark.xaml. -->
    <SolidColorBrush x:Key="RSHBackgroundBrush" Color="#F5F3FF" />
    <SolidColorBrush x:Key="RSHCardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RSHRaisedBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RSHSidebarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RSHBorderBrush" Color="#E7E3F7" />
    <SolidColorBrush x:Key="RSHTextBrush" Color="#1F1B2E" />
    <SolidColorBrush x:Key="RSHSecondaryTextBrush" Color="#5F5A7A" />
    <SolidColorBrush x:Key="RSHTrackBrush" Color="#ECE8FA" />
    <!-- Active nav = AccentSoft (#EEE9FF, §0.1) — yahan literal is liye
         ke palette dictionaries theme-dependent keys ki ek jagah hain. -->
    <SolidColorBrush x:Key="RSHNavActiveBackgroundBrush" Color="#EEE9FF" />
    <SolidColorBrush x:Key="RSHNavHoverBackgroundBrush" Color="#F5F3FF" />
    <SolidColorBrush x:Key="RSHNavActiveForegroundBrush" Color="#4B2FD0" />
    <SolidColorBrush x:Key="RSHNavDotBrush" Color="#C9C1EE" />
    <SolidColorBrush x:Key="RSHShadowColorBrush" Color="#3C288C" />
    <!-- UI-12: theme-aware Color keys — RSHTheme.xaml mein Ax* brushes
         in se bante hain, taake page content bhi Dark mein badle. -->
    <Color x:Key="RSHBackgroundColor">#F5F3FF</Color>
    <Color x:Key="RSHCardColor">#FFFFFF</Color>
    <Color x:Key="RSHTextColor">#1F1B2E</Color>
    <Color x:Key="RSHSecondaryTextColor">#5F5A7A</Color>
    <Color x:Key="RSHTrackColor">#ECE8FA</Color>
    <Color x:Key="RSHBorderColor">#E7E3F7</Color>
    <Color x:Key="RSHAccentSoftColor">#EEE9FF</Color>
    <Color x:Key="RSHAccentDeepColor">#4B2FD0</Color>
    <Color x:Key="RSHAccentColor">#6C4CF1</Color>
    <Color x:Key="RSHAccentHoverColor">#5A3BE0</Color>
    <Color x:Key="RSHErrorColor">#B42318</Color>
    <Color x:Key="RSHWarningTextColor">#B54708</Color>
    <Color x:Key="RSHBannerColor">#FFF4E5</Color>
    <Color x:Key="RSHSuccessTextColor">#146C35</Color>
    <!-- Round 2 W1: status pills theme-aware hon — pehle #E3F6EA / #FDE8E8 /
         #EDEBF5 pages mein hard-coded thay, Dark mein halke dhabbe lagte
         thay. Light values wahi purani hain (koi visual change nahi). -->
    <Color x:Key="RSHSuccessPillColor">#E3F6EA</Color>
    <Color x:Key="RSHDangerPillColor">#FDE8E8</Color>
    <Color x:Key="RSHMutedPillColor">#EDEBF5</Color>
</ResourceDictionary>
