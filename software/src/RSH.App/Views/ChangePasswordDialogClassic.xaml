<Window x:Class="RSH.App.Views.ChangePasswordDialogClassic"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change wheel password" Height="420" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="14"
        Background="{x:Static SystemColors.WindowBrush}"
        Foreground="{x:Static SystemColors.ControlTextBrush}">
    <!-- O-1 (Round 2 W2) — REAL plain Window: OS title bar. Koi
         Fluent Window chrome nahi, koi backdrop type ya title-bar
         extension nahi, koi WPF-UI chrome nahi — classic mode (Win10
         auto) mein Fluent dialog modal hang jaisa lag sakta tha, is liye
         ye variant.
         Fields/buttons/bindings ChangePasswordDialog jaisi hi hain (wahi
         ViewModel contract — IChangePasswordDialogResult); sirf presentation
         saada hai: literal English text + system brushes + literal accent
         #6C4CF1 (primary button). Koi redesign nahi. -->
    <StackPanel Margin="24">
        <TextBlock Text="Change wheel password" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="This changes the board's Wi-Fi / WebOTA password (SET_PASSWORD). The board restarts its access point — reconnect with the new password."
                      TextWrapping="Wrap" Margin="0,0,0,16" />

        <TextBlock Text="New password" FontWeight="Bold" Margin="0,0,0,6" />
        <PasswordBox AutomationProperties.Name="New password" x:Name="NewPasswordBox" Padding="10,8" FontSize="14" Margin="0,0,0,4" PasswordChanged="PasswordBox_PasswordChanged" />
        <TextBlock Text="Confirm password" FontWeight="Bold" Margin="0,12,0,6" />
        <PasswordBox AutomationProperties.Name="Confirm password" x:Name="ConfirmPasswordBox" Padding="10,8" FontSize="14" Margin="0,0,0,4" PasswordChanged="PasswordBox_PasswordChanged" />
        <TextBlock Text="8–63 characters, printable ASCII only (0x21–0x7E, no spaces) — the firmware rule (§5.2)."
                      TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock Text="{Binding ValidationText}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13" />
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" AutomationProperties.Name="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" Padding="12,6" />
            <Button Content="Change password" AutomationProperties.Name="Change password" Command="{Binding ChangeCommand}" IsEnabled="{Binding CanChange}" Padding="12,6" Background="#6C4CF1" Foreground="White" />
        </StackPanel>
    </StackPanel>
</Window>
