<UserControl x:Class="RSH.App.Views.Pages.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="980">
            <ui:TextBlock Text="Diagnostics" FontTypography="Title" Margin="0,0,0,4" />
            <ui:TextBlock Text="Link quality, engine timing, app resource use."
                          Appearance="Secondary" Margin="0,0,0,16" TextWrapping="Wrap" />

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Link" FontTypography="BodyStrong" Margin="0,0,0,6" />
                    <ui:TextBlock Text="{Binding LinkText}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Engine (200 Hz pipeline)" FontTypography="BodyStrong" Margin="0,0,0,6" />
                    <ui:TextBlock Text="{Binding EngineText}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="This app on your PC" FontTypography="BodyStrong" Margin="0,0,0,6" />
                    <ui:TextBlock Text="{Binding ProcessText}" TextWrapping="Wrap" />
                    <ui:TextBlock Text="{Binding StatusText}" Appearance="Secondary" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Export diagnostics (.zip)" Appearance="Primary" Command="{Binding ExportBundleCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Open config folder" Command="{Binding OpenConfigFolderCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
