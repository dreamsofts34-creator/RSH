<UserControl x:Class="RSH.App.Views.Pages.CalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RSH.App.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:RSH.App.Controls">
    <UserControl.Resources>
        <ctl:BoolToVisibilityConverter x:Key="BoolVis" />
        <ctl:CaptureButtonTextConverter x:Key="CaptureText" />
        <ctl:CaptureButtonAppearanceConverter x:Key="CaptureAppearance" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="980">
            <ui:TextBlock Text="{Binding Calibration, Source={x:Static res:UiStrings.Instance}}" FontTypography="Title" Margin="0,0,0,4" />
            <ui:TextBlock Text="{Binding SetYourWheelSReal, Source={x:Static res:UiStrings.Instance}}"
                          Appearance="Secondary" Margin="0,0,0,16" TextWrapping="Wrap" />

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="{Binding LiveValues, Source={x:Static res:UiStrings.Instance}}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <!-- AUDIT FIX (F9): fixed-width kataar ki jagah * columns
                         — tang window par kuch clip nahi hota. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"><Run Text="{Binding SteeringLabel, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding LiveSteering}" FontWeight="SemiBold" /></ui:TextBlock>
                        <ui:TextBlock Grid.Column="1"><Run Text="{Binding AcceleratorLabel, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding LiveAccel}" FontWeight="SemiBold" /></ui:TextBlock>
                        <ui:TextBlock Grid.Column="2"><Run Text="{Binding BrakeLabel, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding LiveBrake}" FontWeight="SemiBold" /></ui:TextBlock>
                    </Grid>
                    <!-- AUDIT FIX (F11): offline halat ki nishani — warna
                         jamay hue 0 asal values lagte thay. -->
                    <ui:TextBlock Text="{Binding NoDataWheelNotConnected, Source={x:Static res:UiStrings.Instance}}"
                                  Foreground="{StaticResource RSHErrorBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                  Visibility="{Binding HasData, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />
                    <ui:TextBlock Text="{Binding StatusText}" Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="{Binding Steering, Source={x:Static res:UiStrings.Instance}}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"><Run Text="{Binding CalibStep1CentreWheelPress, Source={x:Static res:UiStrings.Instance}}"/> <Run FontWeight="SemiBold" Text="{Binding CaptureCentre, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding CalibStep2Press, Source={x:Static res:UiStrings.Instance}}"/> <Run FontWeight="SemiBold" Text="{Binding StartRangeCapture, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding TurnFullyLeftAndRight, Source={x:Static res:UiStrings.Instance}}"/></ui:TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button Content="{Binding CaptureCentre, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding CaptureCentre, Source={x:Static res:UiStrings.Instance}}" Command="{Binding CaptureCenterCommand}" Margin="0,0,8,0" />
                        <!-- AUDIT FIX (F12): capture chal raha ho to button
                             khud batata hai — label "Stop capture" aur
                             Primary appearance. -->
                        <ui:Button Content="{Binding CapturingSteering, Converter={StaticResource CaptureText}, ConverterParameter=StartRangeCapture}" AutomationProperties.Name="{Binding CapturingSteering, Converter={StaticResource CaptureText}, ConverterParameter=StartRangeCapture}"
                                   Appearance="{Binding CapturingSteering, Converter={StaticResource CaptureAppearance}}"
                                   Command="{Binding ToggleCaptureSteeringCommand}" />
                    </StackPanel>
                    <!-- AUDIT FIX (F9): Min/Centre/Max bhi * columns mein. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"><Run Text="{Binding MinLabel, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding SteerMin}" /></ui:TextBlock>
                        <ui:TextBlock Grid.Column="1"><Run Text="{Binding CentreLabel, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding SteerCenter}" /></ui:TextBlock>
                        <ui:TextBlock Grid.Column="2"><Run Text="{Binding MaxLabel, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding SteerMax}" /></ui:TextBlock>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="{Binding Pedals, Source={x:Static res:UiStrings.Instance}}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"><Run Text="{Binding Press, Source={x:Static res:UiStrings.Instance}}"/> <Run FontWeight="SemiBold" Text="{Binding StartPedalCapture, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding KeepPedalsReleasedBrieflyThen, Source={x:Static res:UiStrings.Instance}}"/></ui:TextBlock>
                    <ui:Button Content="{Binding CapturingPedals, Converter={StaticResource CaptureText}, ConverterParameter=StartPedalCapture}" AutomationProperties.Name="{Binding CapturingPedals, Converter={StaticResource CaptureText}, ConverterParameter=StartPedalCapture}"
                               Appearance="{Binding CapturingPedals, Converter={StaticResource CaptureAppearance}}"
                               Command="{Binding ToggleCapturePedalsCommand}" Margin="0,0,0,8" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Width="230"><Run Text="{Binding AccelLabel, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding AccelMin}" /><Run Text=" → " /><Run Text="{Binding AccelMax}" /></ui:TextBlock>
                        <ui:TextBlock><Run Text="{Binding BrakeLabel, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding BrakeMin}" /><Run Text=" → " /><Run Text="{Binding BrakeMax}" /></ui:TextBlock>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal">
                <ui:Button Content="{Binding SaveCalibration, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding SaveCalibration, Source={x:Static res:UiStrings.Instance}}" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{Binding ClearCalibration, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding ClearCalibration, Source={x:Static res:UiStrings.Instance}}" Command="{Binding ResetCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
