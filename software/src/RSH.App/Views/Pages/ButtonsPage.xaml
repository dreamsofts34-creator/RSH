<UserControl x:Class="RSH.App.Views.Pages.ButtonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RSH.App.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:RSH.App.Controls">
    <UserControl.Resources>
        <ctl:BoolToStatusBrushConverter x:Key="StatusBrush" />
        <ctl:BoolToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="980">
            <ui:TextBlock Text="{Binding PageButtons, Source={x:Static res:UiStrings.Instance}}" FontTypography="Title" Margin="0,0,0,4" />
            <ui:TextBlock Text="{Binding GearAndPedalButtonsMapped, Source={x:Static res:UiStrings.Instance}}"
                          Appearance="Secondary" Margin="0,0,0,16" TextWrapping="Wrap" />

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="{Binding GearButtonsVJoy, Source={x:Static res:UiStrings.Instance}}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{Binding GearUpVJoyButtonNumber2, Source={x:Static res:UiStrings.Instance}}" Margin="0,0,0,4" />
                            <ui:NumberBox Value="{Binding GearUpButton, Mode=TwoWay}" Minimum="1" Maximum="32" SpinButtonPlacementMode="Inline" AutomationProperties.Name="{Binding GearUpVJoyButtonNumber, Source={x:Static res:UiStrings.Instance}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <ui:TextBlock Text="{Binding GearDownVJoyButtonNumber2, Source={x:Static res:UiStrings.Instance}}" Margin="0,0,0,4" />
                            <ui:NumberBox Value="{Binding GearDownButton, Mode=TwoWay}" Minimum="1" Maximum="32" SpinButtonPlacementMode="Inline" AutomationProperties.Name="{Binding GearDownVJoyButtonNumber, Source={x:Static res:UiStrings.Instance}}" />
                        </StackPanel>
                    </Grid>
                    <ui:TextBlock Text="{Binding UseUniqueNumbersFrom1, Source={x:Static res:UiStrings.Instance}}"
                                  Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <!-- P2 (D9): button 33+ par error — save nahi hota. -->
                    <ui:TextBlock Text="{Binding GearButtonsError}"
                                  Foreground="{StaticResource RSHErrorBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                  Visibility="{Binding HasGearButtonsError, Converter={StaticResource BoolVis}}" />
                    <!-- AUDIT FIX (F14): dono gear ek hi number par hon to
                         fori warning — warna profile chup chaap save ho
                         jata tha aur game mein dono gear ek button par
                         girte thay. -->
                    <ui:TextBlock Text="{Binding GearUpAndDownShare, Source={x:Static res:UiStrings.Instance}}"
                                  Foreground="{StaticResource RSHErrorBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                  Visibility="{Binding GearButtonsConflict, Converter={StaticResource BoolVis}}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="{Binding DigitalPedalRamp, Source={x:Static res:UiStrings.Instance}}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Text="{Binding PressRamp, Source={x:Static res:UiStrings.Instance}}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="500" Value="{Binding PressMs, Mode=TwoWay}" AutomationProperties.Name="{Binding PressRamp, Source={x:Static res:UiStrings.Instance}}" VerticalAlignment="Center" Margin="12,0" />
                        <ui:TextBlock Grid.Column="2" VerticalAlignment="Center"><Run Text="{Binding PressMs, StringFormat={}{0:F0}}" /><Run Text="{Binding Ms, Source={x:Static res:UiStrings.Instance}}" /></ui:TextBlock>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Text="{Binding ReleaseRamp, Source={x:Static res:UiStrings.Instance}}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="500" Value="{Binding ReleaseMs, Mode=TwoWay}" AutomationProperties.Name="{Binding ReleaseRamp, Source={x:Static res:UiStrings.Instance}}" VerticalAlignment="Center" Margin="12,0" />
                        <ui:TextBlock Grid.Column="2" VerticalAlignment="Center"><Run Text="{Binding ReleaseMs, StringFormat={}{0:F0}}" /><Run Text="{Binding Ms, Source={x:Static res:UiStrings.Instance}}" /></ui:TextBlock>
                    </Grid>
                    <ui:TextBlock Text="{Binding AnalogPedalAndButtonCombine, Source={x:Static res:UiStrings.Instance}}"
                                  Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="{Binding AllVJoyButtonsPressTo, Source={x:Static res:UiStrings.Instance}}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:TextBlock Text="{Binding EveryVJoyButton132, Source={x:Static res:UiStrings.Instance}}"
                                  Appearance="Secondary" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <!-- Cells code-behind mein bante hain (32 buttons) — Tick har
                         33 ms par mask se highlight karta hai (U-P2: < 50 ms). -->
                    <WrapPanel x:Name="ButtonGrid" Margin="0,0,0,8" />
                    <ui:TextBlock x:Name="MappingLegendText" Text="{Binding GearUpVJoy1Gear, Source={x:Static res:UiStrings.Instance}}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="{Binding EncodersLive, Source={x:Static res:UiStrings.Instance}}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock x:Name="Encoder1Text" Text="{Binding Encoder1, Source={x:Static res:UiStrings.Instance}}" Margin="0,0,24,0" />
                        <ui:TextBlock x:Name="Encoder2Text" Text="{Binding Encoder2, Source={x:Static res:UiStrings.Instance}}" />
                    </StackPanel>
                    <ui:TextBlock Text="{Binding CumulativeEncoderCountsFromThe, Source={x:Static res:UiStrings.Instance}}"
                                  Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16">
                <StackPanel>
                    <ui:TextBlock Text="{Binding LiveTest, Source={x:Static res:UiStrings.Instance}}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <!-- AUDIT FIX (F9): WrapPanel — tang window par clip nahi hoti. -->
                    <WrapPanel Margin="0,0,0,8">
                        <Ellipse Width="14" Height="14" VerticalAlignment="Center" Fill="{Binding GearUpPressed, Converter={StaticResource StatusBrush}}" />
                        <ui:TextBlock Text="{Binding GearUp, Source={x:Static res:UiStrings.Instance}}" Margin="6,0,20,0" VerticalAlignment="Center" />
                        <Ellipse Width="14" Height="14" VerticalAlignment="Center" Fill="{Binding GearDownPressed, Converter={StaticResource StatusBrush}}" />
                        <ui:TextBlock Text="{Binding GearDown, Source={x:Static res:UiStrings.Instance}}" Margin="6,0,20,0" VerticalAlignment="Center" />
                        <Ellipse Width="14" Height="14" VerticalAlignment="Center" Fill="{Binding AccelBtnPressed, Converter={StaticResource StatusBrush}}" />
                        <ui:TextBlock Text="{Binding AccelButton, Source={x:Static res:UiStrings.Instance}}" Margin="6,0,20,0" VerticalAlignment="Center" />
                        <Ellipse Width="14" Height="14" VerticalAlignment="Center" Fill="{Binding BrakeBtnPressed, Converter={StaticResource StatusBrush}}" />
                        <ui:TextBlock Text="{Binding BrakeButton, Source={x:Static res:UiStrings.Instance}}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </WrapPanel>
                    <ui:TextBlock><Run Text="{Binding CurrentVJoyButtonMaskLabel, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding MaskText}" FontWeight="SemiBold" /></ui:TextBlock>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
