<UserControl x:Class="RSH.App.Views.Pages.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RSH.App.Controls"
             xmlns:res="clr-namespace:RSH.App.Resources">
    <UserControl.Resources>
        <ctl:BoolToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource AxMutedBrush}" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            <Setter Property="TextElement.FontSize" Value="13" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="1">
                    <Setter Property="Background" Value="{StaticResource AxAccent}" />
                    <Setter Property="TextElement.Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="2">
                    <Setter Property="Background" Value="#E3F6EA" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource RSHSuccessTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <TextBlock Text="{Binding PageSetup, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxH1}" />
            <TextBlock Text="{Binding ConnectYourWheelCheckThe, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxSub}" />

            <!-- NeedsRecalibration prompt (SETUP-GATES-DECISION.md §3.2, verbatim) — entry par dikhta hai, trigger zinda ho to dobara aata hai. -->
            <Border Style="{StaticResource AxCard}" Background="{StaticResource RSHBannerBrush}" Padding="14,10" Margin="0,14,0,0"
                    Visibility="{Binding HasRecalibrationPrompt, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding RecalibrationPrompt, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding RecalibrateNow, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding RecalibrateNow, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxPrimary}" Command="{Binding StartRecalibrationCommand}" Margin="12,0,8,0" />
                    <Button Grid.Column="2" Content="{Binding Dismiss, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding Dismiss, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxGhost}" Command="{Binding DismissRecalibrationPromptCommand}" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Style="{StaticResource Chip}" Tag="{Binding FlowChip0}"><TextBlock Text="{Binding FlowChip0Text}" /></Border>
                <Border Style="{StaticResource Chip}" Tag="{Binding FlowChip1}"><TextBlock Text="{Binding FlowChip1Text}" /></Border>
                <Border Style="{StaticResource Chip}" Tag="{Binding FlowChip2}"><TextBlock Text="{Binding FlowChip2Text}" /></Border>
                <TextBlock Text="{Binding FlowStepCounter}" Style="{StaticResource AxMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <ProgressBar Style="{StaticResource AxBar}" Value="{Binding OverallProgress, Mode=OneWay}" Margin="0,0,0,18" />

            <!-- Step 1: Connect -->
            <StackPanel Visibility="{Binding IsFlowConnect, Converter={StaticResource BoolVis}}">
                <Border Style="{StaticResource AxCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding ConnectToYourWheel, Source={x:Static res:UiStrings.Instance}}" FontSize="22" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding PowerTheWheelJoinIts, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxMuted}" Margin="0,0,0,18" />

                        <TextBlock Text="{Binding ConnectStatus}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ConnectError}" Foreground="{StaticResource RSHErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13"
                                   Visibility="{Binding HasConnectError, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="{Binding Connection.WheelText}" Style="{StaticResource AxMuted}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding Connection.HelloText}" Style="{StaticResource AxMuted}" Margin="0,0,0,18" />

                        <TextBlock Text="{Binding WheelAddress, Source={x:Static res:UiStrings.Instance}}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox Text="{Binding HostText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding WheelAddress, Source={x:Static res:UiStrings.Instance}}"
                                 Padding="10,8" FontSize="14" Margin="0,0,0,4" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220" />
                        <TextBlock Text="{Binding TheWheelSWiFi, Source={x:Static res:UiStrings.Instance}}"
                                   Style="{StaticResource AxMuted}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding HostError}" Foreground="{StaticResource RSHErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13" />

                        <TextBlock Text="{Binding WheelWiFiPassword, Source={x:Static res:UiStrings.Instance}}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <PasswordBox x:Name="WifiPasswordBox" AutomationProperties.Name="{Binding WheelWiFiPassword, Source={x:Static res:UiStrings.Instance}}" Width="220" HorizontalAlignment="Left" Padding="10,8" FontSize="14"
                                     PasswordChanged="WifiPasswordBox_PasswordChanged" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding TheBoardSPerDevice, Source={x:Static res:UiStrings.Instance}}"
                                   Style="{StaticResource AxMuted}" Margin="0,0,0,18" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding ConnectWifi, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding ConnectWifi, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxPrimary}" Command="{Binding ConnectCommand}" Margin="0,0,10,0" />
                            <Button Content="{Binding Retry, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding Retry, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxGhost}" Command="{Binding RetryConnectCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Connection.WifiStatus}" Style="{StaticResource AxMuted}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Step 2: Pins (read-only) -->
            <StackPanel Visibility="{Binding IsFlowPins, Converter={StaticResource BoolVis}}">
                <Border Style="{StaticResource AxCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding WiringPinTable, Source={x:Static res:UiStrings.Instance}}" FontSize="22" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding WhatTheBoardReportsPins, Source={x:Static res:UiStrings.Instance}}"
                                   Style="{StaticResource AxMuted}" Margin="0,0,0,18" />
                        <TextBlock Text="{Binding PinsSourceText}" Style="{StaticResource AxMuted}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding LoadingPinTable, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxMuted}" Margin="0,0,0,8"
                                   Visibility="{Binding PinsLoading, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="{Binding PinsError}" Foreground="{StaticResource RSHErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="13" />

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Function, Source={x:Static res:UiStrings.Instance}}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding Pin, Source={x:Static res:UiStrings.Instance}}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Grid.Column="2" Text="{Binding Type, Source={x:Static res:UiStrings.Instance}}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Grid.Column="3" Text="{Binding Detail, Source={x:Static res:UiStrings.Instance}}" FontWeight="SemiBold" FontSize="13" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding PinRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Function}" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding Gpio}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="13" />
                                        <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="13" Style="{StaticResource AxMuted}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="{Binding RefreshPinTable, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding RefreshPinTable, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxGhost}" Command="{Binding RefreshPinsCommand}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Step 3: Calibrate -->
            <StackPanel Visibility="{Binding IsFlowCalibrate, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Style="{StaticResource Chip}" Tag="{Binding Chip0}"><TextBlock Text="{Binding Chip0Text}" /></Border>
                    <Border Style="{StaticResource Chip}" Tag="{Binding Chip1}"><TextBlock Text="{Binding Chip1Text}" /></Border>
                    <Border Style="{StaticResource Chip}" Tag="{Binding Chip2}"><TextBlock Text="{Binding Chip2Text}" /></Border>
                    <Border Style="{StaticResource Chip}" Tag="{Binding Chip3}"><TextBlock Text="{Binding Chip3Text}" /></Border>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AxCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding StepTitle}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding StepHint}" Style="{StaticResource AxMuted}" Margin="0,0,0,18" />

                            <TextBlock Text="{Binding WheelNotConnectedPowerThe, Source={x:Static res:UiStrings.Instance}}"
                                       Foreground="{StaticResource RSHErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13"
                                       Visibility="{Binding HasData, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />

                            <!-- Track: live position (steps 1-2), captured range markers (step 2) -->
                            <Grid Height="56" Margin="0,0,0,10" Visibility="{Binding ShowTrack, Converter={StaticResource BoolVis}}">
                                <Border Background="{StaticResource AxTrack}" CornerRadius="12" />
                                <Grid Visibility="{Binding ShowMarkers, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="RC0" Width="*" />
                                        <ColumnDefinition x:Name="RC1" Width="*" />
                                        <ColumnDefinition x:Name="RC2" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" Background="#CFC4FA" CornerRadius="12" />
                                    <Border Grid.Column="1" Width="4" Margin="0,-4" Background="{StaticResource AxAccent}" HorizontalAlignment="Left" />
                                    <Border Grid.Column="1" Width="4" Margin="0,-4" Background="{StaticResource AxAccent}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="NC0" Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition x:Name="NC2" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" Width="10" Margin="0,8" CornerRadius="5" Background="{StaticResource AxInk}" />
                                </Grid>
                            </Grid>

                            <StackPanel Visibility="{Binding IsStep0, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource AxMuted}">
                                    <Run Text="{Binding LiveReadingLabel, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding LiveSteering, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolVis}}">
                                <Grid Margin="0,0,0,18">
                                    <TextBlock Text="{Binding LeftText}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RightText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Style="{StaticResource AxBar}" Value="{Binding RangePercent, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource AxMuted}" Margin="0,6,0,0">
                                    <Run Text="{Binding RangeFoundLabel, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding RangePercent, StringFormat={}{0:F0}, Mode=OneWay}" /><Run Text="%" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding AccelText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ProgressBar Style="{StaticResource AxBar}" Value="{Binding AccelPercent, Mode=OneWay}" Margin="0,0,0,16" />
                                <TextBlock Text="{Binding BrakeText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ProgressBar Style="{StaticResource AxBar}" Value="{Binding BrakePercent, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="14" />
                            </StackPanel>

                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource RSHErrorBrush}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AxCard}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{Binding Tips, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxH2}" />
                            <TextBlock Style="{StaticResource AxMuted}" LineHeight="22">
                                <Run Text="{Binding HoldTheWheelByThe, Source={x:Static res:UiStrings.Instance}}" /><LineBreak />
                                <Run Text="{Binding DonTForceItPast, Source={x:Static res:UiStrings.Instance}}" /><LineBreak />
                                <Run Text="{Binding WrongDirectionLaterUseInvert, Source={x:Static res:UiStrings.Instance}}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <Grid Margin="0,20,0,0">
                <Button Content="{Binding Back, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding Back, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxGhost}" Command="{Binding FlowBackCommand}" HorizontalAlignment="Left"
                        Visibility="{Binding CanFlowBack, Converter={StaticResource BoolVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding Restart, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding Restart, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxGhost}" Command="{Binding RestartCommand}" Margin="0,0,10,0"
                            Visibility="{Binding IsFlowCalibrate, Converter={StaticResource BoolVis}}" />
                    <Button Content="{Binding FlowNextLabel}" AutomationProperties.Name="{Binding FlowNextLabel}" Style="{StaticResource AxPrimary}" Command="{Binding FlowNextCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
