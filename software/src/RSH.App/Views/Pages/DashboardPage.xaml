<UserControl x:Class="RSH.App.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:RSH.App.Controls"
             xmlns:res="clr-namespace:RSH.App.Resources">
    <UserControl.Resources>
        <ctl:BoolToVisibilityConverter x:Key="BoolVis" />
        <ctl:NormToPercentConverter x:Key="Pct" />
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="#FDE8E8" />
            <Setter Property="TextElement.Foreground" Value="#B42318" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WheelConnected}" Value="True">
                    <Setter Property="Background" Value="#E3F6EA" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource RSHSuccessTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageDashboard, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxH1}" />
                    <TextBlock Style="{StaticResource AxMuted}" FontSize="14">
                        <Run Text="{Binding ProfileLabel, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding ActiveProfileName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding WheelAddressText, Mode=OneWay}" Style="{StaticResource AxMuted}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Style="{StaticResource Pill}">
                        <TextBlock Text="{Binding WheelPillText}" />
                    </Border>
                    <ui:ToggleSwitch IsChecked="{Binding OutputEnabled}" Content="{Binding GameOutput, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding GameOutput, Source={x:Static res:UiStrings.Instance}}" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource AxCard}" Background="{StaticResource RSHBannerBrush}" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding WatchdogActive, Converter={StaticResource BoolVis}}">
                <TextBlock TextWrapping="Wrap" FontSize="13">
                    <Run Text="{Binding OutputNeutralLabel, Source={x:Static res:UiStrings.Instance}}" FontWeight="SemiBold" />
                    <Run Text="{Binding NoDataFor250Ms, Source={x:Static res:UiStrings.Instance}}" />
                </TextBlock>
            </Border>

            <!-- NeedsRecalibration (SETUP-GATES-DECISION.md §3.2, verbatim): dismiss sirf tab tak jab tak wajah na badle. -->
            <Border Style="{StaticResource AxCard}" Background="{StaticResource RSHBannerBrush}" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HasRecalibrationBanner, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding RecalibrationBannerText, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding OpenSetup, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding OpenSetup, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxPrimary}" Command="{Binding StartSetupCommand}" Margin="12,0,8,0" />
                    <Button Grid.Column="2" Content="{Binding Dismiss, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding Dismiss, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxGhost}" Command="{Binding DismissRecalibrationBannerCommand}" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AxCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding Steering, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxH2}" />
                        <!-- Live wheel: spokes rotate by the real angle (lock-to-lock range = scale × 900°). -->
                        <Canvas Width="200" Height="200" HorizontalAlignment="Center">
                            <Ellipse Canvas.Left="10" Canvas.Top="10" Width="180" Height="180"
                                     Stroke="{StaticResource AxInk}" StrokeThickness="12" />
                            <Canvas Width="200" Height="200">
                                <Canvas.RenderTransform>
                                    <RotateTransform CenterX="100" CenterY="100" Angle="{Binding SteeringDegrees}" />
                                </Canvas.RenderTransform>
                                <Line X1="100" Y1="100" X2="100" Y2="30" Stroke="{StaticResource AxInk}" StrokeThickness="8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="100" Y1="100" X2="34" Y2="150" Stroke="{StaticResource AxInk}" StrokeThickness="8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="100" Y1="100" X2="166" Y2="150" Stroke="{StaticResource AxInk}" StrokeThickness="8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                            <Ellipse Canvas.Left="85" Canvas.Top="85" Width="30" Height="30" Fill="{StaticResource AxAccent}" />
                        </Canvas>
                        <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Run Text="{Binding SteeringBigText, Mode=OneWay}" FontSize="38" FontWeight="Bold" />
                            <Run Text=" " />
                            <Run Text="{Binding SteeringSideText, Mode=OneWay}" FontSize="15" Foreground="{StaticResource AxMutedBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding SteeringRangeText, Mode=OneWay}" Style="{StaticResource AxMuted}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding OutputStatusText}" Style="{StaticResource AxMuted}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource AxCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Pedals, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxH2}" />
                            <TextBlock Style="{StaticResource AxMuted}" Margin="0,0,0,6">
                                <Run Text="{Binding Accelerator2, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding AccelNorm, Converter={StaticResource Pct}, Mode=OneWay}" />
                            </TextBlock>
                            <ProgressBar Style="{StaticResource AxBar}" Maximum="1" Value="{Binding AccelNorm, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource AxMuted}" Margin="0,12,0,6">
                                <Run Text="{Binding BrakeSpace, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding BrakeNorm, Converter={StaticResource Pct}, Mode=OneWay}" />
                            </TextBlock>
                            <ProgressBar Style="{StaticResource AxBar}" Maximum="1" Value="{Binding BrakeNorm, Mode=OneWay}" />
                            <!-- Clutch bar nahi: ProcessedState / protocol v2.1 mein clutch channel hi nahi hai
                                 (pipeline work) — fake bar kabhi nahi. -->
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AxCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Engine, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxH2}" />
                            <TextBlock Text="{Binding EngineStatsText, Mode=OneWay}" Style="{StaticResource AxMuted}" />
                            <TextBlock Text="{Binding FirmwareText, Mode=OneWay}" Style="{StaticResource AxMuted}" Margin="0,4,0,12" />
                            <Button Content="{Binding RestartWheel, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding RestartWheel, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxGhost}" HorizontalAlignment="Left"
                                    Command="{Binding RestartWheelCommand}" />
                            <TextBlock Text="{Binding RestartStatusText, Mode=OneWay}" Style="{StaticResource AxMuted}"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AxCard}" Background="{StaticResource AxAccent}">
                        <StackPanel>
                            <TextBlock Text="{Binding NextStep, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxH2}" Foreground="White" />
                            <TextBlock Text="{Binding CalibrateYourWheelAndPedals, Source={x:Static res:UiStrings.Instance}}"
                                       Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <Button Content="{Binding StartSetup, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding StartSetup, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxWhiteBtn}" Command="{Binding StartSetupCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource AxCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding GameLauncher, Source={x:Static res:UiStrings.Instance}}" Style="{StaticResource AxH2}" />
                    <TextBlock Text="{Binding LaunchingAGameActivatesIts, Source={x:Static res:UiStrings.Instance}}"
                               Style="{StaticResource AxMuted}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding GameLauncher.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource AxLine}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding BoundProfileText}" Style="{StaticResource AxMuted}" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource AxMuted}"
                                                   VerticalAlignment="Center" Margin="16,0" TextWrapping="Wrap" MaxWidth="300" />
                                        <Button Grid.Column="2" Content="{Binding Launch, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding Name, StringFormat='Launch {0}'}" Style="{StaticResource AxPrimary}"
                                                Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" />
                                        <Button Grid.Column="3" Content="{Binding Stop, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding Name, StringFormat='Stop {0}'}" Style="{StaticResource AxGhost}"
                                                Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
