<UserControl x:Class="RSH.App.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:RSH.App.Controls">
    <UserControl.Resources>
        <ctl:BoolToVisibilityConverter x:Key="BoolVis" />
        <ctl:NormToPercentConverter x:Key="Pct" />
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="#FDE8E8" />
            <Setter Property="TextElement.Foreground" Value="#B42318" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WheelConnected}" Value="True">
                    <Setter Property="Background" Value="#E3F6EA" />
                    <Setter Property="TextElement.Foreground" Value="#17803D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Home" Style="{StaticResource AxH1}" />
                    <TextBlock Style="{StaticResource AxMuted}" FontSize="14">
                        <Run Text="Profile: " /><Run Text="{Binding ActiveProfileName, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Style="{StaticResource Pill}">
                        <TextBlock Text="{Binding WheelPillText}" />
                    </Border>
                    <ui:ToggleSwitch IsChecked="{Binding OutputEnabled}" Content="Game output" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource AxCard}" Background="#FFF4E5" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding WatchdogActive, Converter={StaticResource BoolVis}}">
                <TextBlock TextWrapping="Wrap" FontSize="13">
                    <Run Text="Output neutral: " FontWeight="SemiBold" />
                    <Run Text="no data for 250 ms. The safety watchdog is holding the controls centred." />
                </TextBlock>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AxCard}">
                    <StackPanel>
                        <TextBlock Text="Steering" Style="{StaticResource AxH2}" />
                        <Canvas Width="260" Height="190" HorizontalAlignment="Center">
                            <Path Data="M30,170 A100,100 0 0 1 230,170" Stroke="{StaticResource AxTrack}" StrokeThickness="16"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="130" Y1="170" X2="130" Y2="84" Stroke="{StaticResource AxInk}" StrokeThickness="5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Line.RenderTransform>
                                    <RotateTransform CenterX="130" CenterY="170" Angle="{Binding GaugeAngle}" />
                                </Line.RenderTransform>
                            </Line>
                            <Ellipse Canvas.Left="121" Canvas.Top="161" Width="18" Height="18" Fill="{StaticResource AxInk}" />
                        </Canvas>
                        <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Run Text="{Binding SteeringBigText, Mode=OneWay}" FontSize="38" FontWeight="Bold" />
                            <Run Text=" " />
                            <Run Text="{Binding SteeringSideText, Mode=OneWay}" FontSize="15" Foreground="{StaticResource AxMutedBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding OutputStatusText}" Style="{StaticResource AxMuted}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource AxCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Pedals" Style="{StaticResource AxH2}" />
                            <TextBlock Style="{StaticResource AxMuted}" Margin="0,0,0,6">
                                <Run Text="Accelerator " /><Run Text="{Binding AccelNorm, Converter={StaticResource Pct}, Mode=OneWay}" />
                            </TextBlock>
                            <ProgressBar Style="{StaticResource AxBar}" Maximum="1" Value="{Binding AccelNorm, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource AxMuted}" Margin="0,12,0,6">
                                <Run Text="Brake " /><Run Text="{Binding BrakeNorm, Converter={StaticResource Pct}, Mode=OneWay}" />
                            </TextBlock>
                            <ProgressBar Style="{StaticResource AxBar}" Maximum="1" Value="{Binding BrakeNorm, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AxCard}" Background="{StaticResource AxAccent}">
                        <StackPanel>
                            <TextBlock Text="Next step" Style="{StaticResource AxH2}" Foreground="White" />
                            <TextBlock Text="Calibrate your wheel and pedals. Guided, takes about 1 minute."
                                       Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <Button Content="Start setup" Style="{StaticResource AxWhiteBtn}" Command="{Binding StartSetupCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
