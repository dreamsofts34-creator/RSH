<UserControl x:Class="RSH.App.Views.Pages.ConnectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="980">
            <ui:TextBlock Text="Connection" FontTypography="Title" Margin="0,0,0,16" />

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Wheel Wi-Fi" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="Password" VerticalAlignment="Center" Width="90" />
                        <ui:TextBox Text="{Binding WifiPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" />
                        <ui:Button Content="Connect to RSH" Appearance="Primary" Command="{Binding ConnectWifiCommand}" />
                    </StackPanel>
                    <ui:TextBlock Text="{Binding WifiStatus}" Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Live link" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:TextBlock Text="{Binding HelloText}" Margin="0,0,0,4" />
                    <ui:TextBlock Text="{Binding WheelText}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Wheel address" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox Text="{Binding EspIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" />
                        <ui:Button Content="Apply" Command="{Binding ApplyIpCommand}" />
                    </StackPanel>
                    <ui:TextBlock Text="{Binding StatusText}" Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card>
                <StackPanel>
                    <ui:TextBlock Text="Wheel firmware" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:Button Content="Restart wheel" Command="{Binding RestartFirmwareCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
