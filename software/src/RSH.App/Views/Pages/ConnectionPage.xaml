<UserControl x:Class="RSH.App.Views.Pages.ConnectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RSH.App.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="980">
            <ui:TextBlock Text="{Binding Connection, Source={x:Static res:UiStrings.Instance}}" FontTypography="Title" Margin="0,0,0,16" />

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="{Binding WheelWiFi, Source={x:Static res:UiStrings.Instance}}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="{Binding Password, Source={x:Static res:UiStrings.Instance}}" VerticalAlignment="Center" Width="90" />
                        <PasswordBox x:Name="WifiPasswordBox" AutomationProperties.Name="{Binding WheelWiFiPassword, Source={x:Static res:UiStrings.Instance}}" Width="220" Margin="0,0,8,0" PasswordChanged="WifiPasswordBox_PasswordChanged" />
                        <ui:Button Content="{Binding ConnectToRSH, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding ConnectToRSH, Source={x:Static res:UiStrings.Instance}}" Appearance="Primary" Command="{Binding ConnectWifiCommand}" />
                    </StackPanel>
                    <ui:TextBlock Text="{Binding TheBoardSPerDevice, Source={x:Static res:UiStrings.Instance}}" Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <ui:TextBlock Text="{Binding WifiStatus}" Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="{Binding LiveLink, Source={x:Static res:UiStrings.Instance}}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:TextBlock Text="{Binding HelloText}" Margin="0,0,0,4" />
                    <ui:TextBlock Text="{Binding WheelText}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="{Binding WheelAddress, Source={x:Static res:UiStrings.Instance}}" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox Text="{Binding EspIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" AutomationProperties.Name="{Binding WheelAddress, Source={x:Static res:UiStrings.Instance}}" />
                        <ui:Button Content="{Binding Apply, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding Apply, Source={x:Static res:UiStrings.Instance}}" Command="{Binding ApplyIpCommand}" />
                    </StackPanel>
                    <ui:TextBlock Text="{Binding StatusText}" Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
