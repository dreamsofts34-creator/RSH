<UserControl x:Class="RSH.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="980">
            <ui:TextBlock Text="Settings" FontTypography="Title" Margin="0,0,0,16" />

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Appearance" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="Theme" VerticalAlignment="Center" Width="160" />
                        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}" Width="180" />
                    </StackPanel>
                    <ui:TextBlock Text="System follows Windows."
                                  Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Startup &amp; tray" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="Start with Windows" Margin="0,0,0,4" />
                            <ui:ToggleSwitch IsChecked="{Binding Autostart}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <ui:TextBlock Text="Start minimised to tray" Margin="0,0,0,4" />
                            <ui:ToggleSwitch IsChecked="{Binding StartMinimized}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <ui:TextBlock Text="Close button hides to tray" Margin="0,0,0,4" />
                            <ui:ToggleSwitch IsChecked="{Binding CloseToTray}" />
                        </StackPanel>
                    </Grid>
                    <ui:TextBlock Text="Exit fully from the tray menu."
                                  Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Profiles" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="Auto-switch profile per game" VerticalAlignment="Center" Width="260" />
                        <ui:ToggleSwitch IsChecked="{Binding AutoSwitchProfiles}" />
                    </StackPanel>
                    <ui:TextBlock Text="Set each profile's game on the Profiles page."
                                  Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Logging" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="Log level" VerticalAlignment="Center" Width="160" />
                        <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel, Mode=TwoWay}" Width="180" />
                    </StackPanel>
                    <ui:TextBlock Text="Logs keep 7 days, in the config folder."
                                  Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <ui:TextBlock Text="{Binding StatusText}" Appearance="Secondary" Margin="0,4,0,0" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Setup" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:Button Content="Run setup wizard again" Command="{Binding RunWizardCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16">
                <StackPanel>
                    <ui:TextBlock Text="About" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:TextBlock Text="{Binding VersionText}" />
                    <ui:TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="Config folder: " /><Run Text="{Binding ConfigPath}" />
                    </ui:TextBlock>
                    <ui:Button Content="Open config folder" Command="{Binding OpenConfigCommand}" Margin="0,8,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
