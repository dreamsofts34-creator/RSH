<ui:FluentWindow x:Class="RSH.App.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Change wheel password" Height="420" Width="520"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <ui:TextBlock Text="Change wheel password" FontTypography="Title" Margin="0,0,0,4" />
        <ui:TextBlock Text="This changes the board's Wi-Fi / WebOTA password (SET_PASSWORD). The board restarts its access point — reconnect with the new password."
                      Appearance="Secondary" Margin="0,0,0,16" TextWrapping="Wrap" />

        <ui:TextBlock Text="New password" FontTypography="BodyStrong" Margin="0,0,0,6" />
        <PasswordBox AutomationProperties.Name="New password" x:Name="NewPasswordBox" Padding="10,8" FontSize="14" Margin="0,0,0,4" PasswordChanged="PasswordBox_PasswordChanged" />
        <ui:TextBlock Text="Confirm password" FontTypography="BodyStrong" Margin="0,12,0,6" />
        <PasswordBox AutomationProperties.Name="Confirm password" x:Name="ConfirmPasswordBox" Padding="10,8" FontSize="14" Margin="0,0,0,4" PasswordChanged="PasswordBox_PasswordChanged" />
        <ui:TextBlock Text="8–63 characters, printable ASCII only (0x21–0x7E, no spaces) — the firmware rule (§5.2)."
                      Appearance="Secondary" Margin="0,0,0,12" TextWrapping="Wrap" />

        <ui:TextBlock Text="{Binding ValidationText}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13" />
        <ui:TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Cancel" AutomationProperties.Name="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Change password" AutomationProperties.Name="Change password" Appearance="Primary" Command="{Binding ChangeCommand}" IsEnabled="{Binding CanChange}" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
