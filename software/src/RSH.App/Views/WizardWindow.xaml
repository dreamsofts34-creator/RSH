<ui:FluentWindow x:Class="RSH.App.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RSH.App.Resources"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding RSHSetup, Source={x:Static res:UiStrings.Instance}}" Height="560" Width="680"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding RSHSetup, Source={x:Static res:UiStrings.Instance}}" />
        <StackPanel Grid.Row="1" Margin="28,10,28,0">
            <ui:TextBlock x:Name="StepTitle" Text="{Binding WelcomeToRSH, Source={x:Static res:UiStrings.Instance}}" FontTypography="Title" />
            <ui:TextBlock x:Name="StepCounter" Text="{Binding Step1Of7, Source={x:Static res:UiStrings.Instance}}" Appearance="Secondary" Margin="0,2,0,0" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="28,16,28,8">
            <!-- Step 0: Welcome -->
            <StackPanel x:Name="StepWelcome">
                <ui:TextBlock TextWrapping="Wrap" Text="{Binding RSHSetsItselfUpLabel, Source={x:Static res:UiStrings.Instance}}"></ui:TextBlock>
                <ui:TextBlock Margin="0,10,0,0" TextWrapping="Wrap"><Run Text="{Binding WizardStep1VJoyCheck, Source={x:Static res:UiStrings.Instance}}"/><LineBreak /> <Run Text="{Binding WizardStep2WifiConnect, Source={x:Static res:UiStrings.Instance}}"/><LineBreak /> <Run Text="{Binding WizardStep3WiringCheck, Source={x:Static res:UiStrings.Instance}}"/><LineBreak /> <Run Text="{Binding WizardStep4FirmwareUpdate, Source={x:Static res:UiStrings.Instance}}"/><LineBreak /> <Run Text="{Binding WizardStep5SteeringCalibration, Source={x:Static res:UiStrings.Instance}}"/><LineBreak /> <Run Text="{Binding WizardStep6PedalCalibration, Source={x:Static res:UiStrings.Instance}}"/><LineBreak /> <Run Text="{Binding WizardStep7ButtonOutputTest, Source={x:Static res:UiStrings.Instance}}"/></ui:TextBlock>
                <ui:TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Appearance="Secondary" Text="{Binding StepsAdvanceOnTheirOwn, Source={x:Static res:UiStrings.Instance}}"></ui:TextBlock>
            </StackPanel>

            <!-- Step 1: vJoy -->
            <StackPanel x:Name="StepVJoy" Visibility="Collapsed">
                <ui:TextBlock TextWrapping="Wrap"><Run Text="{Binding GamesReadA, Source={x:Static res:UiStrings.Instance}}"/> <Run FontWeight="SemiBold" Text="{Binding VJoy, Source={x:Static res:UiStrings.Instance}}" /> <Run Text="{Binding VirtualJoystick, Source={x:Static res:UiStrings.Instance}}"/></ui:TextBlock>
                <ui:Card Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="VJoyDot" Width="12" Height="12" Fill="#F85149" VerticalAlignment="Center" />
                            <ui:TextBlock x:Name="VJoyStatus" Text="{Binding Checking, Source={x:Static res:UiStrings.Instance}}" Margin="8,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:TextBlock x:Name="VJoyDetails" Appearance="Secondary" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="{Binding OpenVJoyConfigure, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding OpenVJoyConfigure, Source={x:Static res:UiStrings.Instance}}" Click="OpenVJoyConf_Click" Margin="0,0,8,0" />
                    <ui:Button Content="{Binding GetVJoyDriver, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding GetVJoyDriver, Source={x:Static res:UiStrings.Instance}}" Click="GetVJoy_Click" />
                </StackPanel>
                <ui:TextBlock x:Name="VJoyActionStatus" Margin="0,8,0,0" TextWrapping="Wrap" Appearance="Secondary" />
            </StackPanel>

            <!-- Step 2: Wheel link -->
            <StackPanel x:Name="StepLink" Visibility="Collapsed">
                <ui:TextBlock TextWrapping="Wrap"><Run Text="{Binding PowerTheWheelOneClick, Source={x:Static res:UiStrings.Instance}}"/> <Run FontWeight="SemiBold" Text="{Binding RSH, Source={x:Static res:UiStrings.Instance}}" /> <Run Text="{Binding WiFi, Source={x:Static res:UiStrings.Instance}}"/></ui:TextBlock>
                <ui:Card Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LinkDot" Width="12" Height="12" Fill="#F85149" VerticalAlignment="Center" />
                            <ui:TextBlock x:Name="LinkStatus" Text="{Binding WaitingForPackets, Source={x:Static res:UiStrings.Instance}}" Margin="8,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:TextBlock x:Name="LinkDetails" Appearance="Secondary" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button x:Name="WifiConnectButton" Content="{Binding ConnectAutomatically, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding ConnectAutomatically, Source={x:Static res:UiStrings.Instance}}" Appearance="Primary" Click="ConnectWifi_Click" />
                </StackPanel>
                <ui:TextBlock x:Name="WifiStatusText" Margin="0,8,0,0" TextWrapping="Wrap" Appearance="Secondary" />
                <ui:TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Appearance="Secondary" Text="{Binding NoInternetWhileOnRSH, Source={x:Static res:UiStrings.Instance}}"></ui:TextBlock>
            </StackPanel>

            <!-- Step 3: Pins (read-only — UI-7 flow se milta hai) -->
            <StackPanel x:Name="StepPins" Visibility="Collapsed">
                <ui:TextBlock TextWrapping="Wrap" Text="{Binding CheckTheWiringTheBoard, Source={x:Static res:UiStrings.Instance}}"></ui:TextBlock>
                <ui:Card Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:TextBlock Text="{Binding PinsSourceText}" Appearance="Secondary" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding PinRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" Text="{Binding Function}" />
                                        <ui:TextBlock Grid.Column="1" Text="{Binding Gpio}" FontWeight="SemiBold" />
                                        <ui:TextBlock Grid.Column="2" Text="{Binding Kind}" Appearance="Secondary" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:TextBlock Text="{Binding PinsError}" Margin="0,8,0,0" TextWrapping="Wrap" Appearance="Secondary" />
                    </StackPanel>
                </ui:Card>
                <ui:Button Content="{Binding RefreshPinTable, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding RefreshPinTable, Source={x:Static res:UiStrings.Instance}}" Click="RefreshPins_Click" Margin="0,12,0,0" />
            </StackPanel>

            <!-- Step 4: Firmware update (optional) -->
            <StackPanel x:Name="StepFirmware" Visibility="Collapsed">
                <ui:TextBlock TextWrapping="Wrap"><Run Text="{Binding OptionalSendAFirmware, Source={x:Static res:UiStrings.Instance}}"/> <Run FontWeight="SemiBold" Text="{Binding Bin, Source={x:Static res:UiStrings.Instance}}" /> <Run Text="{Binding ToTheWheelNow, Source={x:Static res:UiStrings.Instance}}"/></ui:TextBlock>
                <ui:Card Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:TextBlock x:Name="FwFileName" Text="{Binding NoFileChosen, Source={x:Static res:UiStrings.Instance}}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:Button Content="{Binding ChooseBin, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding ChooseBin, Source={x:Static res:UiStrings.Instance}}" Click="ChooseFw_Click" Margin="0,0,8,0" />
                            <ui:Button x:Name="UploadFwButton" Content="{Binding UploadToWheel, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding UploadToWheel, Source={x:Static res:UiStrings.Instance}}" Appearance="Primary" Click="UploadFw_Click" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:TextBlock Text="{Binding OTAPasswordLabel, Source={x:Static res:UiStrings.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <PasswordBox AutomationProperties.Name="{Binding WheelPassword, Source={x:Static res:UiStrings.Instance}}" x:Name="FwPasswordBox" Width="180" />
                        </StackPanel>
                        <ProgressBar x:Name="FwProgress" IsIndeterminate="True" Visibility="Collapsed" Margin="0,10,0,0" />
                        <ui:TextBlock x:Name="FwStatus" Margin="0,8,0,0" TextWrapping="Wrap" Appearance="Secondary" />
                    </StackPanel>
                </ui:Card>
                <ui:TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Appearance="Secondary" Text="{Binding WrittenToTheSparePartition, Source={x:Static res:UiStrings.Instance}}"></ui:TextBlock>
            </StackPanel>

            <!-- Step 4: Steering auto-calibration -->
            <StackPanel x:Name="StepSteering" Visibility="Collapsed">
                <ui:TextBlock x:Name="SteerPhaseText" TextWrapping="Wrap"><Run Text="{Binding LeaveTheWheel, Source={x:Static res:UiStrings.Instance}}"/> <Run FontWeight="SemiBold" Text="{Binding DeadCentre, Source={x:Static res:UiStrings.Instance}}" /> <Run Text="{Binding AndStillForTwoSeconds, Source={x:Static res:UiStrings.Instance}}"/></ui:TextBlock>
                <ui:Card Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:TextBlock>
                            <Run Text="{Binding LiveSteeringLabel, Source={x:Static res:UiStrings.Instance}}" /><Run x:Name="LiveSteerRun" Text="—" FontWeight="SemiBold" />
                        </ui:TextBlock>
                        <ui:TextBlock Margin="0,6,0,0">
                            <Run Text="{Binding Min, Source={x:Static res:UiStrings.Instance}}" /><Run x:Name="SteerMinRun" Text="0" /><Run Text="{Binding Centre, Source={x:Static res:UiStrings.Instance}}" /><Run x:Name="SteerCentreRun" Text="0" /><Run Text="{Binding Max, Source={x:Static res:UiStrings.Instance}}" /><Run x:Name="SteerMaxRun" Text="0" />
                        </ui:TextBlock>
                        <ui:TextBlock x:Name="SteerAutoStatus" Margin="0,8,0,0" TextWrapping="Wrap" Appearance="Secondary" />
                    </StackPanel>
                </ui:Card>
                <ui:Button Content="{Binding StartOver, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding StartOver, Source={x:Static res:UiStrings.Instance}}" Click="RestartSteer_Click" Margin="0,12,0,0" />
            </StackPanel>

            <!-- Step 5: Pedals auto-calibration -->
            <StackPanel x:Name="StepPedals" Visibility="Collapsed">
                <ui:TextBlock TextWrapping="Wrap"><Run Text="{Binding KeepBothPedals, Source={x:Static res:UiStrings.Instance}}"/> <Run FontWeight="SemiBold" Text="{Binding Released, Source={x:Static res:UiStrings.Instance}}" /> <Run Text="{Binding ForAMomentThenPress, Source={x:Static res:UiStrings.Instance}}"/> <Run FontWeight="SemiBold" Text="{Binding Fully, Source={x:Static res:UiStrings.Instance}}" /><Run Text="{Binding OneAtATimeAnd, Source={x:Static res:UiStrings.Instance}}"/></ui:TextBlock>
                <ui:Card Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:TextBlock>
                            <Run Text="{Binding LiveAccel, Source={x:Static res:UiStrings.Instance}}" /><Run x:Name="LiveAccelRun" Text="—" FontWeight="SemiBold" /><Run Text="{Binding BrakeFrag, Source={x:Static res:UiStrings.Instance}}" /><Run x:Name="LiveBrakeRun" Text="—" FontWeight="SemiBold" />
                        </ui:TextBlock>
                        <ui:TextBlock x:Name="PedalAutoStatus" Margin="0,8,0,0" TextWrapping="Wrap" Appearance="Secondary" />
                    </StackPanel>
                </ui:Card>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="{Binding StartOver, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding StartOver, Source={x:Static res:UiStrings.Instance}}" Click="RestartPedals_Click" Margin="0,0,8,0" />
                </StackPanel>
                <ui:TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Appearance="Secondary" Text="{Binding SavedToTheActiveProfile, Source={x:Static res:UiStrings.Instance}}"></ui:TextBlock>
            </StackPanel>

            <!-- Step 6: Button + output test, summary -->
            <StackPanel x:Name="StepTest" Visibility="Collapsed">
                <ui:TextBlock TextWrapping="Wrap" Text="{Binding PressEachButtonOnceOutput, Source={x:Static res:UiStrings.Instance}}"></ui:TextBlock>
                <ui:Card Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:TextBlock>
                            <Run Text="{Binding GearUpLabel, Source={x:Static res:UiStrings.Instance}}" /><Run x:Name="BtnUpRun" Text="—" /><Run Text="{Binding GearDownLabel, Source={x:Static res:UiStrings.Instance}}" /><Run x:Name="BtnDownRun" Text="—" /><Run Text="{Binding AccelBtnLabel, Source={x:Static res:UiStrings.Instance}}" /><Run x:Name="BtnAccelRun" Text="—" /><Run Text="{Binding BrakeBtnLabel, Source={x:Static res:UiStrings.Instance}}" /><Run x:Name="BtnBrakeRun" Text="—" />
                        </ui:TextBlock>
                        <ui:TextBlock Margin="0,6,0,0">
                            <Run Text="{Binding VJoyOutSteering, Source={x:Static res:UiStrings.Instance}}" /><Run x:Name="OutSteerRun" Text="—" FontWeight="SemiBold" /><Run Text="{Binding Accel, Source={x:Static res:UiStrings.Instance}}" /><Run x:Name="OutAccelRun" Text="—" FontWeight="SemiBold" /><Run Text="{Binding BrakeFrag, Source={x:Static res:UiStrings.Instance}}" /><Run x:Name="OutBrakeRun" Text="—" FontWeight="SemiBold" />
                        </ui:TextBlock>
                        <ui:TextBlock x:Name="SummaryText" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
                <ui:TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Appearance="Secondary" Text="{Binding InYourGameBindThe, Source={x:Static res:UiStrings.Instance}}"></ui:TextBlock>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="28,0,28,20">
            <ui:Button x:Name="BackButton" Content="{Binding Back, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding Back, Source={x:Static res:UiStrings.Instance}}" Click="Back_Click" HorizontalAlignment="Left" IsEnabled="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{Binding SkipWizard, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding SkipWizard, Source={x:Static res:UiStrings.Instance}}" Click="Skip_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="NextButton" Content="{Binding Next, Source={x:Static res:UiStrings.Instance}}" AutomationProperties.Name="{Binding Next, Source={x:Static res:UiStrings.Instance}}" Appearance="Primary" Click="Next_Click" MinWidth="110" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
