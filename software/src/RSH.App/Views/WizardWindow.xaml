<ui:FluentWindow x:Class="RSH.App.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="RSH Setup" Height="560" Width="680"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="RSH Setup" />
        <StackPanel Grid.Row="1" Margin="28,10,28,0">
            <ui:TextBlock x:Name="StepTitle" Text="Welcome to RSH" FontTypography="Title" />
            <ui:TextBlock x:Name="StepCounter" Text="Step 1 of 7" Appearance="Secondary" Margin="0,2,0,0" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="28,16,28,8">
            <!-- Step 0: Welcome -->
            <StackPanel x:Name="StepWelcome">
                <ui:TextBlock TextWrapping="Wrap">
                    RSH sets itself up:
                </ui:TextBlock>
                <ui:TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
                    1. vJoy driver check<LineBreak />
                    2. Wi-Fi connect — automatic<LineBreak />
                    3. Firmware update (optional)<LineBreak />
                    4. Steering calibration — automatic<LineBreak />
                    5. Pedal calibration — automatic<LineBreak />
                    6. Button and output test
                </ui:TextBlock>
                <ui:TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Appearance="Secondary">
                    Steps advance on their own when ready.
                </ui:TextBlock>
            </StackPanel>

            <!-- Step 1: vJoy -->
            <StackPanel x:Name="StepVJoy" Visibility="Collapsed">
                <ui:TextBlock TextWrapping="Wrap">
                    Games read a <Run FontWeight="SemiBold" Text="vJoy" /> virtual joystick.
                </ui:TextBlock>
                <ui:Card Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="VJoyDot" Width="12" Height="12" Fill="#F85149" VerticalAlignment="Center" />
                            <ui:TextBlock x:Name="VJoyStatus" Text="Checking…" Margin="8,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:TextBlock x:Name="VJoyDetails" Appearance="Secondary" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="Open vJoy Configure" Click="OpenVJoyConf_Click" Margin="0,0,8,0" />
                    <ui:Button Content="Get vJoy driver" Click="GetVJoy_Click" />
                </StackPanel>
                <ui:TextBlock x:Name="VJoyActionStatus" Margin="0,8,0,0" TextWrapping="Wrap" Appearance="Secondary" />
            </StackPanel>

            <!-- Step 2: Wheel link -->
            <StackPanel x:Name="StepLink" Visibility="Collapsed">
                <ui:TextBlock TextWrapping="Wrap">
                    Power the wheel. One click joins this PC to the <Run FontWeight="SemiBold" Text="RSH" /> Wi-Fi.
                </ui:TextBlock>
                <ui:Card Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LinkDot" Width="12" Height="12" Fill="#F85149" VerticalAlignment="Center" />
                            <ui:TextBlock x:Name="LinkStatus" Text="Waiting for packets…" Margin="8,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:TextBlock x:Name="LinkDetails" Appearance="Secondary" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button x:Name="WifiConnectButton" Content="Connect automatically" Appearance="Primary" Click="ConnectWifi_Click" />
                </StackPanel>
                <ui:TextBlock x:Name="WifiStatusText" Margin="0,8,0,0" TextWrapping="Wrap" Appearance="Secondary" />
                <ui:TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Appearance="Secondary">
                    No internet while on RSH — normal.
                </ui:TextBlock>
            </StackPanel>

            <!-- Step 3: Firmware update (optional) -->
            <StackPanel x:Name="StepFirmware" Visibility="Collapsed">
                <ui:TextBlock TextWrapping="Wrap">
                    Optional. Send a firmware <Run FontWeight="SemiBold" Text=".bin" /> to the wheel now.
                </ui:TextBlock>
                <ui:Card Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:TextBlock x:Name="FwFileName" Text="No file chosen" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:Button Content="Choose .bin…" Click="ChooseFw_Click" Margin="0,0,8,0" />
                            <ui:Button x:Name="UploadFwButton" Content="Upload to wheel" Appearance="Primary" Click="UploadFw_Click" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:TextBlock Text="OTA password:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="FwPasswordBox" Text="rsh-ota" Width="180" />
                        </StackPanel>
                        <ProgressBar x:Name="FwProgress" IsIndeterminate="True" Visibility="Collapsed" Margin="0,10,0,0" />
                        <ui:TextBlock x:Name="FwStatus" Margin="0,8,0,0" TextWrapping="Wrap" Appearance="Secondary" />
                    </StackPanel>
                </ui:Card>
                <ui:TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Appearance="Secondary">
                    Written to the spare partition first — a failed upload changes nothing.
                </ui:TextBlock>
            </StackPanel>

            <!-- Step 4: Steering auto-calibration -->
            <StackPanel x:Name="StepSteering" Visibility="Collapsed">
                <ui:TextBlock x:Name="SteerPhaseText" TextWrapping="Wrap">
                    Leave the wheel <Run FontWeight="SemiBold" Text="dead centre" /> and still for two seconds — the centre sets itself.
                </ui:TextBlock>
                <ui:Card Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:TextBlock>
                            <Run Text="Live steering: " /><Run x:Name="LiveSteerRun" Text="—" FontWeight="SemiBold" />
                        </ui:TextBlock>
                        <ui:TextBlock Margin="0,6,0,0">
                            <Run Text="Min " /><Run x:Name="SteerMinRun" Text="0" /><Run Text=" · Centre " /><Run x:Name="SteerCentreRun" Text="0" /><Run Text=" · Max " /><Run x:Name="SteerMaxRun" Text="0" />
                        </ui:TextBlock>
                        <ui:TextBlock x:Name="SteerAutoStatus" Margin="0,8,0,0" TextWrapping="Wrap" Appearance="Secondary" />
                    </StackPanel>
                </ui:Card>
                <ui:Button Content="Start over" Click="RestartSteer_Click" Margin="0,12,0,0" />
            </StackPanel>

            <!-- Step 5: Pedals auto-calibration -->
            <StackPanel x:Name="StepPedals" Visibility="Collapsed">
                <ui:TextBlock TextWrapping="Wrap">
                    Keep both pedals <Run FontWeight="SemiBold" Text="released" /> for a moment, then press each one <Run FontWeight="SemiBold" Text="fully" />, one at a time, and hold it a second. The endpoints set themselves.
                </ui:TextBlock>
                <ui:Card Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:TextBlock>
                            <Run Text="Live: accel " /><Run x:Name="LiveAccelRun" Text="—" FontWeight="SemiBold" /><Run Text=" · brake " /><Run x:Name="LiveBrakeRun" Text="—" FontWeight="SemiBold" />
                        </ui:TextBlock>
                        <ui:TextBlock x:Name="PedalAutoStatus" Margin="0,8,0,0" TextWrapping="Wrap" Appearance="Secondary" />
                    </StackPanel>
                </ui:Card>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="Start over" Click="RestartPedals_Click" Margin="0,0,8,0" />
                </StackPanel>
                <ui:TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Appearance="Secondary">
                    Saved to the active profile.
                </ui:TextBlock>
            </StackPanel>

            <!-- Step 6: Button + output test, summary -->
            <StackPanel x:Name="StepTest" Visibility="Collapsed">
                <ui:TextBlock TextWrapping="Wrap">
                    Press each button once. Output below is what games see.
                </ui:TextBlock>
                <ui:Card Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:TextBlock>
                            <Run Text="Gear up: " /><Run x:Name="BtnUpRun" Text="—" /><Run Text=" · Gear down: " /><Run x:Name="BtnDownRun" Text="—" /><Run Text=" · Accel btn: " /><Run x:Name="BtnAccelRun" Text="—" /><Run Text=" · Brake btn: " /><Run x:Name="BtnBrakeRun" Text="—" />
                        </ui:TextBlock>
                        <ui:TextBlock Margin="0,6,0,0">
                            <Run Text="vJoy out — steering " /><Run x:Name="OutSteerRun" Text="—" FontWeight="SemiBold" /><Run Text=" · accel " /><Run x:Name="OutAccelRun" Text="—" FontWeight="SemiBold" /><Run Text=" · brake " /><Run x:Name="OutBrakeRun" Text="—" FontWeight="SemiBold" />
                        </ui:TextBlock>
                        <ui:TextBlock x:Name="SummaryText" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
                <ui:TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Appearance="Secondary">
                    In your game, bind the vJoy device. Finish — and drive.
                </ui:TextBlock>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="28,0,28,20">
            <ui:Button x:Name="BackButton" Content="Back" Click="Back_Click" HorizontalAlignment="Left" IsEnabled="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Skip wizard" Click="Skip_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="NextButton" Content="Next" Appearance="Primary" Click="Next_Click" MinWidth="110" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
