<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RSH.Tests" />
    <!-- Phase F (SEC-E-14): RSH.App.Tests ko UdpWheelSource.ProcessDatagram
         chahiye (HELLO injection, in-memory) — sandbox mein UDP loopback
         sendto EPERM se block hota hai, is liye auto-fetch ka gate test
         HELLO ko socket ke bajaye yahin se chalata hai. -->
    <InternalsVisibleTo Include="RSH.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <!-- Ed25519 (SEC-C-06 app-side verify): BCL (.NET 10) mein Ed25519
         verify nahi hai — NSec (libsodium binding, audited) istemal hota
         hai, sirf verify ke liye (sign nahi). Native libsodium package
         ke saath aata hai (win-x64/linux-x64 runtimes). -->
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />
  </ItemGroup>

</Project>
