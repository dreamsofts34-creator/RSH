<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RSH.Core\RSH.Core.csproj" />
    <!-- HIDMaestro SDK (v2.1.0) — koi NuGet package nahi hai (SEC-H-06):
         release ZIP se li hui DLL yahin vendored hai, SHA-256 pin ke
         saath (dekho HidMaestroConstants). DLL app ke saath ship hoti
         hai (CopyLocal) — driver payloads isi ke andar embedded hain. -->
    <Reference Include="HIDMaestro.Core">
      <HintPath>lib\HIDMaestro.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RSH.HIDMaestro.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
