<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ApexLink</AssemblyName>
    <RootNamespace>ApexLink.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>apexlink.ico</ApplicationIcon>
    <!-- ScottPlot.WPF ki dependency SkiaSharp.Views.WPF sirf .NET Framework
         asset rakhti hai — NU1701 ScottPlot ki maloom dastawi surat hai
         (un ke apne docs mein ignore karne ko kaha gaya hai); sirf is
         project ke liye band hai, Core par warnings-as-errors barkarar. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- Low-end PC dost: workstation GC (server GC zyada memory leta hai) -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <Version>1.2.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexLink.Core\ApexLink.Core.csproj" />
    <ProjectReference Include="..\ApexLink.Output.VJoy\ApexLink.Output.VJoy.csproj" />
  </ItemGroup>

</Project>
