<UserControl x:Class="ApexLink.App.Views.Pages.CalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:ApexLink.App.Controls">
    <UserControl.Resources>
        <ctl:BoolToVisibilityConverter x:Key="BoolVis" />
        <ctl:CaptureButtonTextConverter x:Key="CaptureText" />
        <ctl:CaptureButtonAppearanceConverter x:Key="CaptureAppearance" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="980">
            <ui:TextBlock Text="Calibration" FontTypography="Title" Margin="0,0,0,4" />
            <ui:TextBlock Text="Set your wheel's real steering and pedal ranges."
                          Appearance="Secondary" Margin="0,0,0,16" TextWrapping="Wrap" />

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Live values" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <!-- AUDIT FIX (F9): fixed-width kataar ki jagah * columns
                         — tang window par kuch clip nahi hota. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"><Run Text="Steering: " /><Run Text="{Binding LiveSteering}" FontWeight="SemiBold" /></ui:TextBlock>
                        <ui:TextBlock Grid.Column="1"><Run Text="Accelerator: " /><Run Text="{Binding LiveAccel}" FontWeight="SemiBold" /></ui:TextBlock>
                        <ui:TextBlock Grid.Column="2"><Run Text="Brake: " /><Run Text="{Binding LiveBrake}" FontWeight="SemiBold" /></ui:TextBlock>
                    </Grid>
                    <!-- AUDIT FIX (F11): offline halat ki nishani — warna
                         jamay hue 0 asal values lagte thay. -->
                    <ui:TextBlock Text="No data — wheel not connected, live values are not updating."
                                  Foreground="#F85149" Margin="0,8,0,0" TextWrapping="Wrap"
                                  Visibility="{Binding HasData, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />
                    <ui:TextBlock Text="{Binding StatusText}" Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Steering" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                        1. Centre the wheel, press <Run FontWeight="SemiBold" Text="Capture centre" />.
                        2. Press <Run FontWeight="SemiBold" Text="Start range capture" />, turn fully left and right, press again to stop.
                    </ui:TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button Content="Capture centre" Command="{Binding CaptureCenterCommand}" Margin="0,0,8,0" />
                        <!-- AUDIT FIX (F12): capture chal raha ho to button
                             khud batata hai — label "Stop capture" aur
                             Primary appearance. -->
                        <ui:Button Content="{Binding CapturingSteering, Converter={StaticResource CaptureText}, ConverterParameter=Start range capture}"
                                   Appearance="{Binding CapturingSteering, Converter={StaticResource CaptureAppearance}}"
                                   Command="{Binding ToggleCaptureSteeringCommand}" />
                    </StackPanel>
                    <!-- AUDIT FIX (F9): Min/Centre/Max bhi * columns mein. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"><Run Text="Min: " /><Run Text="{Binding SteerMin}" /></ui:TextBlock>
                        <ui:TextBlock Grid.Column="1"><Run Text="Centre: " /><Run Text="{Binding SteerCenter}" /></ui:TextBlock>
                        <ui:TextBlock Grid.Column="2"><Run Text="Max: " /><Run Text="{Binding SteerMax}" /></ui:TextBlock>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Pedals" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                        Press <Run FontWeight="SemiBold" Text="Start pedal capture" />, keep pedals released briefly, then press each fully. Press again to stop.
                    </ui:TextBlock>
                    <ui:Button Content="{Binding CapturingPedals, Converter={StaticResource CaptureText}, ConverterParameter=Start pedal capture}"
                               Appearance="{Binding CapturingPedals, Converter={StaticResource CaptureAppearance}}"
                               Command="{Binding ToggleCapturePedalsCommand}" Margin="0,0,0,8" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Width="230"><Run Text="Accel: " /><Run Text="{Binding AccelMin}" /><Run Text=" → " /><Run Text="{Binding AccelMax}" /></ui:TextBlock>
                        <ui:TextBlock><Run Text="Brake: " /><Run Text="{Binding BrakeMin}" /><Run Text=" → " /><Run Text="{Binding BrakeMax}" /></ui:TextBlock>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Save calibration" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Clear calibration" Command="{Binding ResetCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
