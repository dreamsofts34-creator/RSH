<UserControl x:Class="ApexLink.App.Views.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="980">
            <ui:TextBlock Text="Profiles" FontTypography="Title" Margin="0,0,0,4" />
            <ui:TextBlock Text="One profile per game. Selecting activates it."
                          Appearance="Secondary" Margin="0,0,0,16" TextWrapping="Wrap" />

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Your profiles" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             MinHeight="140" MaxHeight="260" />
                    <ui:TextBlock Text="{Binding StatusText}" Appearance="Secondary" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Create" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="e.g. Assetto Corsa — GT3" Width="320" Margin="0,0,8,0" />
                        <ui:Button Content="Create profile" Appearance="Primary" Command="{Binding CreateCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Per-game auto-switch" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:TextBlock Text="Process name only, no .exe — see Task Manager → Details."
                                  Appearance="Secondary" Margin="0,0,8,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox Text="{Binding ActiveGameProcess, Mode=TwoWay}"
                                    PlaceholderText="e.g. AssettoCorsa" Width="320" Margin="0,0,8,0" />
                        <ui:TextBlock Text="On/off: Settings."
                                      Appearance="Secondary" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock Text="Rotation presets" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ui:TextBlock Text="Copies the active profile at a shorter rotation."
                                  Appearance="Secondary" Margin="0,0,8,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Add GT 540° preset" Command="{Binding AddPresetGtCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Add F1 360° preset" Command="{Binding AddPresetF1Command}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Duplicate" Command="{Binding DuplicateCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Export…" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Import…" Command="{Binding ImportCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Delete" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
