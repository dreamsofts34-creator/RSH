<UserControl x:Class="ApexLink.App.Views.Pages.ProcessingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:ApexLink.App.Controls">
    <UserControl.Resources>
        <ctl:BoolToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="PresetCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" CornerRadius="16" Padding="18,16"
                                BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CFC4FA" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6C4CF1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SelPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Background" Value="#E3F6EA" />
            <Setter Property="TextElement.Foreground" Value="#17803D" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <TextBlock Text="Tune" Style="{StaticResource AxH1}" />
            <TextBlock Text="Pick how it should feel. Changes apply instantly in the game." Style="{StaticResource AxSub}" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource PresetCard}" Tag="{Binding IsRelaxed}" Command="{Binding PresetRelaxedCommand}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Relaxed" FontWeight="Bold" Foreground="{StaticResource AxInk}" />
                            <Border Style="{StaticResource SelPill}" Visibility="{Binding IsRelaxed, Converter={StaticResource BoolVis}}"><TextBlock Text="Selected" /></Border>
                        </StackPanel>
                        <TextBlock Text="Calm at centre, easy for beginners" Style="{StaticResource AxMuted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource PresetCard}" Tag="{Binding IsBalanced}" Command="{Binding PresetBalancedCommand}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Balanced" FontWeight="Bold" Foreground="{StaticResource AxInk}" />
                            <Border Style="{StaticResource SelPill}" Visibility="{Binding IsBalanced, Converter={StaticResource BoolVis}}"><TextBlock Text="Selected" /></Border>
                        </StackPanel>
                        <TextBlock Text="Linear, good for most cars" Style="{StaticResource AxMuted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource PresetCard}" Tag="{Binding IsSharp}" Command="{Binding PresetSharpCommand}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sharp" FontWeight="Bold" Foreground="{StaticResource AxInk}" />
                            <Border Style="{StaticResource SelPill}" Visibility="{Binding IsSharp, Converter={StaticResource BoolVis}}"><TextBlock Text="Selected" /></Border>
                        </StackPanel>
                        <TextBlock Text="Quick reactions for drifting and F1" Style="{StaticResource AxMuted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AxCard}">
                    <StackPanel>
                        <TextBlock Text="Live response" Style="{StaticResource AxH2}" />
                        <Border Background="{StaticResource AxBg}" CornerRadius="8" Padding="10">
                            <Canvas x:Name="CurveCanvas" Height="170" Background="Transparent" />
                        </Border>
                        <TextBlock Text="The dot moves as you turn the wheel." Style="{StaticResource AxMuted}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource AxCard}">
                    <StackPanel>
                        <TextBlock Text="Fine tune" Style="{StaticResource AxH2}" />

                        <StackPanel Margin="0,0,0,16">
                            <Grid>
                                <TextBlock Text="Centre feel" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="14">
                                    <Run Text="{Binding CurvePercent, StringFormat={}{0:F0}, Mode=OneWay}" /><Run Text="%" />
                                </TextBlock>
                            </Grid>
                            <Slider Style="{StaticResource AxSlider}" Minimum="-100" Maximum="100" Value="{Binding CurvePercent, Mode=TwoWay}" Margin="0,8,0,4" />
                            <TextBlock Text="Higher = calmer at centre. Lower = sharper. 0 = linear." Style="{StaticResource AxMuted}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <Grid>
                                <TextBlock Text="Smoothing" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="14">
                                    <Run Text="{Binding SmoothingPercent, StringFormat={}{0:F0}, Mode=OneWay}" /><Run Text="%" />
                                </TextBlock>
                            </Grid>
                            <Slider Style="{StaticResource AxSlider}" Minimum="0" Maximum="100" Value="{Binding SmoothingPercent, Mode=TwoWay}" Margin="0,8,0,4" />
                            <TextBlock Text="Higher = steadier, slightly slower." Style="{StaticResource AxMuted}" />
                        </StackPanel>

                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Centre dead zone" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="14">
                                    <Run Text="{Binding DeadzonePercent, StringFormat={}{0:F0}, Mode=OneWay}" /><Run Text="%" />
                                </TextBlock>
                            </Grid>
                            <Slider Style="{StaticResource AxSlider}" Minimum="0" Maximum="20" Value="{Binding DeadzonePercent, Mode=TwoWay}" Margin="0,8,0,4" />
                            <TextBlock Text="Removes tiny shake at centre. Set the game's own deadzone to 0." Style="{StaticResource AxMuted}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource AxCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Directions" Style="{StaticResource AxH2}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="Invert steering" Margin="0,0,0,4" FontSize="13" TextWrapping="Wrap" /><ui:ToggleSwitch IsChecked="{Binding InvertSteering}" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Invert accelerator" Margin="0,0,0,4" FontSize="13" TextWrapping="Wrap" /><ui:ToggleSwitch IsChecked="{Binding InvertAccel}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Invert brake" Margin="0,0,0,4" FontSize="13" TextWrapping="Wrap" /><ui:ToggleSwitch IsChecked="{Binding InvertBrake}" /></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="Combine pedals (one axis)" Margin="0,0,0,4" FontSize="13" TextWrapping="Wrap" /><ui:ToggleSwitch IsChecked="{Binding CombinePedals}" /></StackPanel>
                    </Grid>
                    <TextBlock Text="Combine pedals is only for old games with one shared pedal axis." Style="{StaticResource AxMuted}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Reset to Balanced" Style="{StaticResource AxGhost}" Command="{Binding PresetBalancedCommand}" />
                <TextBlock Text="Changes save automatically to this profile." Style="{StaticResource AxMuted}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
