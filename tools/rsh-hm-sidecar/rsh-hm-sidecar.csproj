<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Hotfix v1.0.1 (BUG #2): `WinExe` — Windows GUI subsystem, so
         the sidecar NEVER opens a console window when spawned, neither
         over stdio (`CreateProcess`) nor elevated via `runas`
         (`ShellExecuteEx` — which takes no creation flags, so the
         subsystem is the only thing hiding the window there). The
         piped stdio protocol is unaffected: `Program.cs` talks through
         `Console.OpenStandardInput/Output`, which wrap the redirected
         pipe handles regardless of subsystem (the subsystem only
         controls whether Windows allocates a console). NativeAOT
         supports `WinExe` — ILCompiler sets `LinkerSubsystem`
         `WINDOWS` for it (vs `CONSOLE` for `Exe`). -->
    <OutputType>WinExe</OutputType>
    <!-- net10.0-windows (not a 26100.0 TFM): the sidecar must also run on
         the owner's Windows 10 22H2 PC. The HIDMaestro SDK's members are
         annotated windows10.0.26100.0, which is advisory here — CA1416 is
         suppressed below with justification; Win10 behaviour is a Windows
         gate item (H-HID-1). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RshCoreHiDcr</AssemblyName>
    <RootNamespace>RshHmSidecar</RootNamespace>
    <!-- The sidecar runs elevated (requireAdministrator manifest), so it
         never needs to be self-contained-trimmed beyond the AOT publish. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- NativeAOT toggle: publish with -p:PublishAot=true (Windows only;
         cross-OS native compilation is not supported by ILCompiler).
         The AOT publish is the shipping form; the plain build is the
         dev/sandbox form. -->
    <PublishAot Condition="'$(PublishAot)' == 'true'">true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabled>false</JsonSerializerIsReflectionEnabled>
    <!-- CA1416: the HIDMaestro SDK annotates its members with
         SupportedOSPlatform("windows10.0.26100.0") (Windows 11 24H2).
         The sidecar targets net10.0-windows so it can also run on
         Windows 10 22H2; the annotation is advisory for these calls
         and the actual OS behaviour is verified by gate H-HID-1.
         IL3000: Assembly.Location is empty in a single-file app —
         CheckDllHash already falls back to AppContext.BaseDirectory
         in that case, so the warning is expected and safe. -->
    <NoWarn>$(NoWarn);CA1416;IL3000</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <HidMaestroDllPath Condition="'$(HidMaestroDllPath)' == ''">lib/HIDMaestro.Core.dll</HidMaestroDllPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The HIDMaestro SDK DLL is NEVER committed to the repo. Fetch
         HIDMaestro v2.1.0 from the release, verify its SHA-256 (see
         README.md), and point the build at it. The default location is
         lib/HIDMaestro.Core.dll next to this project. -->
    <Reference Include="HIDMaestro.Core">
      <HintPath>$(HidMaestroDllPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Fail fast with fetch instructions instead of a cryptic
       "metadata file could not be found" from the compiler. -->
  <Target Name="CheckHidMaestroDll" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(HidMaestroDllPath)')"
           Text="HIDMaestro.Core.dll not found at '$(HidMaestroDllPath)'. Fetch HIDMaestro v2.1.0 (see tools/rsh-hm-sidecar/README.md), verify SHA-256 f13e32591404db0f418af9265b8e240f71257297cfae5a41dcd696fd87e9b4d5, and pass -p:HidMaestroDllPath=&lt;path&gt; or place it at lib\HIDMaestro.Core.dll. The DLL is never committed to the repo." />
  </Target>
</Project>
