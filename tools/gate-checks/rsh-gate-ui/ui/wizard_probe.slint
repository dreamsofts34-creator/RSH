// Probe window hosting the real SetupWizard (same-to-same component
// from crates/rsh-ui/ui/screens/setup.slint) so the gate can drive
// its step gating + click its Next/Skip buttons headless. Only the
// properties the gate needs are forwarded; the wizard itself is
// untouched.
import { SetupWizard } from "../../../crates/rsh-ui/ui/screens/setup.slint";

export component GateWizardWindow inherits Window {
    width: 920px;
    height: 580px;
    title: "gate-wizard-probe";

    in-out property <int> step: 0;
    in property <bool> connect-done: false;
    in property <bool> vjoy-installed: false;
    in property <bool> vjoy-fallback: false;
    in property <bool> paired: false;
    in property <bool> calibration-available: false;
    in property <bool> centre-done: false;
    in property <bool> pedals-done: false;
    in property <string> games-text: "No games found yet.";
    in property <string> pair-status: "Waiting for the wheel…";

    callback next();
    callback back();
    callback skip();

    wiz := SetupWizard {
        width: 100%;
        height: 100%;
        step: root.step;
        connect-done: root.connect-done;
        vjoy-installed: root.vjoy-installed;
        vjoy-fallback: root.vjoy-fallback;
        paired: root.paired;
        calibration-available: root.calibration-available;
        centre-done: root.centre-done;
        pedals-done: root.pedals-done;
        games-text: root.games-text;
        pair-status: root.pair-status;
        next => { root.next(); }
        back => { root.back(); }
        skip => { root.skip(); }
    }
}
