// Probe window hosting the real PedalsPage (same-to-same from
// crates/rsh-ui/ui/screens/pedals.slint) so the gate can render
// it headless: Advanced off vs on must add the per-module tuning
// sliders (curve / ramps / saturation / combined pedals), and the
// new callbacks must fire through.
import { PedalsPage } from "../../../crates/rsh-ui/ui/screens/pedals.slint";

export component GatePedalsWindow inherits Window {
    width: 920px;
    height: 1000px;
    title: "gate-pedals-probe";
    background: #0d1118;
    in-out property <bool> advanced: false;
    in-out property <bool> combine-pedals: false;
    callback pedal-curve-changed(int, float);
    callback pedal-press-ms-changed(int, float);
    callback pedal-release-ms-changed(int, float);
    callback throttle-saturation-changed(float);
    callback combine-pedals-changed(bool);
    PedalsPage {
        width: 100%;
        height: 100%;
        advanced: root.advanced;
        combine-pedals: root.combine-pedals;
        pedal-curve-changed(p, v) => { root.pedal-curve-changed(p, v); }
        pedal-press-ms-changed(p, v) => { root.pedal-press-ms-changed(p, v); }
        pedal-release-ms-changed(p, v) => { root.pedal-release-ms-changed(p, v); }
        throttle-saturation-changed(v) => { root.throttle-saturation-changed(v); }
        combine-pedals-changed(b) => { root.combine-pedals-changed(b); }
    }
}
