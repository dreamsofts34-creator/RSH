    },
    "button_matrix": {
      "counts_toward": "buttons",
      "gpio_pins": "rows+cols",
      "requires": "rows x cols keys, default 4x4 = 16 buttons on 8 pins"
    },
    "encoder": {
      "counts_toward": "encoders",
      "gpio_pins": 2,
