// RSH tray icon + menu (REDESIGN-PLAN §7.7/§7.8, TrayMenu.html).
// Reuses the Phase 1 spike's SystemTrayIcon approach: the built-in
// `clicked` is forwarded in
// .slint (`clicked => { tray-clicked(); }`) because it is not
// exposed as `on_clicked` in the generated Rust API in 1.18.1.
// The daemon owns this icon from startup (A-09) — it is created on
// every launch, not only --tray. The tray popup window itself lands
// in Phase 7; left-click currently signals "open UI" to the daemon
// (the UI open hook lands in Phase 3).

struct ProfileMenuItem {
    name: string,
    active: bool,
}

struct GameMenuItem {
    id: string,
    name: string,
}

// One row of the tray popup's game list (P2-6, v2.0.18): the
// popup renders `popup-games` with a `for` loop instead of three
// hardcoded rows.
struct TrayPopupGame {
    id: string,
    name: string,
    initials: string,
    state: string,
    can-launch: bool,
}

export component RshTray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.png");
    tooltip: "RSH — Real Sim Hub";
    title: "RSH Wheel";
    in property <bool> send-to-game;
    in property <string> status-text: "Disconnected";
    // Real menu models (A25): the daemon fills these from the live
    // profile/game store at tray creation — no hardcoded "Default"
    // or game names (a stale "Default" item resolved to nothing).
    in property <[ProfileMenuItem]> profile-items;
    in property <[GameMenuItem]> game-items;
    callback open-main();
    callback toggled-send();
    callback tray-clicked();
    callback profile-selected(string);
    callback launch-game(string);
    callback restart-wheel();
    callback open-setup();
    callback open-settings();
    callback quit-app();

    clicked => { tray-clicked(); }

    Menu {
        MenuItem { title: "Open RSH"; activated => { open-main(); } }
        MenuItem { title: "Send to game"; checked: send-to-game; activated => { toggled-send(); } }
        Menu {
            title: "Profile";
            for item in profile-items: MenuItem { title: item.name; checked: item.active; activated => { profile-selected(item.name); } }
        }
        MenuSeparator {}
        Menu {
            title: "Launch game";
            for g in game-items: MenuItem { title: g.name; activated => { launch-game(g.id); } }
        }
        MenuItem { title: "Restart wheel"; activated => { restart-wheel(); } }
        MenuSeparator {}
        MenuItem { title: "Settings"; activated => { open-settings(); } }
        MenuItem { title: "Run setup"; activated => { open-setup(); } }
        MenuItem { title: "Quit RSH"; activated => { quit-app(); } }
    }
}

// Tray popup (REDESIGN-PLAN §7.7, preview `Tray.html`), 340x440.
// Left-click on the tray icon toggles this window; the daemon
// positions it next to the tray icon (see `tray_geometry.rs` +
// `tray_popup.rs`) and closes it on click-outside (Windows
// foreground poll in the daemon; Escape here). The menu above is
// the platform-native menu (§7.8) — its items are wired in
// `main.rs`; the status header from `TrayMenu.html` lives here, in
// the popup header, because a native menu cannot render one.
// Live values come from the daemon's `AppApi` via `tray_popup.rs`;
// the Rust side pushes them on a timer while the popup is visible.
export component TrayPopup inherits Window {
    title: "RSH Wheel — Tray";
    no-frame: true;
    width: 340px;
    height: 440px;
    background: c-bg;

    // DS-22 (deep scan, U-04): the popup ignored the Light theme —
    // every colour was a hardcoded dark literal. The daemon sets
    // `light-theme` from the persisted UI theme (the same
    // `<data_dir>/ui-theme` file the main window reads; see
    // `tray_popup::popup_is_light`). Dark values are the original
    // literals; Light values mirror `crates/rsh-ui/ui/tokens.slint`.
    in property <bool> light-theme: false;
    out property <color> c-bg: light-theme ? #ffffff : #11161f;
    out property <color> c-panel: light-theme ? #ffffff : #161c27;
    out property <color> c-panel2: light-theme ? #efedf8 : #1d2533;
    out property <color> c-line: light-theme ? #d9d4ec : #262f40;
    out property <color> c-text: light-theme ? #171b26 : #e9edf4;
    out property <color> c-mute: light-theme ? #565c6e : #9aa5b8;
    out property <color> c-faint: light-theme ? #5f657f : #7c879b;
    out property <color> c-accent-text: light-theme ? #2456d6 : #8eb0ff;
    out property <color> c-ok: light-theme ? #12703f : #3dd68c;
    out property <color> c-bad: light-theme ? #c92a2a : #ff6b6b;
    out property <color> c-track: light-theme ? #dcd8ec : #232c3c;
    out property <color> c-switch-off: light-theme ? #c6c1dc : #232c3c;
    out property <color> c-ring: light-theme ? #c9c4de : #2a3446;
    // DS-23 (U-05) hover fills, mirroring the main UI (A5):
    // one step off the resting surface (`Theme.hover-bg`), and the
    // accent darkens in Light / lightens in Dark (`accent-hover`).
    out property <color> c-hover: light-theme ? #e3e8f6 : #28324a;
    out property <color> c-accent-hover: light-theme ? #2456d6 : #2a63f0;

    in property <string> conn-label: "Disconnected";
    in property <string> conn-sub: "Wi-Fi";
    in property <bool> connected: false;
    in property <bool> send-to-game: false;
    in property <angle> steer-angle: 0deg;
    in property <string> steer-text: "+0°";
    in property <float> throttle: 0;
    in property <float> brake: 0;
    in property <float> clutch: 0;
    in property <string> throttle-text: "0%";
    in property <string> brake-text: "0%";
    in property <string> clutch-text: "0%";
    in property <string> profile-name: "Default";
    in property <string> profile-sub: "Auto";
    // P2-6 (v2.0.18): the game list renders from the model (all
    // games, preview order first) instead of three hardcoded rows —
    // a 4th game used to be invisible in the tray.
    in property <[TrayPopupGame]> popup-games;
    in property <string> games-header: "GAMES";

    callback toggled-send();
    callback open-main();
    callback restart-wheel();
    callback launch-game(string);
    callback cycle-profile();
    callback close-popup();

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-popup();
                accept
            } else {
                reject
            }
        }
        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            // Header: logo, name + status, Send-to-game switch.
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: 8px;
                    background: #2f6bff;
                    Text {
                        text: "R";
                        color: #ffffff;
                        font-size: 15px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    spacing: 0px;
                    Text {
                        text: "RSH Wheel";
                        color: c-text;
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 4px;
                            background: connected ? c-ok : c-bad;
                        }
                        Text {
                            text: conn-label + " · " + conn-sub;
                            color: c-mute;
                            font-size: 12px;
                        }
                    }
                }
                Rectangle {
                    // Send-to-game switch (right-aligned).
                    // DS-23 (U-05): hover feedback, mirroring the
                    // main UI Switch (A5) — accent lightens/darkens
                    // when on, the off track steps to the hover fill.
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: send-to-game ? (sw-ta.has-hover ? c-accent-hover : #2f6bff) : (sw-ta.has-hover ? c-hover : c-switch-off);
                    Rectangle {
                        x: send-to-game ? 21px : 3px;
                        y: 3px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: #ffffff;
                    }
                    // P2-6: keyboard activation — Return/Space
                    // toggles, like a click (the switch was
                    // mouse-only; Tab could reach the popup but
                    // not flip it).
                    sw-fs := FocusScope {
                        width: 100%;
                        height: 100%;
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == Key.Space) {
                                root.toggled-send();
                                return accept;
                            }
                            return reject;
                        }
                    }
                    sw-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.toggled-send(); }
                    }
                }
            }

            // Live wheel + 3 bars.
            Rectangle {
                background: c-panel;
                border-width: 1px;
                border-color: c-line;
                border-radius: 12px;
                height: 88px;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 14px;
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: 32px;
                        border-width: 6px;
                        border-color: c-ring;
                        Image {
                            // Steering marker, rotated by the live angle.
                            // (Rectangle has no rotation in Slint 1.18 —
                            // same Image + transform-rotation pattern as
                            // WheelGraphic in rsh-ui.)
                            width: 64px;
                            height: 64px;
                            source: @image-url("../assets/wheel-marker.svg");
                            transform-rotation: steer-angle;
                            transform-origin: { x: 32px, y: 32px };
                        }
                        Text {
                            text: steer-text;
                            color: c-text;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        spacing: 7px;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Throttle"; color: c-mute; font-size: 12px; width: 46px; }
                            Rectangle {
                                height: 6px;
                                background: c-track;
                                border-radius: 3px;
                                Rectangle {
                                    width: parent.width * throttle / 100;
                                    height: 6px;
                                    background: c-ok;
                                    border-radius: 3px;
                                }
                            }
                            Text { text: throttle-text; color: c-text; font-size: 12px; width: 30px; horizontal-alignment: right; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Brake"; color: c-mute; font-size: 12px; width: 46px; }
                            Rectangle {
                                height: 6px;
                                background: c-track;
                                border-radius: 3px;
                                Rectangle {
                                    width: parent.width * brake / 100;
                                    height: 6px;
                                    background: c-bad;
                                    border-radius: 3px;
                                }
                            }
                            Text { text: brake-text; color: c-text; font-size: 12px; width: 30px; horizontal-alignment: right; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Clutch"; color: c-mute; font-size: 12px; width: 46px; }
                            Rectangle {
                                height: 6px;
                                background: c-track;
                                border-radius: 3px;
                                Rectangle {
                                    width: parent.width * clutch / 100;
                                    height: 6px;
                                    background: #2f6bff;
                                    border-radius: 3px;
                                }
                            }
                            Text { text: clutch-text; color: c-text; font-size: 12px; width: 30px; horizontal-alignment: right; }
                        }
                    }
                }
            }

            // Profile selector (click cycles to the next profile).
            // DS-23: hover fill — this row is clickable, so it gets
            // the same hover treatment as the main UI tiles (A5).
            Rectangle {
                background: prof-ta.has-hover ? c-hover : c-panel;
                border-width: 1px;
                border-color: c-line;
                border-radius: 9px;
                height: 34px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text { text: profile-name; color: c-text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                    Text { text: profile-sub; color: c-mute; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                }
                // P2-6: keyboard activation — Return/Space cycles
                // to the next profile, like a click.
                prof-fs := FocusScope {
                    width: 100%;
                    height: 100%;
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Space) {
                            root.cycle-profile();
                            return accept;
                        }
                        return reject;
                    }
                }
                prof-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.cycle-profile(); }
                }
            }

            Text { text: games-header; color: c-faint; font-size: 12px; font-weight: 600; letter-spacing: 1px; }
            // P2-6 (v2.0.18): the game list renders from the model
            // (all games, preview order first). The viewport shows
            // 3 rows (134px — the same height the three hardcoded
            // rows took); more games scroll inside it.
            Flickable {
                width: 100%;
                height: 134px;
                VerticalLayout {
                    spacing: 10px;
                    for g in popup-games: HorizontalLayout {
                        spacing: 10px;
                        height: 38px;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 6px;
                            background: c-panel2;
                            Text { text: g.initials; color: c-accent-text; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { horizontal-stretch: 1; overflow: elide; text: g.name; color: c-text; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                        if g.can-launch: Rectangle {
                            width: 60px;
                            height: 24px;
                            border-radius: 6px;
                            // DS-23: hover darkens the accent, mirroring Btn (A5).
                            background: launch-ta.has-hover ? c-accent-hover : #2f6bff;
                            Text { text: "Launch"; color: #ffffff; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            launch-ta := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => { root.launch-game(g.id); }
                            }
                        }
                        if !g.can-launch: Text { text: g.state; color: c-mute; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }
            }

            // Footer.
            // DS-23: the text links change colour on hover, mirroring
            // the main UI text links (A5).
            Rectangle {
                height: 1px;
                background: c-line;
            }
            HorizontalLayout {
                Rectangle {
                    Text {
                        text: "Open RSH";
                        color: open-ta.has-hover ? c-accent-hover : c-accent-text;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    open-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.open-main(); }
                    }
                }
                Rectangle {
                    Text {
                        text: "Restart wheel";
                        color: restart-ta.has-hover ? c-text : c-mute;
                        font-size: 12px;
                        font-weight: 500;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    restart-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.restart-wheel(); }
                    }
                }
            }
        }
    }
}
