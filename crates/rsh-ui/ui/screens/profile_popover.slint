// RSH v2.0 — Profile popover (REDESIGN-PLAN §8.4). Opens from the
// profile button in the top bar. Content only — the shell positions
// this card under the profile button; the shell's dim backdrop
// closes it on outside click, and Esc closes it too (Phase 2, F-2);
// it does NOT own the Window.
//
// Sections: Presets (read-only, duplicable) + My profiles. Each row:
// name, linked game, Active tick. Footer: New / Duplicate / Rename /
// Delete / Link to game act on the selected row. Switching profiles
// with unsaved changes shows the Save / Discard prompt first (§8.4):
// Rust sets `show-unsaved-prompt` + `pending-name` when the user picks
// a different profile while `unsaved` is true; the prompt callbacks
// resolve the pending switch. Rename opens the rename UI on the Rust
// side (no inline editor here — the popover is 300px wide and the
// rename flow lives with the profile store at integration).
// The profile store itself is NOT an AppApi method yet, so the lists
// are Rust-owned props (sim data until the store lands).

import { Theme } from "../tokens.slint";
import { Card, Btn, Pill } from "../components.slint";

export struct ProfileItem {
    name: string,
    game: string,
    active: bool,
}

// One profile row: name + linked game + Active tick + Use button.
component ProfileRowItem inherits Rectangle {
    in property <string> name;
    in property <string> game;
    in property <bool> active;
    in property <bool> selected;
    in property <bool> is-preset;
    // DS-54: Use runs an activate_profile ProfileOp job (8).
    in property <bool> use-disabled: false;
    callback clicked();
    callback use-clicked();
    accessible-label: name + ", " + game;
    accessible-role: list-item;
    height: 44px;
    border-radius: 8px;
    background: fs.has-focus || selected ? Theme.acc-bg : (ta.has-hover ? Theme.hover-bg : transparent);
    // FIX-4: keyboard activation - Enter/Space acts, like a click.
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                clicked();
                return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        // UI-UX polish (a): the 18px tick centres in the 44px row
        // instead of top-aligning against the text block + Use button.
        cross-axis-alignment: center;
        // Active tick
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: active ? Theme.check-bg : transparent;
            border-width: active ? 0px : 1px;
            border-color: Theme.line;
            // D12: the tick is an SVG, not the "✓" text glyph.
            if active : Image {
                x: 3px;
                y: 3px;
                width: 12px;
                height: 12px;
                source: @image-url("../../assets/icons/check.svg");
                colorize: Theme.ok;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text { text: name; font-size: 12.5px; font-weight: 600; color: Theme.text; wrap: no-wrap; overflow: elide; }
                if is-preset : Pill { label: "Preset"; bg: Theme.panel2; fg: Theme.faint; }
            }
            Text { text: game; font-size: 12px; color: Theme.mute; wrap: no-wrap; overflow: elide; }
        }
        if !active : Btn { label: "Use"; disabled: use-disabled; clicked => { use-clicked(); } }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
}

export component ProfilePopover inherits Card {
    in property <[ProfileItem]> presets;
    in property <[ProfileItem]> profiles;
    in property <bool> unsaved: false;
    in property <bool> show-unsaved-prompt: false;
    in property <string> pending-name: "";
    // DS-54: which job kind the busy strip shows, as a
    // JobKind::order value (-1 = idle) — Use / New / Duplicate /
    // Delete / Link / Save / Discard all run ProfileOp jobs (8).
    in property <int> busy-kind: -1;
    // selected row: 0..presets.length-1 = preset, presets.length.. = my profile
    in-out property <int> selected: 0;
    // M1 (v2.0.2): free-text rename — the input below binds here so
    // Rust can read the typed name (the popover never owned a text
    // input before; rename just reused the linked game's name).
    in-out property <string> rename-text: "";
    in-out property <bool> rename-open: false;
    // Name of the selected row (preset or profile) — the rename
    // input is prefilled with it. Out-of-range reads yield "".
    property <string> selected-name: selected < presets.length ? presets[selected].name : ((selected - presets.length) < profiles.length ? profiles[selected - presets.length].name : "");

    callback use-preset(int);
    callback use-profile(int);
    callback new-profile();
    // v2.0.1 hotfix (A8): row actions pass the selected row index —
    // Rust cannot read the popover's own `selected` property, so the
    // index rides in the callback (0..presets-1 = preset, rest = profile).
    callback duplicate-selected(int);
    callback rename-selected(int);
    // M1: fired when the rename input is saved — selected row +
    // the typed name. (rename-selected(int) stays for the old
    // rename-to-game-name path; Rust wiring pending for this one.)
    callback rename-confirmed(int, string);
    callback delete-selected(int);
    callback link-selected(int);
    callback save-and-switch();
    callback discard-and-switch();
    callback cancel-switch();
    callback closed();

    width: 300px;
    // D5: overlay depth — blur 24, y 8, 25% black.
    drop-shadow-blur: Theme.shadow-blur;
    drop-shadow-offset-y: Theme.shadow-offset-y;
    drop-shadow-color: Theme.shadow-color;
    // B5 (PC-test Bug 5): an explicit content height — a height-less
    // Card parented by the window stretches to the window height
    // (gate-measured 580 px), so the popover used to render as a
    // full-height panel. The layout's preferred height is content-driven
    // (fixed 300 px width, grows with the profile list), so binding
    // to it sizes the card to its content.
    height: layout.preferred-height;
    // Esc is owned by the root keyboard scope (`keyboard-escape`
    // in src/main.rs) — Phase 2 (F-3) removed the zero-size
    // FocusScope here: it was never focused by Rust, so it could
    // never fire.
    layout := VerticalLayout {
        padding-top: 12px; padding-bottom: 12px; padding-left: 12px; padding-right: 12px;
        spacing: 10px;
        HorizontalLayout {
            Text { text: "Profiles"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
            Rectangle { horizontal-stretch: 1; }
            if unsaved : Text { text: "● Unsaved changes"; font-size: 12px; font-weight: 600; color: Theme.warn; }
        }
        Text { text: "Presets"; font-size: 12px; font-weight: 600; color: Theme.faint; }
        VerticalLayout {
            spacing: 2px;
            for p[i] in presets : ProfileRowItem {
                name: p.name;
                game: p.game;
                active: p.active;
                selected: selected == i;
                is-preset: true;
                use-disabled: busy-kind == 8;
                clicked => { selected = i; }
                use-clicked => { use-preset(i); }
            }
        }
        Text { text: "My profiles"; font-size: 12px; font-weight: 600; color: Theme.faint; }
        VerticalLayout {
            spacing: 2px;
            if profiles.length == 0 : Text { text: "No profiles yet — press New to create one."; font-size: 12px; color: Theme.faint; wrap: word-wrap; }
            for p[i] in profiles : ProfileRowItem {
                name: p.name;
                game: p.game;
                active: p.active;
                selected: selected == presets.length + i;
                is-preset: false;
                use-disabled: busy-kind == 8;
                clicked => { selected = presets.length + i; }
                use-clicked => { use-profile(i); }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        HorizontalLayout {
            spacing: 6px;
            Btn { label: "New"; disabled: busy-kind == 8; clicked => { new-profile(); } }
            Btn { label: "Duplicate"; disabled: busy-kind == 8; clicked => { duplicate-selected(selected); } }
            // M1: opens the rename input below (prefilled with the
            // selected row's name) instead of renaming at once.
            Btn { label: "Rename"; clicked => { rename-text = selected-name; rename-open = true; } }
            Btn { label: "Delete"; disabled: busy-kind == 8; clicked => { delete-selected(selected); } }
        }
        // M1: free-text rename input — Save sends the selected row +
        // the typed name, Cancel closes without touching anything.
        // Enter in the field saves too (accepted); empty saves are
        // disabled (Rust validates the name as well).
        if rename-open : Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel2;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text { text: "Rename profile"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 28px;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.bg;
                    TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        vertical-alignment: center;
                        text <=> rename-text;
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.text;
                        selection-background-color: Theme.accent;
                        accepted => { rename-open = false; rename-confirmed(selected, rename-text); }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Btn { label: "Save"; primary: true; disabled: rename-text == "" || busy-kind == 8; clicked => { rename-open = false; rename-confirmed(selected, rename-text); } }
                    Btn { label: "Cancel"; clicked => { rename-open = false; } }
                }
            }
        }
        Btn { label: "Link to game"; disabled: busy-kind == 8; clicked => { link-selected(selected); } }
        Text { text: "Presets are read-only — duplicate one to edit it."; font-size: 12px; color: Theme.faint; wrap: word-wrap; }
        // Save / Discard prompt (§8.4): switching with unsaved changes
        if show-unsaved-prompt : Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.warn;
            background: Theme.warn-bg;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text { text: "Unsaved changes"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                Text { text: "Save your changes before switching to “" + pending-name + "”?"; font-size: 12px; color: Theme.mute; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 6px;
                    Btn { label: "Save"; primary: true; disabled: busy-kind == 8; clicked => { save-and-switch(); } }
                    Btn { label: "Discard"; disabled: busy-kind == 8; clicked => { discard-and-switch(); } }
                    Btn { label: "Cancel"; clicked => { cancel-switch(); } }
                }
            }
        }
    }
}
