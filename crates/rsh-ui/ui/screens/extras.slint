// RSH v2.0 — Extras screen (REDESIGN-PLAN §8.1). No preview exists for
// this screen — it is built in the §5/§6 design language (same tokens,
// same components as Pedals/Buttons). One page, 2x2 grid of 4 cards;
// each card header has an on/off switch; off = greyed body +
// "Off, turn on to edit" (§8.1). Content only — the shell owns the
// Window, sidebar and top bar.
//
// Backend state (verified against source, 2026-11-16):
// - Handbrake button mode EXISTS in firmware v4.0.2 (F-15: pinmap
//   handbrakeButtonMode, AXIS slot-4 flags bit0). The AppApi exposes NO
//   method to read/set it yet, so `handbrake-mode` is a Rust-owned prop
//   (0 Axis, 1 Button) and `handbrake-mode-selected` is the integration
//   seam for the config push. Button mode shows a live pressed tile
//   instead of the axis bar/curve.
// - Shifter: firmware reports H-pattern gear 0=neutral, 1..6 (inputs.h)
//   and sequential up/down; sensitivity is a UI-side tuning value until
//   the engine push lands — `sensitivity-changed` is the seam.
// - Horn: learn/test are callbacks; the horn button mapping itself lives
//   in the Buttons screen's mapping store.
// - LEDs: firmware LED record type 13 exists (protocol config.rs) and
//   rsh-led defines patterns 0–4 Off/Solid/Blink/Chase/Rainbow. No
//   AppApi method yet — `pattern-selected` / `brightness-changed` /
//   `color-selected` are the seams; `led-preview` is the live strip
//   state Rust pushes (8 circles).
// Live values (handbrake pct, gear) are Rust-owned props fed from the
// snapshot/sim feed; nothing here talks to the daemon directly.

import { Theme } from "../tokens.slint";
import { Card, Switch, Btn, SliderRow, RangeBlock, PresetChip, ButtonTile, SegmentedControl } from "../components.slint";

// Mini curve (preview Pedals.html: 110x110 viewBox, axis + dashed
// straight line + accent curve + live marker). Path commands come from
// Rust (feel-dependent); defaults are the preview's exact paths.
component MiniCurve inherits Rectangle {
    in property <string> curve-commands: "M 6 104 C 30 100, 60 85, 104 6";
    in property <string> dashed-commands: "M 6 104 L 104 6";
    in property <bool> show-dashed: true;
    in property <float> marker-vx: 55;
    in property <float> marker-vy: 55;
    width: 130px;
    height: 110px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 110;
        viewbox-height: 110;
        commands: "M 6 6 L 6 104 L 104 104";
        fill: transparent;
        stroke: Theme.line;
        stroke-width: 1px;
    }
    if show-dashed : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 110;
        viewbox-height: 110;
        commands: dashed-commands;
        fill: transparent;
        stroke: Theme.grid-line;
        stroke-width: 1.5px;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 110;
        viewbox-height: 110;
        commands: curve-commands;
        fill: transparent;
        stroke: Theme.accent;
        stroke-width: 2.5px;
    }
    Rectangle {
        x: marker-vx / 110 * 130px - 5px;
        y: marker-vy / 110 * 110px - 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        border-width: 2.5px;
        border-color: Theme.accent-text;
        background: Theme.bg;
    }
}

// Card header: title + on/off switch (§8.1).
component ExtrasCardHeader inherits HorizontalLayout {
    in property <string> title;
    in property <bool> on;
    callback toggled();
    Text { text: title; font-size: 12.5px; font-weight: 600; color: Theme.text; }
    Rectangle { horizontal-stretch: 1; }
    Switch { accessible-name: title; on: on; toggled => { toggled(); } }
}

export component ExtrasScreen inherits VerticalLayout {
    // ---- module on/off (Rust-owned; off greys the card body)
    in-out property <bool> handbrake-on: true;
    in-out property <bool> shifter-on: true;
    in-out property <bool> horn-on: true;
    in-out property <bool> leds-on: true;
    // ---- handbrake (live)
    in property <float> handbrake-pct: 0;
    in property <string> handbrake-up-mv: "500 mV";
    in property <string> handbrake-down-mv: "3050 mV";
    in property <int> handbrake-feel: 0; // 0 Linear, 1 Soft, 2 Sharp
    in property <float> handbrake-deadzone: 0.2; // 0..1 (of 10%)
    in property <string> handbrake-deadzone-text: "2%";
    in property <string> handbrake-curve: "M 6 104 C 30 100, 60 85, 104 6";
    in property <string> handbrake-dashed: "M 6 104 L 104 6";
    in property <float> handbrake-marker-x: 55;
    in property <float> handbrake-marker-y: 55;
    in property <int> handbrake-mode: 0; // 0 Axis, 1 Button (F-15)
    in property <bool> handbrake-pressed: false; // button-mode live state
    // ---- shifter (live)
    in property <string> gear: "N"; // N / 1..6 (H-pattern) or sequential
    in property <int> shifter-mode: 0; // 0 Sequential, 1 H-pattern
    in property <float> shifter-sensitivity: 0.6; // 0..1
    in property <string> shifter-sensitivity-text: "60%";
    // ---- horn
    in property <string> horn-button: "Button 3";
    in property <bool> horn-learning: false;
    in property <bool> horn-pressed: false;
    // ---- LEDs
    in property <int> led-pattern: 1; // 0 Off, 1 Solid, 2 Blink, 3 Chase, 4 Rainbow
    in property <float> led-brightness: 0.8; // 0..1
    in property <string> led-brightness-text: "80%";
    in property <int> led-color: 3; // swatch index 0..5
    in property <[color]> led-preview;

    callback action(string);
    callback handbrake-mode-selected(int);
    callback handbrake-feel-selected(int);
    callback handbrake-deadzone-changed(float);
    callback shifter-sensitivity-changed(float);
    callback led-pattern-selected(int);
    callback led-brightness-changed(float);
    callback led-color-selected(int);

    padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
    spacing: 12px;

    HorizontalLayout {
        spacing: 12px;
        // ---- Handbrake
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 14px; padding-right: 14px;
                spacing: 10px;
                ExtrasCardHeader { title: "Handbrake"; on: handbrake-on; toggled => { handbrake-on = !handbrake-on; action("handbrake-toggle"); } }
                if !handbrake-on : Text { text: "Off, turn on to edit"; font-size: 12px; color: Theme.faint; }
                if handbrake-on : VerticalLayout {
                    spacing: 10px;
                    SegmentedControl {
                        option-0: "Axis";
                        option-1: "Button";
                        selected: handbrake-mode;
                        selected-changed(i) => { handbrake-mode-selected(i); }
                    }
                    if handbrake-mode == 0 : VerticalLayout {
                        spacing: 10px;
                        Rectangle {
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.line;
                            background: Theme.bg;
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 12px;
                                alignment: start;
                                Rectangle {
                                    width: 16px;
                                    height: 110px;
                                    border-radius: 8px;
                                    background: Theme.track;
                                    clip: true;
                                    Rectangle {
                                        width: 16px;
                                        height: parent.height * handbrake-pct / 100;
                                        y: parent.height - self.height;
                                        border-radius: 8px;
                                        background: Theme.bad;
                                    }
                                }
                                MiniCurve {
                                    curve-commands: handbrake-curve;
                                    dashed-commands: handbrake-dashed;
                                    show-dashed: true;
                                    marker-vx: handbrake-marker-x;
                                    marker-vy: handbrake-marker-y;
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: Math.round(handbrake-pct) + "%"; font-family: Theme.font-mono; font-size: 20px; font-weight: 600; color: Theme.text; }
                                    Text { text: "Live"; font-size: 11.5px; color: Theme.mute; }
                                }
                            }
                        }
                        RangeBlock { up-value: handbrake-up-mv; down-value: handbrake-down-mv; set-up => { action("handbrake-up"); } set-down => { action("handbrake-down"); } }
                        HorizontalLayout {
                            spacing: 4px;
                            PresetChip { horizontal-stretch: 1; label: "Linear"; active: handbrake-feel == 0; clicked => { handbrake-feel-selected(0); } }
                            PresetChip { horizontal-stretch: 1; label: "Soft"; active: handbrake-feel == 1; clicked => { handbrake-feel-selected(1); } }
                            PresetChip { horizontal-stretch: 1; label: "Sharp"; active: handbrake-feel == 2; clicked => { handbrake-feel-selected(2); } }
                        }
                        SliderRow { label: "Deadzone"; hint: "Ignore tiny movements"; value-text: handbrake-deadzone-text; value: handbrake-deadzone; changed(v) => { handbrake-deadzone-changed(v); } }
                    }
                    if handbrake-mode == 1 : VerticalLayout {
                        spacing: 10px;
                        ButtonTile { label: "HANDBRAKE"; action: handbrake-pressed ? "Pressed" : "Released"; pressed: handbrake-pressed; clicked => { action("handbrake-test"); } }
                        Text { text: "Button mode: the handbrake acts as a digital button (firmware F-15)."; font-size: 11.5px; color: Theme.faint; wrap: word-wrap; }
                    }
                }
            }
        }
        // ---- Shifter
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 14px; padding-right: 14px;
                spacing: 10px;
                ExtrasCardHeader { title: "Shifter"; on: shifter-on; toggled => { shifter-on = !shifter-on; action("shifter-toggle"); } }
                if !shifter-on : Text { text: "Off, turn on to edit"; font-size: 12px; color: Theme.faint; }
                if shifter-on : VerticalLayout {
                    spacing: 10px;
                    Text { text: gear; font-family: Theme.font-mono; font-size: 44px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                    Text { text: shifter-mode == 1 ? "H-pattern · current gear" : "Sequential · current gear"; font-size: 12px; color: Theme.mute; horizontal-alignment: center; }
                    SliderRow { label: "Sensitivity"; hint: "How firm the shift feels"; value-text: shifter-sensitivity-text; value: shifter-sensitivity; changed(v) => { shifter-sensitivity-changed(v); } }
                    Text {
                        text: "Change gear mapping in Buttons";
                        font-size: 12px;
                        font-weight: 600;
                        color: fs.has-focus ? white : Theme.accent-text;
                        accessible-label: "Change gear mapping in Buttons";
                        accessible-role: button;
                        // FIX-4: keyboard activation for this text link.
                        fs := FocusScope {
                            width: 100%;
                            height: 100%;
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == Key.Space) {
                                    action("shifter-change-in-buttons");
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        TouchArea { clicked => { action("shifter-change-in-buttons"); } }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        // ---- Horn
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 14px; padding-right: 14px;
                spacing: 10px;
                ExtrasCardHeader { title: "Horn"; on: horn-on; toggled => { horn-on = !horn-on; action("horn-toggle"); } }
                if !horn-on : Text { text: "Off, turn on to edit"; font-size: 12px; color: Theme.faint; }
                if horn-on : VerticalLayout {
                    spacing: 10px;
                    ButtonTile { label: "HORN BUTTON"; action: horn-button; pressed: horn-pressed; clicked => { action("horn-learn"); } }
                    HorizontalLayout {
                        spacing: 8px;
                        Btn { label: horn-learning ? "Listening…" : "Learn from wheel"; primary: true; clicked => { action("horn-learn"); } }
                        Btn { label: "Test"; clicked => { action("horn-test"); } }
                    }
                    if horn-learning : Text { text: "Press the horn button on the wheel…"; font-size: 11.5px; color: Theme.warn; }
                    if !horn-learning : Text { text: "Test only lights the indicator when Send to game is off."; font-size: 11.5px; color: Theme.faint; wrap: word-wrap; }
                }
            }
        }
        // ---- LEDs
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 14px; padding-right: 14px;
                spacing: 10px;
                ExtrasCardHeader { title: "LEDs"; on: leds-on; toggled => { leds-on = !leds-on; action("leds-toggle"); } }
                if !leds-on : Text { text: "Off, turn on to edit"; font-size: 12px; color: Theme.faint; }
                if leds-on : VerticalLayout {
                    spacing: 10px;
                    // Live LED strip preview (8 circles, colours from Rust)
                    HorizontalLayout {
                        spacing: 6px;
                        for c in led-preview : Rectangle {
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: c;
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        PresetChip { horizontal-stretch: 1; label: "Off"; active: led-pattern == 0; clicked => { led-pattern-selected(0); } }
                        PresetChip { horizontal-stretch: 1; label: "Solid"; active: led-pattern == 1; clicked => { led-pattern-selected(1); } }
                        PresetChip { horizontal-stretch: 1; label: "Blink"; active: led-pattern == 2; clicked => { led-pattern-selected(2); } }
                        PresetChip { horizontal-stretch: 1; label: "Chase"; active: led-pattern == 3; clicked => { led-pattern-selected(3); } }
                        PresetChip { horizontal-stretch: 1; label: "Rainbow"; active: led-pattern == 4; clicked => { led-pattern-selected(4); } }
                    }
                    SliderRow { label: "Brightness"; hint: "LED strip brightness"; value-text: led-brightness-text; value: led-brightness; changed(v) => { led-brightness-changed(v); } }
                    if led-pattern == 1 : VerticalLayout {
                        spacing: 6px;
                        Text { text: "Colour"; font-size: 12.5px; font-weight: 500; color: Theme.text; }
                        HorizontalLayout {
                            spacing: 8px;
                            for s[i] in [#FF6B6B, #F5B84A, #3DD68C, #2F6BFF, #B46CFF, #FFFFFF] : Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                border-width: led-color == i ? 2px : 1px;
                                border-color: led-color == i ? white : Theme.line;
                                background: s;
                                accessible-label: "LED colour " + (i + 1);
                                accessible-role: button;
                                fs := FocusScope {
                                    width: 100%;
                                    height: 100%;
                                    key-pressed(event) => {
                                        if (event.text == Key.Return || event.text == Key.Space) {
                                            led-color-selected(i);
                                            return accept;
                                        }
                                        return reject;
                                    }
                                }
                                TouchArea { clicked => { led-color-selected(i); } }
                            }
                        }
                    }
                }
            }
        }
    }
    // Absorbs spare vertical space so the rows keep preferred height.
    Rectangle { vertical-stretch: 1; }
}
