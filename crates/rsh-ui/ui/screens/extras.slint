// RSH v2.0 — Extras screen (REDESIGN-PLAN §8.1). No preview exists for
// this screen — it is built in the §5/§6 design language (same tokens,
// same components as Pedals/Buttons). One page, 2x2 grid of 4 cards;
// each card header has an on/off switch; off = greyed body +
// "Off, turn on to edit" (§8.1). Content only — the shell owns the
// Window, sidebar and top bar.
//
// Backend state (verified against source, 2026-11-16):
// - Handbrake button mode EXISTS in firmware v4.0.2 (F-15: pinmap
//   handbrakeButtonMode, AXIS slot-4 flags bit0). The AppApi exposes NO
//   method to read/set it, so `handbrake-mode` stays Axis (0) unless
//   the mode lands — the segmented click explains itself.
// - Shifter gate IS a set_tuning field (shifter_gate): Rust seeds
//   `shifter-mode` from get_tuning("shifter"). Sensitivity IS a
//   board-config value (SH1): Rust reads it once from the board
//   config blob (`SHIFTER` record params[4]) and writes it back
//   through the config transaction (stage → commit → confirm) —
//   the slider is disabled with a reason until the read lands or
//   no shifter is configured. Shift lockout (SH2) is a set_tuning
//   field (shift_lockout_ms, 0–200 ms).
// - Horn button IS a set_tuning field (horn_button): Learn arms
//   start_learn and take_learned_button supplies the picked button.
//   Minimum honk (horn_min_ms, HO1) + latch mode (horn_latch, HO2)
//   are set_tuning fields too.
// - LEDs ARE set_tuning fields (led_brightness, led_pattern,
//   led_color, led_period_ms): the pattern chips + brightness
//   slider + colour swatches push through set_tuning("led") and
//   sync_extras reads the colour back (R2-34: the old "Colour
//   isn't stored on the wheel yet" copy was stale — the colour IS
//   stored). The Blink / Chase speed slider (L1) and the custom
//   RGB colour sliders (L2) push the same way.
// - Handbrake deadzone/feel/mV come from get_tuning("handbrake");
//   Set up/down need calibrate_pedal (BACKEND-2 seam) and stay
//   disabled with a reason until it lands (A2).
// Live values (handbrake pct, gear) are Rust-owned props fed from the
// snapshot; the snapshot carries neither, so both read "—" / 0 until
// the API grows them (A7). Nothing here talks to the daemon directly.

import { Theme } from "../tokens.slint";
import { Card, CardBody, FormRow, Switch, Btn, SliderRow, RangeBlock, PresetChip, ButtonTile, SegmentedControl, PageScaffold } from "../components.slint";

// Mini curve (preview Pedals.html: 110x110 viewBox, axis + dashed
// straight line + accent curve + live marker). Path commands come from
// Rust (feel-dependent); defaults are the preview's exact paths.
component MiniCurve inherits Rectangle {
    in property <string> curve-commands: "M 6 104 C 30 100, 60 85, 104 6";
    in property <string> dashed-commands: "M 6 104 L 104 6";
    in property <bool> show-dashed: true;
    in property <float> marker-vx: 55;
    in property <float> marker-vy: 55;
    width: 130px;
    height: 110px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 110;
        viewbox-height: 110;
        commands: "M 6 6 L 6 104 L 104 104";
        fill: transparent;
        stroke: Theme.line;
        stroke-width: 1px;
    }
    if show-dashed : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 110;
        viewbox-height: 110;
        commands: dashed-commands;
        fill: transparent;
        stroke: Theme.grid-line;
        stroke-width: 1.5px;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 110;
        viewbox-height: 110;
        commands: curve-commands;
        fill: transparent;
        stroke: Theme.accent;
        stroke-width: 2.5px;
    }
    Rectangle {
        x: marker-vx / 110 * 130px - 5px;
        y: marker-vy / 110 * 110px - 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        border-width: 2.5px;
        border-color: Theme.accent-text;
        background: Theme.bg;
    }
}

// Card header: title + on/off switch (§8.1).
component ExtrasCardHeader inherits HorizontalLayout {
    in property <string> title;
    in property <bool> on;
    callback toggled();
    // UI-UX polish (a): the title centres against the 20px switch
    // instead of top-aligning in the row.
    cross-axis-alignment: center;
    Text { text: title; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
    Rectangle { horizontal-stretch: 1; }
    Switch { accessible-name: title; on: on; toggled => { toggled(); } }
}

export component ExtrasScreen inherits PageScaffold {
    // ---- module on/off (Rust-owned; off greys the card body)
    in-out property <bool> handbrake-on: true;
    in-out property <bool> shifter-on: true;
    in-out property <bool> horn-on: true;
    in-out property <bool> leds-on: true;
    // ---- handbrake (live)
    in property <float> handbrake-pct: 0;
    in property <string> handbrake-up-mv: "—";
    in property <string> handbrake-down-mv: "—";
    in property <int> handbrake-feel: 0; // 0 Linear, 1 Soft, 2 Sharp
    in property <float> handbrake-deadzone: 0.2; // 0..1 (of 10%)
    in property <string> handbrake-deadzone-text: "—";
    in property <string> handbrake-curve: "M 6 104 C 30 100, 60 85, 104 6";
    in property <string> handbrake-dashed: "M 6 104 L 104 6";
    in property <float> handbrake-marker-x: 55;
    in property <float> handbrake-marker-y: 55;
    // A2/A6: Set up/down need the calibration backend — Rust sets
    // this false only once calibrate_pedal exists; the reason is
    // shown under the range block.
    in property <bool> calibration-disabled: true;
    in property <int> handbrake-mode: 0; // 0 Axis, 1 Button (F-15)
    in property <bool> handbrake-pressed: false; // button-mode live state
    // --- Handbrake/clutch per-module tuning ---
    // H1 latch, H2 grab speed (0..1 of 0..200 ms), H3
    // auto-release on throttle. Rust owns the values.
    in property <bool> handbrake-latch: false;
    in property <float> handbrake-grab-ms: 0;
    in property <string> handbrake-grab-ms-text: "0 ms";
    in property <bool> handbrake-auto-release: false;
    // ---- shifter (live)
    in property <string> gear: "—"; // "—" until the wheel reports a gear (A7)
    in property <int> shifter-mode: 0; // 0 Sequential, 1 H-pattern
    in property <float> shifter-sensitivity: 0.5; // 0..1 (= 0..100%)
    // SH1: disabled until the board read lands (or no shifter is
    // configured) — the reason text below says why, instead of
    // pretending to work.
    in property <bool> sensitivity-disabled: true;
    in property <string> shifter-sensitivity-text: "50%";
    in property <string> shifter-sensitivity-reason: "Reading the shifter setting…";
    // SH2: shift lockout, 0..1 (= 0..200 ms), default 50 ms.
    in property <float> shifter-lockout: 0.25;
    in property <string> shifter-lockout-text: "50 ms";
    // ---- horn
    in property <string> horn-button: "Button 3";
    in property <bool> horn-learning: false;
    in property <bool> horn-pressed: false;
    // HO1: minimum honk in ms (100–1000); HO2: 0 Momentary, 1 Latch.
    in property <float> horn-min-ms: 400;
    in property <string> horn-min-text: "400 ms";
    in property <int> horn-mode: 0;
    // ---- LEDs
    in property <int> led-pattern: 1; // 0 Off, 1 Solid, 2 Blink, 3 Chase, 4 Rainbow
    in property <float> led-brightness: 0.8; // 0..1
    in property <string> led-brightness-text: "—";
    in property <int> led-color: 3; // swatch index 0..5, -1 = custom colour
    in property <[color]> led-preview;
    // L1: pattern-cycle period in ms (100–5000). L2: custom-colour
    // RGB channels (0..1) + the composed hex text.
    in property <float> led-period-ms: 1000;
    in property <string> led-period-text: "1000 ms";
    in property <float> led-red: 0.18;
    in property <float> led-green: 0.42;
    in property <float> led-blue: 1.0;
    in property <string> led-color-hex-text: "#2F6BFF";
    // Local toggle for the custom-colour sliders (no backend state).
    property <bool> show-custom-color: false;
    // DS-54: which job kind the busy strip shows, as a
    // JobKind::order value (-1 = idle) — Horn Learn disables + dims
    // while its LearnOp job (11) runs; Handbrake Set up/down while
    // their CaptureOp job (10) runs.
    in property <int> busy-kind: -1;

    callback action(string);
    callback handbrake-mode-selected(int);
    callback handbrake-feel-selected(int);
    callback handbrake-deadzone-changed(float);
    callback handbrake-deadzone-edited(string);
    // --- Handbrake/clutch per-module tuning ---
    callback handbrake-latch-changed(bool);
    callback handbrake-grab-ms-changed(float); // 0..1 of 0..200 ms
    callback handbrake-grab-ms-edited(string); // typed "120 ms"
    callback handbrake-auto-release-changed(bool);
    callback shifter-sensitivity-changed(float);
    callback shifter-sensitivity-edited(string);
    callback shifter-lockout-changed(float);
    callback shifter-lockout-edited(string);
    callback led-pattern-selected(int);
    callback led-brightness-changed(float);
    callback led-brightness-edited(string);
    callback led-color-selected(int);
    callback led-period-changed(float);
    callback led-period-edited(string);
    callback led-red-changed(float);
    callback led-red-edited(string);
    callback led-green-changed(float);
    callback led-green-edited(string);
    callback led-blue-changed(float);
    callback led-blue-edited(string);
    callback horn-min-changed(float);
    callback horn-min-edited(string);
    callback horn-mode-selected(int);

    // P1: the page is a PageScaffold (ScrollView + standard
    // padding) — the 2x2 grid is ~750px tall, taller than the
    // 524px body, so the bottom row used to clip below the window
    // edge. Short content still sits at the top.
    HorizontalLayout {
                spacing: 0px;
                // ---- Handbrake
                Card {
                    horizontal-stretch: 1;
                    min-width: 322px;
                    CardBody {
                        ExtrasCardHeader { title: "Handbrake"; on: handbrake-on; toggled => { handbrake-on = !handbrake-on; action("handbrake-toggle"); } }
                        // P2-2 (overlap/`visible` rework, update4):
                        // the ON body stays in the tree with
                        // `visible: handbrake-on` — `visible: false`
                        // still keeps layout space in Slint 1.18.1
                        // (see overview.slint P1-1), so the card
                        // height is the ON body height in BOTH
                        // states, in every font environment. The old
                        // fixed min-height box (638 px, gate-measured
                        // locally) split ON/OFF on CI, where font
                        // metrics differ (694 vs 674 px). The OFF
                        // note is a Text overlaid on the same space,
                        // centred vertically against the holder's
                        // height — no hardcoded pixel height is left,
                        // so a font-metrics shift can never split the
                        // states again. The hidden body takes no
                        // input (invisible elements are skipped by
                        // hit-testing; ui-extras-off-no-input proves
                        // it with a real click).
                        Rectangle {
                            VerticalLayout {
                                visible: handbrake-on;
                                width: 100%;
                                spacing: 10px;
                            SegmentedControl {
                                option-0: "Axis";
                                option-1: "Button";
                                selected: handbrake-mode;
                                selected-changed(i) => { handbrake-mode-selected(i); }
                            }
                            if handbrake-mode == 0 : VerticalLayout {
                                spacing: 10px;
                                Rectangle {
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    background: Theme.bg;
                                    HorizontalLayout {
                                        padding: 10px;
                                        spacing: 12px;
                                        alignment: start;
                                        // UI-UX polish (a): the live % block
                                        // centres against the 110px bar/curve
                                        // instead of top-aligning in the box.
                                        cross-axis-alignment: center;
                                        Rectangle {
                                            width: 16px;
                                            height: 110px;
                                            border-radius: 8px;
                                            background: Theme.track;
                                            clip: true;
                                            Rectangle {
                                                width: 16px;
                                                height: parent.height * handbrake-pct / 100;
                                                y: parent.height - self.height;
                                                border-radius: 8px;
                                                background: Theme.bad;
                                            }
                                        }
                                        MiniCurve {
                                            curve-commands: handbrake-curve;
                                            dashed-commands: handbrake-dashed;
                                            show-dashed: true;
                                            marker-vx: handbrake-marker-x;
                                            marker-vy: handbrake-marker-y;
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: Math.round(handbrake-pct) + "%"; font-family: Theme.font-mono; font-size: Theme.fs-title; font-weight: 600; color: Theme.text; }
                                            Text { text: "Live"; font-size: Theme.fs-hint; color: Theme.mute; }
                                        }
                                    }
                                }
                                RangeBlock { up-value: handbrake-up-mv; down-value: handbrake-down-mv; up-disabled: calibration-disabled || busy-kind == 10; down-disabled: calibration-disabled || busy-kind == 10; set-up => { action("handbrake-up"); } set-down => { action("handbrake-down"); } }
                                if calibration-disabled : Text { text: "RSH isn't running — reconnect to capture."; font-size: Theme.fs-hint; color: Theme.faint; wrap: word-wrap; }
                                HorizontalLayout { cross-axis-alignment: center;
                                    spacing: 4px;
                                    PresetChip { horizontal-stretch: 1; label: "Linear"; active: handbrake-feel == 0; clicked => { handbrake-feel-selected(0); } }
                                    PresetChip { horizontal-stretch: 1; label: "Soft"; active: handbrake-feel == 1; clicked => { handbrake-feel-selected(1); } }
                                    PresetChip { horizontal-stretch: 1; label: "Sharp"; active: handbrake-feel == 2; clicked => { handbrake-feel-selected(2); } }
                                }
                                SliderRow { label: "Deadzone"; hint: "Ignores small inputs"; value-text: handbrake-deadzone-text; value: handbrake-deadzone; changed(v) => { handbrake-deadzone-changed(v); } value-edited(t) => { handbrake-deadzone-edited(t); } }
                            }
                            if handbrake-mode == 1 : VerticalLayout {
                                spacing: 10px;
                                ButtonTile { label: "HANDBRAKE"; action: handbrake-pressed ? "Pressed" : "Released"; pressed: handbrake-pressed; clicked => { action("handbrake-test"); } }
                                Text { text: "Button mode: the handbrake acts as a digital button (firmware F-15)."; font-size: Theme.fs-hint; color: Theme.faint; wrap: word-wrap; }
                            }
                            // --- Handbrake/clutch per-module tuning ---
                            // H1/H2/H3: latch + grab speed + throttle
                            // auto-release. Outside the Axis / Button
                            // branches — the latch and the grab ramp
                            // work on the processed axis value in both
                            // modes (button mode sends 4095/0 on the
                            // same axis). Auto-release only fires
                            // while latch is on (the engine enforces
                            // it too); the note says so when it is off.
                            FormRow { label: "Latch mode"; hint: "Press once to hold, again to release"; Switch { accessible-name: "Latch mode"; on: handbrake-latch; toggled => { handbrake-latch-changed(!handbrake-latch); } } }
                            SliderRow { label: "Grab speed"; hint: "How fast the handbrake bites"; value-text: handbrake-grab-ms-text; value: handbrake-grab-ms; changed(v) => { handbrake-grab-ms-changed(v); } value-edited(t) => { handbrake-grab-ms-edited(t); } }
                            FormRow { label: "Auto-release on throttle"; hint: "Throttle releases a latched handbrake"; Switch { accessible-name: "Auto-release on throttle"; on: handbrake-auto-release; toggled => { handbrake-auto-release-changed(!handbrake-auto-release); } } }
                            if !handbrake-latch : Text { text: "Auto-release only works with latch on."; font-size: Theme.fs-hint; color: Theme.faint; wrap: word-wrap; }
                            }
                            // OFF note overlaid on the ON body's
                            // space, centred vertically (see above).
                            Text {
                                visible: !handbrake-on;
                                text: "Off, turn on to edit";
                                font-size: Theme.fs-hint; color: Theme.faint;
                                width: 100%;
                                y: (parent.height - self.height) / 2;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
                // Responsive gap (CARDS-LAYOUT-RESEARCH §2 R-4):
                // min-width = the 12px design gap; stretch 0.05
                // grows it gently with the window while the cards
                // take the rest. An explicit `width` would cap
                // max == pref (can_grow == 0) and never grow.
                Rectangle { min-width: 12px; horizontal-stretch: 0.05; }
                // ---- Shifter
                Card {
                    horizontal-stretch: 1;
                    min-width: 322px;
                    CardBody {
                        ExtrasCardHeader { title: "Shifter"; on: shifter-on; toggled => { shifter-on = !shifter-on; action("shifter-toggle"); } }
                        // P2-2 (see Handbrake): the ON body stays
                        // in the tree with `visible: shifter-on`,
                        // the OFF note is overlaid on the same space.
                        Rectangle {
                            VerticalLayout {
                                visible: shifter-on;
                                width: 100%;
                                spacing: 10px;
                            Text { text: gear; font-family: Theme.font-mono; font-size: 44px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                            Text { text: shifter-mode == 1 ? "H-pattern · current gear" : "Sequential · current gear"; font-size: Theme.fs-hint; color: Theme.mute; horizontal-alignment: center; }
                            // D8: the disabled reason (Rust-owned
                            // shifter-sensitivity-reason) shows under the
                            // slider now, via SliderRow itself.
                            SliderRow { label: "Sensitivity"; hint: "Shift firmness"; value-text: shifter-sensitivity-text; value: shifter-sensitivity; disabled: sensitivity-disabled; disabled-hint: shifter-sensitivity-reason; changed(v) => { shifter-sensitivity-changed(v); } value-edited(t) => { shifter-sensitivity-edited(t); } }
                            SliderRow { label: "Shift lockout"; hint: "Ignores shifts within this window"; value-text: shifter-lockout-text; value: shifter-lockout; changed(v) => { shifter-lockout-changed(v); } value-edited(t) => { shifter-lockout-edited(t); } }
                            Text {
                                text: "Change gear mapping in Buttons";
                                font-size: Theme.fs-label;
                                font-weight: 600;
                                color: gear-fs.has-focus || gear-ta.has-hover ? Theme.text : Theme.accent-text;
                                accessible-label: "Change gear mapping in Buttons";
                                accessible-role: button;
                                // FIX-4: keyboard activation for this text link.
                                gear-fs := FocusScope {
                                    width: 100%;
                                    height: 100%;
                                    key-pressed(event) => {
                                        if (event.text == Key.Return || event.text == Key.Space) {
                                            action("shifter-change-in-buttons");
                                            return accept;
                                        }
                                        return reject;
                                    }
                                }
                                gear-ta := TouchArea { mouse-cursor: pointer; clicked => { action("shifter-change-in-buttons"); } }
                            }
                            }
                            Text {
                                visible: !shifter-on;
                                text: "Off, turn on to edit";
                                font-size: Theme.fs-hint; color: Theme.faint;
                                width: 100%;
                                y: (parent.height - self.height) / 2;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 0px;
                // ---- Horn
                Card {
                    horizontal-stretch: 1;
                    min-width: 322px;
                    CardBody {
                        ExtrasCardHeader { title: "Horn"; on: horn-on; toggled => { horn-on = !horn-on; action("horn-toggle"); } }
                        // P2-2 (see Handbrake): the ON body stays
                        // in the tree with `visible: horn-on`, the
                        // OFF note is overlaid on the same space.
                        Rectangle {
                            VerticalLayout {
                                visible: horn-on;
                                width: 100%;
                                spacing: 10px;
                            ButtonTile { label: "HORN BUTTON"; action: horn-button; pressed: horn-pressed; clicked => { action("horn-learn"); } }
                            HorizontalLayout { cross-axis-alignment: center;
                                spacing: 8px;
                                Btn { label: horn-learning ? "Listening…" : "Learn from wheel"; primary: true; disabled: busy-kind == 11 || busy-kind == 17; clicked => { action("horn-learn"); } }
                                Btn { label: "Test"; clicked => { action("horn-test"); } }
                            }
                            if horn-learning : Text { text: "Press the horn button on the wheel…"; font-size: Theme.fs-hint; color: Theme.warn; }
                            if !horn-learning : Text { text: "Test only lights the indicator when Send to game is off."; font-size: Theme.fs-hint; color: Theme.faint; wrap: word-wrap; }
                            SegmentedControl {
                                option-0: "Momentary";
                                option-1: "Latch";
                                selected: horn-mode;
                                selected-changed(i) => { horn-mode-selected(i); }
                            }
                            SliderRow { label: "Minimum honk"; hint: "Quick taps still honk this long"; value-text: horn-min-text; value: (horn-min-ms - 100) / 900; changed(v) => { horn-min-changed(v); } value-edited(t) => { horn-min-edited(t); } }
                            if horn-mode == 1 : Text { text: "Latch: press once to honk, again to stop."; font-size: Theme.fs-hint; color: Theme.faint; wrap: word-wrap; }
                            }
                            Text {
                                visible: !horn-on;
                                text: "Off, turn on to edit";
                                font-size: Theme.fs-hint; color: Theme.faint;
                                width: 100%;
                                y: (parent.height - self.height) / 2;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
                // Responsive gap (CARDS-LAYOUT-RESEARCH §2 R-4):
                // min-width = the 12px design gap; stretch 0.05
                // grows it gently with the window while the cards
                // take the rest. An explicit `width` would cap
                // max == pref (can_grow == 0) and never grow.
                Rectangle { min-width: 12px; horizontal-stretch: 0.05; }
                // ---- LEDs
                Card {
                    horizontal-stretch: 1;
                    min-width: 322px;
                    CardBody {
                        ExtrasCardHeader { title: "LEDs"; on: leds-on; toggled => { leds-on = !leds-on; action("leds-toggle"); } }
                        // P2-2 (see Handbrake): the ON body stays
                        // in the tree with `visible: leds-on`, the
                        // OFF note is overlaid on the same space.
                        Rectangle {
                            VerticalLayout {
                                visible: leds-on;
                                width: 100%;
                                spacing: 10px;
                            // Live LED strip preview (8 circles, colours from Rust)
                            HorizontalLayout {
                                spacing: 6px;
                                for c in led-preview : Rectangle {
                                    width: 14px;
                                    height: 14px;
                                    border-radius: 7px;
                                    background: c;
                                }
                            }
                            HorizontalLayout { cross-axis-alignment: center;
                                spacing: 4px;
                                PresetChip { horizontal-stretch: 1; label: "Off"; active: led-pattern == 0; clicked => { led-pattern-selected(0); } }
                                PresetChip { horizontal-stretch: 1; label: "Solid"; active: led-pattern == 1; clicked => { led-pattern-selected(1); } }
                                PresetChip { horizontal-stretch: 1; label: "Blink"; active: led-pattern == 2; clicked => { led-pattern-selected(2); } }
                                PresetChip { horizontal-stretch: 1; label: "Chase"; active: led-pattern == 3; clicked => { led-pattern-selected(3); } }
                                PresetChip { horizontal-stretch: 1; label: "Rainbow"; active: led-pattern == 4; clicked => { led-pattern-selected(4); } }
                            }
                            SliderRow { label: "Brightness"; hint: "Overall LED brightness"; value-text: led-brightness-text; value: led-brightness; changed(v) => { led-brightness-changed(v); } value-edited(t) => { led-brightness-edited(t); } }
                            if led-pattern == 2 || led-pattern == 3 || led-pattern == 4 : SliderRow { label: "Blink / Chase speed"; hint: "Blink / Chase / Rainbow cycle time"; value-text: led-period-text; value: (led-period-ms - 100) / 4900; changed(v) => { led-period-changed(v); } value-edited(t) => { led-period-edited(t); } }
                            if led-pattern == 1 : VerticalLayout {
                                spacing: 6px;
                                Text { text: "Colour"; font-size: Theme.fs-label; font-weight: 500; color: Theme.text; }
                                Text { text: "Colour is saved on the wheel."; font-size: Theme.fs-hint; color: Theme.faint; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    for s[i] in [#FF6B6B, #F5B84A, #3DD68C, #2F6BFF, #B46CFF, #FFFFFF] : Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 11px;
                                        border-width: led-color == i ? 2px : 1px;
                                        border-color: led-color == i ? Theme.text : (sw-ta.has-hover ? Theme.faint : Theme.line);
                                        background: s;
                                        accessible-label: "LED colour " + (i + 1);
                                        accessible-role: button;
                                        color-fs := FocusScope {
                                            width: 100%;
                                            height: 100%;
                                            key-pressed(event) => {
                                                if (event.text == Key.Return || event.text == Key.Space) {
                                                    led-color-selected(i);
                                                    return accept;
                                                }
                                                return reject;
                                            }
                                        }
                                        sw-ta := TouchArea { mouse-cursor: pointer; clicked => { led-color-selected(i); } }
                                    }
                                }
                            }
                            // L2: any RGB colour, not just the six
                            // swatches — the button opens three channel
                            // sliders (Solid / Blink / Chase; Rainbow
                            // ignores the colour board-side).
                            if led-pattern == 1 || led-pattern == 2 || led-pattern == 3 : VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    cross-axis-alignment: center;
                                    Text { text: "Custom colour"; font-size: Theme.fs-label; font-weight: 500; color: Theme.text; }
                                    Text { text: led-color-hex-text; font-family: Theme.font-mono; font-size: Theme.fs-value; color: Theme.mute; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Btn { label: show-custom-color ? "Hide" : "Custom…"; clicked => { show-custom-color = !show-custom-color; } }
                                }
                                if show-custom-color : VerticalLayout {
                                    spacing: 6px;
                                    SliderRow { label: "Red"; hint: "Custom colour channel (0–255)"; value-text: Math.round(led-red * 255) + ""; value: led-red; changed(v) => { led-red-changed(v); } value-edited(t) => { led-red-edited(t); } }
                                    SliderRow { label: "Green"; hint: "Custom colour channel (0–255)"; value-text: Math.round(led-green * 255) + ""; value: led-green; changed(v) => { led-green-changed(v); } value-edited(t) => { led-green-edited(t); } }
                                    SliderRow { label: "Blue"; hint: "Custom colour channel (0–255)"; value-text: Math.round(led-blue * 255) + ""; value: led-blue; changed(v) => { led-blue-changed(v); } value-edited(t) => { led-blue-edited(t); } }
                                }
                            }
                            }
                            Text {
                                visible: !leds-on;
                                text: "Off, turn on to edit";
                                font-size: Theme.fs-hint; color: Theme.faint;
                                width: 100%;
                                y: (parent.height - self.height) / 2;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
}
