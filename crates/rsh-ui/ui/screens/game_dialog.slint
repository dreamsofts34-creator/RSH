// RSH v2.0 — Add/edit game dialog (manual games, no auto-scan).
// The dialog IS the shared Modal (P1): centred 420px card, 40%
// scrim, overlay shadow — P2's hand-rolled centred Card + shadow
// + separate backdrop duplicated that pattern and is gone (P2
// merge). The scrim closes it on outside click, Cancel / Save /
// Esc close it too (Esc is owned by the root keyboard worker);
// it does NOT own the Window. Reuses the profile popover's
// patterns: Rust-owned props, TextInput box with two-way binding
// for the name, Save disabled while a field is empty, Enter in
// the name field saves when both fields are filled.
// The exe path is NOT typed: Browse opens the native Windows file
// picker (Rust `game-dialog-browse`, PC-test Bug 6) and the picked
// path shows read-only here, elided when long; the name auto-fills
// from the file stem when still empty. The profile is a cycling
// button (the profile-link control's pattern) because no dropdown
// component exists — each click moves to the next profile, then
// back to "No profile".

import { Theme } from "../tokens.slint";
import { Modal, Btn } from "../components.slint";

export component GameDialog inherits Modal {
    // Modal owns `title` / `closed()`; the default title is set here.
    title: "Add game";
    in-out property <string> name: "";
    in-out property <string> exe: "";
    in property <string> profile-name: "No profile";
    // P1-7: the daemon's save error, shown inline in the dialog
    // ("" = no error). A failed save used to surface only as a 1 s
    // StatusBar message while the dialog stayed open looking inert.
    in property <string> error-text: "";
    // P2-4: which job kind is running (JobKind::order, -1 = idle)
    // — Save disables + dims while its GameOp job (13) runs, like
    // the Overview / wizard Add buttons, so a double-click cannot
    // start a second save (run_generic_job silently ignores it).
    in property <int> busy-kind: -1;
    callback save(string, string);
    callback cancel();
    callback browse();
    callback cycle-profile();
    // Modal's scrim closes the dialog via `closed()`; Escape
    // closes it via the root keyboard worker (UI-10) — the same
    // outcome as Cancel (the dialog just closes).
    closed => { cancel(); }
    // CardBody (inside Modal) owns the title + 16px padding; this
    // layout is the body content. The card height comes from the
    // body's preferred height (Modal) — no explicit height here, so
    // the Bug-5 full-height-panel defect cannot recur.
    VerticalLayout {
        spacing: 10px;
        Text { text: "Name"; font-size: Theme.fs-label; color: Theme.mute; }
        Rectangle {
            horizontal-stretch: 1;
            height: Theme.control-height;
            border-radius: 7px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.bg;
            TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: 100%;
                vertical-alignment: center;
                text <=> name;
                font-size: Theme.fs-hint;
                font-weight: 500;
                color: Theme.text;
                selection-background-color: Theme.accent;
                accepted => { if (name != "" && exe != "" && busy-kind != 13) { save(name, exe); } }
            }
        }
        Text { text: "Game file (.exe or shortcut)"; font-size: Theme.fs-label; color: Theme.mute; }
        HorizontalLayout { cross-axis-alignment: center;
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                height: Theme.control-height;
                border-radius: 7px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.bg;
                Text {
                    x: 10px;
                    width: parent.width - 20px;
                    height: 100%;
                    vertical-alignment: center;
                    text: exe == "" ? "No file chosen" : exe;
                    font-size: Theme.fs-hint;
                    font-weight: 500;
                    color: exe == "" ? Theme.faint : Theme.text;
                    overflow: elide;
                }
            }
            Btn { label: "Browse…"; icon: @image-url("../../assets/icons/folder.svg"); has-icon: true; clicked => { browse(); } }
        }
        HorizontalLayout { cross-axis-alignment: center;
            spacing: 8px;
            Text { vertical-alignment: center; text: "Profile: " + profile-name; font-size: Theme.fs-label; color: Theme.text; }
            Rectangle { horizontal-stretch: 1; }
            Btn { label: "Change"; clicked => { cycle-profile(); } }
        }
        // P1-7: the save error, inline — the dialog stays open on
        // failure, so the reason must be visible HERE, not only in
        // the 1 s StatusBar message.
        if error-text != "" : Text { text: error-text; font-size: Theme.fs-hint; color: Theme.bad; wrap: word-wrap; }
        HorizontalLayout { cross-axis-alignment: center;
            spacing: 6px;
            Btn { label: "Save"; primary: true; icon: @image-url("../../assets/icons/save.svg"); has-icon: true; disabled: name == "" || exe == "" || busy-kind == 13; clicked => { save(name, exe); } }
            Btn { label: "Cancel"; clicked => { cancel(); } }
        }
        Text { text: "RSH switches profile automatically when this game starts."; font-size: Theme.fs-hint; color: Theme.faint; wrap: word-wrap; }
    }
}
