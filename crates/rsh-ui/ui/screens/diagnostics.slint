// RSH v2.0 — Diagnostics drawer (REDESIGN-PLAN §8.3, old Monitor screen
// as a tab no more). Right-side drawer, 420px wide, opened from
// Overview "Connection quality" or Settings "Open diagnostics". Content
// only — the shell places it at the right edge of the window, above the
// page, and shows/hides it; it does NOT own the Window.
//
// Live data: packet stats come from the daemon telemetry push
// (diag_stats) when it exists; until then every stat reads "—" and
// the charts draw the live steering/pedal ring buffers Rust feeds
// (A20/A21). Nothing here invents a value: no telemetry means an
// explicit "No telemetry yet" line, never a plausible-looking 4 ms.
// Connection / versions ride in as props (A21) — they used to live
// only in the `diag-events` strings.
import { Theme } from "../tokens.slint";
import { Btn, HBar } from "../components.slint";
import { ScrollView } from "std-widgets.slint";

// Small live line chart: title + polyline + readout (viewBox 380x90).
component LiveChart inherits VerticalLayout {
    in property <string> title;
    in property <string> chart-commands: "M 0 45 L 60 45 L 120 43 L 180 47 L 240 44 L 300 46 L 380 45";
    in property <string> readout;
    spacing: 6px;
    HorizontalLayout {
        Text { text: title; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: readout; font-family: Theme.font-mono; font-size: Theme.fs-value; color: Theme.mute; }
    }
    Rectangle {
        height: 90px;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.bg;
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 380;
            viewbox-height: 90;
            commands: "M 0 45 L 380 45";
            fill: transparent;
            stroke: Theme.line;
            stroke-width: 1px;
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 380;
            viewbox-height: 90;
            commands: chart-commands;
            fill: transparent;
            stroke: Theme.accent;
            stroke-width: 2px;
        }
    }
    Text { text: "Last 10 s"; font-size: Theme.fs-hint; color: Theme.faint; }
}

// One packet stat: label + mono value.
component StatCell inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> bad: false;
    spacing: 1px;
    Text { text: value; font-family: Theme.font-mono; font-size: Theme.fs-title; font-weight: 600; color: bad ? Theme.bad : Theme.text; }
    Text { text: label; font-size: Theme.fs-hint; color: Theme.mute; }
}

export component DiagnosticsDrawer inherits FocusScope {
    // ---- live values (Rust-owned props; "—" until telemetry lands)
    in property <string> steer-chart: "";
    in property <string> steer-readout: "—";
    in property <string> pedals-chart: "";
    in property <string> pedals-readout: "—";
    in property <string> delay-text: "—";
    in property <string> jitter-text: "—";
    in property <string> lost-text: "—";
    in property <string> loop-rate-text: "—";
    in property <string> tx-failures-text: "—";
    in property <string> seq-gaps-text: "—";
    // DS-82: frame-time histogram (this UI) + IPC dispatch latency
    // (the daemon); "—" until measured.
    in property <string> frame-p50-text: "—";
    in property <string> frame-p99-text: "—";
    // R2-46: paint-completion p50/p99 (refresh start to Slint
    // AfterRendering); "—" until a paint is observed.
    in property <string> paint-p50-text: "—";
    in property <string> paint-p99-text: "—";
    in property <string> ipc-p50-text: "—";
    in property <string> ipc-p99-text: "—";
    in property <bool> stats-bad: false;
    // A21: connection + versions as real props (not event-log strings).
    in property <string> conn-label: "—";
    in property <bool> daemon-live: false;
    in property <string> app-version: "—";
    in property <string> firmware: "—";
    in property <[string]> events;
    in property <[bool]> buttons-pressed;
    in property <string> knob-1-text: "Knob 1 · —";
    in property <string> knob-2-text: "Knob 2 · —";
    in property <float> throttle-pct: 0;
    in property <float> brake-pct: 0;
    in property <float> clutch-pct: 0;

    callback closed();
    // Esc: this FocusScope's key handler fires when the drawer has
    // focus; the root keyboard scope (`keyboard-escape` in
    // src/main.rs) also closes it, so Esc works from any focus
    // (Phase 2, F-3 — the old comment claimed the shell focuses
    // the drawer on open, which it never did).
    // (`@keys(Escape)` on a callback is NOT valid Slint 1.18.1 syntax:
    // the compiler rejects it — verified 2026-11-16.)

    width: 420px;
    key-pressed(event) => {
        if (event.text == Key.Escape) {
            closed();
            return accept;
        }
        return reject;
    }
    // D5: overlay depth — blur 24, y 8, 25% black. (The root is a
    // FocusScope, which takes no shadow — it lives on the panel.)
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.side;
        drop-shadow-blur: Theme.shadow-blur;
        drop-shadow-offset-y: Theme.shadow-offset-y;
        drop-shadow-color: Theme.shadow-color;
        Rectangle { width: 1px; height: 100%; background: Theme.line; }
        VerticalLayout {
            spacing: 0px;
            // header
            HorizontalLayout {
                padding-top: 14px;
                padding-bottom: 12px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                // UI-UX polish (a): the title centres against the
                // 30px Close button instead of top-aligning.
                cross-axis-alignment: center;
                Text { text: "Diagnostics"; font-size: Theme.fs-title; font-weight: 600; color: Theme.text; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Esc to close"; font-size: Theme.fs-hint; color: Theme.faint; vertical-alignment: center; }
                Btn { label: "Close"; clicked => { closed(); } }
            }
            Rectangle { height: 1px; background: Theme.line; }
            ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                VerticalLayout {
                    padding-top: 14px;
                    padding-bottom: 14px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 14px;
                    // A21: connection + versions, as props.
                    Text { text: "Connection"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Status: " + conn-label; font-family: Theme.font-mono; font-size: Theme.fs-value; color: Theme.mute; }
                        Text { text: "RSH: " + (daemon-live ? "running" : "not running"); font-family: Theme.font-mono; font-size: Theme.fs-value; color: Theme.mute; }
                        Text { text: "App: " + app-version + " · Firmware: " + firmware; font-family: Theme.font-mono; font-size: Theme.fs-value; color: Theme.mute; wrap: word-wrap; }
                    }
                    // live charts (§8.3)
                    LiveChart { title: "Steering"; chart-commands: steer-chart; readout: steer-readout; }
                    LiveChart { title: "Pedals"; chart-commands: pedals-chart; readout: pedals-readout; }
                    HBar { label: "Throttle"; pct: throttle-pct; bar-color: Theme.ok; }
                    HBar { label: "Brake"; pct: brake-pct; bar-color: Theme.bad; }
                    HBar { label: "Clutch"; pct: clutch-pct; bar-color: Theme.accent; }
                    // packet stats (§8.3)
                    Text { text: "Packet stats"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                    if delay-text == "—" && lost-text == "—" : Text { text: "No telemetry yet — stats appear once the wheel streams data."; font-size: Theme.fs-hint; color: Theme.faint; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 12px;
                        StatCell { horizontal-stretch: 1; label: "Delay"; value: delay-text; bad: stats-bad; }
                        StatCell { horizontal-stretch: 1; label: "Jitter (p99)"; value: jitter-text; bad: stats-bad; }
                        StatCell { horizontal-stretch: 1; label: "Lost data"; value: lost-text; bad: stats-bad; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        StatCell { horizontal-stretch: 1; label: "Loop rate"; value: loop-rate-text; }
                        StatCell { horizontal-stretch: 1; label: "TX failures"; value: tx-failures-text; bad: tx-failures-text != "0" && tx-failures-text != "—"; }
                        StatCell { horizontal-stretch: 1; label: "Sequence gaps"; value: seq-gaps-text; bad: seq-gaps-text != "0" && seq-gaps-text != "—"; }
                    }
                    // DS-82: frame-time histogram (this UI, last
                    // 30 s) + IPC dispatch latency (the daemon).
                    Text { text: "Frame + IPC latency"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                    // Phase 2 (F-7): two rows of 3 — six cells in
                    // one 388 px row gave ~54 px each and the
                    // values/labels overlapped their neighbours.
                    HorizontalLayout {
                        spacing: 12px;
                        StatCell { horizontal-stretch: 1; label: "Frame (p50)"; value: frame-p50-text; }
                        StatCell { horizontal-stretch: 1; label: "Frame (p99)"; value: frame-p99-text; }
                        StatCell { horizontal-stretch: 1; label: "Paint (p50)"; value: paint-p50-text; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        StatCell { horizontal-stretch: 1; label: "Paint (p99)"; value: paint-p99-text; }
                        StatCell { horizontal-stretch: 1; label: "IPC (p50)"; value: ipc-p50-text; }
                        StatCell { horizontal-stretch: 1; label: "IPC (p99)"; value: ipc-p99-text; }
                    }
                    // event log (§8.3)
                    Text { text: "Event log"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                    Rectangle {
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.line;
                        background: Theme.bg;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            if events.length == 0 : Text { text: "No events yet."; font-size: Theme.fs-hint; color: Theme.faint; }
                            for e in events : Text {
                                text: e;
                                font-family: Theme.font-mono;
                                font-size: Theme.fs-value;
                                color: Theme.mute;
                                wrap: word-wrap;
                            }
                        }
                    }
                    // H10 (v2.0.2): the live button grid hides when
                    // there is nothing to show — Rust sets
                    // buttons-pressed to an empty list while not live,
                    // so 12 dead tiles never render. (The encoders
                    // line below stays: it reads "—" while not live.)
                    if buttons-pressed.length > 0 : Text { text: "Buttons — live"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                    if buttons-pressed.length > 0 : VerticalLayout {
                        spacing: 6px;
                        for row in 3 : HorizontalLayout {
                            spacing: 6px;
                            for col in 4 : Rectangle {
                                horizontal-stretch: 1;
                                height: 32px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: buttons-pressed.length > row * 4 + col && buttons-pressed[row * 4 + col] ? Theme.ok : Theme.line;
                                background: buttons-pressed.length > row * 4 + col && buttons-pressed[row * 4 + col] ? Theme.ok-bg : Theme.panel2;
                                Text {
                                    width: 100%;
                                    height: 100%;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    text: (row * 4 + col + 1) + "";
                                    font-family: Theme.font-mono;
                                    font-size: Theme.fs-value;
                                    font-weight: 600;
                                    color: buttons-pressed.length > row * 4 + col && buttons-pressed[row * 4 + col] ? Theme.ok : Theme.mute;
                                }
                            }
                        }
                    }
                    // encoders live (§8.3)
                    Text { text: "Encoders — live"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { horizontal-stretch: 1; text: knob-1-text; font-family: Theme.font-mono; font-size: Theme.fs-value; color: Theme.text; }
                        Text { horizontal-stretch: 1; text: knob-2-text; font-family: Theme.font-mono; font-size: Theme.fs-value; color: Theme.text; }
                    }
                }
            }
        }
    }
}
