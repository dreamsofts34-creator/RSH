// RSH v2.0 — Pedals screen (REDESIGN-PLAN §7.3, preview-html/Pedals.html).
// Phase 4 port of ~/workspace/projects/rsh/v2-screens/screens/pedals.slint
// (pixel census 9/9 vs the preview in staging): the staging Sidebar/top
// bar are dropped — the shell owns them — and the local Switch/Pill/Btn/
// Card/SliderRow copies are replaced by the Phase 3 library. Screen-
// specific components (FeelChip, MiniCurve, PedalCard) stay here.
// Slider number boxes are the library's real TextInput (value-edited),
// not the staging display-only Text.
//
// NOTE (tokens): FeelChip's active fill is Theme.acc-bg (B5: the
// literal #1A294A blend is replaced by the token — same hue, one
// token, no other deviation).

import { Theme } from "../tokens.slint";
import { Card, Pill, Btn, SliderRow, Switch } from "../components.slint";
import { ScrollView } from "std-widgets.slint";

// ---------------------------------------------------------------- feel chip (§6: active = accent border + tint)
component FeelChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    accessible-label: label;
    accessible-role: button;
    height: 26px;
    border-radius: 7px;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent-text : (active ? Theme.accent : (ta.has-hover ? Theme.faint : Theme.line));
    background: active ? Theme.acc-bg : (ta.pressed ? Theme.pressed-bg : ta.has-hover ? Theme.hover-bg : Theme.panel2);
    // FIX-4: keyboard activation - Enter/Space acts, like a click.
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                clicked();
                return accept;
            }
            return reject;
        }
    }
    Text {
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: label;
        font-size: 12px;
        font-weight: 600;
        color: active ? Theme.sel-text : (ta.has-hover ? Theme.text : Theme.mute);
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
}

// ---------------------------------------------------------------- mini curve (preview: 110x110 viewBox, axis + dashed
// straight line + accent curve + live marker). Path commands come from Rust
// (feel-dependent); defaults are the preview's exact paths.
component MiniCurve inherits Rectangle {
    in property <string> curve-commands;
    in property <string> dashed-commands;
    in property <bool> show-dashed;
    in property <float> marker-vx;
    in property <float> marker-vy;
    width: 130px;
    height: 110px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 110;
        viewbox-height: 110;
        commands: "M 6 6 L 6 104 L 104 104";
        fill: transparent;
        stroke: Theme.line;
        stroke-width: 1px;
    }
    if show-dashed : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 110;
        viewbox-height: 110;
        commands: dashed-commands;
        fill: transparent;
        stroke: Theme.grid-line;
        stroke-width: 1.5px;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 110;
        viewbox-height: 110;
        commands: curve-commands;
        fill: transparent;
        stroke: Theme.accent;
        stroke-width: 2.5px;
    }
    Rectangle {
        x: marker-vx / 110 * 130px - 5px;
        y: marker-vy / 110 * 110px - 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        border-width: 2.5px;
        border-color: Theme.accent-text;
        background: Theme.bg;
    }
}

// ---------------------------------------------------------------- pedal card (§7.3: live bar + mini curve, Pedal up/down
// + Set buttons, feel chips, Deadzone; Clutch adds Bite point)
component PedalCard inherits Card {
    in property <string> pedal-name;
    in property <float> pct;
    in property <color> bar-color;
    in property <string> up-mv;
    in property <string> down-mv;
    in property <int> feel; // 0 linear, 1 soft, 2 sharp
    in property <bool> show-chips;
    in property <float> deadzone; // 0..1 (of 10%)
    in property <string> deadzone-text;
    in property <bool> show-bite;
    in property <float> bite; // 0..1
    in property <string> bite-text;
    // --- Handbrake/clutch per-module tuning ---
    // C2 clutch slip zone: shown on the clutch card only.
    // `bite-width` is 0..1 of 5..40% of travel (Rust maps it to
    // the 0.05..0.40 fraction); the 15% default sits at 10/35.
    in property <bool> show-bite-width: false;
    in property <float> bite-width: 0.2857;
    in property <string> bite-width-text: "15%";
    // --- Brake per-module tuning ---
    // B1 brake force: shown on the brake card only. `force` is the
    // saturation fraction itself (0.5..1.0 = 50–100% travel for full
    // brake), so the thumb sits at 50–100% of the track.
    in property <bool> show-force;
    in property <float> force; // 0.5..1.0
    in property <string> force-text;
    in property <string> curve-commands;
    in property <string> dashed-commands;
    in property <bool> show-dashed;
    in property <float> marker-vx;
    in property <float> marker-vy;
    // R2-16: Advanced mode shows the live raw ADC value (~1 Hz).
    in property <bool> advanced: false;
    in property <string> raw-mv: "—";
    // Disabled while the calibration backend is unavailable (A2):
    // Rust sets this; the reason shows under the Set buttons (D8).
    in property <bool> set-disabled: false;
    in property <string> set-reason: "RSH isn't running — reconnect to capture.";
    // DS-54: which job kind the busy strip shows, as a
    // JobKind::order value (-1 = idle) — Set up/down disable + dim
    // while their CaptureOp job (10) runs.
    in property <int> busy-kind: -1;
    callback set-up();
    callback set-down();
    callback feel-selected(int);
    callback deadzone-changed(float);
    callback deadzone-edited(string);
    callback bite-changed(float);
    callback bite-edited(string);
    // --- Handbrake/clutch per-module tuning ---
    callback bite-width-changed(float);
    callback bite-width-edited(string);
    // --- Brake per-module tuning ---
    callback force-changed(float);
    callback force-edited(string);
    // --- Pedal ramps/curves per-module tuning ---
    // Advanced-only sliders (Rust owns the values; the frac is
    // 0..1 over the control's own range — see the page props).
    in property <float> curve-value: 0.333;
    in property <string> curve-text: "1.00";
    in property <bool> show-press: false;
    in property <string> press-label: "Tip-in";
    in property <string> press-hint: "How fast it opens";
    in property <float> press-ms-value: 0;
    in property <string> press-ms-text: "";
    in property <bool> show-release: false;
    in property <string> release-label: "Lift-off";
    in property <string> release-hint: "How fast it closes";
    in property <float> release-ms-value: 0;
    in property <string> release-ms-text: "";
    in property <bool> show-saturation: false;
    in property <float> saturation-value: 1;
    in property <string> saturation-text: "100%";
    callback curve-changed(float);
    callback curve-edited(string);
    callback press-ms-changed(float);
    callback press-ms-edited(string);
    callback release-ms-changed(float);
    callback release-ms-edited(string);
    callback saturation-changed(float);
    callback saturation-edited(string);

    VerticalLayout {
        padding-top: 14px; padding-bottom: 14px; padding-left: 14px; padding-right: 14px;
        spacing: 12px;
        HorizontalLayout {
            alignment: space-between;
            Text { text: pedal-name; font-size: 13px; font-weight: 600; color: Theme.text; }
            Pill { label: Math.round(pct) + "%"; bg: pct > 0 ? Theme.ok-bg : Theme.panel2; fg: pct > 0 ? Theme.ok : Theme.mute; }
        }
        // live viz: vertical bar (16x110) + mini curve
        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.bg;
            HorizontalLayout {
                padding: 10px;
                spacing: 12px;
                alignment: start;
                Rectangle {
                    width: 16px;
                    height: 110px;
                    border-radius: 8px;
                    background: Theme.track;
                    clip: true;
                    Rectangle {
                        width: 16px;
                        height: parent.height * pct / 100;
                        y: parent.height - self.height;
                        border-radius: 8px;
                        background: bar-color;
                    }
                }
                MiniCurve {
                    curve-commands: curve-commands;
                    dashed-commands: dashed-commands;
                    show-dashed: show-dashed;
                    marker-vx: marker-vx;
                    marker-vy: marker-vy;
                }
            }
        }
        // range block (§6): Pedal up / Pedal down + Set buttons
        // D8: the disabled reason shows under the buttons — but not
        // while a capture job is running (busy-kind 10): then the
        // buttons are only briefly disabled, and the reason would lie.
        if set-disabled && busy-kind != 10 : Text { text: set-reason; font-size: 12px; color: Theme.faint; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel2;
                VerticalLayout {
                    padding-top: 8px; padding-bottom: 8px; padding-left: 10px; padding-right: 10px;
                    spacing: 6px;
                    Text { text: "Pedal up"; font-size: 12px; color: Theme.mute; }
                    Text { text: up-mv; font-family: Theme.font-mono; font-size: 13px; font-weight: 600; color: Theme.text; }
                    Btn { horizontal-stretch: 1; label: "Set up"; disabled: set-disabled || busy-kind == 10; clicked => { set-up(); } }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel2;
                VerticalLayout {
                    padding-top: 8px; padding-bottom: 8px; padding-left: 10px; padding-right: 10px;
                    spacing: 6px;
                    Text { text: "Pedal down"; font-size: 12px; color: Theme.mute; }
                    Text { text: down-mv; font-family: Theme.font-mono; font-size: 13px; font-weight: 600; color: Theme.text; }
                    Btn { horizontal-stretch: 1; label: "Set down"; disabled: set-disabled || busy-kind == 10; clicked => { set-down(); } }
                }
            }
        }
        if show-chips : HorizontalLayout {
            spacing: 4px;
            FeelChip { horizontal-stretch: 1; label: "Linear"; active: feel == 0; clicked => { feel-selected(0); } }
            FeelChip { horizontal-stretch: 1; label: "Soft"; active: feel == 1; clicked => { feel-selected(1); } }
            FeelChip { horizontal-stretch: 1; label: "Sharp"; active: feel == 2; clicked => { feel-selected(2); } }
        }
        // --- Brake per-module tuning ---
        // B1 brake force first (the headline brake control), then
        // the bite point (B2), then the shared deadzone.
        if show-force : SliderRow { label: "Brake force"; hint: "Travel for full brake"; value-text: force-text; value: force; changed(v) => { force-changed(v); } value-edited(t) => { force-edited(t); } }
        if show-bite : SliderRow { label: "Bite point"; hint: "Where the grip starts"; value-text: bite-text; value: bite; changed(v) => { bite-changed(v); } value-edited(t) => { bite-edited(t); } }
        // --- Handbrake/clutch per-module tuning ---
        // C2: slip zone around the bite (clutch only) — the value
        // is 0..1 of 5..40%, so Rust maps it to 0.05..0.40.
        if show-bite-width : SliderRow { label: "Slip zone"; hint: "Travel the clutch engages over"; value-text: bite-width-text; value: bite-width; changed(v) => { bite-width-changed(v); } value-edited(t) => { bite-width-edited(t); } }
        SliderRow { label: "Deadzone"; hint: "Ignores small inputs"; value-text: deadzone-text; value: deadzone; changed(v) => { deadzone-changed(v); } value-edited(t) => { deadzone-edited(t); } }
        // --- Pedal ramps/curves per-module tuning ---
        // Advanced only: each pedal's own curve + ramps, never
        // copied into a module that does not need them.
        if advanced : SliderRow { label: "Response curve"; hint: "Shape — 1.00 is linear"; value-text: curve-text; value: curve-value; changed(v) => { curve-changed(v); } value-edited(t) => { curve-edited(t); } }
        if advanced && show-press : SliderRow { label: press-label; hint: press-hint; value-text: press-ms-text; value: press-ms-value; changed(v) => { press-ms-changed(v); } value-edited(t) => { press-ms-edited(t); } }
        if advanced && show-release : SliderRow { label: release-label; hint: release-hint; value-text: release-ms-text; value: release-ms-value; changed(v) => { release-ms-changed(v); } value-edited(t) => { release-ms-edited(t); } }
        if advanced && show-saturation : SliderRow { label: "Throttle saturation"; hint: "Travel % for full throttle"; value-text: saturation-text; value: saturation-value; changed(v) => { saturation-changed(v); } value-edited(t) => { saturation-edited(t); } }
        // R2-16: Advanced only — the live raw ADC reading (~1 Hz).
        if advanced : HorizontalLayout {
            spacing: 8px;
            Text { text: "Raw live"; font-size: 12px; color: Theme.mute; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: raw-mv; font-family: Theme.font-mono; font-size: 12px; font-weight: 600; color: Theme.text; }
        }
    }
}

// ---------------------------------------------------------------- Pedals page (§7.3). Body only: the shell owns the
// sidebar, the top bar (Basic/Advanced + profile + Save) and the window.
// The calibration rule (§7.3): "Set down" needs the pedal fully pressed —
// the backend enforces it with a UserError (see PEDALS-BUTTONS-PORTING.md
// §3); this line states the rule, it is not the enforcement.
export component PedalsPage inherits VerticalLayout {
    // R2-16: Advanced mode (live raw mV per pedal, ~1 Hz).
    in property <bool> advanced: false;
    in property <string> throttle-raw-mv: "—";
    in property <string> brake-raw-mv: "—";
    in property <string> clutch-raw-mv: "—";
    // throttle
    in property <float> throttle-pct;
    in property <string> throttle-up-mv;
    in property <string> throttle-down-mv;
    in property <int> throttle-feel;
    in property <float> throttle-deadzone;
    in property <string> throttle-deadzone-text;
    in property <string> throttle-curve;
    in property <string> throttle-dashed;
    in property <float> throttle-marker-x;
    in property <float> throttle-marker-y;
    // brake
    in property <float> brake-pct;
    in property <string> brake-up-mv;
    in property <string> brake-down-mv;
    in property <int> brake-feel;
    in property <float> brake-deadzone;
    in property <string> brake-deadzone-text;
    in property <string> brake-curve;
    in property <string> brake-dashed;
    in property <float> brake-marker-x;
    in property <float> brake-marker-y;
    // --- Brake per-module tuning ---
    // B2 brake bite (0..1 of 50%) + B1 brake force (0.5..1.0).
    in property <float> brake-bite;
    in property <string> brake-bite-text;
    in property <float> brake-force;
    in property <string> brake-force-text;
    // clutch
    in property <float> clutch-pct;
    in property <string> clutch-up-mv;
    in property <string> clutch-down-mv;
    in property <int> clutch-feel;
    in property <float> clutch-deadzone;
    in property <string> clutch-deadzone-text;
    in property <float> clutch-bite;
    in property <string> clutch-bite-text;
    // --- Handbrake/clutch per-module tuning ---
    // C2 clutch slip zone (0..1 of 5..40%; the 15% default is 10/35).
    in property <float> clutch-bite-width: 0.2857;
    in property <string> clutch-bite-width-text: "15%";
    in property <string> clutch-curve;
    in property <string> clutch-dashed;
    in property <float> clutch-marker-x;
    in property <float> clutch-marker-y;
    // --- Pedal ramps/curves per-module tuning ---
    // Slider fracs are 0..1 over each control's own range
    // (curve 0.5..2.0; throttle press/release 0..500 ms; brake
    // press 0..300 ms; clutch release 0..1000 ms; saturation
    // 70..100%) — Rust owns the mapping, the page only displays.
    in property <float> throttle-curve-value: 0.333;
    in property <string> throttle-curve-text: "1.00";
    in property <float> throttle-press-ms-value: 0.2;
    in property <string> throttle-press-ms-text: "100 ms";
    in property <float> throttle-release-ms-value: 0.1;
    in property <string> throttle-release-ms-text: "50 ms";
    in property <float> throttle-saturation-value: 1;
    in property <string> throttle-saturation-text: "100%";
    in property <float> brake-curve-value: 0.533;
    in property <string> brake-curve-text: "1.30";
    in property <float> brake-press-ms-value: 0.167;
    in property <string> brake-press-ms-text: "50 ms";
    in property <float> clutch-curve-value: 0.333;
    in property <string> clutch-curve-text: "1.00";
    in property <float> clutch-release-ms-value: 0.3;
    in property <string> clutch-release-ms-text: "300 ms";
    // Combined pedals (gas + brake as one axis, for old games).
    in property <bool> combine-pedals: false;

    in property <bool> set-disabled: false;
    // DS-54: which job kind the busy strip shows, as a
    // JobKind::order value (-1 = idle) — the cards' Set up/down
    // disable + dim while their CaptureOp job (10) runs.
    in property <int> busy-kind: -1;
    callback set-up(int);          // pedal index 0 throttle, 1 brake, 2 clutch
    callback set-down(int);
    callback feel-selected(int, int); // (pedal, feel)
    callback deadzone-changed(int, float); // (pedal, 0..1 of 10%)
    callback deadzone-edited(int, string); // (pedal, typed value)
    callback bite-changed(float);
    callback bite-edited(string);
    // --- Handbrake/clutch per-module tuning ---
    callback clutch-bite-width-changed(float); // 0..1 of 5..40%
    callback clutch-bite-width-edited(string); // typed percent, 5–40%
    // --- Brake per-module tuning ---
    callback brake-bite-changed(float); // 0..1 of 50%
    callback brake-bite-edited(string); // typed percent, 0–50%
    callback brake-force-changed(float); // 0.5..1.0 saturation
    callback brake-force-edited(string); // typed percent, 50–100%
    // --- Pedal ramps/curves per-module tuning ---
    callback pedal-curve-changed(int, float); // (pedal, 0..1 of 0.5..2.0)
    callback pedal-curve-edited(int, string); // (pedal, typed exponent)
    callback pedal-press-ms-changed(int, float); // (pedal, 0..1 of range)
    callback pedal-press-ms-edited(int, string); // (pedal, typed "120 ms")
    callback pedal-release-ms-changed(int, float); // (pedal, 0..1 of range)
    callback pedal-release-ms-edited(int, string); // (pedal, typed "120 ms")
    callback throttle-saturation-changed(float); // 0..1 of 70..100%
    callback throttle-saturation-edited(string); // typed "85%"
    callback combine-pedals-changed(bool);

    // Phase 2 (F-5): the page scrolls (Settings pattern) — the
    // clutch card clipped ~11 px Basic / ~30–38 px Advanced.
    // Root padding lives on the inner layout now; the trailing
    // stretch absorber goes away (the ScrollView owns the slack).
    pedals-scroll := ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
    padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
    spacing: 12px;
    // FIX (inner shortfall): the shell sizes the page to its preferred
    // width, and the row only shares what the cards prefer - the cards
    // preferred 215px each (row 671px, ending x=874). `min-width:
    // 224px` card widths (preview-exact: (696 - 2*12) / 3) make the
    // row prefer 696px, so the page spans the full 736px column.
    // CARDS-LAYOUT-RESEARCH §2: min-width (not `width`) so the cards
    // can GROW past 224px on wider windows (explicit `width` caps
    // max == pref, can_grow == 0); the gaps are spacer Rectangles
    // (min-width 12px, stretch 0.05) that scale with the window.
    HorizontalLayout {
        spacing: 0px;
        PedalCard {
            horizontal-stretch: 1;
            min-width: 224px;
            pedal-name: "Throttle";
            pct: throttle-pct;
            bar-color: Theme.ok;
            up-mv: throttle-up-mv;
            down-mv: throttle-down-mv;
            feel: throttle-feel;
            show-chips: true;
            deadzone: throttle-deadzone;
            deadzone-text: throttle-deadzone-text;
            show-bite: false;
            show-force: false;
            curve-value: throttle-curve-value;
            curve-text: throttle-curve-text;
            show-press: true;
            press-label: "Tip-in";
            press-hint: "How fast the throttle opens";
            press-ms-value: throttle-press-ms-value;
            press-ms-text: throttle-press-ms-text;
            show-release: true;
            release-label: "Lift-off";
            release-hint: "How fast the throttle closes";
            release-ms-value: throttle-release-ms-value;
            release-ms-text: throttle-release-ms-text;
            show-saturation: true;
            saturation-value: throttle-saturation-value;
            saturation-text: throttle-saturation-text;
            advanced: advanced;
            raw-mv: throttle-raw-mv;
            set-disabled: set-disabled;
            busy-kind: busy-kind;
            bite: 0;
            bite-text: "";
            force: 1;
            force-text: "";
            curve-commands: throttle-curve;
            dashed-commands: throttle-dashed;
            show-dashed: true;
            marker-vx: throttle-marker-x;
            marker-vy: throttle-marker-y;
            set-up => { set-up(0); }
            set-down => { set-down(0); }
            feel-selected(f) => { feel-selected(0, f); }
            deadzone-changed(v) => { deadzone-changed(0, v); }
            deadzone-edited(t) => { deadzone-edited(0, t); }
            bite-changed(v) => { bite-changed(v); }
            bite-edited(t) => { bite-edited(t); }
            curve-changed(v) => { pedal-curve-changed(0, v); }
            curve-edited(t) => { pedal-curve-edited(0, t); }
            press-ms-changed(v) => { pedal-press-ms-changed(0, v); }
            press-ms-edited(t) => { pedal-press-ms-edited(0, t); }
            release-ms-changed(v) => { pedal-release-ms-changed(0, v); }
            release-ms-edited(t) => { pedal-release-ms-edited(0, t); }
            saturation-changed(v) => { throttle-saturation-changed(v); }
            saturation-edited(t) => { throttle-saturation-edited(t); }
        }
        // Responsive gap (R-4): min-width 12px, stretch 0.05.
        Rectangle { min-width: 12px; horizontal-stretch: 0.05; }
        PedalCard {
            horizontal-stretch: 1;
            min-width: 224px;
            pedal-name: "Brake";
            pct: brake-pct;
            bar-color: Theme.bad;
            up-mv: brake-up-mv;
            down-mv: brake-down-mv;
            feel: brake-feel;
            show-chips: true;
            deadzone: brake-deadzone;
            deadzone-text: brake-deadzone-text;
            // --- Brake per-module tuning ---
            // B2 bite (0..1 of 50%) + B1 brake force (0.5..1.0).
            show-bite: true;
            show-force: true;
            curve-value: brake-curve-value;
            curve-text: brake-curve-text;
            show-press: true;
            press-label: "Initial bite";
            press-hint: "How fast brake force builds";
            press-ms-value: brake-press-ms-value;
            press-ms-text: brake-press-ms-text;
            show-release: false;
            show-saturation: false;
            advanced: advanced;
            raw-mv: brake-raw-mv;
            set-disabled: set-disabled;
            busy-kind: busy-kind;
            bite: brake-bite;
            bite-text: brake-bite-text;
            force: brake-force;
            force-text: brake-force-text;
            curve-commands: brake-curve;
            dashed-commands: brake-dashed;
            show-dashed: true;
            marker-vx: brake-marker-x;
            marker-vy: brake-marker-y;
            set-up => { set-up(1); }
            set-down => { set-down(1); }
            feel-selected(f) => { feel-selected(1, f); }
            deadzone-changed(v) => { deadzone-changed(1, v); }
            deadzone-edited(t) => { deadzone-edited(1, t); }
            // --- Brake per-module tuning ---
            bite-changed(v) => { brake-bite-changed(v); }
            bite-edited(t) => { brake-bite-edited(t); }
            force-changed(v) => { brake-force-changed(v); }
            force-edited(t) => { brake-force-edited(t); }
            curve-changed(v) => { pedal-curve-changed(1, v); }
            curve-edited(t) => { pedal-curve-edited(1, t); }
            press-ms-changed(v) => { pedal-press-ms-changed(1, v); }
            press-ms-edited(t) => { pedal-press-ms-edited(1, t); }
        }
        // Responsive gap (R-4): min-width 12px, stretch 0.05.
        Rectangle { min-width: 12px; horizontal-stretch: 0.05; }
        PedalCard {
            horizontal-stretch: 1;
            min-width: 224px;
            pedal-name: "Clutch";
            pct: clutch-pct;
            bar-color: Theme.accent;
            up-mv: clutch-up-mv;
            down-mv: clutch-down-mv;
            feel: clutch-feel;
            show-chips: true;
            deadzone: clutch-deadzone;
            deadzone-text: clutch-deadzone-text;
            show-bite: true;
            show-force: false;
            curve-value: clutch-curve-value;
            curve-text: clutch-curve-text;
            show-press: false;
            show-release: true;
            release-label: "Release speed";
            release-hint: "Slower release, smoother engagement";
            release-ms-value: clutch-release-ms-value;
            release-ms-text: clutch-release-ms-text;
            show-saturation: false;
            advanced: advanced;
            raw-mv: clutch-raw-mv;
            set-disabled: set-disabled;
            busy-kind: busy-kind;
            bite: clutch-bite;
            bite-text: clutch-bite-text;
            // --- Handbrake/clutch per-module tuning ---
            show-bite-width: true;
            bite-width: clutch-bite-width;
            bite-width-text: clutch-bite-width-text;
            force: 1;
            force-text: "";
            curve-commands: clutch-curve;
            dashed-commands: clutch-dashed;
            show-dashed: false;
            marker-vx: clutch-marker-x;
            marker-vy: clutch-marker-y;
            set-up => { set-up(2); }
            set-down => { set-down(2); }
            feel-selected(f) => { feel-selected(2, f); }
            deadzone-changed(v) => { deadzone-changed(2, v); }
            deadzone-edited(t) => { deadzone-edited(2, t); }
            bite-changed(v) => { bite-changed(v); }
            bite-edited(t) => { bite-edited(t); }
            // --- Handbrake/clutch per-module tuning ---
            bite-width-changed(v) => { clutch-bite-width-changed(v); }
            bite-width-edited(t) => { clutch-bite-width-edited(t); }
            curve-changed(v) => { pedal-curve-changed(2, v); }
            curve-edited(t) => { pedal-curve-edited(2, t); }
            release-ms-changed(v) => { pedal-release-ms-changed(2, v); }
            release-ms-edited(t) => { pedal-release-ms-edited(2, t); }
        }
    }
    // --- Pedal ramps/curves per-module tuning ---
    // A5: Combined pedals — gas + brake as one axis, for old games.
    // Advanced only; Rust owns the switch state.
    if advanced : HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            Text { text: "Combined pedals"; font-size: 13px; font-weight: 500; color: Theme.text; }
            Text { text: "Gas + brake as one axis, for old games"; font-size: 12px; color: Theme.faint; }
        }
        Rectangle { horizontal-stretch: 1; }
        Switch { accessible-name: "Combined pedals"; on: combine-pedals; toggled => { combine-pedals-changed(!combine-pedals); } }
    }
    // B4: the extra calibration-rule hint line below the cards is
    // removed — the Set up / Set down buttons carry the action.
    // (Phase 2: the old stretch absorber is gone — the ScrollView
    // owns the slack now.)
        }
    }
}
