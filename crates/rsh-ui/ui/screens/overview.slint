// RSH v2.0 — Overview screen (REDESIGN-PLAN §7.1, preview Overview.html).
// Phase 4 port: extracted verbatim from the Phase 3 shell
// (ui/shell.slint OverviewPage), which the shell imports at integration
// instead of defining inline. No design change.
//
// v2.0.1 hotfix: nothing here is hardcoded live data any more — the
// firmware line, delay/jitter/loss, updates/s, calibration label and
// game tiles all arrive as Rust-owned props (A11/A12/A14). No daemon
// means "Disconnected" + "—" placeholders, never fake Online (the
// sim fallback is labelled as unavailable, not live). The GT3 Sprint
// box opens the profile popover (A13); the pairing-needed banner
// (§8.6) shows when the wheel is not paired yet.
import { Theme } from "../tokens.slint";
import { EmptyBanner, Card, WheelGraphic, PedalBar, Pill, Btn, GameTile, CheckRow } from "../components.slint";

export struct GameItem {
    id: string,
    code: string,
    name: string,
    sub: string,
    sub_warn: bool,
    action: string,
    action_primary: bool,
}

export component OverviewPage inherits VerticalLayout {
    in property <angle> steer-angle;
    in property <string> steer-text;
    in property <float> throttle;
    in property <float> brake;
    in property <float> clutch;
    in property <bool> daemon-live;
    in property <bool> connected;
    in property <bool> paired: true;
    // M-2 (v2.0.2): the specific fatal reason from
    // read_daemon_status() — "" while there is none. Shown as an
    // error banner with Reconnect instead of the generic line below.
    in property <string> daemon-error: "";
    // Live values from Rust (A11/A12): "—" when there is no telemetry.
    in property <string> firmware-line: "—";
    in property <string> delay-text: "—";
    in property <string> jitter-text: "—";
    in property <string> lost-text: "—";
    in property <string> calibrated-label: "Not calibrated";
    in property <bool> calibrated-warn: true;
    in property <string> backend-name: "—";
    in property <bool> backend-ready: false;
    in property <string> profile-name: "GT3 Sprint";
    in property <[GameItem]> games;
    // DS-54: which job kind the busy strip shows, as a
    // JobKind::order value (-1 = idle) — the Find games button
    // disables + dims while its job runs.
    in property <int> busy-kind: -1;
    callback configure();
    callback launch-game(string);
    callback find-games();
    callback open-diagnostics();
    callback reconnect();
    callback open-profile-popover();
    callback pair-now();
    padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
    spacing: 12px;
    if daemon-error != "" : EmptyBanner { text: daemon-error; action-label: "Reconnect"; is-error: true; action-clicked => { reconnect(); } }
    if !daemon-live && daemon-error == "" : EmptyBanner { text: "Live data unavailable — RSH isn't running. Live data appears once it starts."; is-error: false; }
    // REDESIGN-PLAN §8.6 disconnected state: banner + Reconnect.
    if daemon-live && !connected : EmptyBanner { text: "Wheel not connected — check the RSH Wi-Fi is joined (or the USB cable is plugged in), then retry."; action-label: "Reconnect"; is-error: true; action-clicked => { reconnect(); } }
    // REDESIGN-PLAN §8.6 pairing-needed state (E): banner + Pair.
    if daemon-live && connected && !paired : EmptyBanner { text: "Wheel not paired — pair it so only this PC can control it."; action-label: "Pair now"; is-error: true; action-clicked => { pair-now(); } }
    Card {
        HorizontalLayout {
            padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
            spacing: 28px;
            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 14px;
                WheelGraphic { steer-angle: steer-angle; }
                VerticalLayout {
                    Text { text: steer-text; font-family: Theme.font-mono; font-size: 30px; font-weight: 600; color: Theme.text; }
                    Text { text: "Steering"; font-size: 12px; color: Theme.mute; }
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 18px;
                PedalBar { pct: throttle; bar-color: Theme.ok; label: "Throttle"; }
                PedalBar { pct: brake; bar-color: Theme.bad; label: "Brake"; }
                PedalBar { pct: clutch; bar-color: Theme.accent; label: "Clutch"; }
            }
            Rectangle { width: 1px; vertical-stretch: 1; horizontal-stretch: 0; background: Theme.line; }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "RSH Wheel"; font-size: 14px; font-weight: 600; color: Theme.text; }
                    Pill { label: connected ? "Online" : "Offline"; bg: connected ? Theme.ok-bg : Theme.err-bg; fg: connected ? Theme.ok : Theme.bad; }
                }
                Text { text: firmware-line; font-size: 12px; color: Theme.mute; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: prof-ta.has-hover ? Theme.faint : Theme.line;
                        background: prof-ta.has-hover ? Theme.hover-bg : Theme.panel2;
                        accessible-label: "Current profile: " + profile-name;
                        accessible-role: button;
                        prof-fs := FocusScope {
                            width: 100%;
                            height: 100%;
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == Key.Space) {
                                    open-profile-popover();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text { text: profile-name; font-size: 12px; font-weight: 600; color: Theme.text; }
                            Rectangle { horizontal-stretch: 1; }
                            Image { width: 12px; height: 12px; source: @image-url("../../assets/icons/chevron.svg"); }
                        }
                        prof-ta := TouchArea { mouse-cursor: pointer; clicked => { open-profile-popover(); } }
                    }
                    Btn { label: "Configure"; primary: true; clicked => { configure(); } }
                }
            }
        }
    }
    Card {
        VerticalLayout {
            padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
            spacing: 10px;
            HorizontalLayout {
                Text { text: "Games"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Auto-switches profile."; font-size: 12px; color: Theme.mute; }
            }
            // DS-56: the empty state gets an action — Find games runs
            // the same search as the wizard (daemon-live guarded, DS-55).
            if games.length == 0 : HorizontalLayout {
                spacing: 10px;
                Text { horizontal-stretch: 1; vertical-alignment: center; text: "No games found yet — run setup again to search."; font-size: 12px; color: Theme.faint; wrap: word-wrap; }
                Btn { label: "Find games"; disabled: busy-kind == 13; clicked => { find-games(); } }
            }
            if games.length > 0 : HorizontalLayout {
                spacing: 10px;
                for g in games : GameTile { horizontal-stretch: 1; code: g.code; name: g.name; sub: g.sub; sub-warn: g.sub_warn; action: g.action; action-primary: g.action_primary; action-clicked => { launch-game(g.id); } }
            }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
                spacing: 4px;
                HorizontalLayout {
                    Text { text: "Ready to race"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: connected ? "All good" : "Check needed"; bg: connected ? Theme.ok-bg : Theme.warn-bg; fg: connected ? Theme.ok : Theme.warn; }
                }
                CheckRow { label: "Wheel connected"; hint: "Wi-Fi"; warn: !connected; }
                CheckRow { label: "Pedals calibrated"; hint: calibrated-label; warn: calibrated-warn; }
                CheckRow { label: "Game controller ready"; hint: backend-name; warn: !backend-ready; }
            }
        }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: "Connection quality"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "Last 10 s"; font-size: 12px; color: Theme.mute; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout { horizontal-stretch: 1; Text { text: delay-text; font-family: Theme.font-mono; font-size: 20px; font-weight: 600; color: Theme.text; } Text { text: "Delay"; font-size: 11.5px; color: Theme.mute; } }
                    VerticalLayout { horizontal-stretch: 1; Text { text: lost-text; font-family: Theme.font-mono; font-size: 20px; font-weight: 600; color: Theme.text; } Text { text: "Lost data"; font-size: 11.5px; color: Theme.mute; } }
                    VerticalLayout { horizontal-stretch: 1; Text { text: jitter-text; font-family: Theme.font-mono; font-size: 20px; font-weight: 600; color: Theme.text; } Text { text: "Jitter"; font-size: 11.5px; color: Theme.mute; } }
                }
                Text {
                    text: "Open diagnostics";
                    font-size: 12px;
                    color: fs.has-focus || diag-ta.has-hover ? Theme.text : Theme.accent-text;
                    accessible-label: "Open diagnostics";
                    accessible-role: button;
                    // FIX-4: keyboard activation for this text link.
                    fs := FocusScope {
                        width: 100%;
                        height: 100%;
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == Key.Space) {
                                open-diagnostics();
                                return accept;
                            }
                            return reject;
                        }
                    }
                    diag-ta := TouchArea { mouse-cursor: pointer; clicked => { open-diagnostics(); } }
                }
            }
        }
    }
}
