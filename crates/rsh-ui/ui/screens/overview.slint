// RSH v2.0 — Overview screen (REDESIGN-PLAN §7.1, preview Overview.html).
// Phase 4 port: extracted verbatim from the Phase 3 shell
// (ui/shell.slint OverviewPage), which the shell imports at integration
// instead of defining inline. No design change.
//
// v2.0.1 hotfix: nothing here is hardcoded live data any more — the
// firmware line, delay/jitter/loss, updates/s, calibration label and
// game tiles all arrive as Rust-owned props (A11/A12/A14). No daemon
// means "Disconnected" + "—" placeholders, never fake Online (the
// sim fallback is labelled as unavailable, not live). The GT3 Sprint
// box opens the profile popover (A13); the pairing-needed banner
// (§8.6) shows when the wheel is not paired yet.
import { Theme } from "../tokens.slint";
import { EmptyBanner, Card, WheelGraphic, PedalBar, Pill, Btn, GameTile, CheckRow } from "../components.slint";
import { ScrollView } from "std-widgets.slint";

export struct GameItem {
    id: string,
    code: string,
    name: string,
    sub: string,
    sub_warn: bool,
    action: string,
    action_primary: bool,
}

export component OverviewPage inherits VerticalLayout {
    in property <angle> steer-angle;
    in property <string> steer-text;
    in property <float> throttle;
    in property <float> brake;
    in property <float> clutch;
    in property <bool> daemon-live;
    in property <bool> connected;
    in property <bool> paired: true;
    // M-2 (v2.0.2): the specific fatal reason from
    // read_daemon_status() — "" while there is none. Shown as an
    // error banner with Reconnect instead of the generic line below.
    in property <string> daemon-error: "";
    // Live values from Rust (A11/A12): "—" when there is no telemetry.
    in property <string> firmware-line: "—";
    in property <string> delay-text: "—";
    in property <string> jitter-text: "—";
    in property <string> lost-text: "—";
    in property <string> calibrated-label: "Not calibrated";
    in property <bool> calibrated-warn: true;
    in property <string> backend-name: "—";
    in property <bool> backend-ready: false;
    in property <string> profile-name: "GT3 Sprint";
    in property <[GameItem]> games;
    // DS-54: which job kind the busy strip shows, as a
    // JobKind::order value (-1 = idle) — the Add game button
    // disables + dims while its GameOp job runs.
    in property <int> busy-kind: -1;
    callback configure();
    callback launch-game(string);
    callback add-game();
    callback edit-game(string);
    callback remove-game(string);
    callback open-diagnostics();
    callback reconnect();
    callback open-profile-popover();
    callback pair-now();
    // Phase 2 (RC-3): the board already has a stored key — the
    // Overview banner offers Replace pairing directly (the wizard
    // Pair step is not the only surface any more).
    callback replace-pairing();
    in property <bool> replace-required: false;
    in property <string> replace-board-mac: "";
    // Phase 2 (Wi-Fi gap): true while the daemon's last activation
    // error is Unreachable — the banner then names the fix
    // (join the RSH Wi-Fi / plug in USB) instead of the generic
    // "not connected" line.
    in property <bool> unreachable: false;
    // Phase 2 (F-4): the page scrolls (Settings pattern) — the
    // bottom row was clipped ~9 px with no banner, ~50–70 px
    // with one. Root padding lives on the inner layout now.
    overview-scroll := ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
    padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
    spacing: 12px;
    if daemon-error != "" : EmptyBanner { text: daemon-error; action-label: "Reconnect"; is-error: true; action-disabled: busy-kind == 0; action-clicked => { reconnect(); } }
    if !daemon-live && daemon-error == "" : EmptyBanner { text: "Live data unavailable — RSH isn't running. Live data appears once it starts."; is-error: false; }
    // REDESIGN-PLAN §8.6 disconnected state: banner + Reconnect.
    // Phase 2 (Wi-Fi gap): while Unreachable, name the fix
    // proactively instead of the generic line.
    if daemon-live && !connected && unreachable : EmptyBanner { text: "Wheel not found — join the 'RSH' Wi-Fi network (or plug in USB), then press Reconnect."; action-label: "Reconnect"; is-error: true; action-disabled: busy-kind == 0; action-clicked => { reconnect(); } }
    if daemon-live && !connected && !unreachable : EmptyBanner { text: "Wheel not connected — check the RSH Wi-Fi is joined (or the USB cable is plugged in), then retry."; action-label: "Reconnect"; is-error: true; action-disabled: busy-kind == 0; action-clicked => { reconnect(); } }
    // Phase 2 (RC-3): StoredKeyExists — Replace pairing straight
    // from Overview, wired to confirm_replace_pairing_flow.
    if daemon-live && replace-required && !paired : EmptyBanner { text: "This wheel is already paired with a different key" + (replace-board-mac == "" ? "" : " (" + replace-board-mac + ")") + " — replace the pairing to connect."; action-label: "Replace pairing"; is-error: true; action-disabled: busy-kind == 12; action-clicked => { replace-pairing(); } }
    // REDESIGN-PLAN §8.6 pairing-needed state (E): banner + Pair.
    if daemon-live && connected && !paired : EmptyBanner { text: "Wheel not paired — pair it so only this PC can control it."; action-label: "Pair now"; is-error: true; action-disabled: busy-kind == 12; action-clicked => { pair-now(); } }
    Card {
        HorizontalLayout {
            // Phase 2 (F-16): spec card padding 14/16 (was 16/20).
            padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
            spacing: 28px;
            // UI-UX polish (a): preview `Main.html` §96 is
            // align-items:center — the 112px wheel group centres
            // against the ~132px pedal bars instead of top-aligning.
            // The divider keeps full height via self-alignment
            // stretch (a centred container would collapse it to 0).
            cross-axis-alignment: center;
            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 14px;
                cross-axis-alignment: center;
                WheelGraphic { steer-angle: steer-angle; }
                VerticalLayout {
                    Text { text: steer-text; font-family: Theme.font-mono; font-size: 30px; font-weight: 600; color: Theme.text; }
                    Text { text: "Steering"; font-size: 12px; color: Theme.mute; }
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 18px;
                PedalBar { pct: throttle; bar-color: Theme.ok; label: "Throttle"; }
                PedalBar { pct: brake; bar-color: Theme.bad; label: "Brake"; }
                PedalBar { pct: clutch; bar-color: Theme.accent; label: "Clutch"; }
            }
            Rectangle { width: 1px; vertical-stretch: 1; horizontal-stretch: 0; background: Theme.line; cross-axis-self-alignment: stretch; }
            VerticalLayout {
                horizontal-stretch: 1;
                // (same as the divider: this column must keep the
                // full row height, or its internal stretch spacer
                // can't push the profile row to the bottom.)
                cross-axis-self-alignment: stretch;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "RSH Wheel"; font-size: 14px; font-weight: 600; color: Theme.text; }
                    Pill { label: connected ? "Online" : "Offline"; bg: connected ? Theme.ok-bg : Theme.err-bg; fg: connected ? Theme.ok : Theme.bad; }
                }
                Text { text: firmware-line; font-size: 12px; color: Theme.mute; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: prof-ta.has-hover ? Theme.faint : Theme.line;
                        background: prof-ta.has-hover ? Theme.hover-bg : Theme.panel2;
                        accessible-label: "Current profile: " + profile-name;
                        accessible-role: button;
                        prof-fs := FocusScope {
                            width: 100%;
                            height: 100%;
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == Key.Space) {
                                    open-profile-popover();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text { text: profile-name; font-size: 12px; font-weight: 600; color: Theme.text; }
                            Rectangle { horizontal-stretch: 1; }
                            Image { width: 12px; height: 12px; source: @image-url("../../assets/icons/chevron.svg"); }
                        }
                        prof-ta := TouchArea { mouse-cursor: pointer; clicked => { open-profile-popover(); } }
                    }
                    Btn { label: "Configure"; primary: true; clicked => { configure(); } }
                }
            }
        }
    }
    Card {
        VerticalLayout {
            padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
            spacing: 10px;
            HorizontalLayout {
                Text { text: "Games"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Auto-switches profile."; font-size: 12px; color: Theme.mute; }
                Btn { label: "Add game"; disabled: busy-kind == 13; clicked => { add-game(); } }
            }
            // Manual games (no auto-scan): the empty state offers
            // Add game instead of a search.
            if games.length == 0 : HorizontalLayout {
                spacing: 10px;
                Text { horizontal-stretch: 1; vertical-alignment: center; text: "No games added yet — add your first game."; font-size: 12px; color: Theme.faint; wrap: word-wrap; }
                Btn { label: "Add game"; disabled: busy-kind == 13; clicked => { add-game(); } }
            }
            // Phase 2 (F-8): two tiles per row, min 300 px each —
            // three tiles in one row left ~26 px for the game name
            // (the Edit/Remove column broke the preview's 3-tile
            // layout); rows beyond two scroll with the page (F-4).
            // (`for … : if …` is not valid Slint, so each row
            // repeats all tiles and hides the other row's via
            // `visible` — hidden tiles take no layout space.)
            if games.length > 0 : GridLayout {
                // Fixed 10px: a computed spacing from `self.width`
                // is a binding LOOP here — the grid sits inside a
                // ScrollView, so its width comes back through
                // flickable.content-width (compiler error, caught by
                // ui-theme-switch). The tiles themselves still grow
                // (min-width 300px + stretch 1); only the gap stays
                // fixed. See CARDS-LAYOUT-RESEARCH §2 R-4.
                spacing: 10px;
                Row {
                    for g[idx] in games : GameTile { visible: idx < 2; horizontal-stretch: 1; min-width: 300px; code: g.code; name: g.name; sub: g.sub; sub-warn: g.sub_warn; action: g.action; action-primary: g.action_primary; action-disabled: busy-kind == 13; action-clicked => { launch-game(g.id); } edit-clicked => { edit-game(g.id); } remove-clicked => { remove-game(g.id); } }
                }
                Row {
                    for g[idx] in games : GameTile { visible: idx >= 2; horizontal-stretch: 1; min-width: 300px; code: g.code; name: g.name; sub: g.sub; sub-warn: g.sub_warn; action: g.action; action-primary: g.action_primary; action-disabled: busy-kind == 13; action-clicked => { launch-game(g.id); } edit-clicked => { edit-game(g.id); } remove-clicked => { remove-game(g.id); } }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 0px;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
                // UI-UX polish (a): preview is h2 margin 10 + `.chk`
                // padding 4px 0 — title to first row 14px, rows 8px
                // apart. Was spacing 4 throughout (rows packed).
                spacing: 8px;
                HorizontalLayout {
                    // UI-UX polish (a): preview is h2 margin 10 +
                    // `.chk` padding 4px 0 — title to first row 14px
                    // (8 spacing + this 6px row padding), rows 8px.
                    padding-bottom: 6px;
                    Text { text: "Ready to race"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: connected ? "All good" : "Check needed"; bg: connected ? Theme.ok-bg : Theme.warn-bg; fg: connected ? Theme.ok : Theme.warn; }
                }
                CheckRow { label: "Wheel connected"; hint: "Wi-Fi"; warn: !connected; }
                CheckRow { label: "Pedals calibrated"; hint: calibrated-label; warn: calibrated-warn; }
                CheckRow { label: "Game controller ready"; hint: backend-name; warn: !backend-ready; }
            }
        }
        // Responsive gap (R-4): min-width 12px, stretch 0.05.
        Rectangle { min-width: 12px; horizontal-stretch: 0.05; }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
                spacing: 10px;
                HorizontalLayout {
                    // UI-UX polish (a): preview is h2 margin 10 +
                    // stats grid margin-top 6 = 16px title-to-stats
                    // (10 spacing + this 6px row padding).
                    padding-bottom: 6px;
                    Text { text: "Connection quality"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "Last 10 s"; font-size: 12px; color: Theme.mute; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout { horizontal-stretch: 1; Text { text: delay-text; font-family: Theme.font-mono; font-size: 20px; font-weight: 600; color: Theme.text; } Text { text: "Delay"; font-size: 11.5px; color: Theme.mute; } }
                    VerticalLayout { horizontal-stretch: 1; Text { text: lost-text; font-family: Theme.font-mono; font-size: 20px; font-weight: 600; color: Theme.text; } Text { text: "Lost data"; font-size: 11.5px; color: Theme.mute; } }
                    VerticalLayout { horizontal-stretch: 1; Text { text: jitter-text; font-family: Theme.font-mono; font-size: 20px; font-weight: 600; color: Theme.text; } Text { text: "Jitter"; font-size: 11.5px; color: Theme.mute; } }
                }
                Text {
                    text: "Open diagnostics";
                    font-size: 12px;
                    color: fs.has-focus || diag-ta.has-hover ? Theme.text : Theme.accent-text;
                    accessible-label: "Open diagnostics";
                    accessible-role: button;
                    // FIX-4: keyboard activation for this text link.
                    fs := FocusScope {
                        width: 100%;
                        height: 100%;
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == Key.Space) {
                                open-diagnostics();
                                return accept;
                            }
                            return reject;
                        }
                    }
                    diag-ta := TouchArea { mouse-cursor: pointer; clicked => { open-diagnostics(); } }
                }
            }
        }
    }
}
}
}
