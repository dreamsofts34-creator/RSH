// RSH v2.0 — Steering screen (REDESIGN-PLAN §7.2, preview Wheel.html).
// Phase 4 port: extracted verbatim from the Phase 3 shell
// (ui/shell.slint SteeringPage), which the shell imports at integration
// instead of defining inline. No design change.
import { Theme } from "../tokens.slint";
import { Card, PresetChip, SliderRow, Pill, Btn, CurveGraph, Switch } from "../components.slint";
import { ScrollView } from "std-widgets.slint";

export component SteeringPage inherits HorizontalLayout {
    // Bug 7 (PC-test fix): the Advanced card is real tuning now —
    // invert, steering lock, smoothing. The old read-only rows
    // (centre mV, raw live, curve exponent box, min/max note) are
    // gone: they showed info nobody could act on.
    // S1–S3 (per-module tuning): capture full lock (two buttons
    // in the centre card), left/right balance, centre trim.
    in property <bool> advanced: false;
    in property <bool> invert: false;
    // v2.0.21 P2 factory defaults (360° lock, 0% smoothing) —
    // pre-sync placeholders; the window re-syncs them from the
    // live tuning within one frame.
    in property <float> lock-frac: (360.0 - 270.0) / 630.0;
    in property <string> lock-text: "360°";
    in property <float> smoothing: 0.0;
    in property <string> smoothing-text: "0%";
    in property <float> balance: 0.5;
    in property <string> balance-text: "0%";
    in property <float> trim: 0.5;
    in property <string> trim-text: "0%";
    in property <float> input-pct;
    in property <float> output-pct;
    in property <float> marker-vx;
    in property <float> marker-vy;
    in property <string> dashed-line;
    in property <string> crosshair;
    in property <string> curve-commands;
    in property <float> deadzone;
    in property <string> deadzone-text;
    in property <float> curve-val;
    in property <string> curve-text;
    in property <int> preset;
    in property <bool> unsaved;
    // A22: "Set" pill only once the centre is actually set (Rust
    // owns this via the calibration backend); the button is disabled
    // with a reason while the backend is unavailable.
    in property <bool> centre-set: false;
    in property <bool> centre-available: false;
    in property <string> centre-reason: "RSH isn't running — reconnect to capture.";
    // DS-54: which job kind the busy strip shows, as a
    // JobKind::order value (-1 = idle) — Set centre disables + dims
    // while its CaptureOp job (10) runs.
    in property <int> busy-kind: -1;
    callback deadzone-changed(float);
    callback curve-changed(float);
    callback deadzone-edited(string);
    callback curve-edited(string);
    callback invert-changed(bool);
    callback lock-changed(float);
    callback lock-edited(string);
    callback smoothing-changed(float);
    callback smoothing-edited(string);
    callback balance-changed(float);
    callback balance-edited(string);
    callback trim-changed(float);
    callback trim-edited(string);
    callback preset-selected(int);
    callback reset-defaults();
    callback set-centre();
    callback capture-full-left();
    callback capture-full-right();
    padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
    spacing: 0px;
    Card {
        horizontal-stretch: 1;
        VerticalLayout {
            padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
            spacing: 10px;
            CurveGraph {
                input-pct: input-pct;
                output-pct: output-pct;
                marker-vx: marker-vx;
                marker-vy: marker-vy;
                dashed-line: dashed-line;
                crosshair: crosshair;
                curve-commands: curve-commands;
            }
        }
    }
    // Responsive gap (R-4): min-width 12px, stretch 0.05. The graph
    // card grows; the right column stays 340px (tool panel, fixed).
    Rectangle { min-width: 12px; horizontal-stretch: 0.05; }
    // R2-16 (UI-UX polish): the right column scrolls so the
    // Advanced card (below) never clips the page when Advanced
    // mode is on; with Advanced off the content fits and no
    // scrollbar appears (Settings pattern).
    ScrollView {
        width: 340px;
        vertical-stretch: 1;
        content-width: self.visible-width;
        VerticalLayout {
            spacing: 12px;
            alignment: start;
        Card {
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
                spacing: 0px;
                Text { text: "Feel"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                // UI-UX polish (a): preview `.card h2` is
                // margin-bottom 10px — the chips sat flush under the
                // title (spacing 0 + no spacer).
                Rectangle { height: 10px; }
                Text { text: "Feel preset"; font-size: Theme.fs-label; font-weight: 500; color: Theme.text; }
                HorizontalLayout { cross-axis-alignment: center;
                    spacing: 6px;
                    PresetChip { horizontal-stretch: 1; label: "Soft"; active: preset == 0; clicked => { preset-selected(0); } }
                    PresetChip { horizontal-stretch: 1; label: "Normal"; active: preset == 1; clicked => { preset-selected(1); } }
                    PresetChip { horizontal-stretch: 1; label: "Firm"; active: preset == 2; clicked => { preset-selected(2); } }
                    PresetChip { horizontal-stretch: 1; label: "Custom"; active: preset == 3; clicked => { preset-selected(3); } }
                }
                Text { text: preset == 0 ? "Soft — gentle response, forgiving at the centre." : preset == 1 ? "Normal — even response, the default." : preset == 2 ? "Firm — quick, direct response." : "Custom — your own deadzone and curve below."; font-size: Theme.fs-hint; color: Theme.mute; wrap: word-wrap; }
                Rectangle { height: 14px; }
                SliderRow { label: "Centre deadzone"; hint: "Ignores small inputs"; value-text: deadzone-text; value: deadzone; changed(v) => { deadzone-changed(v); } value-edited(t) => { deadzone-edited(t); } }
                Rectangle { height: 14px; }
                SliderRow { label: "Response curve"; hint: "Linear to progressive"; value-text: curve-text; value: curve-val; changed(v) => { curve-changed(v); } value-edited(t) => { curve-edited(t); } }
                Rectangle { height: 14px; }
                // B07 (v2.0.8 retest): Reset and Unsaved on separate
                // lines — side by side they overflowed the 296 px
                // panel and clipped (the hint wrap + 340 px panel
                // above fix the rest of the clipping).
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Reset to defaults";
                        font-size: Theme.fs-label;
                        font-weight: 600;
                        color: fs.has-focus || reset-ta.has-hover ? Theme.text : Theme.accent-text;
                        accessible-label: "Reset to defaults";
                        accessible-role: button;
                        // FIX-4: keyboard activation for this text link.
                        // P2-5: the FocusScope + TouchArea extend 4px
                        // above/below the text (see "Open diagnostics").
                        fs := FocusScope {
                            y: -4px;
                            width: 100%;
                            height: parent.height + 8px;
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == Key.Space) {
                                    reset-defaults();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        // P1-4: visible focus ring — the colour change
                        // alone is too subtle to show Tab focus (About
                        // link pattern).
                        if fs.has-focus : Rectangle {
                            x: -6px;
                            y: -3px;
                            width: parent.width + 12px;
                            height: parent.height + 6px;
                            border-radius: 6px;
                            border-width: 2px;
                            border-color: Theme.accent-text;
                        }
                        reset-ta := TouchArea { y: -4px; width: 100%; height: parent.height + 8px; mouse-cursor: pointer; clicked => { reset-defaults(); } }
                    }
                    if unsaved : Text { text: "Unsaved changes"; font-size: Theme.fs-hint; color: Theme.warn; }
                }
            }
        }
        Card {
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
                spacing: 10px;
                HorizontalLayout { cross-axis-alignment: center;
                    Text { text: "Steering centre"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    if centre-set : Pill { label: "Set"; bg: Theme.ok-bg; fg: Theme.ok; }
                }
                HorizontalLayout { cross-axis-alignment: center;
                    spacing: 10px;
                    // UI-UX polish (a): the hint centres against the
                    // 30px Set centre button instead of top-aligning
                    // in the row (it stretched to 30px and rendered
                    // its text at the top).
                    Text { horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; text: "Point straight ahead, then press."; font-size: Theme.fs-hint; color: Theme.mute; }
                    // D12: no "✓" glyph in the label — the "Set" pill above already shows the state.
                    Btn { label: centre-set ? "Set" : "Set centre"; disabled: !centre-available || busy-kind == 10; clicked => { set-centre(); } }
                }
                // HID P3-3 (v2.0.13): the board treats the wheel
                // position at power-on as its centre, which can
                // disagree with the pipeline's centre — a wheel
                // turned at boot stays off-centre. The capture
                // above is the fix; the note tells the user why
                // it matters and how to avoid it next boot.
                Text { wrap: word-wrap; text: "The board treats the wheel position at power-on as its centre — always switch it on with the wheel straight. If steering feels off-centre, hold it straight and press Set centre."; font-size: Theme.fs-hint; color: Theme.mute; }
                // S1: Capture full lock — the two buttons sit next
                // to Set centre: turn fully left / right, press.
                // Same availability: live daemon only (CaptureOp).
                HorizontalLayout { cross-axis-alignment: center;
                    spacing: 10px;
                    Text { horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; text: "Turn fully left or right, then press."; font-size: Theme.fs-hint; color: Theme.mute; }
                    Btn { label: "Full left"; disabled: !centre-available || busy-kind == 10; clicked => { capture-full-left(); } }
                    Btn { label: "Full right"; disabled: !centre-available || busy-kind == 10; clicked => { capture-full-right(); } }
                }
                if !centre-available : Text { text: centre-reason; font-size: Theme.fs-hint; color: Theme.faint; wrap: word-wrap; }
            }
        }
        // Bug 7: Advanced mode is real tuning — invert, steering
        // lock (270–900° in steps), smoothing. No second
        // "Sensitivity" slider: the Basic Response curve already is
        // the sensitivity. S2+S3 add the left/right balance and
        // centre trim sliders here.
        if advanced : Card {
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
                spacing: 10px;
                Text { text: "Advanced"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                HorizontalLayout { cross-axis-alignment: center;
                    spacing: 8px;
                    VerticalLayout {
                        Text { text: "Invert steering"; font-size: Theme.fs-label; color: Theme.text; }
                        Text { text: "Reverses left and right"; font-size: Theme.fs-hint; color: Theme.faint; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Switch { accessible-name: "Invert steering"; on: invert; toggled => { invert-changed(!invert); } }
                }
                SliderRow { label: "Steering lock"; hint: "Lock-to-lock rotation"; value-text: lock-text; value: lock-frac; changed(v) => { lock-changed(v); } value-edited(t) => { lock-edited(t); } }
                SliderRow { label: "Smoothing"; hint: "Steadies the wheel input"; value-text: smoothing-text; value: smoothing; changed(v) => { smoothing-changed(v); } value-edited(t) => { smoothing-edited(t); } }
                SliderRow { label: "Left/right balance"; hint: "Evens out uneven pot travel — + favours left"; value-text: balance-text; value: balance; changed(v) => { balance-changed(v); } value-edited(t) => { balance-edited(t); } }
                SliderRow { label: "Centre trim"; hint: "Fine-nudges the centre, no re-capture"; value-text: trim-text; value: trim; changed(v) => { trim-changed(v); } value-edited(t) => { trim-edited(t); } }
            }
        }
        }
    }
}

// ---------------------------------------------------------------- Pedals placeholder (Phase 4: calibration editing)
