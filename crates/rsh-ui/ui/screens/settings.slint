// RSH v2.0 — Settings screen (REDESIGN-PLAN §7.5, preview-html/Settings.html
// is the single source of truth). Phase 5 port of the verified staging
// screen (v2-screens/screens/settings.slint, see SETTINGS-PORTING.md):
// sidebar/top-bar removed (the Phase 3 shell owns them once for all
// pages); local staging components replaced one-for-one with the shared
// library (../components.slint); Derived fills replaced with Theme
// tokens (Phase 3 folded them in); font/icon imports dropped (the shell
// embeds the fonts once). One local component remains: Seg, because the
// shared SegmentedControl has no disabled options.
//
// Data: connection/backend/startup/theme/profiles come from Rust via the
// props below. v2.0.1 hotfix wires them to the real AppApi: transport
// switch calls connect(), backend switch calls set_output_backend()
// (default vJoy), Start with Windows seeds from autost() and calls
// set_autostart(bool), profiles come from list_profiles(), firmware /
// update / backup texts are Rust-owned. Restore has no backend call
// yet, so its button is disabled with a reason. The About card is
// gone (B3: not in the preview) — attribution lives on the shell
// About page. English only; no language selector (§9).

import { Theme } from "../tokens.slint";
import { Card, Btn, Pill, RadioOptionCard, Switch } from "../components.slint";
import { ScrollView } from "std-widgets.slint";

export struct ProfileRow {
    name: string,
    games: string,
    active: bool,
}

// ---------------------------------------------------------------- segmented control with disabled options
// (shared SegmentedControl has no disabled state; the Theme row uses
// it for Dark/Light/Auto — all three enabled since v2.0.2, when the
// light theme landed in tokens.slint).
// Pure view: never sets `selected` itself; the parent owns the state.
component Seg inherits Rectangle {
    in property <[string]> options;
    in property <[bool]> enabled: [true, true, true];
    in property <int> selected;
    callback selected-changed(int);
    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.bg;
    HorizontalLayout {
        padding: 2px;
        spacing: 0px;
        for o[i] in options : Rectangle {
            horizontal-stretch: 1;
            border-radius: 6px;
            accessible-label: o;
            accessible-role: button;
            background: fs.has-focus ? Theme.line : (selected == i ? Theme.panel2 : (ta.has-hover ? Theme.hover-bg : transparent));
            opacity: enabled[i] ? 1 : 0.45;
            fs := FocusScope {
                width: 100%;
                height: 100%;
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == Key.Space) {
                        if (enabled[i]) { selected-changed(i); }
                        return accept;
                    }
                    return reject;
                }
            }
            Text {
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: o;
                font-size: 12px;
                font-weight: 600;
                color: selected == i ? Theme.sel-text : (ta.has-hover ? Theme.text : Theme.mute);
            }
            ta := TouchArea { mouse-cursor: enabled[i] ? MouseCursor.pointer : MouseCursor.default; clicked => { if (enabled[i]) { selected-changed(i); } } }
        }
    }
}

// ---------------------------------------------------------------- Settings page (content only — no Window/sidebar)
export component SettingsScreen inherits VerticalLayout {
    // ---- state owned by Rust (simulated defaults; AppApi covers
    // connection + pairing only — see header)
    in-out property <bool> connected: true;
    in-out property <int> connection-type: 0; // 0 Wi-Fi, 1 USB cable
    // L-2: "—" until Rust sets the live address — never a hardcoded
    // default (the window binds this to setup-address).
    in-out property <string> address: "—";
    in-out property <int> backend: 0; // 0 HIDMaestro, 1 vJoy
    in-out property <bool> start-with-windows: true;
    in-out property <bool> keep-in-tray: true;
    in-out property <int> theme: 0; // 0 Dark, 1 Light, 2 Auto (v2.0.2: all enabled)
    in-out property <[ProfileRow]> profiles;
    in-out property <string> app-version: "RSH 2.0.2";
    in-out property <string> firmware-text: "—";
    in-out property <string> app-update-text: "Auto-update is off — new versions are on GitHub Releases";
    in-out property <string> backup-text: "No backups yet";

    callback connection-selected(int);
    // H4 (v2.0.2): fired on Enter with the typed address — the old
    // address-changed(string) fired per keystroke and its payload was
    // dropped by the window, so Rust could never save the value.
    // (Enter = accept the address, not Save — M5.)
    callback address-accepted(string);
    callback reconnect();
    callback pair-requested();
    callback backend-selected(int);
    callback toggled-start-windows(bool);
    callback toggled-keep-tray(bool);
    callback theme-selected(int);
    callback new-profile();
    callback use-profile(int);
    callback duplicate-profile(int);
    callback check-firmware();
    // H-4 (v2.0.2): start the firmware flash (Rust arm
    // settings-action("update-firmware") is already wired).
    callback update-firmware();
    callback check-app-updates();
    callback backup();
    callback restore();
    callback run-setup();
    callback open-diagnostics();

    settings-scroll := ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            padding-top: 14px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 12px;
                // Equal columns: explicit 342px each (preview-exact:
                // (736 - 40 pad - 12 gap) / 2 = 342 at 920px). The
                // staging formula sized them from the ScrollView's
                // visible-width, but that feeds back into the page's
                // own preferred width here and the columns came out
                // ~357px, overflowing the right edge to x=915.
                // ---- left column
                VerticalLayout {
                    width: 342px;
                    spacing: 12px;
                    // Connection
                    Card {
                        VerticalLayout {
                            padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px;
                            spacing: 0px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "Connection"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                                Pill { label: connected ? "Connected" : "Disconnected"; bg: connected ? Theme.ok-bg : Theme.panel2; fg: connected ? Theme.ok : Theme.bad; }
                            }
                            Rectangle { height: 8px; }
                            Seg {
                                options: ["Wi-Fi", "USB cable"];
                                enabled: [true, true];
                                selected: connection-type;
                                selected-changed(i) => { connection-type = i; connection-selected(i); }
                            }
                            Rectangle { height: 6px; }
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;
                                Text { width: 52px; text: "Address"; font-size: 13px; color: Theme.mute; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 28px;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    background: Theme.bg;
                                    TextInput {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        height: 100%;
                                        vertical-alignment: center;
                                        text <=> address;
                                        font-family: Theme.font-mono;
                                        font-size: 12px;
                                        font-weight: 500;
                                        color: Theme.text;
                                        selection-background-color: Theme.accent;
                                        // H4: Enter accepts the typed
                                        // address — nothing is sent
                                        // per keystroke any more.
                                        accepted => { address-accepted(self.text); }
                                    }
                                }
                                Btn { label: "Reconnect"; clicked => { reconnect(); } }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 0px;
                                    Text { text: "Pair a new wheel"; font-size: 13px; color: Theme.text; }
                                    Text { text: "120 s pairing window"; font-size: 11.5px; color: Theme.mute; wrap: word-wrap; }
                                }
                                Btn { label: "Pair"; clicked => { pair-requested(); } }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            // A1 (v2.0.2): the setup-reopen row is easy
                            // to miss at the bottom of this card, so its
                            // button is primary — it stands out at a glance.
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 0px;
                                    Text { text: "Run setup again"; font-size: 13px; color: Theme.text; }
                                    Text { text: "Connect, drivers, pair, calibrate, games."; font-size: 11.5px; color: Theme.mute; wrap: word-wrap; }
                                }
                                Btn { label: "Run setup"; primary: true; clicked => { run-setup(); } }
                            }
                        }
                    }
                    // Game controller
                    Card {
                        VerticalLayout {
                            padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px;
                            spacing: 0px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text { text: "Game controller"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                            }
                            Rectangle { height: 8px; }
                            VerticalLayout {
                                spacing: 6px;
                                RadioOptionCard {
                                    title: "HIDMaestro";
                                    desc: "Needs admin permission when first used.";
                                    selected: backend == 0;
                                    clicked => { backend = 0; backend-selected(0); }
                                }
                                RadioOptionCard {
                                    title: "vJoy";
                                    desc: "No admin prompt. Needs vJoy.";
                                    selected: backend == 1;
                                    clicked => { backend = 1; backend-selected(1); }
                                }
                            }
                            // M-6 (v2.0.2): the sub-text wraps — at
                            // 920px the "Run setup" button is primary
                            // (wider), so the 39-char sub needs two
                            // lines instead of pushing past the card.
                            Text { text: "Recommended: vJoy"; font-size: 11.5px; color: Theme.faint; wrap: word-wrap; }
                        }
                    }
                    // Startup
                    Card {
                        VerticalLayout {
                            padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px;
                            spacing: 0px;
                            Text { text: "Startup"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                            Rectangle { height: 8px; }
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                alignment: space-between;
                                Text { text: "Start with Windows"; font-size: 13px; color: Theme.text; }
                                Switch { accessible-name: "Start with Windows"; on: start-with-windows; toggled => { start-with-windows = !start-with-windows; toggled-start-windows(start-with-windows); } }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                alignment: space-between;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 0px;
                                    Text { text: "Keep running in the tray"; font-size: 13px; color: Theme.text; }
                                    Text { text: "Keeps running after close."; font-size: 11.5px; color: Theme.mute; wrap: word-wrap; }
                                }
                                Switch { accessible-name: "Keep running in tray"; on: keep-in-tray; toggled => { keep-in-tray = !keep-in-tray; toggled-keep-tray(keep-in-tray); } }
                            }
                        }
                    }
                }
                // ---- right column
                VerticalLayout {
                    width: 342px;
                    spacing: 12px;
                    // Profiles
                    Card {
                        VerticalLayout {
                            padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px;
                            spacing: 0px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "Profiles"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                                Btn { label: "New"; clicked => { new-profile(); } }
                            }
                            Rectangle { height: 8px; }
                            for p[i] in profiles : VerticalLayout {
                                if i > 0 : Rectangle { height: 1px; background: Theme.line; }
                                HorizontalLayout {
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 0px;
                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: start;
                                            Text { text: p.name; font-size: 13px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                                            if p.active : Pill { label: "Active"; bg: Theme.ok-bg; fg: Theme.ok; }
                                        }
                                        Text { text: p.games; font-size: 11.5px; color: Theme.mute; wrap: word-wrap; }
                                    }
                                    if p.active : Btn { label: "Duplicate"; clicked => { duplicate-profile(i); } }
                                    if !p.active : Btn { label: "Use"; clicked => { use-profile(i); } }
                                }
                            }
                        }
                    }
                    // Appearance (v2.0.2, A8): Dark / Light / Auto all
                    // work now — Light tokens live in tokens.slint, Auto
                    // is resolved to Dark/Light by the Rust side.
                    Card {
                        VerticalLayout {
                            padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px;
                            spacing: 0px;
                            Text { text: "Appearance"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                            Rectangle { height: 8px; }
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;
                                Text { text: "Theme"; font-size: 13px; color: Theme.mute; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Seg {
                                    width: 190px;
                                    options: ["Dark", "Light", "Auto"];
                                    enabled: [true, true, true];
                                    selected: theme;
                                    selected-changed(i) => { theme = i; theme-selected(i); }
                                }
                            }
                        }
                    }
                    // Backup and updates (A7, v2.0.2): every sub-text
                    // wraps, so a long line can never push its button
                    // out of the card — the "App updates" Check button
                    // overflowed before this fix.
                    Card {
                        VerticalLayout {
                            padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px;
                            spacing: 0px;
                            Text { text: "Backup and updates"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                            Rectangle { height: 8px; }
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 0px;
                                    Text { text: "Wheel firmware"; font-size: 13px; color: Theme.text; }
                                    Text { text: firmware-text; font-size: 11.5px; color: Theme.mute; wrap: word-wrap; }
                                }
                                // H-4: Check reports the verdict,
                                // Update firmware starts the flash
                                // (daemon validates + flashes, the
                                // global busy strip shows progress).
                                HorizontalLayout {
                                    spacing: 6px;
                                    Btn { label: "Check"; clicked => { check-firmware(); } }
                                    Btn { label: "Update firmware"; clicked => { update-firmware(); } }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 0px;
                                    Text { text: "App updates"; font-size: 13px; color: Theme.text; }
                                    Text { text: app-update-text; font-size: 11.5px; color: Theme.mute; wrap: word-wrap; }
                                }
                                Btn { label: "Check"; clicked => { check-app-updates(); } }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 0px;
                                    Text { text: "Backups"; font-size: 13px; color: Theme.text; }
                                    Text { text: backup-text; font-size: 11.5px; color: Theme.mute; wrap: word-wrap; }
                                    Text { text: "Restore isn't supported yet."; font-size: 11.5px; color: Theme.faint; wrap: word-wrap; }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Btn { label: "Back up"; clicked => { backup(); } }
                                    Btn { label: "Restore"; disabled: true; clicked => { restore(); } }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { height: 2px; }
        }
    }
    // diagnostics link, pinned at the bottom (§7.5)
    HorizontalLayout {
        padding-top: 4px;
        padding-bottom: 12px;
        padding-left: 20px;
        padding-right: 20px;
        Text {
            text: "Open diagnostics";
            font-size: 12px;
            font-weight: 600;
            color: fs.has-focus || diag-ta.has-hover ? Theme.text : Theme.accent-text;
            accessible-label: "Open diagnostics";
            accessible-role: button;
            // FIX-4: keyboard activation for this text link.
            fs := FocusScope {
                width: 100%;
                height: 100%;
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == Key.Space) {
                        open-diagnostics();
                        return accept;
                    }
                    return reject;
                }
            }
            diag-ta := TouchArea { mouse-cursor: pointer; clicked => { open-diagnostics(); } }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}
