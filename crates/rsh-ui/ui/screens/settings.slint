// RSH v2.0 — Settings screen (REDESIGN-PLAN §7.5, preview-html/Settings.html
// is the single source of truth). Phase 5 port of the verified staging
// screen (v2-screens/screens/settings.slint, see SETTINGS-PORTING.md):
// sidebar/top-bar removed (the Phase 3 shell owns them once for all
// pages); local staging components replaced one-for-one with the shared
// library (../components.slint); Derived fills replaced with Theme
// tokens (Phase 3 folded them in); font/icon imports dropped (the shell
// embeds the fonts once). One local component remains: Seg, because the
// shared SegmentedControl has no disabled options.
//
// Data: connection/backend/startup/theme/profiles come from Rust via the
// props below. v2.0.1 hotfix wires them to the real AppApi: transport
// switch calls connect(), backend switch calls set_output_backend()
// (default vJoy), Start with Windows seeds from autost() and calls
// set_autostart(bool), profiles come from list_profiles(), firmware /
// update / backup texts are Rust-owned. Restore calls the real
// backend now (DS-52: restore_backup is wired UI → IPC → daemon →
// app-core); a missing backup reports a graceful error instead of
// a dead button. The About card is
// gone (B3: not in the preview) — attribution lives on the shell
// About page. English only; no language selector (§9).

import { Theme } from "../tokens.slint";
import { Card, CardBody, Btn, Pill, RadioOptionCard, Switch, PageScaffold } from "../components.slint";

export struct ProfileRow {
    name: string,
    games: string,
    active: bool,
}

// ---------------------------------------------------------------- segmented control with disabled options
// (shared SegmentedControl has no disabled state; the Theme row uses
// it for Dark/Light/Auto — all three enabled since v2.0.2, when the
// light theme landed in tokens.slint).
// Pure view: never sets `selected` itself; the parent owns the state.
component Seg inherits Rectangle {
    in property <[string]> options;
    in property <[bool]> enabled: [true, true, true];
    in property <int> selected;
    callback selected-changed(int);
    height: Theme.control-height;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.bg;
    HorizontalLayout {
        padding: 2px;
        spacing: 0px;
        for o[i] in options : Rectangle {
            horizontal-stretch: 1;
            border-radius: 6px;
            accessible-label: o;
            accessible-role: button;
            background: fs.has-focus ? Theme.line : (selected == i ? Theme.panel2 : (ta.has-hover ? Theme.hover-bg : transparent));
            // D4: 120ms background transition on hover/select.
            animate background { duration: 120ms; easing: ease-out; }
            opacity: enabled[i] ? 1 : 0.45;
            fs := FocusScope {
                width: 100%;
                height: 100%;
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == Key.Space) {
                        if (enabled[i]) { selected-changed(i); }
                        return accept;
                    }
                    return reject;
                }
            }
            Text {
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: o;
                font-size: Theme.fs-hint;
                font-weight: 600;
                color: selected == i ? Theme.sel-text : (ta.has-hover ? Theme.text : Theme.mute);
            }
            ta := TouchArea { mouse-cursor: enabled[i] ? MouseCursor.pointer : MouseCursor.default; clicked => { if (enabled[i]) { selected-changed(i); } } }
        }
    }
}

// D7: section header — small caps label grouping the cards below
// it (Connection · Game controller · Profiles · App · Backup & updates).
// The cards keep their own titles; the header is the section label.
component SectionHeader inherits Text {
    font-size: Theme.fs-hint;
    font-weight: 600;
    color: Theme.faint;
    letter-spacing: 0.8px;
}

// ---------------------------------------------------------------- Settings page (content only — no Window/sidebar)
export component SettingsScreen inherits VerticalLayout {
    // ---- state owned by Rust (simulated defaults; AppApi covers
    // connection only — see header)
    in-out property <bool> connected: true;
    // DS-54: which job kind the busy strip shows, as a
    // JobKind::order value (-1 = idle) — the invoking button
    // disables + dims while its job runs.
    in property <int> busy-kind: -1;
    in-out property <int> connection-type: 0; // 0 Wi-Fi, 1 USB cable
    // L-2: "—" until Rust sets the live address — never a hardcoded
    // default (the window binds this to setup-address).
    in-out property <string> address: "—";
    in-out property <int> backend: 0; // 0 HIDMaestro, 1 vJoy
    // P2 (v2.0.10 HID retest, Bug 1 retry storm): seconds left on
    // the post-failure backend-selector cooldown, 0 = idle. Rust
    // arms it for 30 s on ANY backend-switch failure and ticks it
    // on the 1 Hz timer; both radios disable while it is > 0.
    in property <int> backend-cooldown-secs: 0;
    in-out property <bool> start-with-windows: true;
    in-out property <bool> keep-in-tray: true;
    // R2-31 (UI-UX polish, h): the STORED theme choice (0 Dark,
    // 1 Light, 2 Auto) — what the Appearance segment shows. The
    // window's `theme` prop stays the resolved 0/1 that drives
    // Theme.mode; the window binds this two-way to `theme-choice`.
    in-out property <int> theme-choice: 0;
    in-out property <[ProfileRow]> profiles;
    in-out property <string> app-version: "RSH 2.0.12";
    in-out property <string> firmware-text: "—";
    in-out property <string> app-update-text: "Auto-update is off — new versions are on GitHub Releases";
    in-out property <string> backup-text: "No backups yet";
    // D19: Wi-Fi password state (Settings "Connection" card) —
    // whether the wheel's hotspot has a password, the new-password
    // + confirm fields, inline error/success, and the busy state
    // while a set/forget runs. Rust owns all of these.
    in property <bool> wifi-password-set: false;
    in property <string> wifi-password-error: "";
    in property <string> wifi-password-message: "";
    in property <bool> wifi-password-busy: false;
    in-out property <string> wifi-password-new: "";
    in-out property <string> wifi-password-confirm: "";

    callback connection-selected(int);
    // H4 (v2.0.2): fired on Enter with the typed address — the old
    // address-changed(string) fired per keystroke and its payload was
    // dropped by the window, so Rust could never save the value.
    // (Enter = accept the address, not Save — M5.)
    callback address-accepted(string);
    callback reconnect();
    callback set-wifi-password();
    callback forget-wifi-password();
    callback backend-selected(int);
    callback toggled-start-windows(bool);
    callback toggled-keep-tray(bool);
    callback theme-selected(int);
    callback new-profile();
    callback use-profile(int);
    callback duplicate-profile(int);
    callback check-firmware();
    // H-4 (v2.0.2): start the firmware flash (Rust arm
    // settings-action("update-firmware") is already wired).
    callback update-firmware();
    callback check-app-updates();
    callback backup();
    callback restore();
    callback run-setup();
    callback open-diagnostics();

    // P1: the scroll area is a PageScaffold (ScrollView +
    // standard padding). The diagnostics link below stays pinned
    // outside the scroll, as before.
    PageScaffold {
        vertical-stretch: 1;
            HorizontalLayout {
                spacing: 0px;
                // Equal columns: `min-width: 322px` each — P1-6:
                // (656 - 12 gap) / 2 = 322 at the 880px minimum
                // window ((880 - 184 sidebar - 40 page pad) = 656
                // content). At the 920px design width the columns
                // still stretch to 342px ((736 - 40 - 12) / 2), so
                // the design-width maths — and the gate's 342px
                // audit — are unchanged; 322 is only the floor
                // two-across needs at the minimum width.
                // (P2's 338px assumed its 24px pad-page token,
                // which the scaffold does not use.) Staging formula
                // sized them from the ScrollView's visible-width,
                // but that feeds back into the page's own preferred
                // width here and the columns came out ~357px,
                // overflowing the right edge to x=915.
                // CARDS-LAYOUT-RESEARCH §2: min-width (not `width`)
                // + stretch 1 so the columns GROW with the window
                // instead of sitting left-aligned at 322px; the gap
                // is a spacer Rectangle (min-width 12px, stretch
                // 0.05) that scales with the window.
                // ---- left column
                VerticalLayout {
                    min-width: 322px;
                    horizontal-stretch: 1;
                    spacing: 12px;
                    SectionHeader { text: "CONNECTION"; }
                    // Connection
                    Card {
                        CardBody {
                            HorizontalLayout {
                                alignment: space-between;
                                // UI-UX polish (a): preview `.card h2`
                                // is align-items:center — the title
                                // centres against the 20px pill.
                                cross-axis-alignment: center;
                                Text { text: "Connection"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                                Pill { label: connected ? "Connected" : "Disconnected"; bg: connected ? Theme.ok-bg : Theme.panel2; fg: connected ? Theme.ok : Theme.bad; }
                            }
                            Seg {
                                options: ["Wi-Fi", "USB cable"];
                                enabled: [busy-kind != 1, busy-kind != 1];
                                selected: connection-type;
                                selected-changed(i) => { connection-type = i; connection-selected(i); }
                            }
                            HorizontalLayout { cross-axis-alignment: center;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;
                                Text { width: 52px; text: "Address"; font-size: Theme.fs-label; color: Theme.mute; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: Theme.control-height;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    background: Theme.bg;
                                    TextInput {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        height: 100%;
                                        vertical-alignment: center;
                                        text <=> address;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.fs-value;
                                        font-weight: 500;
                                        color: Theme.text;
                                        selection-background-color: Theme.accent;
                                        // H4: Enter accepts the typed
                                        // address — nothing is sent
                                        // per keystroke any more.
                                        accepted => { address-accepted(self.text); }
                                    }
                                }
                                Btn { label: "Reconnect"; icon: @image-url("../../assets/icons/refresh.svg"); has-icon: true; disabled: busy-kind == 0; clicked => { reconnect(); } }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            // D19: Wi-Fi password — set on the wheel's
                            // hotspot so the next connection uses it.
                            // 8–63 printable ASCII; Rust validates and
                            // reports inline + toast on failure.
                            VerticalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 6px;
                                HorizontalLayout { cross-axis-alignment: center;
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 0px;
                                        Text { text: "Wi-Fi password"; font-size: Theme.fs-label; color: Theme.text; }
                                        Text { text: wifi-password-set ? "Password set — the wheel's hotspot needs it." : "No password — the wheel's hotspot is open."; font-size: Theme.fs-hint; color: Theme.mute; wrap: word-wrap; }
                                    }
                                    Pill { label: wifi-password-set ? "Set" : "Not set"; bg: wifi-password-set ? Theme.ok-bg : Theme.panel2; fg: wifi-password-set ? Theme.ok : Theme.mute; }
                                }
                                // B15: each password box has its label above it
                                // (the S6 screenshot showed two bare boxes)
                                // and a placeholder inside it — visible in
                                // Light and Dark, since the label is real text.
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "New password"; font-size: Theme.fs-label; color: Theme.text; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: Theme.control-height;
                                        border-radius: 7px;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        background: Theme.bg;
                                        Text {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            height: 100%;
                                            vertical-alignment: center;
                                            text: "New password";
                                            font-size: Theme.fs-hint;
                                            color: Theme.faint;
                                            visible: wifi-password-new == "";
                                        }
                                        TextInput {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            height: 100%;
                                            vertical-alignment: center;
                                            text <=> wifi-password-new;
                                            input-type: InputType.password;
                                            font-size: Theme.fs-hint;
                                            font-weight: 500;
                                            color: Theme.text;
                                            selection-background-color: Theme.accent;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "Confirm password"; font-size: Theme.fs-label; color: Theme.text; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: Theme.control-height;
                                        border-radius: 7px;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        background: Theme.bg;
                                        Text {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            height: 100%;
                                            vertical-alignment: center;
                                            text: "Confirm password";
                                            font-size: Theme.fs-hint;
                                            color: Theme.faint;
                                            visible: wifi-password-confirm == "";
                                        }
                                        TextInput {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            height: 100%;
                                            vertical-alignment: center;
                                            text <=> wifi-password-confirm;
                                            input-type: InputType.password;
                                            font-size: Theme.fs-hint;
                                            font-weight: 500;
                                            color: Theme.text;
                                            selection-background-color: Theme.accent;
                                        }
                                    }
                                }
                                Text { text: "New password (8–63 characters) — type it again to confirm."; font-size: Theme.fs-hint; color: Theme.mute; wrap: word-wrap; }
                                HorizontalLayout { cross-axis-alignment: center;
                                    spacing: 8px;
                                    Btn { label: wifi-password-busy ? "Setting…" : wifi-password-set ? "Change password" : "Set password"; primary: true; disabled: wifi-password-busy || busy-kind == 14; clicked => { set-wifi-password(); } }
                                    if wifi-password-set : Btn { label: "Forget password"; disabled: wifi-password-busy || busy-kind == 14; clicked => { forget-wifi-password(); } }
                                }
                                if wifi-password-error != "" : Text { text: wifi-password-error; font-size: Theme.fs-hint; color: Theme.bad; wrap: word-wrap; }
                                if wifi-password-message != "" : Text { text: wifi-password-message; font-size: Theme.fs-hint; color: Theme.ok; wrap: word-wrap; }
                                Text { text: "Forgetting clears the password on this PC. If the wheel still has one, hold BOOT on the wheel for 10 seconds to clear it there too — the hotspot then comes back open."; font-size: Theme.fs-hint; color: Theme.mute; wrap: word-wrap; }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            // D3: one primary per screen — "Set
                            // password" above is this screen's
                            // primary, so "Run setup" is a secondary
                            // outline button (was primary, A1).
                            HorizontalLayout { cross-axis-alignment: center;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 0px;
                                    Text { text: "Run setup again"; font-size: Theme.fs-label; color: Theme.text; }
                                    Text { text: "Connect, drivers, calibrate, games."; font-size: Theme.fs-hint; color: Theme.mute; wrap: word-wrap; }
                                }
                                Btn { label: "Run setup"; clicked => { run-setup(); } }
                            }
                        }
                    }
                    SectionHeader { text: "GAME CONTROLLER"; }
                    // Game controller
                    Card {
                        CardBody {
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text { text: "Game controller"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                RadioOptionCard {
                                    title: "HIDMaestro";
                                    desc: "Needs admin permission when first used.";
                                    selected: backend == 0;
                                    disabled: busy-kind == 2 || backend-cooldown-secs > 0;
                                    clicked => { backend = 0; backend-selected(0); }
                                }
                                RadioOptionCard {
                                    title: "vJoy";
                                    desc: "No admin prompt. Needs vJoy.";
                                    selected: backend == 1;
                                    disabled: busy-kind == 2 || backend-cooldown-secs > 0;
                                    clicked => { backend = 1; backend-selected(1); }
                                }
                            }
                            // P2: the cooldown countdown — `visible`,
                            // never `if`, so the card keeps the SAME
                            // size while it shows/hides (a hidden
                            // element still reserves its layout
                            // space). The StatusBar error lives ~1 s;
                            // this line is the visible surface for
                            // the remaining ~29 s.
                            Text { visible: backend-cooldown-secs > 0; text: "Retry in " + backend-cooldown-secs + " s — switching is paused after the last failure."; font-size: Theme.fs-hint; color: Theme.warn; wrap: word-wrap; }
                            // M-6 (v2.0.2): the sub-text wraps — at
                            // 920px the "Run setup" button is primary
                            // (wider), so the 39-char sub needs two
                            // lines instead of pushing past the card.
                            Text { text: "Recommended: vJoy"; font-size: Theme.fs-hint; color: Theme.faint; wrap: word-wrap; }
                        }
                    }
                    SectionHeader { text: "APP"; }
                    // Startup
                    Card {
                        CardBody {
                            Text { text: "Startup"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                alignment: space-between;
                                // UI-UX polish (a): preview `.row` is
                                // align-items:center — the label
                                // centres against the 20px switch.
                                cross-axis-alignment: center;
                                Text { text: "Start with Windows"; font-size: Theme.fs-label; color: Theme.text; }
                                Switch { accessible-name: "Start with Windows"; on: start-with-windows; toggled => { start-with-windows = !start-with-windows; toggled-start-windows(start-with-windows); } }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                alignment: space-between;
                                // UI-UX polish (a): preview `.row` is
                                // align-items:center — the two-line
                                // label centres against the switch.
                                cross-axis-alignment: center;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 0px;
                                    Text { text: "Keep running in the tray"; font-size: Theme.fs-label; color: Theme.text; }
                                    Text { text: "Keeps running after close."; font-size: Theme.fs-hint; color: Theme.mute; wrap: word-wrap; }
                                }
                                Switch { accessible-name: "Keep running in tray"; on: keep-in-tray; toggled => { keep-in-tray = !keep-in-tray; toggled-keep-tray(keep-in-tray); } }
                            }
                        }
                    }
                }
                // Responsive gap (R-4): min-width 12px, stretch 0.05.
                Rectangle { min-width: 12px; horizontal-stretch: 0.05; }
                // ---- right column
                VerticalLayout {
                    min-width: 322px;
                    horizontal-stretch: 1;
                    spacing: 12px;
                    SectionHeader { text: "PROFILES"; }
                    // Profiles
                    Card {
                        CardBody {
                            HorizontalLayout {
                                alignment: space-between;
                                // UI-UX polish (a): preview `.card h2`
                                // is align-items:center — the title
                                // centres against the 30px New button.
                                cross-axis-alignment: center;
                                Text { text: "Profiles"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                                Btn { label: "New"; disabled: busy-kind == 8; clicked => { new-profile(); } }
                            }
                            for p[i] in profiles : VerticalLayout {
                                if i > 0 : Rectangle { height: 1px; background: Theme.line; }
                                HorizontalLayout { cross-axis-alignment: center;
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 0px;
                                        HorizontalLayout { cross-axis-alignment: center;
                                            spacing: 4px;
                                            alignment: start;
                                            Text { text: p.name; font-size: Theme.fs-label; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                                            if p.active : Pill { label: "Active"; bg: Theme.ok-bg; fg: Theme.ok; }
                                        }
                                        Text { text: p.games; font-size: Theme.fs-hint; color: Theme.mute; wrap: word-wrap; }
                                    }
                                    if p.active : Btn { label: "Duplicate"; disabled: busy-kind == 8; clicked => { duplicate-profile(i); } }
                                    if !p.active : Btn { label: "Use"; disabled: busy-kind == 8; clicked => { use-profile(i); } }
                                }
                            }
                        }
                    }
                    SectionHeader { text: "APP"; }
                    // Appearance (v2.0.2, A8): Dark / Light / Auto all
                    // work now — Light tokens live in tokens.slint, Auto
                    // is resolved to Dark/Light by the Rust side.
                    Card {
                        CardBody {
                            Text { text: "Appearance"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;
                                Text { text: "Theme"; font-size: Theme.fs-label; color: Theme.mute; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Seg {
                                    width: 190px;
                                    options: ["Dark", "Light", "Auto"];
                                    enabled: [true, true, true];
                                    selected: theme-choice;
                                    selected-changed(i) => { theme-choice = i; theme-selected(i); }
                                }
                            }
                        }
                    }
                    SectionHeader { text: "BACKUP & UPDATES"; }
                    // Backup and updates (A7, v2.0.2): every sub-text
                    // wraps, so a long line can never push its button
                    // out of the card — the "App updates" Check button
                    // overflowed before this fix.
                    Card {
                        CardBody {
                            Text { text: "Backup and updates"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
                            // D6: empty state — 32px icon + one line + one
                            // button — while no firmware info has landed.
                            if firmware-text == "—" : VerticalLayout {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                Image { width: 32px; height: 32px; source: @image-url("../../assets/icons/wheel.svg"); colorize: Theme.faint; }
                                Text { text: "No firmware info yet — check for updates."; font-size: Theme.fs-hint; color: Theme.mute; horizontal-alignment: center; }
                                Btn { label: "Check"; disabled: busy-kind == 3; clicked => { check-firmware(); } }
                            }
                            if firmware-text != "—" : HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 0px;
                                    Text { text: "Wheel firmware"; font-size: Theme.fs-label; color: Theme.text; }
                                    Text { text: firmware-text; font-size: Theme.fs-hint; color: Theme.mute; wrap: word-wrap; }
                                }
                                // H-4: Check reports the verdict,
                                // Update firmware starts the flash
                                // (daemon validates + flashes, the
                                // global busy strip shows progress).
                                HorizontalLayout { cross-axis-alignment: center;
                                    spacing: 6px;
                                    Btn { label: "Check"; icon: @image-url("../../assets/icons/check.svg"); has-icon: true; disabled: busy-kind == 3; clicked => { check-firmware(); } }
                                    Btn { label: "Update firmware"; disabled: busy-kind == 4; clicked => { update-firmware(); } }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            HorizontalLayout { cross-axis-alignment: center;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 0px;
                                    Text { text: "App updates"; font-size: Theme.fs-label; color: Theme.text; }
                                    Text { text: app-update-text; font-size: Theme.fs-hint; color: Theme.mute; wrap: word-wrap; }
                                }
                                Btn { label: "Check"; icon: @image-url("../../assets/icons/check.svg"); has-icon: true; disabled: busy-kind == 16; clicked => { check-app-updates(); } }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            // D6: empty state — 32px icon + one line + one
                            // button — while no backup exists yet.
                            // (Restore only appears once a backup exists.)
                            if backup-text == "No backups yet" : VerticalLayout {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                Image { width: 32px; height: 32px; source: @image-url("../../assets/icons/archive.svg"); colorize: Theme.faint; }
                                Text { text: "No backups yet"; font-size: Theme.fs-hint; color: Theme.mute; horizontal-alignment: center; }
                                Btn { label: "Back up"; disabled: busy-kind == 14; clicked => { backup(); } }
                            }
                            if backup-text != "No backups yet" : HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 0px;
                                    Text { text: "Backups"; font-size: Theme.fs-label; color: Theme.text; }
                                    Text { text: backup-text; font-size: Theme.fs-hint; color: Theme.mute; wrap: word-wrap; }
                                }
                                HorizontalLayout { cross-axis-alignment: center;
                                    spacing: 6px;
                                    Btn { label: "Back up"; disabled: busy-kind == 14; clicked => { backup(); } }
                                    Btn { label: "Restore"; icon: @image-url("../../assets/icons/restore.svg"); has-icon: true; destructive: true; disabled: busy-kind == 14; clicked => { restore(); } }
                                }
                            }
                        }
                    }
                }
            }
    }
    // diagnostics link, pinned at the bottom (§7.5) + version
    // (B17: the header badge moved here — "RSH 2.0.11").
    HorizontalLayout {
        padding-top: 4px;
        padding-bottom: 12px;
        padding-left: Theme.pad-page-x;
        padding-right: Theme.pad-page-x;
        Text {
            text: "Open diagnostics";
            font-size: Theme.fs-hint;
            font-weight: 600;
            color: fs.has-focus || diag-ta.has-hover ? Theme.text : Theme.accent-text;
            accessible-label: "Open diagnostics";
            accessible-role: button;
            // FIX-4: keyboard activation for this text link.
            fs := FocusScope {
                width: 100%;
                height: 100%;
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == Key.Space) {
                        open-diagnostics();
                        return accept;
                    }
                    return reject;
                }
            }
            diag-ta := TouchArea { mouse-cursor: pointer; clicked => { open-diagnostics(); } }
        }
        Rectangle { horizontal-stretch: 1; }
        // B17: version lives here now (and on the About page).
        Text { text: app-version; font-size: Theme.fs-hint; color: Theme.faint; vertical-alignment: center; }
    }
}
