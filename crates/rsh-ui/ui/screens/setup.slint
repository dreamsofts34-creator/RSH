// RSH v2.0 — Setup wizard (REDESIGN-PLAN §7.6, preview Setup.html;
// NO-PAIRING-PLAN D16: pairing is gone — 4 steps (Connect, Drivers,
// Calibrate, Games), 920x580, dark theme.
//
// Step 1 Connect merges the old Connect + Pair steps: the Wi-Fi
// card performs the join itself (scan → join RSH-XXXX, open or with
// the stored WLAN password) — no more "join manually in Windows".
// Next unlocks on `board-reachable` (HELLO-or-better, D15), NEVER
// on Active/pairing. USB probes and unlocks on HELLO too.
//
// Step 2 Drivers: vJoy install shows progress % (or indeterminate
// + elapsed) and pre-warns about the external installer window.
// Step 3 Calibrate: an unavailable backend is an EXPLICIT skip
// ("Calibration unavailable — you can do this later in Settings"),
// never a silent pass; pedal graphs are live here. Step 4 Games:
// keep as-is. Wizard errors also fire a toast (Rust side, in
// addition to the inline text). Esc dismisses only the topmost
// overlay/toast; closing the wizard needs Skip/Finish. Finish →
// success toast ("Setup complete — …").
//
// Wiring note: this screen is standalone — the shell (main.slint)
// shows it instead of the main pages while setup is unfinished,
// and the Rust side drives it from the AppApi. All live values
// arrive as properties; the screen never polls. "Skip for now" is
// always present (left column).

import { Theme } from "../tokens.slint";
import { Btn, PedalBar } from "../components.slint";
import { ScrollView } from "std-widgets.slint";

component StepRow inherits HorizontalLayout {
    in property <int> num;
    in property <string> label;
    in property <string> sub;
    in property <bool> done;
    in property <bool> now;
    spacing: 12px;
    // UI-UX polish (a): preview `.st` is padding 10px 0 — each step
    // row has 10px above and below it (26px between circles with the
    // 6px column gap). Was flush, 6px apart.
    padding-top: 10px;
    padding-bottom: 10px;
    Rectangle {
        width: 26px;
        height: 26px;
        border-radius: 13px;
        border-width: 2px;
        border-color: done ? transparent : now ? Theme.accent : Theme.ring-line;
        background: done ? Theme.check-bg : now ? Theme.accent : transparent;
        // D12: the done tick is an SVG, not the "✓" text glyph.
        if done : Image {
            x: 6px;
            y: 6px;
            width: 14px;
            height: 14px;
            source: @image-url("../../assets/icons/check.svg");
            colorize: Theme.ok;
        }
        if !done : Text {
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: "" + num;
            font-size: Theme.fs-hint;
            font-weight: 700;
            color: now ? #ffffff : Theme.mute;
        }
    }
    VerticalLayout {
        spacing: 0px;
        Text { text: label; font-size: Theme.fs-label; font-weight: 500; color: now ? Theme.text : Theme.mute; }
        Text { text: sub; font-size: Theme.fs-hint; color: Theme.faint; }
    }
}

export component SetupWizard inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;

    // 0 Connect, 1 Drivers, 2 Calibrate, 3 Games (D16: 4 steps;
    // setup starts at Connect, step 0).
    in-out property <int> step: 0;
    // Step 0 — Connect.
    in property <bool> connect-done: false;
    // R2-19: why step 0 cannot advance ("" = no error to show).
    in property <string> connect-hint: "";
    in property <bool> wifi-joined: false;
    in property <int> transport: 0; // 0 Wi-Fi, 1 USB
    in property <string> address: "—";
    // D16: Wi-Fi scan/join state — the card performs the join via
    // the daemon (scan → join RSH-XXXX). `wifi-ssid` is the network
    // found by the scan ("" = none found yet); `wifi-joining` is
    // true while the join runs; `wifi-error` is the inline failure
    // (the Rust side toasts it too).
    in property <string> wifi-ssid: "";
    in property <bool> wifi-joining: false;
    in property <string> wifi-error: "";
    in property <bool> usb-available: false;
    // DS-54: which job kind the busy strip shows, as a
    // JobKind::order value (-1 = idle) — the invoking button
    // disables + dims while its job runs.
    in property <int> busy-kind: -1;
    // P2 (v2.0.10 HID retest, Bug 1 retry storm): seconds left on
    // the post-failure backend-selector cooldown, 0 = idle. Rust
    // arms it for 30 s on ANY backend-switch failure and ticks it
    // on the 1 Hz timer; the Xbox fallback button disables
    // while it is > 0.
    in property <int> backend-cooldown-secs: 0;
    // A3 (v2.0.2): daemon state drives the display — while the
    // background service is down the wizard shows "Disconnected" /
    // "—", never a plausible-looking address or status.
    in property <bool> daemon-live: false;
    // Step 1 — Drivers (v2.0.1 hotfix): Rust polls vjoy_status().
    in property <bool> vjoy-installed: false;
    in property <bool> vjoy-installing: false;
    // D16: install progress — percent when the daemon reports it,
    // -1 = indeterminate (then `vjoy-elapsed` shows the elapsed
    // time instead, e.g. "0:42").
    in property <int> vjoy-progress: -1;
    in property <string> vjoy-elapsed: "";
    in property <string> vjoy-version: "";
    in property <string> vjoy-error: "";
    in property <bool> xbox-fallback: false;
    // Step 2 — Calibrate availability (A17): false while the
    // calibration backend is unavailable; the buttons stay disabled
    // and Next does not gate on calibration then — the step says
    // so explicitly (D16), never a silent pass.
    in property <bool> calibration-available: false;
    in property <string> calibration-reason: "RSH isn't running — reconnect to capture.";
    // Step 2 — Calibrate.
    in property <bool> centre-done: false;
    in property <bool> pedals-done: false;
    // D16: live pedal levels (0..100) for the pedal graphs on the
    // Calibrate step — same live values as the Overview pedal bars.
    in property <float> live-throttle: 0;
    in property <float> live-brake: 0;
    in property <float> live-clutch: 0;
    // Step 3 — Games.
    in property <string> games-text: "No games added yet.";
    in property <bool> games-done: false;

    callback back();
    callback next();
    callback skip();
    callback install-vjoy();
    callback use-xbox();
    callback connect-action(string);
    callback calibrate-action(string);
    callback add-game();

    property <bool> next-enabled: step == 0 ? connect-done : step == 1 ? (vjoy-installed || xbox-fallback) : step == 2 ? (!calibration-available || (centre-done && pedals-done)) : true;
    property <string> step-title: step == 0 ? "Connect your wheel" : step == 1 ? "Install the game controller" : step == 2 ? "Calibrate your wheel" : "Add your games";
    property <string> step-lead: step == 0 ? "Join the wheel's Wi-Fi, or plug in a USB cable." : step == 1 ? "Games need a controller driver — vJoy is the default." : step == 2 ? "Centre the wheel and set the pedals, so the game gets true inputs." : "Add your racing games — pick the exe or shortcut for each game. RSH switches profile automatically when a game starts.";

    HorizontalLayout {
        // P1-2: 100% of the window — the component ROOT used to pin
        // an explicit 920px (Theme.window-width), clipping 40px off
        // the right edge at 1366x768 @150% (880px window). The right
        // column sizes to content here, so full-width elements still
        // carry explicit 584px widths ((920 - 264 - 2*36) — the same
        // explicit-width pattern as the Pedals/Settings fixes); those
        // are preferred widths with horizontal-stretch, so at 880px
        // they shrink to the 544px column.
        width: 100%;
        height: 100%;
        // Left column: logo + steps + Skip (preview: 264px).
        Rectangle {
            width: 264px;
            height: 100%;
            background: Theme.side;
            VerticalLayout {
                width: 100%;
                height: 100%;
                padding-top: 24px;
                // Permanent 40px reserve for the bottom StatusBar
                // (it floats over the window's last 40px, incl. this
                // "Skip for now" link) + the 24px margin.
                padding-bottom: 64px;
                padding-left: 22px;
                padding-right: 22px;
                spacing: 6px;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 10px;
                    background: Theme.accent;
                    Image {
                        x: 7px;
                        y: 7px;
                        width: 22px;
                        height: 22px;
                        source: @image-url("../../assets/icons/wheel.svg");
                    }
                }
                // UI-UX polish (a): preview `.side h1` is margin
                // 14px 0 2px — logo-to-title 14px (column gap 6 + this
                // 2px spacer + gap 6). Title-to-sub stays 6px vs the
                // preview's 2px — 4px, not worth restructuring the
                // column for. Sub-to-steps is 6+10+6=22, the preview's
                // margin-bottom 22px.
                Rectangle { height: 2px; }
                Text { text: "Set up your wheel"; font-size: Theme.fs-title; font-weight: 700; color: Theme.text; }
                Text { text: "About 3 minutes. You only do this once."; font-size: Theme.fs-label; color: Theme.mute; wrap: word-wrap; }
                Rectangle { height: 10px; }
                // L-2: the live address, never a hardcoded default —
                // "Wi-Fi · —" until the wheel is really connected.
                StepRow { num: 1; label: "Connect"; sub: transport == 1 ? "USB cable" : "Wi-Fi · " + address; done: step > 0 || connect-done; now: step == 0; }
                StepRow { num: 2; label: "Drivers"; sub: "vJoy controller"; done: step > 1 || vjoy-installed || xbox-fallback; now: step == 1; }
                StepRow { num: 3; label: "Calibrate"; sub: "Centre and pedals"; done: step > 2; now: step == 2; }
                StepRow { num: 4; label: "Games"; sub: "Add your racing games"; done: games-done; now: step == 3; }
                Rectangle { vertical-stretch: 1; }
                skip-ta := TouchArea {
                    width: 100%;
                    height: 20px;
                    accessible-label: "Skip for now";
                    accessible-role: button;
                    mouse-cursor: pointer;
                    clicked => { skip(); }
                    // (was `fs` — duplicated id in this component, see below)
                    skip-fs := FocusScope {
                        width: 100%;
                        height: 100%;
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == Key.Space) {
                                skip();
                                return accept;
                            }
                            return reject;
                        }
                    }
                    Text { text: "Skip for now"; font-size: Theme.fs-label; font-weight: 600; color: skip-ta.has-hover ? Theme.text : Theme.accent-text; }
                }
            }
            Rectangle { x: 263px; width: 1px; height: 100%; background: Theme.line; }
        }
        // Right column: step content.
        VerticalLayout {
            horizontal-stretch: 1;
            padding-top: 28px;
            // UI-UX polish (c): the status bar sits over the
            // bottom 40px of the window, so the right column keeps
            // empty padding below the footer (66px — more than the
            // 40px bar) — otherwise the bar would cover Back/Next
            // while a job runs. The window never resizes; this is
            // the reserve.
            padding-bottom: 66px;
            padding-left: 36px;
            padding-right: 36px;
            spacing: 0px;
            Text { text: "Step " + (step + 1) + " of 4"; font-size: Theme.fs-hint; font-weight: 700; color: Theme.accent-text; }
            // UI-UX polish (a): preview `h2` is margin 6px 0 4px —
            // eyebrow-to-title 6px, title-to-lead 4px (was 0/0).
            Rectangle { height: 6px; }
            Text { text: step-title; font-size: Theme.fs-title; font-weight: 700; color: Theme.text; }
            Rectangle { height: 4px; }
            Text { text: step-lead; font-size: Theme.fs-label; color: Theme.mute; }

            // P1-6: the step area scrolls when the window is short
            // (1366x768 @150% = 480px tall — Calibrate with its
            // pedal graphs needs ~518px). The ScrollView takes the
            // column's slack (it replaces the stretch spacer below),
            // so at the 580px design height the content fits, no
            // scrollbar appears, and the footer stays at the bottom.
            step-scroll := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                VerticalLayout {
            // ---- Step 0: Connect ----
            // (horizontal-stretch: the right column is 656px wide, but
            // a VerticalLayout child takes its preferred width unless
            // stretched — without this the cards sat at ~384px and the
            // footer at ~420px, ending x=684 instead of x=884.)
            if step == 0 : VerticalLayout {
                horizontal-stretch: 1;
                spacing: 12px;
                Rectangle { height: 10px; }
                Rectangle {
                    horizontal-stretch: 1;
                    width: 584px;
                    height: 64px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.panel;
                    HorizontalLayout { cross-axis-alignment: center;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        Text { vertical-alignment: center; text: "Wi-Fi"; font-size: Theme.fs-label; font-weight: 600; color: Theme.text; }
                        // D16: the card performs the join itself —
                        // the app scans for the wheel's RSH-XXXX
                        // network and joins it; the user never joins
                        // it in Windows by hand.
                        Text { vertical-alignment: center; text: wifi-joined ? "Joined the wheel's Wi-Fi" : wifi-ssid != "" ? "Found " + wifi-ssid : "Scan for the wheel's Wi-Fi network"; font-size: Theme.fs-label; color: Theme.mute; }
                        Rectangle { horizontal-stretch: 1; }
                        // A3: "Connected" only once the connection is
                        // really up — transport == 0 alone is not proof.
                        Btn { label: transport == 0 && (connect-done || wifi-joined) ? "Connected" : wifi-joining ? "Joining…" : wifi-ssid != "" ? "Join " + wifi-ssid : "Scan & join"; primary: transport == 0 && (connect-done || wifi-joined); disabled: busy-kind == 1 || wifi-joining; clicked => { connect-action("wifi"); } }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    width: 584px;
                    height: 64px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.panel;
                    HorizontalLayout { cross-axis-alignment: center;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        Text { vertical-alignment: center; text: "USB"; font-size: Theme.fs-label; font-weight: 600; color: Theme.text; }
                        Text { vertical-alignment: center; text: usb-available ? "USB cable connected" : "Plug in a USB cable for the fastest setup"; font-size: Theme.fs-label; color: Theme.mute; }
                        Rectangle { horizontal-stretch: 1; }
                        // A3: same rule as Wi-Fi — "Connected" needs a
                        // real connection, not just the USB choice.
                        Btn { label: transport == 1 && connect-done ? "Connected" : "Use USB"; primary: transport == 1 && connect-done; disabled: busy-kind == 1; clicked => { connect-action("usb"); } }
                    }
                }
                // A3: no address is known until the wheel is really
                // connected — "—" instead of the default address.
                Text { text: "Wheel address: " + (connect-done ? address : "—"); font-size: Theme.fs-label; font-family: Theme.font-mono; color: Theme.mute; }
                if wifi-error != "" : Text { text: wifi-error; font-size: Theme.fs-label; color: Theme.bad; wrap: word-wrap; }
                // R2-19: step 0 used to show no error at all — the
                // pair-status text lived on step 2. The hint names
                // the connection error (or the down daemon) so a
                // stuck Connect step explains itself.
                if connect-hint != "" : Text { text: connect-hint; font-size: Theme.fs-label; color: Theme.bad; wrap: word-wrap; }
            }

            // ---- Step 1: Drivers (v2.0.1 hotfix) ----
            if step == 1 : VerticalLayout {
                horizontal-stretch: 1;
                spacing: 12px;
                Rectangle { height: 10px; }
                // D16: pre-warn about the external installer window
                // BEFORE the user clicks Install — it opens in its
                // own window, then they come back here.
                if !vjoy-installed : Text { text: "The vJoy installer will open in its own window — follow it, then come back here."; font-size: Theme.fs-label; color: Theme.mute; wrap: word-wrap; }
                Rectangle {
                    horizontal-stretch: 1;
                    width: 584px;
                    height: 64px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.panel;
                    HorizontalLayout { cross-axis-alignment: center;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        Text { vertical-alignment: center; text: "vJoy"; font-size: Theme.fs-label; font-weight: 600; color: Theme.text; }
                        // A3: while the service is down the driver
                        // status is unknown — never claim "Not installed".
                        // D16: while installing, show progress % when
                        // known, else indeterminate + elapsed time.
                        Text { vertical-alignment: center; text: !daemon-live ? "Disconnected — status unknown" : vjoy-installed ? "Installed" + (vjoy-version == "" ? "" : " · " + vjoy-version) : vjoy-installing ? (vjoy-progress >= 0 ? "Installing… " + vjoy-progress + "%" : "Installing…" + (vjoy-elapsed == "" ? "" : " " + vjoy-elapsed)) : "Not installed — games need a controller driver"; font-size: Theme.fs-label; color: vjoy-installed ? Theme.ok : Theme.mute; }
                        Rectangle { horizontal-stretch: 1; }
                        // D12: SVG tick, not the "✓" text glyph.
                        if vjoy-installed : Image { width: 16px; height: 16px; source: @image-url("../../assets/icons/check.svg"); colorize: Theme.ok; }
                        if !vjoy-installed && !vjoy-installing : Btn { label: "Install vJoy"; primary: true; disabled: busy-kind == 14; clicked => { install-vjoy(); } }
                    }
                }
                if vjoy-error != "" : Text { text: vjoy-error; font-size: Theme.fs-label; color: Theme.bad; wrap: word-wrap; }
                // R2-40: an install failure strands the wizard on
                // this step unless the fallback is picked — say so
                // on the step itself, next to the error.
                if vjoy-error != "" && !xbox-fallback : Text { text: "Install failed — you can still continue with Xbox (ViGEmBus) below."; font-size: Theme.fs-label; color: Theme.mute; wrap: word-wrap; }
                // D16 (v2.0.19): the Xbox (ViGEmBus) fallback is
                // offered UP FRONT (not only after a failure) — it
                // is always visible while vJoy is not installed.
                // It needs the ViGEmBus driver: if it is not
                // installed, RSH offers to install it and shows a
                // plain error if that is declined or fails.
                if !vjoy-installed : Rectangle {
                    horizontal-stretch: 1;
                    width: 584px;
                    height: 64px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.panel;
                    HorizontalLayout { cross-axis-alignment: center;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        Text { vertical-alignment: center; text: "Xbox (ViGEmBus)"; font-size: Theme.fs-label; font-weight: 600; color: Theme.text; }
                        Text { vertical-alignment: center; text: "For games that don't see the vJoy wheel. Needs the ViGEmBus driver."; font-size: Theme.fs-label; color: Theme.mute; }
                        Rectangle { horizontal-stretch: 1; }
                        Btn { label: xbox-fallback ? "Selected" : "Use Xbox instead"; primary: !xbox-fallback; disabled: busy-kind == 14 || backend-cooldown-secs > 0; clicked => { use-xbox(); } }
                    }
                }
                // P2: the cooldown countdown — `visible`, never
                // `if`, so the step keeps the SAME size while it
                // shows/hides.
                Text { visible: backend-cooldown-secs > 0; text: "Retry in " + backend-cooldown-secs + " s — switching is paused after the last failure."; font-size: Theme.fs-label; color: Theme.warn; wrap: word-wrap; }
                if xbox-fallback : Text { text: "Xbox selected — the wheel appears as an Xbox 360 controller in games (steering on the left stick)."; font-size: Theme.fs-label; color: Theme.mute; wrap: word-wrap; }
            }

            // ---- Step 2: Calibrate ----
            if step == 2 : VerticalLayout {
                horizontal-stretch: 1;
                spacing: 12px;
                Rectangle { height: 10px; }
                Rectangle {
                    horizontal-stretch: 1;
                    width: 584px;
                    height: 64px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.panel;
                    HorizontalLayout { cross-axis-alignment: center;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        Text { vertical-alignment: center; text: "Centre"; font-size: Theme.fs-label; font-weight: 600; color: Theme.text; }
                        Text { vertical-alignment: center; text: centre-done ? "Centre set" : "Hold the wheel straight, then set the centre"; font-size: Theme.fs-label; color: Theme.mute; }
                        Rectangle { horizontal-stretch: 1; }
                        Btn { label: centre-done ? "Set" : "Set centre"; primary: !centre-done; disabled: !calibration-available || busy-kind == 10; clicked => { calibrate-action("centre"); } }
                    }
                }
                // HID P3-3 (v2.0.13): the board treats the wheel
                // position at power-on as its centre — a wheel
                // turned at boot stays off-centre until it is
                // re-captured here (or the board is rebooted with
                // the wheel straight). Say so on the step itself,
                // not just in docs.
                Text { text: "Tip: switch the board on with the wheel straight — it treats the power-on position as its centre. If steering feels off-centre, hold the wheel straight and press Set centre."; font-size: Theme.fs-label; color: Theme.mute; wrap: word-wrap; }
                Rectangle {
                    horizontal-stretch: 1;
                    width: 584px;
                    height: 64px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.panel;
                    HorizontalLayout { cross-axis-alignment: center;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        Text { vertical-alignment: center; text: "Pedals"; font-size: Theme.fs-label; font-weight: 600; color: Theme.text; }
                        Text { vertical-alignment: center; text: pedals-done ? "Pedals set" : "Press each pedal fully, then set"; font-size: Theme.fs-label; color: Theme.mute; }
                        Rectangle { horizontal-stretch: 1; }
                        Btn { label: pedals-done ? "Set" : "Set pedals"; primary: !pedals-done; disabled: !calibration-available || busy-kind == 10; clicked => { calibrate-action("pedals"); } }
                    }
                }
                // D16: pedal graphs live on this step too — the same
                // live values as the Overview pedal bars.
                if calibration-available : Rectangle {
                    horizontal-stretch: 1;
                    width: 584px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.panel;
                    HorizontalLayout {
                        padding-top: 14px;
                        padding-bottom: 14px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 18px;
                        PedalBar { pct: live-throttle; bar-color: Theme.ok; label: "Throttle"; }
                        PedalBar { pct: live-brake; bar-color: Theme.bad; label: "Brake"; }
                        PedalBar { pct: live-clutch; bar-color: Theme.accent; label: "Clutch"; }
                    }
                }
                // D16: an unavailable backend is an EXPLICIT skip,
                // never a silent pass.
                if !calibration-available : Text { text: "Calibration unavailable — you can do this later in Settings."; font-size: Theme.fs-label; color: Theme.mute; wrap: word-wrap; }
                if !calibration-available : Text { text: calibration-reason; font-size: Theme.fs-label; color: Theme.faint; wrap: word-wrap; }
            }

            // ---- Step 3: Games ----
            if step == 3 : VerticalLayout {
                horizontal-stretch: 1;
                spacing: 12px;
                Rectangle { height: 10px; }
                Rectangle {
                    horizontal-stretch: 1;
                    width: 584px;
                    height: 64px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.panel;
                    HorizontalLayout { cross-axis-alignment: center;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        Text { vertical-alignment: center; text: games-text; font-size: Theme.fs-label; color: Theme.mute; }
                        Rectangle { horizontal-stretch: 1; }
                        Btn { label: "Add game"; primary: true; disabled: busy-kind == 13; clicked => { add-game(); } }
                    }
                }
                Text { text: "RSH switches profile automatically when a game starts."; font-size: Theme.fs-label; color: Theme.mute; }
            }
                }
            }

            // Footer: Back / Next. Next is gated: Connect only
            // completes when the board is reachable (HELLO or
            // better — never on Active/pairing).
            HorizontalLayout { cross-axis-alignment: center;
                horizontal-stretch: 1;
                width: 584px;
                spacing: 8px;
                // P2-12: why Next is disabled — a silently dead
                // button reads as broken. Step 3 never disables.
                if !next-enabled : Text { vertical-alignment: center; text: step == 0 ? "Connect the wheel to continue." : step == 1 ? "Install vJoy or choose Xbox to continue." : "Set the centre and pedals to continue."; font-size: Theme.fs-hint; color: Theme.mute; wrap: word-wrap; }
                Rectangle { horizontal-stretch: 1; }
                if step > 0 : Btn { label: "Back"; clicked => { back(); } }
                if next-enabled : Btn { label: step == 3 ? "Finish" : "Next"; primary: true; clicked => { next(); } }
                // Phase 2 (F-9): a disabled Btn, not a hand-made
                // 76 px rectangle — the placeholder was ~24 px
                // wider than the real Next button, so the footer
                // jumped sideways on every gating change.
                if !next-enabled : Btn { label: step == 3 ? "Finish" : "Next"; primary: true; disabled: true; }
            }
        }
    }
}
