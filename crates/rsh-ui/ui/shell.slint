// RSH v2.0 — Phase 3 shell (REDESIGN-PLAN §3-§4): 184px sidebar, 56px top
// bar (in main.slint), status card on every screen. Overview + Steering
// are the real Phase 1-spike layouts, rebuilt on the component library.
// Pedals / Buttons / Extras / Settings are placeholders that already use
// the real §6 components with simulated data; their editing behaviour
// lands in Phases 4/5 (each page says so in its banner).
import { Theme } from "tokens.slint";
import { AboutSlint } from "std-widgets.slint";
import { Card, NavItem, SubItem, StatusCard, Switch, SegmentedControl, ProfileButton, AutoProfileChip, SliderRow, PresetChip, CurveGraph, PedalBar, HBar, RangeBlock, ButtonTile, GameTile, CheckRow, Pill, RadioOptionCard, EmptyBanner, WheelGraphic, Btn } from "components.slint";

// Page ids (shared with Rust): 0 Overview, 1 Steering, 2 Pedals,
// 3 Buttons, 4 Extras, 5 Settings, 6 About.
export component Sidebar inherits Rectangle {
    in property <int> page;
    in property <bool> connected;
    in property <string> conn-label;
    in property <string> conn-sub;
    in property <bool> send-to-game;
    callback nav(int);
    callback toggled-send();
    callback open-about();
    width: Theme.sidebar-width;
    background: Theme.side;
    VerticalLayout {
        padding-top: 14px;
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 14px;
        spacing: 2px;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 14px;
            spacing: 10px;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                background: Theme.accent;
                Image {
                    x: 5px;
                    y: 5px;
                    width: 18px;
                    height: 18px;
                    source: @image-url("../assets/icons/wheel.svg");
                }
            }
            VerticalLayout {
                spacing: 0px;
                Text { text: "RSH"; font-size: 14px; font-weight: 700; color: Theme.text; }
                Text { text: "Real Sim Hub"; font-size: 11px; color: Theme.faint; }
            }
        }
        NavItem { label: "Overview"; icon: @image-url("../assets/icons/grid.svg"); active: page == 0; clicked => { nav(0); } }
        Text { text: "DEVICE"; font-size: 10.5px; font-weight: 600; color: Theme.faint; }
        NavItem { label: "RSH Wheel"; icon: @image-url("../assets/icons/wheel.svg"); active: page >= 1 && page <= 4; show-dot: connected; clicked => { nav(1); } }
        SubItem { label: "Steering"; active: page == 1; clicked => { nav(1); } }
        SubItem { label: "Pedals"; active: page == 2; clicked => { nav(2); } }
        SubItem { label: "Buttons"; active: page == 3; clicked => { nav(3); } }
        SubItem { label: "Extras"; active: page == 4; clicked => { nav(4); } }
        Text { text: "APP"; font-size: 10.5px; font-weight: 600; color: Theme.faint; }
        NavItem { label: "Settings"; icon: @image-url("../assets/icons/gear.svg"); active: page == 5 || page == 6; clicked => { nav(5); } }
        Rectangle { vertical-stretch: 1; }
        StatusCard {
            connected: connected;
            label: conn-label;
            sub: conn-sub;
            send-to-game: send-to-game;
            toggled-send => { toggled-send(); }
        }
        Text {
            horizontal-alignment: center;
            text: "About";
            font-size: 11.5px;
            color: fs.has-focus ? Theme.text : Theme.faint;
            accessible-label: "About";
            accessible-role: button;
            // FIX-4: keyboard activation for this text link.
            fs := FocusScope {
                width: 100%;
                height: 100%;
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == Key.Space) {
                        open-about();
                        return accept;
                    }
                    return reject;
                }
            }
            // Visible focus ring (compare-fix): the colour change
            // alone is too subtle to show Tab focus on this link.
            if fs.has-focus : Rectangle {
                x: -6px;
                y: -3px;
                width: parent.width + 12px;
                height: parent.height + 6px;
                border-radius: 6px;
                border-width: 2px;
                border-color: Theme.accent-text;
            }
            TouchArea { clicked => { open-about(); } }
        }
    }
    Rectangle { x: 183px; width: 1px; height: 100%; background: Theme.line; }
}

// ---------------------------------------------------------------- Overview (preview Main.html)
export component OverviewPage inherits VerticalLayout {
    in property <angle> steer-angle;
    in property <string> steer-text;
    in property <float> throttle;
    in property <float> brake;
    in property <float> clutch;
    in property <bool> daemon-live;
    in property <bool> connected;
    callback configure();
    callback launch-game(string);
    callback open-diagnostics();
    callback reconnect();
    padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
    spacing: 12px;
    if !daemon-live : EmptyBanner { text: "Simulated data — the daemon is not running yet. Live data lands when Phase 2 IPC is connected."; is-error: false; }
    // REDESIGN-PLAN §8.6 disconnected state: banner + Reconnect.
    if daemon-live && !connected : EmptyBanner { text: "Wheel not connected — check the RSH Wi-Fi is joined (or the USB cable is plugged in), then retry."; action-label: "Reconnect"; is-error: true; action-clicked => { reconnect(); } }
    Card {
        HorizontalLayout {
            padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
            spacing: 28px;
            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 14px;
                WheelGraphic { steer-angle: steer-angle; }
                VerticalLayout {
                    Text { text: steer-text; font-family: Theme.font-mono; font-size: 30px; font-weight: 600; color: Theme.text; }
                    Text { text: "Steering"; font-size: 12px; color: Theme.mute; }
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 18px;
                PedalBar { pct: throttle; bar-color: Theme.ok; label: "Throttle"; }
                PedalBar { pct: brake; bar-color: Theme.bad; label: "Brake"; }
                PedalBar { pct: clutch; bar-color: Theme.accent; label: "Clutch"; }
            }
            Rectangle { width: 1px; vertical-stretch: 1; horizontal-stretch: 0; background: Theme.line; }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "RSH Wheel"; font-size: 14px; font-weight: 600; color: Theme.text; }
                    Pill { label: connected ? "Online" : "Offline"; bg: connected ? Theme.ok-bg : #2E1F26; fg: connected ? Theme.ok : Theme.bad; }
                }
                Text { text: "Firmware 4.0.1 · rsh.local · 200 updates/s"; font-size: 12px; color: Theme.mute; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.line;
                        background: Theme.panel2;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text { text: "GT3 Sprint"; font-size: 12px; font-weight: 600; color: Theme.text; }
                            Rectangle { horizontal-stretch: 1; }
                            Image { width: 12px; height: 12px; source: @image-url("../assets/icons/chevron.svg"); }
                        }
                    }
                    Btn { label: "Configure"; primary: true; clicked => { configure(); } }
                }
            }
        }
    }
    Card {
        VerticalLayout {
            padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
            spacing: 10px;
            HorizontalLayout {
                Text { text: "Games"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Launch from here. RSH switches profile automatically."; font-size: 12px; color: Theme.mute; }
            }
            HorizontalLayout {
                spacing: 10px;
                GameTile { horizontal-stretch: 1; code: "AC"; name: "Assetto Corsa"; sub: "GT3 Sprint"; action: "Launch"; action-primary: true; action-clicked => { launch-game("Assetto Corsa"); } }
                GameTile { horizontal-stretch: 1; code: "ACC"; name: "AC Competizione"; sub: "Running · GT3 Sprint"; sub-warn: true; action: "Stop"; action-clicked => { launch-game("AC Competizione"); } }
                GameTile { horizontal-stretch: 1; code: "iR"; name: "iRacing"; sub: "Not found"; action: "Locate"; action-clicked => { launch-game("iRacing"); } }
            }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
                spacing: 4px;
                HorizontalLayout {
                    Text { text: "Ready to race"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: connected ? "All good" : "Check needed"; bg: connected ? Theme.ok-bg : Theme.warn-bg; fg: connected ? Theme.ok : Theme.warn; }
                }
                CheckRow { label: "Wheel connected"; hint: "Wi-Fi"; warn: !connected; }
                CheckRow { label: "Pedals calibrated"; hint: "12 Nov"; }
                CheckRow { label: "Game controller ready"; hint: "HIDMaestro"; }
            }
        }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: "Connection quality"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "Last 10 s"; font-size: 12px; color: Theme.mute; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout { horizontal-stretch: 1; Text { text: "4 ms"; font-family: Theme.font-mono; font-size: 20px; font-weight: 600; color: Theme.text; } Text { text: "Delay"; font-size: 11.5px; color: Theme.mute; } }
                    VerticalLayout { horizontal-stretch: 1; Text { text: "0%"; font-family: Theme.font-mono; font-size: 20px; font-weight: 600; color: Theme.text; } Text { text: "Lost data"; font-size: 11.5px; color: Theme.mute; } }
                    VerticalLayout { horizontal-stretch: 1; Text { text: "1 ms"; font-family: Theme.font-mono; font-size: 20px; font-weight: 600; color: Theme.text; } Text { text: "Jitter"; font-size: 11.5px; color: Theme.mute; } }
                }
                Text {
                    text: "Open diagnostics";
                    font-size: 12px;
                    color: fs.has-focus ? white : Theme.accent-text;
                    accessible-label: "Open diagnostics";
                    accessible-role: button;
                    // FIX-4: keyboard activation for this text link.
                    fs := FocusScope {
                        width: 100%;
                        height: 100%;
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == Key.Space) {
                                open-diagnostics();
                                return accept;
                            }
                            return reject;
                        }
                    }
                    TouchArea { clicked => { open-diagnostics(); } }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- Steering (preview Wheel.html)
export component SteeringPage inherits HorizontalLayout {
    in property <float> input-pct;
    in property <float> output-pct;
    in property <float> marker-vx;
    in property <float> marker-vy;
    in property <string> dashed-line;
    in property <string> crosshair;
    in property <string> curve-commands;
    in property <float> deadzone;
    in property <string> deadzone-text;
    in property <float> curve-val;
    in property <string> curve-text;
    in property <int> preset;
    in property <bool> unsaved;
    callback deadzone-changed(float);
    callback curve-changed(float);
    callback deadzone-edited(string);
    callback curve-edited(string);
    callback preset-selected(int);
    callback reset-defaults();
    callback set-centre();
    padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
    spacing: 12px;
    Card {
        horizontal-stretch: 1;
        VerticalLayout {
            padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
            spacing: 10px;
            CurveGraph {
                input-pct: input-pct;
                output-pct: output-pct;
                marker-vx: marker-vx;
                marker-vy: marker-vy;
                dashed-line: dashed-line;
                crosshair: crosshair;
                curve-commands: curve-commands;
            }
        }
    }
    VerticalLayout {
        width: 296px;
        spacing: 12px;
        Card {
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
                spacing: 0px;
                Text { text: "Feel"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                HorizontalLayout {
                    spacing: 6px;
                    PresetChip { horizontal-stretch: 1; label: "Soft"; active: preset == 0; clicked => { preset-selected(0); } }
                    PresetChip { horizontal-stretch: 1; label: "Balanced"; active: preset == 1; clicked => { preset-selected(1); } }
                    PresetChip { horizontal-stretch: 1; label: "Sharp"; active: preset == 2; clicked => { preset-selected(2); } }
                    PresetChip { horizontal-stretch: 1; label: "Custom"; active: preset == 3; clicked => { preset-selected(3); } }
                }
                Rectangle { height: 14px; }
                SliderRow { label: "Centre deadzone"; hint: "Ignore tiny movements"; value-text: deadzone-text; value: deadzone; changed(v) => { deadzone-changed(v); } value-edited(t) => { deadzone-edited(t); } }
                Rectangle { height: 14px; }
                SliderRow { label: "Response curve"; hint: "Straight to Progressive"; value-text: curve-text; value: curve-val; changed(v) => { curve-changed(v); } value-edited(t) => { curve-edited(t); } }
                Rectangle { height: 14px; }
                HorizontalLayout {
                    Text {
                        text: "Reset to defaults";
                        font-size: 12px;
                        font-weight: 600;
                        color: fs.has-focus ? white : Theme.accent-text;
                        accessible-label: "Reset to defaults";
                        accessible-role: button;
                        // FIX-4: keyboard activation for this text link.
                        fs := FocusScope {
                            width: 100%;
                            height: 100%;
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == Key.Space) {
                                    reset-defaults();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        TouchArea { clicked => { reset-defaults(); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if unsaved : Text { text: "Unsaved changes"; font-size: 11.5px; color: Theme.warn; }
                }
            }
        }
        Card {
            VerticalLayout {
                padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: "Steering centre"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Pill { label: "Set"; bg: Theme.ok-bg; fg: Theme.ok; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { horizontal-stretch: 1; wrap: word-wrap; text: "Point the wheel straight ahead, then press the button."; font-size: 12px; color: Theme.mute; }
                    Btn { label: "Set centre"; clicked => { set-centre(); } }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- Pedals placeholder (Phase 4: calibration editing)
export component PedalsPage inherits VerticalLayout {
    in property <float> throttle;
    in property <float> brake;
    in property <float> clutch;
    callback pedal-action(string);
    padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
    spacing: 12px;
    alignment: start;
    EmptyBanner { text: "Pedal calibration editing lands in Phase 4 — values below are live simulated data."; }
    HorizontalLayout {
        spacing: 12px;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: "Throttle"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                HBar { label: "Live"; pct: throttle; bar-color: Theme.ok; }
                RangeBlock { up-value: "512 mV"; down-value: "3072 mV"; set-up => { pedal-action("throttle-up"); } set-down => { pedal-action("throttle-down"); } }
                SliderRow { label: "Deadzone"; hint: "Ignore tiny movements"; value-text: "2%"; value: 0.2; changed(v) => { pedal-action("throttle-deadzone"); } }
            }
        }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: "Brake"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                HBar { label: "Live"; pct: brake; bar-color: Theme.bad; }
                RangeBlock { up-value: "498 mV"; down-value: "3105 mV"; set-up => { pedal-action("brake-up"); } set-down => { pedal-action("brake-down"); } }
                SliderRow { label: "Deadzone"; hint: "Ignore tiny movements"; value-text: "2%"; value: 0.2; changed(v) => { pedal-action("brake-deadzone"); } }
            }
        }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: "Clutch"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                HBar { label: "Live"; pct: clutch; bar-color: Theme.accent; }
                RangeBlock { up-value: "505 mV"; down-value: "2980 mV"; set-up => { pedal-action("clutch-up"); } set-down => { pedal-action("clutch-down"); } }
                SliderRow { label: "Bite point"; hint: "Where the grip starts"; value-text: "40%"; value: 0.4; changed(v) => { pedal-action("clutch-bite"); } }
            }
        }
    }
}

// ---------------------------------------------------------------- Buttons placeholder (Phase 4: learning + mapping)
export component ButtonsPage inherits HorizontalLayout {
    in property <int> pressed-index: -1;
    in property <int> selected-index: 0;
    callback tile-selected(int);
    callback action-chip(string);
    padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
    spacing: 12px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 12px;
        alignment: start;
        EmptyBanner { text: "Button learning lands in Phase 4 — tiles below are a live simulated preview."; }
        Card {
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: "Wheel buttons"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                HorizontalLayout { spacing: 8px;
                    ButtonTile { horizontal-stretch: 1; label: "BUTTON 1"; action: "Shift up"; selected: selected-index == 0; pressed: pressed-index == 0; clicked => { tile-selected(0); } }
                    ButtonTile { horizontal-stretch: 1; label: "BUTTON 2"; action: "Shift down"; selected: selected-index == 1; pressed: pressed-index == 1; clicked => { tile-selected(1); } }
                    ButtonTile { horizontal-stretch: 1; label: "BUTTON 3"; action: "Horn"; selected: selected-index == 2; pressed: pressed-index == 2; clicked => { tile-selected(2); } }
                    ButtonTile { horizontal-stretch: 1; label: "BUTTON 4"; action: "Handbrake"; selected: selected-index == 3; pressed: pressed-index == 3; clicked => { tile-selected(3); } }
                }
                HorizontalLayout { spacing: 8px;
                    ButtonTile { horizontal-stretch: 1; label: "BUTTON 5"; action: "Gear 1"; selected: selected-index == 4; pressed: pressed-index == 4; clicked => { tile-selected(4); } }
                    ButtonTile { horizontal-stretch: 1; label: "BUTTON 6"; action: "Gear 2"; selected: selected-index == 5; pressed: pressed-index == 5; clicked => { tile-selected(5); } }
                    ButtonTile { horizontal-stretch: 1; label: "BUTTON 7"; action: "Gear 3"; selected: selected-index == 6; pressed: pressed-index == 6; clicked => { tile-selected(6); } }
                    ButtonTile { horizontal-stretch: 1; label: "BUTTON 8"; action: "Gear 4"; selected: selected-index == 7; pressed: pressed-index == 7; clicked => { tile-selected(7); } }
                }
                HorizontalLayout { spacing: 8px;
                    ButtonTile { horizontal-stretch: 1; label: "BUTTON 9"; action: "Gear 5"; selected: selected-index == 8; pressed: pressed-index == 8; clicked => { tile-selected(8); } }
                    ButtonTile { horizontal-stretch: 1; label: "BUTTON 10"; action: "Gear 6"; selected: selected-index == 9; pressed: pressed-index == 9; clicked => { tile-selected(9); } }
                    ButtonTile { horizontal-stretch: 1; label: "BUTTON 11"; action: "Not set"; not-set: true; selected: selected-index == 10; pressed: pressed-index == 10; clicked => { tile-selected(10); } }
                    ButtonTile { horizontal-stretch: 1; label: "BUTTON 12"; action: "Not set"; not-set: true; selected: selected-index == 11; pressed: pressed-index == 11; clicked => { tile-selected(11); } }
                }
            }
        }
        Card {
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: "Rotary knobs"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                HorizontalLayout { spacing: 8px;
                    Text { text: "Knob 1"; font-size: 12.5px; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "Left: Brake bias − · Right: Brake bias +"; font-size: 12px; color: Theme.mute; }
                }
                HorizontalLayout { spacing: 8px;
                    Text { text: "Knob 2"; font-size: 12.5px; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "Left: Volume − · Right: Volume +"; font-size: 12px; color: Theme.mute; }
                }
            }
        }
    }
    Card {
        width: 268px;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text { text: "Edit button"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
            Text { text: "Press any button on the wheel to learn it."; font-size: 12px; color: Theme.mute; wrap: word-wrap; }
            HorizontalLayout { spacing: 6px;
                PresetChip { horizontal-stretch: 1; label: "Shift up"; active: false; clicked => { action-chip("Shift up"); } }
                PresetChip { horizontal-stretch: 1; label: "Shift down"; active: false; clicked => { action-chip("Shift down"); } }
            }
            HorizontalLayout { spacing: 6px;
                PresetChip { horizontal-stretch: 1; label: "Horn"; active: false; clicked => { action-chip("Horn"); } }
                PresetChip { horizontal-stretch: 1; label: "Handbrake"; active: false; clicked => { action-chip("Handbrake"); } }
            }
            PresetChip { label: "Not set"; active: false; clicked => { action-chip("Not set"); } }
            Rectangle { vertical-stretch: 1; }
            Text { text: "Changes roll back after 10 seconds if the wheel does not confirm them."; font-size: 11.5px; color: Theme.faint; wrap: word-wrap; }
            HorizontalLayout { spacing: 8px;
                Btn { label: "Cancel"; clicked => { action-chip("cancel"); } }
                Rectangle { horizontal-stretch: 1; }
                Btn { label: "Save"; primary: true; clicked => { action-chip("save"); } }
            }
        }
    }
}

// ---------------------------------------------------------------- Extras placeholder (Phase 5: Handbrake / Shifter / Horn / LEDs)
export component ExtrasPage inherits VerticalLayout {
    in-out property <bool> handbrake-on: true;
    in-out property <bool> shifter-on: true;
    in-out property <bool> horn-on: true;
    in-out property <bool> leds-on: true;
    in property <float> handbrake;
    in property <string> gear: "N";
    callback extras-action(string);
    padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
    spacing: 12px;
    EmptyBanner { vertical-stretch: 0; text: "Extras editing lands in Phase 5 — cards below preview the layout with simulated data."; }
    HorizontalLayout {
        vertical-stretch: 0;
        spacing: 12px;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: "Handbrake"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Switch { accessible-name: "Handbrake"; on: handbrake-on; toggled => { handbrake-on = !handbrake-on; } }
                }
                HBar { label: "Live"; pct: handbrake; bar-color: Theme.bad; }
                RangeBlock { up-value: "500 mV"; down-value: "3050 mV"; set-up => { extras-action("handbrake-up"); } set-down => { extras-action("handbrake-down"); } }
            }
        }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: "Shifter"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Switch { accessible-name: "Shifter"; on: shifter-on; toggled => { shifter-on = !shifter-on; } }
                }
                Text { text: gear; font-family: Theme.font-mono; font-size: 30px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                Text { text: "Current gear"; font-size: 12px; color: Theme.mute; horizontal-alignment: center; }
                SliderRow { label: "Sensitivity"; hint: "How firm the shift feels"; value-text: "60%"; value: 0.6; changed(v) => { extras-action("shifter-sensitivity"); } }
            }
        }
    }
    HorizontalLayout {
        vertical-stretch: 0;
        spacing: 12px;
        // FIX (inner shortfall, compare-fix): this row preferred
        // ~467px (ending x=671) while the top row spans the full
        // 696px. Explicit 342px cards ((696 - 12) / 2, same as the
        // Settings columns) make the row prefer the full width.
        Card {
            horizontal-stretch: 1;
            width: 342px;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: "Horn"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Switch { accessible-name: "Horn"; on: horn-on; toggled => { horn-on = !horn-on; } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    ButtonTile { horizontal-stretch: 1; label: "HORN BUTTON"; action: "Button 3"; clicked => { extras-action("horn-learn"); } }
                    Btn { label: "Learn from wheel"; clicked => { extras-action("horn-learn"); } }
                }
                Btn { label: "Test horn"; clicked => { extras-action("horn-test"); } }
            }
        }
        Card {
            horizontal-stretch: 1;
            width: 342px;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: "LEDs"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Switch { accessible-name: "LEDs"; on: leds-on; toggled => { leds-on = !leds-on; } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle { width: 14px; height: 14px; border-radius: 7px; background: Theme.ok; }
                    Rectangle { width: 14px; height: 14px; border-radius: 7px; background: Theme.ok; }
                    Rectangle { width: 14px; height: 14px; border-radius: 7px; background: Theme.warn; }
                    Rectangle { width: 14px; height: 14px; border-radius: 7px; background: Theme.bad; }
                    Rectangle { width: 14px; height: 14px; border-radius: 7px; background: Theme.panel2; }
                    Rectangle { width: 14px; height: 14px; border-radius: 7px; background: Theme.panel2; }
                    Rectangle { width: 14px; height: 14px; border-radius: 7px; background: Theme.panel2; }
                    Rectangle { width: 14px; height: 14px; border-radius: 7px; background: Theme.panel2; }
                }
                HorizontalLayout { spacing: 6px;
                    PresetChip { horizontal-stretch: 1; label: "Off"; active: false; clicked => { extras-action("led-off"); } }
                    PresetChip { horizontal-stretch: 1; label: "Solid"; active: true; clicked => { extras-action("led-solid"); } }
                    PresetChip { horizontal-stretch: 1; label: "Chase"; active: false; clicked => { extras-action("led-chase"); } }
                }
                SliderRow { label: "Brightness"; hint: "LED strip brightness"; value-text: "80%"; value: 0.8; changed(v) => { extras-action("led-brightness"); } }
            }
        }
    }
    // Absorbs the spare vertical space so the rows keep preferred height.
    Rectangle { vertical-stretch: 1; }
}

// ---------------------------------------------------------------- Settings placeholder (Phase 5: full editing)
export component SettingsPage inherits VerticalLayout {
    in property <int> transport: 0;   // 0 Wi-Fi, 1 USB
    in property <int> controller: 0;  // 0 HIDMaestro, 1 vJoy
    in property <int> theme: 0;       // 0 Dark, 1 Auto (Light removed: no light tokens yet, audit FIX-6)
    callback transport-changed(int);
    callback controller-changed(int);
    callback theme-changed(int);
    callback settings-action(string);
    padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
    spacing: 12px;
    EmptyBanner { vertical-stretch: 0; text: "Full Settings editing lands in Phase 5 — controls below preview the layout."; }
    HorizontalLayout {
        vertical-stretch: 0;
        spacing: 12px;
        // FIX (inner shortfall): the columns preferred ~250px each, so the
        // page stayed ~214px short (right edge x=683). Explicit 342px columns
        // (preview-exact, staging census) make the row prefer 696px, so the
        // page spans the full 736px column.
        VerticalLayout {
            width: 342px;
            spacing: 12px;
            Card {
                VerticalLayout {
                    padding-top: 12px; padding-bottom: 12px; padding-left: 16px; padding-right: 16px;
                    spacing: 10px;
                    Text { text: "Connection"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    SegmentedControl { option-0: "Wi-Fi"; option-1: "USB"; selected: transport; selected-changed(i) => { transport-changed(i); } }
                    Text { text: "rsh.local · 192.168.4.1"; font-family: Theme.font-mono; font-size: 12px; color: Theme.mute; }
                    Btn { label: "Pair"; clicked => { settings-action("pair"); } }
                }
            }
            Card {
                VerticalLayout {
                    padding-top: 12px; padding-bottom: 12px; padding-left: 16px; padding-right: 16px;
                    spacing: 10px;
                    Text { text: "Game controller"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    RadioOptionCard { title: "HIDMaestro"; desc: "Native HID, recommended"; selected: controller == 0; clicked => { controller-changed(0); } }
                    RadioOptionCard { title: "vJoy"; desc: "Virtual joystick fallback"; selected: controller == 1; clicked => { controller-changed(1); } }
                }
            }
            Card {
                VerticalLayout {
                    padding-top: 12px; padding-bottom: 12px; padding-left: 16px; padding-right: 16px;
                    spacing: 10px;
                    Text { text: "Startup"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    HorizontalLayout {
                        Text { text: "Start with Windows"; font-size: 12.5px; color: Theme.text; }
                        Rectangle { horizontal-stretch: 1; }
                        Switch { accessible-name: "Start with Windows"; on: true; toggled => { settings-action("autostart"); } }
                    }
                    HorizontalLayout {
                        Text { text: "Keep running in tray"; font-size: 12.5px; color: Theme.text; }
                        Rectangle { horizontal-stretch: 1; }
                        Switch { accessible-name: "Keep running in tray"; on: true; toggled => { settings-action("tray"); } }
                    }
                }
            }
        }
        // FIX (inner shortfall): the columns preferred ~250px each, so the
        // page stayed ~214px short (right edge x=683). Explicit 342px columns
        // (preview-exact, staging census) make the row prefer 696px, so the
        // page spans the full 736px column.
        VerticalLayout {
            width: 342px;
            spacing: 12px;
            Card {
                VerticalLayout {
                    padding-top: 12px; padding-bottom: 12px; padding-left: 16px; padding-right: 16px;
                    spacing: 10px;
                    Text { text: "Profiles"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    CheckRow { label: "GT3 Sprint"; hint: "Active"; }
                    CheckRow { label: "Drift"; hint: "Assetto Corsa"; }
                    CheckRow { label: "Rally"; hint: "Dirt Rally 2.0"; }
                    Btn { label: "New profile"; clicked => { settings-action("new-profile"); } }
                }
            }
            Card {
                VerticalLayout {
                    padding-top: 12px; padding-bottom: 12px; padding-left: 16px; padding-right: 16px;
                    spacing: 10px;
                    Text { text: "Appearance"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    SegmentedControl { option-0: "Dark"; option-1: "Auto"; selected: theme; selected-changed(i) => { theme-changed(i); } }
                }
            }
            Card {
                VerticalLayout {
                    padding-top: 12px; padding-bottom: 12px; padding-left: 16px; padding-right: 16px;
                    spacing: 10px;
                    Text { text: "Backup and updates"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    Text { text: "App 1.0.2 · Firmware 4.0.1 · Both up to date"; font-size: 12px; color: Theme.mute; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        Btn { label: "Back up"; clicked => { settings-action("backup"); } }
                        Btn { label: "Check for updates"; clicked => { settings-action("update-check"); } }
                    }
                }
            }
        }
    }
    Rectangle { vertical-stretch: 1; }
}

// ---------------------------------------------------------------- About (licence attribution: Slint Royalty-free 2.0
// requires the AboutSlint widget on an About screen reachable from the
// top-level menu — here via the sidebar footer and Settings → About).
export component AboutPage inherits VerticalLayout {
    in property <string> app-version;
    callback back();
    padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
    spacing: 12px;
    alignment: start;
    Card {
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            HorizontalLayout {
                Text { text: "About RSH"; font-size: 17px; font-weight: 600; color: Theme.text; }
                Rectangle { horizontal-stretch: 1; }
                Btn { label: "Back"; clicked => { back(); } }
            }
            Text { text: "RSH — Real Sim Hub"; font-size: 14px; font-weight: 600; color: Theme.text; }
            Text { text: "Version " + app-version + " · MIT licence · ESP32 wheel + Rust PC app"; font-size: 12px; color: Theme.mute; }
            Text { text: "The user interface is built with Slint (Royalty-free 2.0 licence)."; font-size: 12px; color: Theme.mute; wrap: word-wrap; }
            Rectangle {
                height: 150px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel2;
                AboutSlint { }
            }
        }
    }
}
