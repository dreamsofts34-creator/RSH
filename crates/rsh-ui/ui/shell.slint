// RSH v2.0 — Phase 3 shell (REDESIGN-PLAN §3-§4): 184px sidebar, 56px top
// bar (in main.slint), status card on every screen. This file holds only
// the Sidebar and the About page; the other screens live in
// ui/screens/*.slint and are imported by main.slint. (The old ExtrasPage
// stub was deleted in the v2.0.1 hotfix — screens/extras.slint owns
// Extras now, A6.)
import { Theme } from "tokens.slint";
import { AboutSlint } from "std-widgets.slint";
import { Card, NavItem, SubItem, StatusCard, Btn } from "components.slint";

// Page ids (shared with Rust): 0 Overview, 1 Steering, 2 Pedals,
// 3 Buttons, 4 Extras, 5 Settings, 6 About.
export component Sidebar inherits Rectangle {
    in property <int> page;
    in property <bool> connected;
    in property <bool> conn-warn: false;
    in property <string> conn-label;
    in property <string> conn-sub;
    in property <bool> send-to-game;
    callback nav(int);
    callback toggled-send();
    callback open-about();
    width: Theme.sidebar-width;
    background: Theme.side;
    VerticalLayout {
        padding-top: 14px;
        padding-left: 10px;
        padding-right: 10px;
        // B06: the bottom bar is a real 40px StatusBar now — the
        // sidebar keeps 40px + 12px gap of empty padding below the
        // About link, so the bar never covers the link (or the
        // StatusCard's bottom edge) while a job runs. The window
        // never resizes; this is the reserve.
        padding-bottom: 52px;
        spacing: 2px;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 14px;
            spacing: 10px;
            // UI-UX polish (a): preview `.brand` is
            // align-items:center — the 28px logo centres against the
            // two-line wordmark.
            cross-axis-alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                background: Theme.accent;
                Image {
                    x: 5px;
                    y: 5px;
                    width: 18px;
                    height: 18px;
                    source: @image-url("../assets/icons/wheel.svg");
                }
            }
            VerticalLayout {
                spacing: 0px;
                Text { text: "RSH"; font-size: Theme.fs-card; font-weight: 700; color: Theme.text; }
                Text { text: "Real Sim Hub"; font-size: Theme.fs-hint; color: Theme.faint; }
            }
        }
        NavItem { label: "Overview"; icon: @image-url("../assets/icons/grid.svg"); active: page == 0; clicked => { nav(0); } }
        // UI-UX polish (a): preview `.lbl` is padding 12px 10px 4px —
        // the section label sits 12px below the nav item above it and
        // 4px above the next one. The column gap is 2px, so the row
        // padding makes up the rest (2+10=12 above, 2+2=4 below).
        // (x=20: sidebar padding 10 + this 10 — preview `.lbl`
        // padding-left 10px puts the label over the nav icons.)
        HorizontalLayout {
            padding-top: 10px;
            padding-bottom: 2px;
            padding-left: 10px;
            Text { text: "DEVICE"; font-size: Theme.fs-hint; font-weight: 600; color: Theme.faint; }
        }
        NavItem { label: "RSH Wheel"; icon: @image-url("../assets/icons/wheel.svg"); active: page >= 1 && page <= 4; show-dot: connected; clicked => { nav(1); } }
        SubItem { label: "Steering"; active: page == 1; clicked => { nav(1); } }
        SubItem { label: "Pedals"; active: page == 2; clicked => { nav(2); } }
        SubItem { label: "Buttons"; active: page == 3; clicked => { nav(3); } }
        SubItem { label: "Extras"; active: page == 4; clicked => { nav(4); } }
        HorizontalLayout {
            padding-top: 10px;
            padding-bottom: 2px;
            padding-left: 10px;
            Text { text: "APP"; font-size: Theme.fs-hint; font-weight: 600; color: Theme.faint; }
        }
        NavItem { label: "Settings"; icon: @image-url("../assets/icons/gear.svg"); active: page == 5 || page == 6; clicked => { nav(5); } }
        Rectangle { vertical-stretch: 1; }
        StatusCard {
            connected: connected;
            conn-warn: conn-warn;
            label: conn-label;
            sub: conn-sub;
            send-to-game: send-to-game;
            toggled-send => { toggled-send(); }
        }
        Text {
            horizontal-alignment: center;
            text: "About";
            font-size: Theme.fs-hint;
            color: fs.has-focus || about-ta.has-hover ? Theme.text : Theme.faint;
            accessible-label: "About";
            accessible-role: button;
            // FIX-4: keyboard activation for this text link.
            fs := FocusScope {
                width: 100%;
                height: 100%;
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == Key.Space) {
                        open-about();
                        return accept;
                    }
                    return reject;
                }
            }
            // Visible focus ring (compare-fix): the colour change
            // alone is too subtle to show Tab focus on this link.
            if fs.has-focus : Rectangle {
                x: -6px;
                y: -3px;
                width: parent.width + 12px;
                height: parent.height + 6px;
                border-radius: 6px;
                border-width: 2px;
                border-color: Theme.accent-text;
            }
            about-ta := TouchArea { mouse-cursor: pointer; clicked => { open-about(); } }
        }
    }
    Rectangle { x: 183px; width: 1px; height: 100%; background: Theme.line; }
}

// ---------------------------------------------------------------- About (licence attribution: Slint Royalty-free 2.0
// requires the AboutSlint widget on an About screen reachable from the
// top-level menu — here via the sidebar footer and Settings → About).
export component AboutPage inherits VerticalLayout {
    in property <string> app-version;
    callback back();
    padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
    spacing: 12px;
    alignment: start;
    Card {
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            HorizontalLayout { cross-axis-alignment: center;
                Text { text: "About RSH"; font-size: Theme.fs-title; font-weight: 600; color: Theme.text; }
                Rectangle { horizontal-stretch: 1; }
                Btn { label: "Back"; clicked => { back(); } }
            }
            Text { text: "RSH — Real Sim Hub"; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
            Text { text: "Version " + app-version + " · MIT licence · ESP32 wheel + Rust PC app"; font-size: Theme.fs-hint; color: Theme.mute; }
            Text { text: "The user interface is built with Slint (Royalty-free 2.0 licence)."; font-size: Theme.fs-hint; color: Theme.mute; wrap: word-wrap; }
            Rectangle {
                height: 150px;
                clip: true;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel2;
                AboutSlint { }
            }
        }
    }
}
