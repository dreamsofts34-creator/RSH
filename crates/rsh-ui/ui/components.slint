// RSH v2.0 — Phase 3 component library (REDESIGN-PLAN §6).
// Every screen is built from these components; no screen invents its own
// switch, card, or slider. Tokens live in tokens.slint. Layout rules from
// the Phase 1 spike apply throughout: never put a non-stretch `alignment`
// on a layout that has a stretch child (it collapses the stretch), and
// give fixed-size siblings an explicit `horizontal-stretch: 0` where they
// would otherwise share freed space.
import { Theme } from "tokens.slint";
import { ScrollView } from "std-widgets.slint";

// ---------------------------------------------------------------- card shell (§6: radius 12px, 1px border, 14px 16px padding via content)
export component Card inherits Rectangle {
    border-radius: Theme.card-radius;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.panel;
}

// ---------------------------------------------------------------- shared card body (P1, B09/B12/B14):
// EVERY card's content goes through this — 16px padding, 12px
// spacing, `alignment: start`, so slack never lands in a Text
// child and no card grows a gap when its row-mates are taller.
// Project rule (see the file header): an `alignment: start`
// layout must NOT contain a `vertical-stretch` absorber Rectangle
// — the alignment already packs children at the top, the leftover
// space simply stays empty.
export component CardBody inherits VerticalLayout {
    in property <string> title;
    in property <image> title-icon;
    in property <bool> has-title-icon: false;
    padding: 16px;
    spacing: 12px;
    alignment: start;
    if title != "" : HorizontalLayout {
        spacing: 8px;
        cross-axis-alignment: center;
        if has-title-icon : Image { width: 16px; height: 16px; source: title-icon; colorize: Theme.mute; }
        Text { text: title; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
    }
    @children
}

// ---------------------------------------------------------------- form row (P1): label+hint left (stretch,
// wrap), control right, min-height 44, vertically centred. The
// control is whatever the caller puts after the labels.
export component FormRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    min-height: 44px;
    spacing: 16px;
    cross-axis-alignment: center;
    VerticalLayout {
        horizontal-stretch: 1;
        min-width: 0px;
        spacing: 2px;
        Text { text: label; font-size: Theme.fs-label; font-weight: 500; color: Theme.text; overflow: elide; }
        if hint != "" : Text { text: hint; font-size: Theme.fs-hint; color: Theme.faint; wrap: word-wrap; }
    }
    @children
}

// ---------------------------------------------------------------- page scaffold (P1): EVERY page's outer
// shell — a ScrollView with the standard page padding (20px
// sides, 16px top/bottom) and 16px card gaps, content packed at
// the top. `viewport-width: visible-width` pins the content to
// the visible width, so a long hint can never push a card off
// the right edge (B07-class). The 40px StatusBar reserve lives
// on the main.slint content column, not here.
// `scroll-width` exposes the ScrollView's width for spacing
// formulas that must read a parent-driven width (never
// `self.width` inside the content — binding loop).
export component PageScaffold inherits VerticalLayout {
    out property <length> scroll-width: page-scroll.width;
    page-scroll := ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;
        VerticalLayout {
            padding-top: 16px; padding-bottom: 16px; padding-left: 20px; padding-right: 20px;
            spacing: 16px;
            alignment: start;
            @children
        }
    }
}

// ---------------------------------------------------------------- modal (P1, B19 wiring is P2): centred
// 420px card over a 40% scrim, overlay shadow. The caller owns
// the open state (places `if open : Modal { ... }` over the area
// it covers) and closes on `closed()` — scrim click only. Escape
// is NOT owned here (UI-10, v2.0.12): the Modal's FocusScope
// rejects it so it bubbles to the root keyboard scope, whose
// single Rust handler closes the TOPMOST overlay first — the old
// direct `closed()` here made one key close the dialog or only
// clear the status bar depending on invisible focus state. The
// scrim is a child Rectangle so its opacity never dims the card.
export component Modal inherits Rectangle {
    in property <string> title;
    callback closed();
    background: transparent;
    scrim := Rectangle {
        width: 100%;
        height: 100%;
        background: #000000;
        opacity: 0.4;
        TouchArea { clicked => { closed(); } }
    }
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            // UI-10: Escape is rejected on purpose — it bubbles to
            // the root keyboard scope, the single Esc owner (see
            // `wire_keyboard`), which closes the topmost overlay.
            // Accepting it here used to close the dialog while a
            // status message stayed, or (focus elsewhere) clear the
            // status while the dialog stayed — one key, two outcomes.
            return reject;
        }
    }
    // Card size for the gate probe (Bug 5): the visible card's
    // content height, not the full-window Modal size.
    out property <length> card-width: modal-card.width;
    out property <length> card-height: modal-card.height;
    modal-card := Card {
        width: 420px;
        height: body.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000040;
        // P1-2: a blocking TouchArea over the whole card, FIRST so
        // the body paints above it — clicks on card background or
        // labels stop here instead of falling through to the scrim
        // TouchArea below (which closed the dialog and discarded
        // typed input). It takes no input itself and never sits
        // above an interactive child: buttons / inputs inside the
        // body keep their own TouchAreas on top.
        TouchArea { width: 100%; height: 100%; }
        body := CardBody {
            title: title;
            @children
        }
    }
}

// ---------------------------------------------------------------- switch (§6: 34x20 cards/top bar, 40x22 tray)
export component Switch inherits Rectangle {
    in property <bool> on;
    // A2 (Steam FH4 wheel mode): a disabled switch never fires
    // `toggled` (click or keyboard) and renders dimmed — the
    // caller shows the short reason next to it (vJoy-only on HID).
    in property <bool> disabled: false;
    in property <string> accessible-name: "Toggle";
    accessible-label: accessible-name;
    accessible-role: switch;
    in property <length> sw-w: 34px;
    in property <length> sw-h: 20px;
    callback toggled();
    width: sw-w;
    height: sw-h;
    border-radius: sw-h / 2;
    opacity: disabled ? 0.45 : 1;
    background: on ? Theme.accent : (ta.has-hover ? Theme.hover-bg : Theme.switch-off);
    // FIX-4: accent border while keyboard-focused.
    border-width: fs.has-focus || ta.has-hover ? 1px : 0px;
    border-color: fs.has-focus ? Theme.accent-text : Theme.faint;
    // FIX-4: keyboard activation - Enter/Space acts, like a click.
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                if (!disabled) { toggled(); }
                return accept;
            }
            return reject;
        }
    }
    // Visible focus ring (compare-fix): a 2px accent outline around
    // the switch while keyboard-focused — the 1px border alone is too
    // subtle, and invisible against the accent on-state.
    if fs.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: sw-w + 6px;
        height: sw-h + 6px;
        border-radius: (sw-h + 6px) / 2;
        border-width: 2px;
        border-color: Theme.accent-text;
    }
    knob := Rectangle {
        width: sw-h - 6px;
        height: sw-h - 6px;
        x: on ? sw-w - (sw-h - 6px) - 3px : 3px;
        y: 3px;
        border-radius: (sw-h - 6px) / 2;
        background: white;
        animate x { duration: 120ms; easing: ease-out; }
    }
    // P2-5: the hit target extends 2px past the visual on every
    // side (20px -> 24px tall) — the visual is unchanged.
    ta := TouchArea { x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px; mouse-cursor: disabled ? MouseCursor.default : MouseCursor.pointer; clicked => { if (!disabled) { toggled(); } } }
}

// ---------------------------------------------------------------- pill (§6: Ok / warn / neutral / accent)
export component Pill inherits Rectangle {
    in property <string> label;
    in property <color> bg: Theme.panel2;
    in property <color> fg: Theme.mute;
    width: lbl.width + 16px;
    height: 20px;
    border-radius: 10px;
    background: bg;
    lbl := Text {
        x: 8px;
        y: 0px;
        height: 20px;
        vertical-alignment: center;
        text: label;
        font-size: Theme.fs-hint;
        font-weight: 600;
        color: fg;
    }
}

// ---------------------------------------------------------------- button (D3 hierarchy — one primary
// (accent fill) per screen; secondary is an outline, tertiary is
// a ghost (no border), destructive (Remove, Restore) is a red
// outline. D2: `icon` + `has-icon` put a 16px line icon before
// the label, colour-matched to the label.)
export component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> ghost: false;
    in property <bool> destructive: false;
    // Disabled buttons never fire `clicked` and render dimmed; the
    // caller shows the short reason next to them (v2.0.1 hotfix: no
    // fake-working buttons — a button either works or is disabled
    // with a reason).
    in property <bool> disabled: false;
    accessible-label: label;
    accessible-role: button;
    in property <length> btn-w: 0px;
    callback clicked();
    width: btn-w > 0px ? btn-w : content.preferred-width + 24px;
    height: 30px; // not control-height (32px): Btn lives in the 30px top-bar row.
    border-radius: Theme.radius-control;
    // P3-2: clip so an over-long label (fixed btn-w caller) can
    // never paint outside the button's rounded edge.
    clip: true;
    // P1-4: the focus border is 2px, not 1px — an outside ring
    // would be clipped away by `clip` above, so the thicker accent
    // border IS the focus ring here (same colour + weight as the
    // Switch/BellButton outside rings).
    border-width: fs.has-focus ? 2px : ghost ? 0px : 1px;
    // A5: hover + pressed feedback — primary lightens/darkens the
    // accent, secondary/destructive lift the border + fill on
    // hover, ghost only fills on hover. A disabled button never
    // shows hover or pressed fills — it stays dimmed (opacity 0.45
    // below) with its resting border/background, so a job running
    // elsewhere never leaves a dead button looking live on hover.
    border-color: fs.has-focus ? Theme.accent-text : destructive ? Theme.bad : (primary ? Theme.accent : (!disabled && ta.has-hover ? Theme.faint : Theme.line));
    background: primary ? (!disabled && ta.pressed ? Theme.accent-pressed : !disabled && ta.has-hover ? Theme.accent-hover : Theme.accent) : destructive ? (!disabled && ta.pressed ? Theme.err-bg : !disabled && ta.has-hover ? Theme.err-bg : transparent) : ghost ? (!disabled && ta.pressed ? Theme.pressed-bg : !disabled && ta.has-hover ? Theme.hover-bg : transparent) : (!disabled && ta.pressed ? Theme.pressed-bg : !disabled && ta.has-hover ? Theme.hover-bg : transparent);
    opacity: disabled ? 0.45 : 1;
    // D4: hover/pressed is a 120ms background transition, not an instant switch.
    animate background { duration: 120ms; easing: ease-out; }
    // FIX-4: keyboard activation - Enter/Space acts, like a click.
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (disabled) { return reject; }
            if (event.text == Key.Return || event.text == Key.Space) {
                clicked();
                return accept;
            }
            return reject;
        }
    }
    // The layout fills the button and CENTRES its content. It used
    // to rely on `x: (parent.width - self.width) / 2`, but a layout
    // with no explicit size takes the parent's size, so that was 0
    // and the label sat at the left edge, off-centre (the "text
    // aage-peeche" bug on every Btn).
    content := HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        alignment: center;
        spacing: 6px;
        cross-axis-alignment: center;
        if has-icon : Image {
            width: 16px;
            height: 16px;
            source: icon;
            colorize: primary ? #FFFFFF : destructive ? Theme.bad : Theme.text;
        }
        lbl := Text {
            vertical-alignment: center;
            text: label;
            font-size: Theme.fs-label;
            font-weight: 600;
            // P3-2: elide instead of overflowing when a fixed
            // btn-w caller constrains the label (no caller does
            // today — Btn sizes to content — this is defence).
            overflow: elide;
            // White on accent (4.50:1); Theme.text on accent is 3.83:1 (audit FIX-2).
            color: primary ? #FFFFFF : destructive ? Theme.bad : Theme.text;
        }
    }
    ta := TouchArea { mouse-cursor: disabled ? MouseCursor.default : MouseCursor.pointer; clicked => { if (!disabled) { clicked(); } } }
}

// ---------------------------------------------------------------- icon-only button (D9/D12: SVG icon, never a text
// glyph; `accessible-name` is the tooltip/announcement — Slint 1.18
// has no native tooltip element, so this is the mechanism that names
// the button for the user).
export component IconBtn inherits Rectangle {
    in property <image> icon;
    in property <string> accessible-name: "";
    in property <bool> disabled: false;
    accessible-label: accessible-name;
    accessible-role: button;
    callback clicked();
    width: Theme.control-height;
    height: Theme.control-height;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent-text : (ta.has-hover ? Theme.faint : Theme.line);
    background: ta.pressed ? Theme.pressed-bg : (ta.has-hover ? Theme.hover-bg : Theme.panel2);
    opacity: disabled ? 0.45 : 1;
    // D4: 120ms background transition, like Btn.
    animate background { duration: 120ms; easing: ease-out; }
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (disabled) { return reject; }
            if (event.text == Key.Return || event.text == Key.Space) {
                clicked();
                return accept;
            }
            return reject;
        }
    }
    // P1-4: visible 2px focus ring (Switch pattern).
    if fs.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Theme.radius-control + 2px;
        border-width: 2px;
        border-color: Theme.accent-text;
    }
    Image {
        x: 8px;
        y: 8px;
        width: 16px;
        height: 16px;
        source: icon;
        colorize: Theme.mute;
    }
    ta := TouchArea { mouse-cursor: disabled ? MouseCursor.default : MouseCursor.pointer; clicked => { if (!disabled) { clicked(); } } }
}

// ---------------------------------------------------------------- nav item (§6: 36px, icon 17px + label; active = accent tint)
export component NavItem inherits Rectangle {
    in property <string> label;
    accessible-label: label;
    accessible-role: button;
    in property <image> icon;
    in property <bool> active;
    in property <bool> show-dot;
    callback clicked();
    height: 36px;
    border-radius: 8px;
    background: fs.has-focus || active ? Theme.acc-bg : (ta.has-hover ? Theme.hover-bg : transparent);
    // D4: 120ms background transition on hover/active.
    animate background { duration: 120ms; easing: ease-out; }
    // FIX-4: keyboard activation - Enter/Space acts, like a click.
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                clicked();
                return accept;
            }
            return reject;
        }
    }
    // P1-4: visible 2px focus ring (Switch pattern) — the acc-bg
    // background change alone is too subtle to show Tab focus.
    if fs.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 10px;
        border-width: 2px;
        border-color: Theme.accent-text;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        // UI-UX polish (a): preview `a.nav` is align-items:center —
        // the 17px icon + label + 8px dot are centred in the 36px row,
        // not top-aligned (Slint's default cross-axis is stretch, so
        // fixed-height children sit high without this).
        cross-axis-alignment: center;
        Image {
            width: 16px;
            height: 16px;
            source: icon;
            colorize: active ? Theme.accent-text : Theme.mute;
        }
        Text {
            vertical-alignment: center;
            text: label;
            font-size: Theme.fs-label;
            font-weight: 500;
            color: active ? Theme.sel-text : (ta.has-hover ? Theme.text : Theme.mute);
        }
        Rectangle { horizontal-stretch: 1; }
        if show-dot : Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.ok;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
}

// ---------------------------------------------------------------- nav sub-item (§6: 30px, left padding 38px)
export component SubItem inherits Rectangle {
    in property <string> label;
    accessible-label: label;
    accessible-role: button;
    in property <bool> active;
    callback clicked();
    height: 30px;
    border-radius: 8px;
    background: fs.has-focus || active ? Theme.acc-bg : (ta.has-hover ? Theme.hover-bg : transparent);
    // FIX-4: keyboard activation - Enter/Space acts, like a click.
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                clicked();
                return accept;
            }
            return reject;
        }
    }
    // P1-4: visible 2px focus ring (Switch pattern).
    if fs.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 10px;
        border-width: 2px;
        border-color: Theme.accent-text;
    }
    Text {
        x: 38px;
        height: 100%;
        vertical-alignment: center;
        text: label;
        font-size: Theme.fs-label;
        font-weight: 500;
        color: active ? Theme.sel-text : (ta.has-hover ? Theme.text : Theme.mute);
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
}

// ---------------------------------------------------------------- status card (§6: sidebar bottom, on every screen)
// D10: the dot is green only when Connected. `conn-warn` (wheel
// simply not found / dropped / reconnecting) is amber; red is
// reserved for a real fault (wrong wheel, watchdog latch, port
// in use) — set from Rust via ConnectionState::is_fault().
export component StatusCard inherits Rectangle {
    in property <bool> connected;
    in property <bool> conn-warn: false;
    in property <string> label;
    in property <string> sub;
    in property <bool> send-to-game;
    callback toggled-send();
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.panel;
    VerticalLayout {
        padding-top: 10px; padding-bottom: 10px; padding-left: 12px; padding-right: 12px;
        spacing: 9px;
        HorizontalLayout {
            spacing: 8px;
            // UI-UX polish (a): preview centres the dot against the
            // two-line label (align-items:center) — without this the
            // 14px halo sits at the top of the ~30px text block.
            cross-axis-alignment: center;
            // Halo disc is a pre-blended solid (Theme.halo-ok /
            // halo-warn / halo-bad); the dot is a solid disc on top.
            // Do NOT use opacity here — an opacity rect dims its
            // child dot too (spike bug, Phase 3 fix).
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: connected ? Theme.halo-ok : conn-warn ? Theme.halo-warn : Theme.halo-bad;
                Rectangle {
                    x: 3px;
                    y: 3px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: connected ? Theme.ok : conn-warn ? Theme.warn : Theme.bad;
                }
            }
            VerticalLayout {
                Text { text: label; font-size: Theme.fs-label; font-weight: 600; color: Theme.text; }
                Text { text: sub; font-size: Theme.fs-hint; color: Theme.mute; }
            }
        }
        HorizontalLayout {
            // UI-UX polish (a): preview `.status .r` is
            // align-items:center — the label centres against the 20px
            // switch instead of sitting at the top of the row.
            cross-axis-alignment: center;
            Text { text: "Send to game"; font-size: Theme.fs-label; color: Theme.text; }
            Rectangle { horizontal-stretch: 1; }
            Switch { accessible-name: "Send to game"; on: send-to-game; toggled => { toggled-send(); } }
        }
    }
}

// ---------------------------------------------------------------- segmented control v2 (§6: Basic/Advanced, Dark/Light/Auto, Wi-Fi/USB)
// B11: every option stretches equally — no fixed 62/78/62px
// widths, so "Momentary" never clips and a wide control never
// leaves its options small. `min-width: 160px` keeps three
// options usable in a narrow container.
export component SegmentedControl inherits Rectangle {
    in property <string> option-0;
    in property <string> option-1;
    in property <string> option-2: "";
    in property <int> selected: 0;
    callback selected-changed(int);
    height: 30px; // not control-height (32px): this lives in the 30px top-bar row.
    min-width: 160px;
    border-radius: 8px;
    border-width: 1px;
    // P2-8: the border is the focus border while the control has
    // focus (roving tabindex below — one Tab stop, not three).
    border-color: fs.has-focus ? Theme.accent-text : Theme.line;
    background: Theme.panel;
    // P2-8: roving tabindex — ONE FocusScope on the control, not
    // one per option, so Tab stops once here instead of three
    // times; Left/Right/Up/Down move the selection with wraparound
    // (count = 2 or 3 options), Return/Space re-confirms it.
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                selected-changed(Math.mod(selected - 1 + (option-2 == "" ? 2 : 3), option-2 == "" ? 2 : 3));
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                selected-changed(Math.mod(selected + 1, option-2 == "" ? 2 : 3));
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                selected-changed(selected);
                return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        padding: 2px;
        spacing: 0px;
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            height: 24px;
            border-radius: 6px;
            accessible-label: option-0;
            accessible-role: button;
            background: selected == 0 ? Theme.panel2 : (ta0.has-hover ? Theme.hover-bg : transparent);
            // D4: 120ms background transition on hover/select.
            animate background { duration: 120ms; easing: ease-out; }
            // P2-8: the 2px ring on the selected option while the
            // control has focus — inset, so it never spills into
            // the next option.
            if fs.has-focus && selected == 0 : Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                border-radius: 5px; border-width: 2px; border-color: Theme.accent-text;
            }
            Text { width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; text: option-0; font-size: Theme.fs-hint; font-weight: 600; color: selected == 0 ? Theme.sel-text : (ta0.has-hover ? Theme.text : Theme.mute); overflow: elide; }
            ta0 := TouchArea { mouse-cursor: pointer; clicked => { selected-changed(0); } }
        }
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            height: 24px;
            border-radius: 6px;
            accessible-label: option-1;
            accessible-role: button;
            background: selected == 1 ? Theme.panel2 : (ta1.has-hover ? Theme.hover-bg : transparent);
            // D4: 120ms background transition on hover/select.
            animate background { duration: 120ms; easing: ease-out; }
            if fs.has-focus && selected == 1 : Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                border-radius: 5px; border-width: 2px; border-color: Theme.accent-text;
            }
            Text { width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; text: option-1; font-size: Theme.fs-hint; font-weight: 600; color: selected == 1 ? Theme.sel-text : (ta1.has-hover ? Theme.text : Theme.mute); overflow: elide; }
            ta1 := TouchArea { mouse-cursor: pointer; clicked => { selected-changed(1); } }
        }
        if option-2 != "" : Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            height: 24px;
            border-radius: 6px;
            accessible-label: option-2;
            accessible-role: button;
            background: selected == 2 ? Theme.panel2 : (ta2.has-hover ? Theme.hover-bg : transparent);
            // D4: 120ms background transition on hover/select.
            animate background { duration: 120ms; easing: ease-out; }
            if fs.has-focus && selected == 2 : Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                border-radius: 5px; border-width: 2px; border-color: Theme.accent-text;
            }
            Text { width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; text: option-2; font-size: Theme.fs-hint; font-weight: 600; color: selected == 2 ? Theme.sel-text : (ta2.has-hover ? Theme.text : Theme.mute); overflow: elide; }
            ta2 := TouchArea { mouse-cursor: pointer; clicked => { selected-changed(2); } }
        }
    }
}

// ---------------------------------------------------------------- profile button (§6: name + chevron, orange dot when unsaved)
export component ProfileButton inherits Rectangle {
    in property <string> name;
    in property <bool> unsaved;
    callback clicked();
    accessible-label: name;
    accessible-role: button;
    height: 30px; // not control-height (32px): this lives in the 30px top-bar row.
    border-radius: 8px;
    // P2-6: a long profile name must elide, not push the bell
    // button off-screen at 920 px — the button caps at 220 px and
    // the name Text (stretch, elide) takes what is left.
    max-width: 220px;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent-text : (ta.has-hover ? Theme.faint : Theme.line);
    background: ta.pressed ? Theme.pressed-bg : (ta.has-hover ? Theme.hover-bg : Theme.panel);
    // FIX-4: keyboard activation - Enter/Space acts, like a click.
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                clicked();
                return accept;
            }
            return reject;
        }
    }
    // P1-4: visible 2px focus ring (Switch pattern).
    if fs.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 10px;
        border-width: 2px;
        border-color: Theme.accent-text;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        // UI-UX polish (a): preview `.pf` is align-items:center — the
        // 12px chevron centres against the label in the 30px button.
        cross-axis-alignment: center;
        if unsaved : Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.warn; }
        Text { horizontal-stretch: 1; min-width: 0px; text: name; font-size: Theme.fs-label; font-weight: 600; color: Theme.text; overflow: elide; }
        Image { width: 12px; height: 12px; source: @image-url("../assets/icons/chevron.svg"); }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
}

// ---------------------------------------------------------------- auto-profile chip (§6: "Auto profile  Game → Profile" + pause switch)
export component AutoProfileChip inherits Rectangle {
    in property <string> game-profile;
    in property <bool> paused;
    callback pause-toggled();
    height: 30px; // not control-height (32px): this lives in the 30px top-bar row.
    border-radius: 8px;
    // P2-6: same cap as ProfileButton — a long auto-profile name
    // elides instead of pushing the bell off-screen at 920 px.
    max-width: 300px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.panel;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        // UI-UX polish (a): preview `.chip` is align-items:center —
        // the 7px dot + labels centre against the 20px switch.
        cross-axis-alignment: center;
        Rectangle { width: 7px; height: 7px; border-radius: 4px; background: paused ? Theme.warn : Theme.accent-text; }
        Text { text: "Auto profile"; font-size: Theme.fs-label; color: Theme.mute; }
        Text { horizontal-stretch: 1; min-width: 0px; text: game-profile; font-size: Theme.fs-label; font-weight: 600; color: Theme.text; overflow: elide; }
        Switch { accessible-name: "Pause auto profile"; on: !paused; toggled => { pause-toggled(); } }
    }
}

// ---------------------------------------------------------------- slider + number box (§6: accent slider + 64x28 mono box, typeable)
export component SliderRow inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> value-text;
    in property <float> value;      // 0..1 normalised
    // A6 (v2.0.2): `frac` is the clamped 0..1 fraction — the fill and
    // the thumb both read it, never the raw value, so an out-of-range
    // value can never flip the fill or push the thumb off the track.
    // Fill is ALWAYS min -> thumb (left edge -> thumb centre): at
    // 1.24 on a 1.0..2.0 range the value is 0.24, so the fill is 24%.
    property <float> frac: Math.max(0, Math.min(1, value));
    // Disabled sliders never fire `changed` and render dimmed; the
    // caller shows the short reason (v2.0.1 hotfix: no backend
    // setting for this slider yet).
    in property <bool> disabled: false;
    // D8: why this slider is disabled, shown underneath it in 12px
    // while disabled ("Turn on Acceleration to change this."). Empty
    // means no reason is shown (e.g. transient job disables).
    in property <string> disabled-hint: "";
    callback changed(float);
    callback value-edited(string);
    // DS-63: local edit buffer — the box shows the buffer, which only
    // syncs from value-text when the box is not focused, so a Rust
    // re-sync (slider drag, profile load, per-frame refresh) never
    // clobbers text the user is typing. `text: edit-buffer` is a
    // two-way binding, so typing updates the buffer; the first
    // imperative write replaces the initial `value-text` binding.
    // An empty box is provably invalid: red border + note. On blur
    // the buffer re-syncs — valid input is reformatted canonically
    // ("3" -> "3%"), invalid input reverts to the last good value.
    property <string> edit-buffer: value-text;
    property <bool> edit-invalid: false;
    changed value-text => {
        if (!num.has-focus) {
            edit-buffer = value-text;
            edit-invalid = false;
        }
    }
    spacing: 6px;
    opacity: disabled ? 0.45 : 1;
    // SliderRow v2 (P1, B07): top row is label (elides) + value
    // box; the track sits below; the hint wraps under the track.
    // The old header put label+hint in one column beside the box
    // with no wrap/elide/stretch, so a long hint forced the whole
    // panel wider than its ScrollView and clipped it.
    HorizontalLayout {
        spacing: 8px;
        cross-axis-alignment: center;
        Text { horizontal-stretch: 1; min-width: 0px; text: label; font-size: Theme.fs-label; font-weight: 500; color: Theme.text; overflow: elide; }
        Rectangle {
            width: Theme.value-box-w;
            height: Theme.value-box-h;
            border-radius: Theme.radius-chip;
            border-width: 1px;
            // P1-3: the focus border is the accent text colour —
            // invalid (empty) still wins over focus for the red.
            border-color: edit-invalid ? Theme.bad : num.has-focus ? Theme.accent-text : Theme.line;
            background: Theme.bg;
            // Raw TextInput (not the std LineEdit widget): the Fluent
            // widget hardcodes its own palette and a 160px min-width.
            num := TextInput {
                width: 100%;
                height: 100%;
                horizontal-alignment: right;
                accessible-label: label;
                enabled: !disabled;
                text: edit-buffer;
                font-family: Theme.font-mono;
                font-size: Theme.fs-value;
                font-weight: 500;
                color: Theme.text;
                // P1-5: Up/Down stay in the field, and Return is
                // accepted here too — otherwise it bubbles to the
                // root keyboard scope and triggers Save while the
                // user is typing a value.
                key-pressed(event) => {
                    if (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Return) {
                        return accept;
                    }
                    return reject;
                }
                edited => { edit-invalid = num.text == ""; value-edited(num.text); }
                changed has-focus => {
                    if (!self.has-focus) {
                        edit-buffer = value-text;
                        edit-invalid = false;
                    }
                }
            }
        }
    }
    track := Rectangle {
        height: 20px;
        accessible-label: label;
        accessible-role: slider;
        // FIX-4: keyboard slider - arrows adjust by 5%. Enter/Space are
        // left alone here (Return = Save is handled at the window).
        fs := FocusScope {
            width: 100%;
            height: 100%;
            key-pressed(event) => {
                if (disabled) { return reject; }
                if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                    changed(Math.max(0, value - 0.05));
                    return accept;
                }
                if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                    changed(Math.min(1, value + 0.05));
                    return accept;
                }
                return reject;
            }
        }
        Rectangle {
            y: 8px;
            width: 100%;
            height: 4px;
            border-radius: 2px;
            background: Theme.switch-off;
        }
        // A6: fill starts at the track's left edge (min) and ends at
        // the thumb centre — never on the thumb's right side.
        // NOTE: `x: 0px` is REQUIRED, not cosmetic — Slint centres a
        // child Rectangle with no explicit x, so without it the fill
        // sat centred in the track (at 1.24 / frac 0.24 it lay
        // entirely RIGHT of the thumb — exactly the reported bug).
        Rectangle {
            x: 0px;
            y: 8px;
            width: parent.width * frac;
            height: 4px;
            border-radius: 2px;
            background: ta.has-hover ? Theme.accent-hover : Theme.accent;
        }
        Rectangle {
            // A6: thumb centre sits on frac, clamped so the whole
            // 14px thumb stays inside the track at min AND max
            // (was: x = width*value - 7px, sticking out 7px at both ends).
            property <length> thumb-x: parent.width * frac - 7px;
            x: thumb-x < 0px ? 0px : thumb-x > parent.width - 14px ? parent.width - 14px : thumb-x;
            y: 3px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            border-width: fs.has-focus || ta.has-hover ? 2px : 1px;
            border-color: ta.has-hover ? Theme.accent-text : Theme.accent;
            // P3-3: Light theme — a white thumb on the pale track
            // was invisible; panel2 reads as a thumb there. Dark
            // stays white (visible against the dark track).
            background: Theme.is-light ? Theme.panel2 : white;
        }
        // P2-7: the hit target is 24px tall (±2px past the 20px
        // visual track) — the visual is unchanged.
        ta := TouchArea {
            y: -2px;
            height: parent.height + 4px;
            mouse-cursor: disabled ? MouseCursor.default : MouseCursor.pointer;
            clicked => { if (!disabled) { changed(Math.max(0, Math.min(1, self.mouse-x / track.width))); } }
            moved => { if (self.pressed && !disabled) { changed(Math.max(0, Math.min(1, self.mouse-x / track.width))); } }
        }
    }
    // Hint under the track, wrapping — never a min-width driver.
    if hint != "" : Text { text: hint; font-size: Theme.fs-hint; color: Theme.faint; wrap: word-wrap; }
    // D8: the disabled reason sits under the track, same 12px size.
    if disabled && disabled-hint != "" : Text { text: disabled-hint; font-size: Theme.fs-hint; color: Theme.faint; wrap: word-wrap; }
    // DS-63: empty input is invalid — red border above, one-line note here.
    if edit-invalid : Text { text: "Enter a number."; font-size: Theme.fs-hint; color: Theme.bad; }
}

// ---------------------------------------------------------------- preset chips (§6: Soft / Balanced / Sharp / Custom)
export component PresetChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    accessible-label: label;
    accessible-role: button;
    height: Theme.control-height;
    border-radius: Theme.radius-chip;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent-text : (active ? Theme.accent : (ta.has-hover ? Theme.faint : Theme.line));
    background: active ? Theme.acc-bg : (ta.pressed ? Theme.pressed-bg : ta.has-hover ? Theme.hover-bg : Theme.panel2);
    // D4: 120ms background transition on hover/active.
    animate background { duration: 120ms; easing: ease-out; }
    // FIX-4: keyboard activation - Enter/Space acts, like a click.
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                clicked();
                return accept;
            }
            return reject;
        }
    }
    // P1-4: visible 2px focus ring (Switch pattern).
    if fs.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Theme.radius-chip + 2px;
        border-width: 2px;
        border-color: Theme.accent-text;
    }
    Text {
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: label;
        font-size: Theme.fs-hint;
        font-weight: 600;
        color: active ? Theme.sel-text : (ta.has-hover ? Theme.text : Theme.mute);
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
}

// ---------------------------------------------------------------- curve graph (§6: grid + dashed straight line + accent curve + live marker)
// ViewBox 330x232 (preview Wheel.html): plot x 30..290, y 20..190.
export component CurveGraph inherits VerticalLayout {
    in property <string> title: "Response curve";
    in property <string> subtitle: "Input vs. game output";
    in property <float> input-pct;
    in property <float> output-pct;
    in property <float> marker-vx;
    in property <float> marker-vy;
    in property <string> dashed-line;
    in property <string> crosshair;
    in property <string> curve-commands;
    spacing: 10px;
    HorizontalLayout {
        Text { text: title; font-size: Theme.fs-card; font-weight: 600; color: Theme.text; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: subtitle; font-size: Theme.fs-hint; color: Theme.mute; }
    }
    curve-box := Rectangle {
        height: self.width * 232 / 330;
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 330;
            viewbox-height: 232;
            commands: "M 30 20 L 30 190 M 95 20 L 95 190 M 160 20 L 160 190 M 225 20 L 225 190 M 290 20 L 290 190 M 30 20 L 290 20 M 30 62.5 L 290 62.5 M 30 105 L 290 105 M 30 147.5 L 290 147.5 M 30 190 L 290 190";
            fill: transparent;
            stroke: Theme.line;
            stroke-width: 1px;
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 330;
            viewbox-height: 232;
            commands: dashed-line;
            fill: transparent;
            stroke: Theme.grid-line;
            stroke-width: 1.5px;
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 330;
            viewbox-height: 232;
            commands: curve-commands;
            fill: transparent;
            stroke: Theme.accent;
            stroke-width: 3px;
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 330;
            viewbox-height: 232;
            commands: crosshair;
            fill: transparent;
            stroke: Theme.accent-text;
            stroke-width: 1px;
        }
        Rectangle {
            x: curve-box.width * marker-vx / 330 - 6px;
            y: curve-box.height * marker-vy / 232 - 6px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            border-width: 3px;
            border-color: Theme.accent-text;
            background: Theme.bg;
        }
        Text { x: curve-box.width * 30 / 330 - 10px; y: curve-box.height * 196 / 232; width: 20px; horizontal-alignment: center; text: "0"; font-size: Theme.fs-hint; color: Theme.faint; }
        Text { x: curve-box.width * 160 / 330 - 10px; y: curve-box.height * 196 / 232; width: 20px; horizontal-alignment: center; text: "50"; font-size: Theme.fs-hint; color: Theme.faint; }
        // "100%" is 4 glyphs (~29px at 12px font) — a 30px box fits it; a
        // 20px box clipped it to "100:" (compare-fix). 30px centred on the 290 tick.
        Text { x: curve-box.width * 290 / 330 - 15px; y: curve-box.height * 196 / 232; width: 30px; horizontal-alignment: center; text: "100%"; font-size: Theme.fs-hint; color: Theme.faint; }
        Text { x: curve-box.width * 24 / 330 - 26px; y: curve-box.height * 183 / 232; width: 26px; horizontal-alignment: right; text: "0"; font-size: Theme.fs-hint; color: Theme.faint; }
        Text { x: curve-box.width * 24 / 330 - 26px; y: curve-box.height * 99 / 232; width: 26px; horizontal-alignment: right; text: "50"; font-size: Theme.fs-hint; color: Theme.faint; }
        Text { x: curve-box.width * 24 / 330 - 26px; y: curve-box.height * 14 / 232; width: 26px; horizontal-alignment: right; text: "100"; font-size: Theme.fs-hint; color: Theme.faint; }
        Text { x: curve-box.width * 160 / 330 - 40px; y: curve-box.height * 214 / 232; width: 80px; horizontal-alignment: center; text: "Wheel input"; font-size: Theme.fs-hint; color: Theme.faint; }
    }
    HorizontalLayout {
        spacing: 20px;
        HorizontalLayout {
            spacing: 4px;
            Text { text: "Input"; font-size: Theme.fs-hint; color: Theme.mute; }
            Text { text: Math.round(input-pct) + "%"; font-family: Theme.font-mono; font-size: Theme.fs-value; font-weight: 600; color: Theme.text; }
        }
        HorizontalLayout {
            spacing: 4px;
            Text { text: "Output"; font-size: Theme.fs-hint; color: Theme.mute; }
            Text { text: Math.round(output-pct) + "%"; font-family: Theme.font-mono; font-size: Theme.fs-value; font-weight: 600; color: Theme.text; }
        }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: 6px;
            // UI-UX polish (a): the 2px dashed swatch centres against
            // the "Straight line" label instead of top-aligning.
            cross-axis-alignment: center;
            Path {
                width: 22px;
                height: 2px;
                viewbox-width: 22;
                viewbox-height: 2;
                commands: "M 0 1 L 4 1 M 8 1 L 12 1 M 16 1 L 20 1";
                fill: transparent;
                stroke: Theme.grid-line;
                stroke-width: 2px;
            }
            Text { text: "Straight line"; font-size: Theme.fs-hint; color: Theme.mute; }
        }
    }
}

// ---------------------------------------------------------------- pedal bars (§6: vertical 16px; throttle ok, brake bad, clutch accent)
export component PedalBar inherits VerticalLayout {
    in property <float> pct;
    in property <color> bar-color;
    in property <string> label;
    spacing: 6px;
    Rectangle {
        width: 16px;
        height: 92px;
        border-radius: 8px;
        background: Theme.track;
        clip: true;
        Rectangle {
            width: 16px;
            height: parent.height * pct / 100;
            y: parent.height - self.height;
            border-radius: 8px;
            background: bar-color;
        }
    }
    Text {
        horizontal-alignment: center;
        text: Math.round(pct) + "%";
        font-family: Theme.font-mono;
        font-size: Theme.fs-value;
        font-weight: 600;
        color: Theme.text;
    }
    Text {
        horizontal-alignment: center;
        text: label;
        font-size: Theme.fs-hint;
        color: Theme.mute;
    }
}

// Horizontal pedal bar (§6: 6-8px, tray + diagnostics)
export component HBar inherits HorizontalLayout {
    in property <string> label;
    in property <float> pct;
    in property <color> bar-color;
    spacing: 8px;
    // UI-UX polish (a): the 6px bar centres against the labels —
    // without this it top-aligns in the ~16px row and reads as a
    // line above the text instead of a bar beside it.
    cross-axis-alignment: center;
    Text {
        // B18: 46px clipped "Throttle" at the 12px minimum font.
        width: 56px;
        text: label;
        font-size: Theme.fs-hint;
        color: Theme.mute;
    }
    Rectangle {
        horizontal-stretch: 1;
        height: 6px;
        border-radius: 3px;
        background: Theme.track;
        clip: true;
        Rectangle {
            // A6-family: explicit x: 0px — a child Rectangle with no
            // x is centred by Slint, so without this the bar filled
            // from the middle outwards instead of from the left.
            x: 0px;
            width: parent.width * pct / 100;
            height: 6px;
            border-radius: 3px;
            background: bar-color;
        }
    }
    Text {
        width: 30px;
        horizontal-alignment: right;
        text: Math.round(pct) + "%";
        font-family: Theme.font-mono;
        font-size: Theme.fs-value;
        color: Theme.text;
    }
}

// ---------------------------------------------------------------- range block (§6: "Pedal up / Pedal down" + Set buttons)
export component RangeBlock inherits VerticalLayout {
    in property <string> up-label: "Pedal up";
    in property <string> down-label: "Pedal down";
    in property <string> up-value;
    in property <string> down-value;
    // Disabled when the calibration backend is unavailable (v2.0.1
    // hotfix); the caller shows the reason.
    in property <bool> up-disabled: false;
    in property <bool> down-disabled: false;
    callback set-up();
    callback set-down();
    spacing: 8px;
    HorizontalLayout { cross-axis-alignment: center;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            Text { text: up-label; font-size: Theme.fs-hint; color: Theme.mute; }
            Text { text: up-value; font-family: Theme.font-mono; font-size: Theme.fs-value; font-weight: 600; color: Theme.text; }
        }
        Btn { label: "Set up"; disabled: up-disabled; clicked => { set-up(); } }
    }
    HorizontalLayout { cross-axis-alignment: center;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            Text { text: down-label; font-size: Theme.fs-hint; color: Theme.mute; }
            Text { text: down-value; font-family: Theme.font-mono; font-size: Theme.fs-value; font-weight: 600; color: Theme.text; }
        }
        Btn { label: "Set down"; disabled: down-disabled; clicked => { set-down(); } }
    }
}

// ---------------------------------------------------------------- button tile (§6: BUTTON n + action; normal / selected / live pressed / not set)
export component ButtonTile inherits Rectangle {
    in property <string> label;
    in property <string> action;
    in property <bool> selected;
    in property <bool> pressed;
    in property <bool> not-set;
    callback clicked();
    accessible-label: label + ": " + action;
    accessible-role: button;
    height: 52px;
    border-radius: 10px;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent-text : (selected ? Theme.accent : (ta.has-hover ? Theme.faint : Theme.line));
    background: pressed ? Theme.ok-bg : (selected ? Theme.acc-bg : (ta.pressed ? Theme.pressed-bg : ta.has-hover ? Theme.hover-bg : Theme.panel2));
    // FIX-4: keyboard activation - Enter/Space acts, like a click.
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                clicked();
                return accept;
            }
            return reject;
        }
    }
    VerticalLayout {
        padding-left: 10px;
        padding-top: 8px;
        spacing: 1px;
        Text { text: label; font-size: Theme.fs-hint; font-weight: 600; color: Theme.mute; }
        Text { text: action; font-size: Theme.fs-value; font-weight: 600; color: not-set ? Theme.mute : Theme.text; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { clicked(); } }
}

// ---------------------------------------------------------------- game tile (§6: icon square + name + profile + status pill + Launch/Stop/Locate)
export component GameTile inherits Rectangle {
    in property <string> code;
    in property <string> name;
    in property <string> sub;
    in property <bool> sub-warn;
    in property <string> action;
    in property <bool> action-primary;
    // DS-54: the action button disables + dims while its job runs
    // (Overview binds this to busy-kind == 13, GameOp).
    in property <bool> action-disabled: false;
    callback action-clicked();
    // Manual games (no auto-scan): small Edit / Remove affordances
    // next to the Launch/Stop button — text links, like the
    // Overview diagnostics link, so the tile stays one row tall.
    callback edit-clicked();
    callback remove-clicked();
    // P3-7: tap-to-expand for the game name — a long name is
    // capped at two lines by default; tapping it shows the full
    // name (the tile grows; the grid row follows).
    property <bool> name-expanded: false;
    // Phase 2 (F-8): clip so the Launch button can never paint
    // outside the tile when the name squeezes the row.
    clip: true;
    border-radius: 10px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.faint : Theme.line;
    background: ta.has-hover ? Theme.hover-bg : Theme.panel2;
    // A5: the tile itself is not clickable (only its action button
    // is), so this TouchArea only reports hover — it sits behind the
    // content, so the inner Btn still gets its own clicks.
    ta := TouchArea { }
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        // UI-UX polish (a): preview `.tile` is align-items:center —
        // the 34px icon + text block centre against the 30px button.
        cross-axis-alignment: center;
        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: Theme.panel;
            Text {
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: code;
                font-size: Theme.fs-value;
                font-weight: 700;
                color: Theme.accent-text;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            // UI-9 (v2.0.12): the name and sub elide at two lines
            // max — a long game name used to wrap without limit and
            // stretch its whole grid row. The caps are two lines at
            // the token sizes (fs-label 13 px / fs-hint 12 px, ~17 px
            // and ~16 px a line); `overflow: elide` puts the "…"
            // on the last visible line. The tile clips, so nothing
            // can paint outside it.
            Text {
                text: name;
                font-size: Theme.fs-label;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
                overflow: elide;
                // P3-7: capped at two lines until tapped (above).
                max-height: name-expanded ? 1000px : 34px;
                TouchArea { width: 100%; height: 100%; mouse-cursor: pointer; clicked => { name-expanded = !name-expanded; } }
            }
            Text {
                text: sub;
                font-size: Theme.fs-hint;
                color: sub-warn ? Theme.warn : Theme.mute;
                wrap: word-wrap;
                overflow: elide;
                max-height: 32px;
            }
        }
        // Edit / Remove links (manual games): text links with the
        // same keyboard activation as the diagnostics link.
        // P2-5: 8px spacing (was 4px) so the ±4px TouchArea
        // extensions below meet without overlapping.
        VerticalLayout {
            spacing: 8px;
            Text {
                text: "Edit";
                font-size: Theme.fs-hint;
                font-weight: 600;
                color: edit-fs.has-focus || edit-ta.has-hover ? Theme.text : Theme.accent-text;
                accessible-label: "Edit " + name;
                accessible-role: button;
                // P2-5: the FocusScope + TouchArea extend 4px
                // above/below the text (see "Open diagnostics").
                edit-fs := FocusScope {
                    y: -4px;
                    width: 100%;
                    height: parent.height + 8px;
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Space) {
                            edit-clicked();
                            return accept;
                        }
                        return reject;
                    }
                }
                // P1-4: visible focus ring (About link pattern).
                if edit-fs.has-focus : Rectangle {
                    x: -6px;
                    y: -3px;
                    width: parent.width + 12px;
                    height: parent.height + 6px;
                    border-radius: 6px;
                    border-width: 2px;
                    border-color: Theme.accent-text;
                }
                edit-ta := TouchArea { y: -4px; width: 100%; height: parent.height + 8px; mouse-cursor: pointer; clicked => { edit-clicked(); } }
            }
            Text {
                text: "Remove";
                font-size: Theme.fs-hint;
                font-weight: 600;
                color: remove-fs.has-focus || remove-ta.has-hover ? Theme.text : Theme.mute;
                accessible-label: "Remove " + name;
                accessible-role: button;
                remove-fs := FocusScope {
                    y: -4px;
                    width: 100%;
                    height: parent.height + 8px;
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Space) {
                            remove-clicked();
                            return accept;
                        }
                        return reject;
                    }
                }
                // P1-4: visible focus ring (About link pattern).
                if remove-fs.has-focus : Rectangle {
                    x: -6px;
                    y: -3px;
                    width: parent.width + 12px;
                    height: parent.height + 6px;
                    border-radius: 6px;
                    border-width: 2px;
                    border-color: Theme.accent-text;
                }
                remove-ta := TouchArea { y: -4px; width: 100%; height: parent.height + 8px; mouse-cursor: pointer; clicked => { remove-clicked(); } }
            }
        }
        // No action for "Not installed" games (A14): an empty action
        // hides the button entirely instead of a fake Locate button.
        if action != "" : Btn { label: action; primary: action-primary; disabled: action-disabled; clicked => { action-clicked(); } }
    }
}

// ---------------------------------------------------------------- checklist row (§6: green tick circle + text + right hint)
export component CheckRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> warn;
    height: 26px;
    HorizontalLayout {
        // P3-1: 8px spacing (was 9px) — the token grid is 4/8/12/16.
        spacing: 8px;
        // UI-UX polish (a): preview `.chk` is align-items:center —
        // the 18px tick centres against the label in the 26px row.
        cross-axis-alignment: center;
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: warn ? Theme.warn-bg : Theme.check-bg;
            // D12: the tick is an SVG, not the "✓" text glyph.
            if !warn : Image {
                x: 3px;
                y: 3px;
                width: 12px;
                height: 12px;
                source: @image-url("../assets/icons/check.svg");
                colorize: Theme.ok;
            }
            // D12: the warn mark is an SVG, not the "!" text glyph.
            if warn : Image {
                x: 3px;
                y: 3px;
                width: 12px;
                height: 12px;
                source: @image-url("../assets/icons/alert-triangle.svg");
                colorize: Theme.warn;
            }
        }
        Text {
            vertical-alignment: center;
            text: label;
            font-size: Theme.fs-label;
            color: Theme.text;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            vertical-alignment: center;
            text: hint;
            font-size: Theme.fs-hint;
            color: Theme.mute;
        }
    }
}

// ---------------------------------------------------------------- radio option card (§6: game controller choice)
export component RadioOptionCard inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <bool> selected;
    // DS-54: disabled cards never fire `clicked` and render dimmed
    // (same contract as Btn) — the backend switch dims while its
    // job runs.
    in property <bool> disabled: false;
    callback clicked();
    accessible-label: title;
    accessible-role: radio-button;
    height: 64px;
    border-radius: 10px;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent-text : (selected ? Theme.accent : (!disabled && ta.has-hover ? Theme.faint : Theme.line));
    background: selected ? Theme.acc-bg : (!disabled && ta.pressed ? Theme.pressed-bg : !disabled && ta.has-hover ? Theme.hover-bg : Theme.panel2);
    opacity: disabled ? 0.45 : 1;
    // FIX-4: keyboard activation - Enter/Space acts, like a click.
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (disabled) { return reject; }
            if (event.text == Key.Return || event.text == Key.Space) {
                clicked();
                return accept;
            }
            return reject;
        }
    }
    // P1-4: visible 2px focus ring (Switch pattern).
    if fs.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 12px;
        border-width: 2px;
        border-color: Theme.accent-text;
    }
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        // UI-UX polish (a): preview `.opt` is align-items:flex-start —
        // the 18px radio stays at the top against the two-line text,
        // matching the preview (deliberately NOT centred here).
        cross-axis-alignment: start;
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 9px;
            border-width: 2px;
            border-color: selected ? Theme.accent : Theme.faint;
            background: transparent;
            Rectangle {
                x: 3px;
                y: 3px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: selected ? Theme.accent : transparent;
            }
        }
        VerticalLayout {
            spacing: 1px;
            Text { text: title; font-size: Theme.fs-label; font-weight: 600; color: Theme.text; }
            Text { text: desc; font-size: Theme.fs-hint; color: Theme.mute; wrap: word-wrap; }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { if (!disabled) { clicked(); } } }
}

// ---------------------------------------------------------------- empty / error banner (§6: one line + one action button)
export component EmptyBanner inherits Rectangle {
    in property <string> text;
    in property <string> action-label: "";
    in property <bool> is-error;
    // DS-54: the action button disables + dims while its job runs
    // (Overview binds this to the banner's job kind: Reconnect 0).
    in property <bool> action-disabled: false;
    // P2-12: why the action is disabled ("Reconnecting…") — shown
    // next to the button instead of a silently dead one.
    in property <string> action-disabled-text: "";
    // D2: optional 16px icon on the action button (Reconnect).
    in property <image> action-icon;
    in property <bool> action-has-icon: false;
    callback action-clicked();
    // DS-21 (U-03): was a fixed 36 px with no wrapping, so long
    // strings (the ~100-char Overview banners, unbounded
    // daemon-error text) were cut off mid-sentence with no way to
    // read them. The text wraps now and the banner grows with it.
    // B03: 46px minimum — a 30px button + 8px padding top/bottom —
    // and the row is vertically centred, so the button never sits
    // on the border.
    min-height: 46px;
    border-radius: 8px;
    border-width: 1px;
    border-color: is-error ? Theme.bad : Theme.line;
    background: is-error ? Theme.err-bg : Theme.panel2;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        cross-axis-alignment: center;
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            wrap: word-wrap;
            text: text;
            font-size: Theme.fs-hint;
            color: is-error ? Theme.bad : Theme.mute;
        }
        if action-label != "" && action-disabled && action-disabled-text != "" : Text { vertical-alignment: center; text: action-disabled-text; font-size: Theme.fs-hint; color: Theme.mute; }
        if action-label != "" : Btn { label: action-label; icon: action-icon; has-icon: action-has-icon; disabled: action-disabled; clicked => { action-clicked(); } }
    }
}

// ---------------------------------------------------------------- wheel graphic (rotates with steer angle; Rectangle has no
// rotation in Slint 1.18, so the wheel is one SVG image rotated as a whole)
export component WheelGraphic inherits Rectangle {
    in property <angle> steer-angle;
    in property <length> size: 112px;
    width: size;
    height: size;
    Image {
        width: size;
        height: size;
        source: @image-url("../assets/icons/wheel-large.svg");
        transform-rotation: steer-angle;
        transform-origin: { x: size / 2, y: size / 2 };
    }
}
