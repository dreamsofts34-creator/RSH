// RSH v2.0 — Phase 3 main window (REDESIGN-PLAN §3-§5).
// 920x580 window, 184px sidebar, 56px top bar. Fonts embedded at compile
// time (Inter + JetBrains Mono, OFL). The tray icon/menu live in the
// daemon (crates/rsh-daemon/ui/tray.slint) — this crate owns only the main
// app window. Data comes from the Rust side through the rsh-api surface
// (live daemon IPC when the background service runs, SimApi fallback
// otherwise — never fake live data: see src/sim_api.rs).
//
// v2.0.1 hotfix: the window owns every live value as a Rust-driven
// prop — pedals (mV/feel/deadzone from get_tuning), buttons (12 actions
// + selected action), Extras (screens/extras.slint, wired to
// set_tuning), the profile popover (real list_profiles), the wizard
// Drivers step (vJoy status/install/fallback) and the diagnostics
// drawer (live charts from Rust ring buffers, measured stats from
// diag_stats() — "—" while the service does not measure). Nothing is
// hardcoded live-looking any more: no daemon means Disconnected + "—",
import "../assets/Inter.ttf";
import "../assets/JetBrainsMono.ttf";
import { Theme } from "tokens.slint";
import { SegmentedControl, ProfileButton, AutoProfileChip, Btn, Pill } from "components.slint";
import { Sidebar, AboutPage } from "shell.slint";
import { OverviewPage, GameItem } from "screens/overview.slint";
import { SteeringPage } from "screens/steering.slint";
import { PedalsPage } from "screens/pedals.slint";
import { ButtonsPage } from "screens/buttons.slint";
import { ExtrasScreen } from "screens/extras.slint";
import { ProfilePopover, ProfileItem } from "screens/profile_popover.slint";
import { GameDialog } from "screens/game_dialog.slint";
// Compare-fix: the full Settings screen (screens/settings.slint)
// replaces the shell placeholder — Reconnect, connect-hint text,
// Duplicate/Use, Restore and per-item Check buttons only exist there.
// SetupWizard likewise replaces the shell layout while setup runs.
import { SettingsScreen, ProfileRow } from "screens/settings.slint";
import { SetupWizard } from "screens/setup.slint";
import { DiagnosticsDrawer } from "screens/diagnostics.slint";
import { BellButton, NotificationsDrawer, NotificationItem } from "notifications.slint";

export component MainWindow inherits Window {
    title: "RSH — Real Sim Hub";
    icon: @image-url("../assets/tray.png");
    preferred-width: Theme.window-width;
    preferred-height: Theme.window-height;
    // min-width MUST equal the design width (920px). Slint opens the window
    // at the content's preferred size clamped to [min-width, preferred-width],
    // so min-width 840px opened narrow pages at 840px (audit FIX-1: Extras/
    // Settings windows measured 839px, right edge clipped). The window can
    // still be enlarged; it just never opens (or shrinks) below the design.
    min-width: 920px;
    min-height: 580px;
    background: Theme.bg;
    // A8 (v2.0.2): the window theme drives the global tokens — the
    // whole UI repaints when it changes. `theme` is the RESOLVED
    // value only (0 Dark / 1 Light) — it never holds 2, so Auto
    // never flashes the UI dark (R2-31). The stored choice
    // (0/1/2) lives in `theme-choice` below, which is what the
    // Settings segment binds to.
    // (A `Theme.mode: theme;` binding is not valid Slint — globals
    // are written from code, so the change handler does it.)
    changed theme => { Theme.mode = theme; }
    default-font-family: Theme.font-text;
    default-font-size: 13px;

    in-out property <int> page: 0; // 0 Overview, 1 Steering, 2 Pedals, 3 Buttons, 4 Extras, 5 Settings, 6 About
    in-out property <bool> send-to-game: true;
    in-out property <bool> advanced: false;
    in-out property <bool> unsaved: false;
    in-out property <bool> auto-paused: false;
    in-out property <int> transport: 0;   // 0 Wi-Fi, 1 USB
    in-out property <int> controller: 1;  // 0 HIDMaestro, 1 vJoy (vJoy is the default, user order 2026-11-16)
    in-out property <int> theme: 0;       // Resolved window theme: 0 Dark, 1 Light (never 2 — R2-31). Drives Theme.mode.
    // R2-31: the STORED theme choice (0 Dark, 1 Light, 2 Auto) —
    // this is what the Settings segment shows and what theme-persist
    // stores. `theme` above stays the RESOLVED 0/1 the Rust side
    // writes after resolving Auto against the OS; it alone drives
    // Theme.mode. Rust sets both in wire_theme.
    in-out property <int> theme-choice: 0;
    in-out property <int> pressed-index: -1;
    in-out property <int> selected-index: 5; // A4: index 5 = "Gear 3" (preview), not 0
    in property <[string]> button-actions: ["Shift up", "Shift down", "Horn", "Gear 1", "Gear 2", "Gear 3", "Gear 4", "Gear 5", "Gear 6", "Handbrake", "Not set", "Not set"];
    in property <string> selected-action: "Gear 3";
    in property <string> knob-row-action: "Gear 1";
    in property <bool> buttons-listening: false;
    in property <string> profile-name: "GT3 Sprint";
    in property <string> auto-profile-text: "No profile yet";
    in property <string> app-version: "2.0.7";
    in property <bool> daemon-live: false;
    // B5 (v2.0.2): the global busy strip reads these — Rust drives
    // them from busy_jobs (each start_*_job records its label, the
    // 1 Hz frame timer clears them); an empty label renders "Working…".
    in property <bool> busy: false;
    in property <string> busy-label: "";
    // DS-54: which job kind the strip shows, as a JobKind::order
    // value (-1 = idle) — screens disable + dim the button that
    // started it while its job runs.
    in property <int> busy-kind: -1;
    // F27 (v2.0.3): true while the window is hidden to tray —
    // the busy spinner's Timer stops (see below), so no redraw
    // is scheduled on the hidden window. Set from Rust in the
    // close handler, cleared on show (`apply_page_request`).
    in property <bool> window-hidden: false;
    // M-2 (v2.0.2): the specific fatal reason from
    // read_daemon_status() (daemon-status.json) — empty while there
    // is none; the Overview shows it as an error banner instead of
    // the generic "not running" line. Set from Rust (mark_dead / sync).
    in property <string> daemon-error: "";
    // DS-24 (U-06): transient in-place failure toast — every
    // `notify_error` also surfaces here for ~5 s, so a failure is
    // visible on the current screen without opening the bell drawer
    // (the full text stays in the drawer). `in-out` so the toast's
    // own click-to-dismiss can clear it; Rust clears it on expiry
    // (1 Hz tick). Empty = hidden.
    in-out property <string> toast-title: "";
    in-out property <string> toast-text: "";
    // D17: "error" (error-accent border) or "success" (ok-accent
    // border) — same 480 px card, set by Rust's set_toast /
    // set_toast_success. Empty toast-text hides the card.
    in-out property <string> toast-kind: "error";
    // B5 spinner step (0..11, driven by the strip's Timer).
    property <int> spin-step: 0;
    in property <bool> connected: true;
    in property <string> conn-label: "Disconnected";
    in property <string> conn-sub: "Not connected";
    in property <angle> steer-angle;
    in property <string> steer-text;
    in property <float> throttle;
    in property <float> brake;
    in property <float> clutch;
    in property <float> handbrake: 0;
    in property <string> gear: "—";
    in property <float> input-pct;
    in property <float> output-pct;
    in property <float> marker-vx;
    in property <float> marker-vy;
    in property <string> dashed-line;
    in property <string> crosshair;
    in property <string> curve-commands;
    in property <float> deadzone;
    in property <string> deadzone-text;
    in property <float> curve-val;
    in property <string> curve-text;
    in property <int> preset;
    // Steering Advanced (Bug 7): invert + lock + smoothing — the
    // old centre/raw-mV readouts are gone (steering.slint).
    in property <bool> steer-invert: false;
    in property <float> steer-lock: 1.0;
    in property <string> steer-lock-text: "900°";
    in property <float> steer-smoothing: 0.3;
    in property <string> steer-smoothing-text: "30%";
    // Encoder tuning (E1/E2): pulse length + steps per click, on the
    // Buttons page (rotary knobs live there, not in a module of
    // their own) — from get_tuning("encoders"), never literals.
    in property <float> enc-pulse-ms: 50.0;
    in property <string> enc-pulse-text: "50 ms";
    in property <int> enc-counts: 4;
    in property <string> throttle-raw-mv-text: "—";
    in property <string> brake-raw-mv-text: "—";
    in property <string> clutch-raw-mv-text: "—";
    // Steering centre (A22): pill only once set; button disabled
    // while the calibration backend is unavailable.
    in property <bool> centre-set: false;
    in property <bool> centre-available: false;
    in property <string> centre-reason: "RSH isn't running — reconnect to capture.";
    // Pedals (A1/A2): mV / feel / deadzone / curve / marker from Rust
    // (get_tuning), refreshed on startup, on swap-to-live and after
    // every pedal edit — never literals.
    in property <string> throttle-up-mv: "—";
    in property <string> throttle-down-mv: "—";
    in property <int> throttle-feel: 0;
    in property <float> throttle-deadzone: 0;
    in property <string> throttle-deadzone-text: "—";
    in property <string> throttle-curve: "M 6 104 L 104 6";
    in property <string> throttle-dashed: "M 6 104 L 104 6";
    in property <float> throttle-marker-x: 6;
    in property <float> throttle-marker-y: 104;
    in property <string> brake-up-mv: "—";
    in property <string> brake-down-mv: "—";
    in property <int> brake-feel: 0;
    in property <float> brake-deadzone: 0;
    in property <string> brake-deadzone-text: "—";
    in property <string> brake-curve: "M 6 104 L 104 6";
    in property <string> brake-dashed: "M 6 104 L 104 6";
    in property <float> brake-marker-x: 6;
    in property <float> brake-marker-y: 104;
    in property <string> clutch-up-mv: "—";
    in property <string> clutch-down-mv: "—";
    in property <int> clutch-feel: 0;
    in property <float> clutch-deadzone: 0;
    in property <string> clutch-deadzone-text: "—";
    in property <float> clutch-bite: 0;
    in property <string> clutch-bite-text: "—";
    in property <string> clutch-curve: "M 6 104 L 104 6";
    in property <string> clutch-dashed: "";
    in property <float> clutch-marker-x: 6;
    in property <float> clutch-marker-y: 104;
    in property <bool> pedal-set-disabled: true;
    // Extras (A6/A7): wired to set_tuning fields; "—" / 0 until the
    // wheel reports a value.
    in property <string> handbrake-up-mv: "—";
    in property <string> handbrake-down-mv: "—";
    in property <int> handbrake-feel: 0;
    in property <float> handbrake-deadzone: 0;
    in property <string> handbrake-deadzone-text: "—";
    in property <string> handbrake-curve: "M 6 104 L 104 6";
    in property <string> handbrake-dashed: "M 6 104 L 104 6";
    in property <float> handbrake-marker-x: 6;
    in property <float> handbrake-marker-y: 104;
    in property <int> handbrake-mode: 0;
    in property <bool> handbrake-pressed: false;
    in property <bool> extras-calibration-disabled: true;
    in property <int> shifter-mode: 0;
    in property <string> horn-button: "Not set";
    in property <bool> horn-learning: false;
    in property <bool> horn-pressed: false;
    in property <int> led-pattern: 1;
    in property <float> led-brightness: 0.8;
    in property <string> led-brightness-text: "—";
    in property <int> led-color: 3;
    in property <[color]> led-preview;
    // Overview live values (A11/A12/A14): "—" until telemetry lands.
    in property <string> firmware-line: "—";
    in property <string> delay-text: "—";
    in property <string> jitter-text: "—";
    in property <string> lost-text: "—";
    in property <string> calibrated-label: "Not calibrated";
    in property <bool> calibrated-warn: true;
    in property <string> backend-name: "—";
    in property <bool> backend-ready: false;
    in property <[GameItem]> games;
    // Settings live values (A9/A10/C3/C6): seeded from the API.
    in-out property <bool> autostart-enabled: false;
    // M-7 (v2.0.2): two-way — Rust reads keep-in-tray for the close
    // handler and writes it back when set_close_to_tray fails, so the
    // switch never lies about the real state. Same for the Extras
    // module switches: Rust tracks the intended state in
    // module_states and reverts the prop on a failed toggle.
    in-out property <bool> keep-in-tray: true;
    in-out property <bool> extras-handbrake-on: true;
    in-out property <bool> extras-shifter-on: true;
    in-out property <bool> extras-horn-on: true;
    in-out property <bool> extras-leds-on: true;
    in property <string> firmware-text: "—";
    in property <string> app-update-text: "Auto-update is off — new versions are on GitHub Releases";
    in property <string> backup-text: "No backups yet";
    in property <[ProfileRow]> settings-profiles;
    // D19: Wi-Fi password state (Settings "Connection" card).
    in property <bool> wifi-password-set: false;
    in property <string> wifi-password-error: "";
    in property <string> wifi-password-message: "";
    in property <bool> wifi-password-busy: false;
    in-out property <string> wifi-password-new: "";
    in-out property <string> wifi-password-confirm: "";
    callback set-wifi-password();
    callback forget-wifi-password();
    // Profile popover (A8): Rust-owned model, opened from the top-bar
    // ProfileButton and the Overview profile box.
    in-out property <bool> popover-open: false;
    // Add/edit game dialog (manual games, no auto-scan): Rust-owned
    // model, opened from the Overview / wizard Add game buttons.
    in-out property <bool> game-dialog-open: false;
    in property <string> game-dialog-title: "Add game";
    in-out property <string> game-dialog-name: "";
    in-out property <string> game-dialog-exe: "";
    in property <string> game-dialog-profile-name: "No profile";
    in property <[ProfileItem]> popover-presets;
    in property <[ProfileItem]> popover-profiles;
    in property <bool> popover-show-prompt: false;
    in property <string> popover-pending-name: "";
    // Notification center (Phase 6): bell badge + drawer model.
    in-out property <bool> notif-open: false;
    in-out property <int> notif-unread: 0;
    in-out property <[NotificationItem]> notifications;
    // Setup wizard (compare-fix): shown instead of the shell layout
    // while first-time setup runs; --page setup opens it (main.rs).
    in-out property <bool> setup-mode: false;
    in-out property <int> setup-step: 0; // A15: setup starts at Connect
    // Wizard live state (v2.0.1 hotfix): Rust drives these from the
    // AppApi — connect-done from the live connection's reachability
    // (D15: board_reachable latch or Active — LinkUp alone does
    // not prove the board is there), centre/pedals-done from the
    // calibration backend, drivers from vjoy_status().
    in-out property <bool> setup-connect-done: false;
    // R2-19: why step 0 cannot advance (connection-error hint, or
    // "RSH isn't running" while the daemon is down) — shown on the
    // Connect step, which used to show no error at all.
    in-out property <string> setup-connect-hint: "";
    in-out property <bool> setup-centre-done: false;
    in-out property <bool> setup-pedals-done: false;
    in-out property <int> setup-transport: 0; // 0 Wi-Fi, 1 USB
    in-out property <bool> setup-wifi-joined: false;
    in-out property <bool> setup-usb-available: false;
    // D16: Wi-Fi scan/join state for Step 1 (the card performs the
    // join via the daemon) + vJoy install progress for Step 2
    // (-1 = indeterminate, `setup-vjoy-elapsed` carries "m:ss")
    // + live pedal levels for the Calibrate step's pedal graphs.
    in-out property <string> setup-wifi-ssid: "";
    in-out property <bool> setup-wifi-joining: false;
    in-out property <string> setup-wifi-error: "";
    in-out property <int> setup-vjoy-progress: -1;
    in-out property <string> setup-vjoy-elapsed: "";
    in-out property <float> setup-live-throttle: 0;
    in-out property <float> setup-live-brake: 0;
    in-out property <float> setup-live-clutch: 0;
    // L-2 (v2.0.2): live board address from connection().address —
    // Rust sets this in sync_overview (where the address is already
    // computed); empty/unknown renders as "—" in the wizard.
    in-out property <string> setup-address: "";
    in-out property <string> setup-games-text: "No games added yet.";
    in-out property <bool> setup-games-done: false;
    in-out property <bool> setup-vjoy-installed: false;
    in-out property <bool> setup-vjoy-installing: false;
    in-out property <string> setup-vjoy-version: "";
    in-out property <string> setup-vjoy-error: "";
    in-out property <bool> setup-vjoy-fallback: false;
    in-out property <bool> setup-calibration-available: false;
    in-out property <string> setup-calibration-reason: "RSH isn't running — reconnect to capture.";
    // Diagnostics drawer (v2.0.1 hotfix): right-edge overlay like the
    // notifications drawer; Rust syncs these values when it opens.
    in-out property <bool> diag-open: false;
    in-out property <string> diag-conn-label: "Disconnected";
    in-out property <bool> diag-daemon-live: false;
    in-out property <string> diag-app-version: "";
    in-out property <string> diag-firmware: "";
    in-out property <[string]> diag-events;
    in-out property <string> diag-steer-chart: "";
    in-out property <string> diag-pedals-chart: "";
    in-out property <string> diag-steer-readout: "—";
    in-out property <string> diag-pedals-readout: "—";
    in-out property <string> diag-delay-text: "—";
    in-out property <string> diag-jitter-text: "—";
    in-out property <string> diag-lost-text: "—";
    in-out property <string> diag-loop-rate-text: "—";
    in-out property <string> diag-tx-failures-text: "—";
    in-out property <string> diag-seq-gaps-text: "—";
    in-out property <string> diag-frame-p50-text: "—";
    in-out property <string> diag-frame-p99-text: "—";
    // R2-46: paint-completion p50/p99 (refresh start to Slint
    // AfterRendering) — "—" until a paint is observed.
    in-out property <string> diag-paint-p50-text: "—";
    in-out property <string> diag-paint-p99-text: "—";
    in-out property <string> diag-ipc-p50-text: "—";
    in-out property <string> diag-ipc-p99-text: "—";
    in-out property <[bool]> diag-buttons-pressed;

    callback toggled-send();
    callback reconnect();
    callback deadzone-changed(float);
    callback curve-changed(float);
    callback deadzone-edited(string);
    callback curve-edited(string);
    callback invert-changed(bool);
    callback lock-changed(float);
    callback lock-edited(string);
    callback smoothing-changed(float);
    callback smoothing-edited(string);
    callback preset-selected(int);
    callback reset-defaults();
    callback set-centre();
    callback save-profile();
    callback profile-clicked();
    callback launch-game(string);
    callback pedal-set-up(int);
    callback pedal-set-down(int);
    callback pedal-feel-selected(int, int);
    callback pedal-deadzone-changed(int, float);
    callback pedal-deadzone-edited(int, string);
    callback pedal-bite-changed(float);
    callback pedal-bite-edited(string);
    callback knob-selected(int);
    callback knob-row-selected(int);
    callback enc-pulse-changed(float);
    callback enc-pulse-edited(string);
    callback enc-counts-changed(int);
    callback learn-clicked();
    callback edit-cancel();
    callback edit-save();
    callback extras-action(string);
    callback extras-handbrake-mode(int);
    callback extras-handbrake-feel(int);
    callback extras-handbrake-deadzone(float);
    callback extras-handbrake-deadzone-edited(string);
    callback extras-led-pattern(int);
    callback extras-led-brightness(float);
    callback extras-led-brightness-edited(string);
    callback extras-led-color(int);
    callback settings-action(string);
    // H4 (v2.0.2): the Settings address field fires this on Enter
    // with the typed value — the old address-changed(string) carried
    // no payload and fired per keystroke, so Rust could never save
    // it. Rust wiring pending (FC: on_address_accepted).
    callback address-accepted(string);
    // M-7 (v2.0.2): the "Keep running in tray" switch fires this
    // with the NEW state — settings-action("tray") drops the payload.
    // Rust wiring pending (FC: on_keep_tray_selected).
    callback keep-tray-selected(bool);
    callback settings-use-profile(int);
    callback settings-duplicate-profile(int);
    callback transport-selected(int);
    callback output-backend-selected(int);
    callback autostart-selected(bool);
    callback run-setup-again();
    // Phase 2 (Wi-Fi gap): the Overview disconnected banner names
    // the fix while the daemon's last activation error is
    // Unreachable (set from sync_overview).
    in property <bool> overview-unreachable: false;
    callback tile-selected(int);
    callback action-chip(string);
    callback open-diagnostics();
    callback auto-pause-toggled();
    // Profile popover (A8).
    callback popover-use-preset(int);
    callback popover-use-profile(int);
    callback popover-new-profile();
    callback popover-duplicate(int);
    callback popover-rename(int);
    // M1 (v2.0.2): free-text rename — the popover's rename input
    // fires this with the selected row + the typed name. The old
    // popover-rename(int) renames to the linked game's name (no text
    // input existed). Wired in Rust (rename_profile_free_text).
    callback popover-rename-confirmed(int, string);
    callback popover-delete(int);
    callback popover-link(int);
    callback popover-save-switch();
    callback popover-discard-switch();
    callback popover-cancel-switch();
    callback popover-closed();
    // FIX-4 keyboard: the root FocusScope below captures Return (Save),
    // Up/Down (navigator) and Escape (close drawer/popover); Rust owns
    // what each does (wire_keyboard in src/main.rs).
    callback keyboard-save();
    callback keyboard-nav(int);
    callback keyboard-escape();
    callback focus-keyboard();
    callback bell-clicked();
    callback notif-close();
    callback notif-mark-all-read();
    callback notif-clear();
    // Theme persist (v2.0.1 hotfix, A8 in v2.0.2): Rust writes the choice to the
    // <data_dir>/ui-theme file ("Dark"/"Light"/"Auto").
    callback theme-persist(int);
    // Setup wizard (compare-fix): Rust owns step advance/finish.
    callback setup-back();
    callback setup-next();
    callback setup-skip();
    callback setup-connect(string);
    callback setup-calibrate(string);
    callback setup-install-vjoy();
    callback setup-use-hidmaestro();
    // D17: small confirm dialog for destructive actions (delete
    // profile, remove game) — 360 px card, same pattern as the
    // GameDialog. Rust owns the pending action; Yes runs it.
    in-out property <bool> confirm-open: false;
    in property <string> confirm-title: "";
    in property <string> confirm-text: "";
    in property <string> confirm-confirm-label: "Delete";
    callback confirm-yes();
    callback confirm-no();
    // Manual games (no auto-scan): open the add/edit dialog,
    // remove a game, and the dialog's own save / cancel / profile
    // cycling. Wired in Rust (wire_game_dialog in src/main.rs).
    callback add-game();
    callback edit-game(string);
    callback remove-game(string);
    callback game-dialog-save(string, string);
    callback game-dialog-cancel();
    callback game-dialog-browse();
    callback game-dialog-cycle-profile();

    // FIX-4: root keyboard scope - ancestor of every control, so keys a
    // focused control rejects (Up/Down/Return/Escape) bubble up here.
    // Tab order itself is automatic: Tab/Shift+Tab move between the
    // FocusScopes in the tree, in document order.
    focus-keyboard => { kb.focus(); }
    kb := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return) {
                keyboard-save();
                return accept;
            }
            if (event.text == Key.Escape) {
                keyboard-escape();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                keyboard-nav(-1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                keyboard-nav(1);
                return accept;
            }
            return reject;
        }
        if !setup-mode : HorizontalLayout {
            width: 100%;
            // R2-12 / DS-53 (UI-UX polish, c): NO height reservation
            // any more — the busy strip floats over the bottom 38px
            // instead of shrinking the layout (the old
            // `parent.height - (busy ? 38px : 0px)` re-laid the whole
            // window on every job start/finish, which read as a
            // blink). The 38px under the content is permanent empty
            // padding (see the column's padding-bottom below and the
            // sidebar's 52px bottom padding), so the strip only ever
            // covers empty space — never content, never the About
            // link. The window height never changes.
            height: parent.height;
        Sidebar {
            page: page;
            connected: connected;
            conn-label: conn-label;
            conn-sub: conn-sub;
            send-to-game: send-to-game;
            nav(p) => { page = p; }
            toggled-send => { toggled-send(); }
            open-about => { page = 6; }
        }
        VerticalLayout {
            // The column must fill the window (920px) minus the 184px
            // sidebar: min-width 736px. Without it the column takes the
            // current page's preferred width (Slint 1.18.1: the root
            // layout sizes to content, horizontal-stretch: 1 only shares
            // space the layout already has) — measured before this fix:
            // Pedals 712px, Buttons 684px, Extras 550px, Settings 522px,
            // so the top-bar divider and Save ended short of the right
            // edge on every narrow page. A "width: parent.width - 184px"
            // binding was tried by Phase 3 and reverted (binding loop);
            // a constant min-width has no cycle: the window itself is
            // pinned to 920px by min-width = preferred-width, so the
            // column can never ask for more than the window gives.
            min-width: 736px;
            horizontal-stretch: 1;
            // R2-12 (c): permanent 38px empty reserve at the bottom
            // of the content column — the floating busy strip sits
            // over this padding, never over page content. Pages keep
            // their own 16px bottom padding above it; the reserve
            // only eats slack (Overview already had ~68px of it) or
            // shrinks a stretch absorber / the Settings ScrollView.
            padding-bottom: 38px;
            // top bar (56px). The inner row is 30px tall and offset by
            // 13px so its contents are vertically centred in the bar:
            // Slint layouts top-align fixed-height children, so an
            // un-offset row would sit at the top edge (as in the spike).
            Rectangle {
                height: Theme.topbar-height;
                HorizontalLayout {
                    y: 13px;
                    height: 30px;
                    width: parent.width;
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 12px;
                    if page == 0 : Text { vertical-alignment: center; text: "Overview"; font-size: 17px; font-weight: 600; color: Theme.text; }
                    if page == 1 : HorizontalLayout {
                        spacing: 0px;
                        Text { vertical-alignment: center; text: "RSH Wheel  "; font-size: 17px; font-weight: 600; color: Theme.text; }
                        Text { vertical-alignment: center; text: "/ Steering"; font-size: 17px; font-weight: 500; color: Theme.faint; }
                    }
                    if page == 2 : HorizontalLayout {
                        spacing: 0px;
                        Text { vertical-alignment: center; text: "RSH Wheel  "; font-size: 17px; font-weight: 600; color: Theme.text; }
                        Text { vertical-alignment: center; text: "/ Pedals"; font-size: 17px; font-weight: 500; color: Theme.faint; }
                    }
                    if page == 3 : HorizontalLayout {
                        spacing: 0px;
                        Text { vertical-alignment: center; text: "RSH Wheel  "; font-size: 17px; font-weight: 600; color: Theme.text; }
                        Text { vertical-alignment: center; text: "/ Buttons"; font-size: 17px; font-weight: 500; color: Theme.faint; }
                    }
                    if page == 4 : HorizontalLayout {
                        spacing: 0px;
                        Text { vertical-alignment: center; text: "RSH Wheel  "; font-size: 17px; font-weight: 600; color: Theme.text; }
                        Text { vertical-alignment: center; text: "/ Extras"; font-size: 17px; font-weight: 500; color: Theme.faint; }
                    }
                    if page == 5 : HorizontalLayout {
                        spacing: 8px;
                        Text { vertical-alignment: center; text: "Settings"; font-size: 17px; font-weight: 600; color: Theme.text; }
                        // B2: version pill on the Settings top bar.
                        Pill { label: "v" + app-version; bg: Theme.panel2; fg: Theme.mute; }
                    }
                    if page == 6 : Text { vertical-alignment: center; text: "About"; font-size: 17px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    if page == 0 : AutoProfileChip {
                        game-profile: auto-profile-text;
                        paused: auto-paused;
                        pause-toggled => { auto-pause-toggled(); }
                    }
                    if page >= 1 && page <= 4 : HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 8px;
                        // R2-16: the preview shows the Basic/Advanced
                        // segment only on Steering (Wheel.html) and
                        // Pedals (Pedals.html) — it never did anything
                        // on Buttons/Extras, so it is not shown there.
                        // (Profile + Save stay on all four pages.)
                        if page == 1 || page == 2 : SegmentedControl {
                            option-0: "Basic";
                            option-1: "Advanced";
                            selected: advanced ? 1 : 0;
                            selected-changed(i) => { advanced = i == 1; }
                        }
                        ProfileButton {
                            name: profile-name;
                            unsaved: unsaved;
                            clicked => { profile-clicked(); }
                        }
                        // DS-54: Save runs a ProfileOp job (8) — it
                        // disables + dims while the save is in flight.
                        Btn { label: "Save"; primary: true; disabled: busy-kind == 8; clicked => { save-profile(); } }
                    }
                    BellButton {
                        unread: notif-unread;
                        clicked => { bell-clicked(); }
                    }
                }
                Rectangle { y: 55px; width: 100%; height: 1px; background: Theme.line; }
            }
            // body - pages are sized to their preferred width (explicit
            // width / min-width on the page, and on the row, are ignored:
            // cross-axis sizes are capped at the container). The shortfall
            // (Pedals cards x=874, Buttons panel x=886, Settings x=683) is
            // fixed per-page by explicit content widths (see the FIX notes
            // in pedals/buttons/settings), so every page prefers the full
            // 736px column here.
            if page == 0 : OverviewPage {
                steer-angle: steer-angle;
                steer-text: steer-text;
                throttle: throttle;
                brake: brake;
                clutch: clutch;
                daemon-live: daemon-live;
                daemon-error: daemon-error;
                busy-kind: busy-kind;
                connected: connected;
                firmware-line: firmware-line;
                delay-text: delay-text;
                jitter-text: jitter-text;
                lost-text: lost-text;
                calibrated-label: calibrated-label;
                calibrated-warn: calibrated-warn;
                backend-name: backend-name;
                backend-ready: backend-ready;
                profile-name: profile-name;
                games: games;
                configure => { page = 1; }
                launch-game(g) => { launch-game(g); }
                open-diagnostics => { open-diagnostics(); }
                reconnect => { reconnect(); }
                open-profile-popover => { profile-clicked(); }
                // Manual games (no auto-scan): Add opens the dialog,
                // Edit / Remove act on the tile's game.
                add-game => { add-game(); }
                edit-game(g) => { edit-game(g); }
                remove-game(g) => { remove-game(g); }
                unreachable: overview-unreachable;
            }
            if page == 1 : SteeringPage {
                busy-kind: busy-kind;
                advanced: advanced;
                invert: steer-invert;
                lock-frac: steer-lock;
                lock-text: steer-lock-text;
                smoothing: steer-smoothing;
                smoothing-text: steer-smoothing-text;
                input-pct: input-pct;
                output-pct: output-pct;
                marker-vx: marker-vx;
                marker-vy: marker-vy;
                dashed-line: dashed-line;
                crosshair: crosshair;
                curve-commands: curve-commands;
                deadzone: deadzone;
                deadzone-text: deadzone-text;
                curve-val: curve-val;
                curve-text: curve-text;
                preset: preset;
                unsaved: unsaved;
                centre-set: centre-set;
                centre-available: centre-available;
                centre-reason: centre-reason;
                deadzone-changed(v) => { deadzone-changed(v); }
                curve-changed(v) => { curve-changed(v); }
                deadzone-edited(t) => { deadzone-edited(t); }
                curve-edited(t) => { curve-edited(t); }
                invert-changed(b) => { invert-changed(b); }
                lock-changed(v) => { lock-changed(v); }
                lock-edited(t) => { lock-edited(t); }
                smoothing-changed(v) => { smoothing-changed(v); }
                smoothing-edited(t) => { smoothing-edited(t); }
                preset-selected(i) => { preset-selected(i); }
                reset-defaults => { reset-defaults(); }
                set-centre => { set-centre(); }
            }
            if page == 2 : PedalsPage {
                busy-kind: busy-kind;
                // Live values come from the window (Rust drives them);
                // mV / feel / deadzone / curves come from get_tuning
                // via the window props below — never literals (A1/A2).
                // R2-16: Advanced mode (live raw mV per pedal).
                advanced: advanced;
                throttle-raw-mv: throttle-raw-mv-text;
                brake-raw-mv: brake-raw-mv-text;
                clutch-raw-mv: clutch-raw-mv-text;
                throttle-pct: throttle;
                throttle-up-mv: throttle-up-mv;
                throttle-down-mv: throttle-down-mv;
                throttle-feel: throttle-feel;
                throttle-deadzone: throttle-deadzone;
                throttle-deadzone-text: throttle-deadzone-text;
                throttle-curve: throttle-curve;
                throttle-dashed: throttle-dashed;
                throttle-marker-x: throttle-marker-x;
                throttle-marker-y: throttle-marker-y;
                brake-pct: brake;
                brake-up-mv: brake-up-mv;
                brake-down-mv: brake-down-mv;
                brake-feel: brake-feel;
                brake-deadzone: brake-deadzone;
                brake-deadzone-text: brake-deadzone-text;
                brake-curve: brake-curve;
                brake-dashed: brake-dashed;
                brake-marker-x: brake-marker-x;
                brake-marker-y: brake-marker-y;
                clutch-pct: clutch;
                clutch-up-mv: clutch-up-mv;
                clutch-down-mv: clutch-down-mv;
                clutch-feel: clutch-feel;
                clutch-deadzone: clutch-deadzone;
                clutch-deadzone-text: clutch-deadzone-text;
                clutch-bite: clutch-bite;
                clutch-bite-text: clutch-bite-text;
                clutch-curve: clutch-curve;
                clutch-dashed: clutch-dashed;
                clutch-marker-x: clutch-marker-x;
                clutch-marker-y: clutch-marker-y;
                set-disabled: pedal-set-disabled;
                set-up(i) => { pedal-set-up(i); }
                set-down(i) => { pedal-set-down(i); }
                feel-selected(p, f) => { pedal-feel-selected(p, f); }
                deadzone-changed(p, v) => { pedal-deadzone-changed(p, v); }
                deadzone-edited(p, t) => { pedal-deadzone-edited(p, t); }
                bite-changed(v) => { pedal-bite-changed(v); }
                bite-edited(t) => { pedal-bite-edited(t); }
            }
            if page == 3 : ButtonsPage {
                busy-kind: busy-kind;
                button-actions: button-actions;
                pressed-index: pressed-index;
                selected-index: selected-index;
                selected-action: selected-action;
                knob1-left: "Gear 1";
                knob1-right: "Gear 2";
                knob1-press: "Not set";
                knob2-left: "Not set";
                knob2-right: "Not set";
                knob2-press: "Not set";
                knob-flash-index: -1;
                knob-flash-text: "";
                knob-row-action: knob-row-action;
                enc-pulse-ms: enc-pulse-ms;
                enc-pulse-text: enc-pulse-text;
                enc-counts: enc-counts;
                enc-pulse-changed(v) => { enc-pulse-changed(v); }
                enc-pulse-edited(t) => { enc-pulse-edited(t); }
                enc-counts-changed(i) => { enc-counts-changed(i); }
                listening: buttons-listening;
                tile-selected(i) => { tile-selected(i); }
                knob-selected(i) => { knob-selected(i); }
                knob-row-selected(i) => { knob-row-selected(i); }
                action-selected(a) => { action-chip(a); }
                learn-clicked => { learn-clicked(); }
                edit-cancel => { edit-cancel(); }
                edit-save => { edit-save(); }
            }
            if page == 4 : ExtrasScreen {
                busy-kind: busy-kind;
                handbrake-pct: handbrake;
                handbrake-up-mv: handbrake-up-mv;
                handbrake-down-mv: handbrake-down-mv;
                handbrake-feel: handbrake-feel;
                handbrake-deadzone: handbrake-deadzone;
                handbrake-deadzone-text: handbrake-deadzone-text;
                handbrake-curve: handbrake-curve;
                handbrake-dashed: handbrake-dashed;
                handbrake-marker-x: handbrake-marker-x;
                handbrake-marker-y: handbrake-marker-y;
                handbrake-mode: handbrake-mode;
                handbrake-pressed: handbrake-pressed;
                calibration-disabled: extras-calibration-disabled;
                gear: gear;
                shifter-mode: shifter-mode;
                horn-button: horn-button;
                horn-learning: horn-learning;
                horn-pressed: horn-pressed;
                led-pattern: led-pattern;
                led-brightness: led-brightness;
                led-brightness-text: led-brightness-text;
                led-color: led-color;
                led-preview: led-preview;
                // H-7: module switches are two-way window props, so
                // Rust can revert them when a toggle fails.
                handbrake-on <=> extras-handbrake-on;
                shifter-on <=> extras-shifter-on;
                horn-on <=> extras-horn-on;
                leds-on <=> extras-leds-on;
                action(a) => { extras-action(a); }
                handbrake-mode-selected(i) => { extras-handbrake-mode(i); }
                handbrake-feel-selected(f) => { extras-handbrake-feel(f); }
                handbrake-deadzone-changed(v) => { extras-handbrake-deadzone(v); }
                handbrake-deadzone-edited(t) => { extras-handbrake-deadzone-edited(t); }
                shifter-sensitivity-changed(v) => { extras-action("shifter-sensitivity"); }
                led-pattern-selected(i) => { extras-led-pattern(i); }
                led-brightness-changed(v) => { extras-led-brightness(v); }
                led-brightness-edited(t) => { extras-led-brightness-edited(t); }
                led-color-selected(i) => { extras-led-color(i); }
            }
            if page == 5 : SettingsScreen {
                connected: connected;
                busy-kind: busy-kind;
                // Two-way bindings: the screen edits these, Rust
                // reverts them on a failed backend call (A9/A10).
                connection-type <=> transport;
                // L-2: the live board address, never a hardcoded
                // default — "—" until Rust sets setup-address.
                address: setup-address == "" ? "—" : setup-address;
                backend <=> controller;
                start-with-windows <=> autostart-enabled;
                keep-in-tray <=> keep-in-tray;
                // R2-31 (h): the segment shows the STORED choice
                // (theme-choice, 0/1/2) — never the resolved `theme`
                // (0/1), so Auto stays visibly selected.
                theme-choice <=> theme-choice;
                profiles: settings-profiles;
                app-version: "RSH " + app-version;
                firmware-text: firmware-text;
                app-update-text: app-update-text;
                backup-text: backup-text;
                connection-selected(i) => { transport-selected(i); }
                // H4: Enter in the address field sends the typed
                // value (the old per-keystroke address-changed
                // carried no payload, so Rust could never save it).
                address-accepted(a) => { address-accepted(a); }
                reconnect => { reconnect(); }
                wifi-password-set: wifi-password-set;
                wifi-password-error: wifi-password-error;
                wifi-password-message: wifi-password-message;
                wifi-password-busy: wifi-password-busy;
                wifi-password-new <=> wifi-password-new;
                wifi-password-confirm <=> wifi-password-confirm;
                set-wifi-password => { set-wifi-password(); }
                forget-wifi-password => { forget-wifi-password(); }
                backend-selected(i) => { output-backend-selected(i); }
                toggled-start-windows(b) => { autostart-selected(b); }
                // M-7: forward the new switch state, don't drop it.
                toggled-keep-tray(b) => { keep-tray-selected(b); }
                theme-selected(i) => { theme-choice = i; theme-persist(i); }
                new-profile => { settings-action("new-profile"); }
                use-profile(i) => { settings-use-profile(i); }
                duplicate-profile(i) => { settings-duplicate-profile(i); }
                check-firmware => { settings-action("check-firmware"); }
                // H-4: the firmware flash job (Rust arm already wired:
                // settings-action("update-firmware") starts the job,
                // progress is polled on the 1 Hz tick).
                update-firmware => { settings-action("update-firmware"); }
                check-app-updates => { settings-action("update-check"); }
                backup => { settings-action("backup"); }
                restore => { settings-action("restore"); }
                run-setup => { run-setup-again(); }
                open-diagnostics => { open-diagnostics(); }
            }
            if page == 6 : AboutPage {
                app-version: app-version;
                back => { page = 5; }
            }
        }
    }
    // Setup wizard (compare-fix): full-window, replaces the shell
    // layout while setup-mode is on. Step state lives on the window
    // (setup-step) so Rust drives Back/Next; the wizard itself only
    // reads it. The notifications drawer below still overlays it.
    if setup-mode : SetupWizard {
        // R2-12 (c): no 38px height reservation any more (see the
        // shell layout above) — the wizard is always full-height and
        // the strip floats over the right column's 38px bottom
        // reserve (setup.slint padding-bottom 66px). Full height is
        // kept explicit (perf R2-12) so the wizard never shrinks.
        height: parent.height;
        step: setup-step;
        daemon-live: daemon-live;
        busy-kind: busy-kind;
        connect-done: setup-connect-done;
        connect-hint: setup-connect-hint;
        centre-done: setup-centre-done;
        pedals-done: setup-pedals-done;
        transport: setup-transport;
        wifi-joined: setup-wifi-joined;
        usb-available: setup-usb-available;
        wifi-ssid: setup-wifi-ssid;
        wifi-joining: setup-wifi-joining;
        wifi-error: setup-wifi-error;
        // L-2: live address ("" until Rust sets it) — the wizard
        // shows "—" while unconnected, never a hardcoded default.
        address: setup-address == "" ? "—" : setup-address;
        games-text: setup-games-text;
        games-done: setup-games-done;
        vjoy-installed: setup-vjoy-installed;
        vjoy-installing: setup-vjoy-installing;
        vjoy-progress: setup-vjoy-progress;
        vjoy-elapsed: setup-vjoy-elapsed;
        vjoy-version: setup-vjoy-version;
        vjoy-error: setup-vjoy-error;
        vjoy-fallback: setup-vjoy-fallback;
        calibration-available: setup-calibration-available;
        calibration-reason: setup-calibration-reason;
        live-throttle: setup-live-throttle;
        live-brake: setup-live-brake;
        live-clutch: setup-live-clutch;
        back => { setup-back(); }
        next => { setup-next(); }
        skip => { setup-skip(); }
        install-vjoy => { setup-install-vjoy(); }
        use-hidmaestro => { setup-use-hidmaestro(); }
        connect-action(a) => { setup-connect(a); }
        calibrate-action(a) => { setup-calibrate(a); }
        add-game => { add-game(); }
    }
    // Phase 2 (F-2 / U-1): click-outside-to-dismiss — one dim
    // backdrop + full-window TouchArea behind EACH overlay. The
    // backdrop is painted before the overlay (so it sits behind
    // it) and closes only that overlay; clicks on the overlay
    // itself never reach the backdrop. No popup in this window
    // closes only via its own toggle button any more.
    if popover-open : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #000000; opacity: 0.35;
        TouchArea { width: parent.width; height: parent.height; clicked => { popover-closed(); } }
    }
    // Profile popover overlay (A8): under the top-bar profile
    // button, above the page. Esc is owned by the keyboard worker
    // (clears `popover-open`).
    if popover-open : ProfilePopover {
        x: parent.width - 320px;
        y: 64px;
        busy-kind: busy-kind;
        presets: popover-presets;
        profiles: popover-profiles;
        unsaved: unsaved;
        show-unsaved-prompt: popover-show-prompt;
        pending-name: popover-pending-name;
        use-preset(i) => { popover-use-preset(i); }
        use-profile(i) => { popover-use-profile(i); }
        new-profile => { popover-new-profile(); }
        duplicate-selected(i) => { popover-duplicate(i); }
        rename-selected(i) => { popover-rename(i); }
        rename-confirmed(i, t) => { popover-rename-confirmed(i, t); }
        delete-selected(i) => { popover-delete(i); }
        link-selected(i) => { popover-link(i); }
        save-and-switch => { popover-save-switch(); }
        discard-and-switch => { popover-discard-switch(); }
        cancel-switch => { popover-cancel-switch(); }
        closed => { popover-closed(); }
    }
    // Phase 2 (F-2 / U-1): backdrop + click-away for the game dialog.
    if game-dialog-open : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #000000; opacity: 0.35;
        TouchArea { width: parent.width; height: parent.height; clicked => { game-dialog-cancel(); } }
    }
    // Add/edit game dialog overlay (manual games): same right-edge
    // overlay position as the profile popover. Esc is owned by the
    // keyboard worker (clears `game-dialog-open`) and by the
    // dialog's own FocusScope.
    if game-dialog-open : GameDialog {
        x: parent.width - 380px;
        y: 64px;
        title: game-dialog-title;
        name <=> game-dialog-name;
        exe <=> game-dialog-exe;
        profile-name: game-dialog-profile-name;
        save(n, e) => { game-dialog-save(n, e); }
        cancel => { game-dialog-cancel(); }
        browse => { game-dialog-browse(); }
        cycle-profile => { game-dialog-cycle-profile(); }
    }
    // D17: small confirm dialog for destructive actions (delete
    // profile, remove game) — 360 px card, GameDialog pattern:
    // backdrop + click-away closes it, Esc closes it (keyboard
    // worker), Yes runs the pending action, No cancels. No
    // destructive action runs without this confirm any more.
    if confirm-open : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #000000; opacity: 0.35;
        TouchArea { width: parent.width; height: parent.height; clicked => { confirm-no(); } }
    }
    if confirm-open : Rectangle {
        x: parent.width - 380px;
        y: 64px;
        width: 360px;
        // B5 (PC-test Bug 5): an explicit content height — a
        // height-less Rectangle parented by the window stretches
        // to the window height (gate-measured 580 px), so the
        // confirm used to render as a full-height panel. The
        // layout's preferred height is content-driven (fixed
        // 360 px width), so binding to it sizes the card to its
        // content. (Binding to layout.height is a loop: a layout
        // fills its parent, so layout.height IS the card height.)
        height: confirm-layout.preferred-height;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.panel;
        confirm-layout := VerticalLayout {
            padding-top: 12px; padding-bottom: 12px; padding-left: 12px; padding-right: 12px;
            spacing: 10px;
            Text { text: confirm-title; font-size: 12.5px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
            Text { text: confirm-text; font-size: 12px; color: Theme.mute; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 6px;
                Btn { label: confirm-confirm-label; primary: true; clicked => { confirm-yes(); } }
                Btn { label: "Cancel"; clicked => { confirm-no(); } }
            }
        }
    }
    // DS-24 (U-06): transient failure toast — Phase 2 (F-1 / U-2):
    // a centred ~480 px top-middle card per UI-DESIGN §6, NOT a
    // full-content-width banner: the old full-width toast covered
    // the Overview banner's Reconnect / Pair buttons while visible
    // and read as a full-screen error. Click it to dismiss early;
    // it also expires after ~5 s (U-1: the toast is not a modal
    // popup — it never blocks the page, so it needs no backdrop).
    // Painted before the drawers, so an open drawer covers its
    // right end; the text is left-aligned and stays readable.
    if toast-text != "" : Rectangle {
        // Centre within the content column (sidebar .. right edge).
        x: Theme.sidebar-width + (parent.width - Theme.sidebar-width - 480px) / 2;
        y: 64px;
        width: 480px;
        // B2 (PC-test Bug 2): an explicit content height — a
        // height-less Rectangle parented by the window stretches
        // to the window height (gate-measured 580 px for every
        // body, short or long), so the toast used to render as a
        // full-height panel instead of the designed 480×~52 px
        // card. The layout's preferred height is content-driven
        // (fixed 480 px width, wrapped text), so binding to it
        // sizes the card to its text; Rust caps the text
        // (set_toast) so the card stays ≤ ~80 px. The 52 px floor
        // is the design height for one-line toasts (height +
        // min-height cannot both be set). (Binding to
        // layout.height is a loop: a layout fills its parent, so
        // layout.height IS the card height.)
        height: Math.max(toast-layout.preferred-height, 52px);
        border-radius: 8px;
        border-width: 1px;
        border-color: toast-kind == "success" ? Theme.ok : Theme.bad;
        background: toast-kind == "success" ? Theme.ok-bg : Theme.err-bg;
        toast-layout := HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: toast-title; font-size: 12.5px; font-weight: 600; color: toast-kind == "success" ? Theme.ok : Theme.bad; wrap: word-wrap; }
                Text { text: toast-text; font-size: 12px; color: Theme.text; wrap: word-wrap; }
            }
            Text { text: "✕"; font-size: 12px; color: Theme.faint; vertical-alignment: center; }
        }
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { toast-text = ""; toast-title = ""; toast-kind = "error"; }
        }
    }
    // Phase 2 (F-2 / U-1): backdrop + click-away for the
    // notifications drawer.
    if notif-open : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #000000; opacity: 0.35;
        TouchArea { width: parent.width; height: parent.height; clicked => { notif-close(); } }
    }
    // Notification drawer overlay (right edge, above the page).
    // Esc is owned by the keyboard worker (clears `notif-open`).
    if notif-open : NotificationsDrawer {
        x: parent.width - 356px;
        y: 64px;
        items: notifications;
        unread: notif-unread;
        close-requested => { notif-close(); }
        mark-all-read => { notif-mark-all-read(); }
        clear-all => { notif-clear(); }
    }
    // Phase 2 (F-2 / U-1): backdrop + click-away for the
    // diagnostics drawer.
    if diag-open : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #000000; opacity: 0.35;
        TouchArea { width: parent.width; height: parent.height; clicked => { diag-open = false; } }
    }
    // Diagnostics drawer overlay (v2.0.1 hotfix): right edge, above
    // the page, like the notifications drawer. Live values come from
    // the window (Rust drives them); stats read "—" until the
    // telemetry backend lands, charts draw the live ring buffers.
    // Esc is owned by the keyboard worker (clears `diag-open`).
    if diag-open : DiagnosticsDrawer {
        x: parent.width - 420px;
        y: 0px;
        // R2-12 (c): the drawer stops 38px above the window bottom
        // so the floating busy strip never covers its bottom edge
        // (event log / encoders) while a job runs.
        height: parent.height - 38px;
        steer-chart: diag-steer-chart;
        steer-readout: diag-steer-readout;
        pedals-chart: diag-pedals-chart;
        pedals-readout: diag-pedals-readout;
        delay-text: diag-delay-text;
        jitter-text: diag-jitter-text;
        lost-text: diag-lost-text;
        loop-rate-text: diag-loop-rate-text;
        tx-failures-text: diag-tx-failures-text;
        seq-gaps-text: diag-seq-gaps-text;
        frame-p50-text: diag-frame-p50-text;
        frame-p99-text: diag-frame-p99-text;
        paint-p50-text: diag-paint-p50-text;
        paint-p99-text: diag-paint-p99-text;
        ipc-p50-text: diag-ipc-p50-text;
        ipc-p99-text: diag-ipc-p99-text;
        conn-label: diag-conn-label;
        daemon-live: diag-daemon-live;
        app-version: diag-app-version;
        firmware: diag-firmware;
        throttle-pct: throttle;
        brake-pct: brake;
        clutch-pct: clutch;
        buttons-pressed: diag-buttons-pressed;
        events: diag-events;
        closed => { diag-open = false; }
    }
    // B5 (v2.0.2): global busy strip — one bar, bottom-anchored, on
    // every screen (it is a direct child of the root FocusScope, so
    // it also shows over the setup wizard). R2-12 (UI-UX polish, c):
    // it FLOATS now — it is positioned absolute over the window's
    // bottom 38px and the content keeps a permanent 38px empty
    // reserve there, so starting/finishing a job never re-lays the
    // window. Rust drives `busy` / `busy-label` from busy_jobs;
    // while a job runs the strip is visible with a spinner + the
    // job's label, and it vanishes the moment the job finishes or
    // times out — no infinite loading.
    if busy : Rectangle {
        x: 0px;
        y: parent.height - 38px;
        width: parent.width;
        height: 38px;
        background: Theme.panel;
        // Floating shadow: an 8px fade above the strip so it reads
        // as a bar floating over the page's bottom padding, not as a
        // hard edge slicing the content. (A child at negative y
        // paints outside the parent — Rectangle does not clip.)
        Rectangle {
            x: 0px;
            y: -8px;
            width: parent.width;
            height: 8px;
            background: @linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.20));
        }
        Rectangle { y: 0px; width: 100%; height: 1px; background: Theme.line; }
        HorizontalLayout {
            y: 11px;
            height: 16px;
            width: parent.width;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 10px;
            // Spinner: a ring with one accent dot orbiting it. The
            // dot's position is a plain x/y binding off spin-step
            // (Timer-driven), so it animates in every renderer.
            // (transform-rotation was tried first: it compiles, but
            // the dot does not move under the testing backend's
            // software renderer — probe-verified 2026-11-17 — so the
            // spinner does not rely on it.)
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 1.5px;
                border-color: Theme.line;
                property <angle> dot-angle: spin-step * 30deg - 90deg;
                Rectangle {
                    x: 6px + 5.5px * Math.cos(dot-angle);
                    y: 5.5px + 5.5px * Math.sin(dot-angle);
                    width: 4px;
                    height: 5px;
                    border-radius: 2px;
                    background: Theme.accent;
                }
            }
            Text {
                vertical-alignment: center;
                text: busy-label == "" ? "Working…" : busy-label;
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.text;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Timer {
            interval: 90ms;
            // F27: the spinner stops while the window is hidden —
            // a running spinner schedules a redraw every 90 ms,
            // and a redraw on the just-hidden window SIGSEGVs the
            // software renderer under Xvfb (the fault is in the
            // `llvmpipe` render thread, not app code). The strip
            // stays mounted (invisible anyway); the Timer resumes
            // when the window comes back.
            running: !window-hidden;
            triggered => { spin-step = spin-step >= 11 ? 0 : spin-step + 1; }
        }
    }
    }
}
