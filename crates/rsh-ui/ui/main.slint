// RSH v2.0 — Phase 3 main window (REDESIGN-PLAN §3-§5).
// 920x580 window, 184px sidebar, 56px top bar. Fonts embedded at compile
// time (Inter + JetBrains Mono, OFL). The tray icon/menu live in the
// daemon (crates/rsh-daemon/ui/tray.slint) — this crate owns only the main
// app window. Data comes from the Rust side through the rsh-api surface
// (live daemon IPC when the background service runs, SimApi fallback
// otherwise — never fake live data: see src/sim_api.rs).
//
// v2.0.1 hotfix: the window owns every live value as a Rust-driven
// prop — pedals (mV/feel/deadzone from get_tuning), buttons (12 actions
// + selected action), Extras (screens/extras.slint, wired to
// set_tuning), the profile popover (real list_profiles), the wizard
// Drivers step (vJoy status/install/fallback) and the diagnostics
// drawer (live charts from Rust ring buffers, measured stats from
// diag_stats() — "—" while the service does not measure). Nothing is
// hardcoded live-looking any more: no daemon means Disconnected + "—",
import "../assets/Inter.ttf";
import "../assets/JetBrainsMono.ttf";
import { Theme } from "tokens.slint";
import { SegmentedControl, ProfileButton, AutoProfileChip, Btn, Modal } from "components.slint";
import { Sidebar, AboutPage } from "shell.slint";
import { OverviewPage, GameItem } from "screens/overview.slint";
import { SteeringPage } from "screens/steering.slint";
import { PedalsPage } from "screens/pedals.slint";
import { ButtonsPage } from "screens/buttons.slint";
import { ExtrasScreen } from "screens/extras.slint";
import { ProfilePopover, ProfileItem } from "screens/profile_popover.slint";
import { GameDialog } from "screens/game_dialog.slint";
// Compare-fix: the full Settings screen (screens/settings.slint)
// replaces the shell placeholder — Reconnect, connect-hint text,
// Duplicate/Use, Restore and per-item Check buttons only exist there.
// SetupWizard likewise replaces the shell layout while setup runs.
import { SettingsScreen, ProfileRow } from "screens/settings.slint";
import { SetupWizard } from "screens/setup.slint";
import { DiagnosticsDrawer } from "screens/diagnostics.slint";
import { BellButton, NotificationsDrawer, NotificationItem } from "notifications.slint";

export component MainWindow inherits Window {
    title: "RSH — Real Sim Hub";
    icon: @image-url("../assets/tray.png");
    preferred-width: Theme.window-width;
    preferred-height: Theme.window-height;
    // P1-6: the minimums fit 1366x768 @150% (910x512 logical,
    // ~910x480 work area with the taskbar) — the window opens at
    // the 920x580 preferred size wherever it fits and can shrink
    // to 880x480 where it does not. The old 920x580 minimums made
    // the window taller/wider than the screen at 150% scaling, so
    // it could never fit. Every page already scrolls vertically
    // (PageScaffold) and the wizard step area scrolls too, so the
    // shorter height only scrolls — nothing clips. The 920x580
    // layout maths are unchanged (preferred size + column widths
    // below are the same); the 342px card floors drop to 322px so
    // two-across cards fit the 656px content width at 880px.
    min-width: 880px;
    min-height: 480px;
    background: Theme.bg;
    // A8 (v2.0.2): the window theme drives the global tokens — the
    // whole UI repaints when it changes. `theme` is the RESOLVED
    // value only (0 Dark / 1 Light) — it never holds 2, so Auto
    // never flashes the UI dark (R2-31). The stored choice
    // (0/1/2) lives in `theme-choice` below, which is what the
    // Settings segment binds to.
    // (A `Theme.mode: theme;` binding is not valid Slint — globals
    // are written from code, so the change handler does it.)
    changed theme => { Theme.mode = theme; }
    default-font-family: Theme.font-text;
    default-font-size: Theme.fs-label;

    in-out property <int> page: 0; // 0 Overview, 1 Steering, 2 Pedals, 3 Buttons, 4 Extras, 5 Settings, 6 About
    // D4: page-switch fade — dips to 0.7 on every `page` change and
    // the timer below restores it to 1; the content column animates
    // its opacity over 150ms both ways. (P3-9: the old 0.3 dip was
    // a near-flash to almost-invisible on every tab switch.)
    property <float> page-opacity: 1;
    changed page => { page-opacity = 0.7; }
    in-out property <bool> send-to-game: true;
    in-out property <bool> advanced: false;
    in-out property <bool> unsaved: false;
    in-out property <bool> auto-paused: false;
    in-out property <int> transport: 0;   // 0 Wi-Fi, 1 USB
    in-out property <int> controller: 1;  // 0 HIDMaestro, 1 vJoy (vJoy is the default, user order 2026-11-16)
    in-out property <int> theme: 0;       // Resolved window theme: 0 Dark, 1 Light (never 2 — R2-31). Drives Theme.mode.
    // R2-31: the STORED theme choice (0 Dark, 1 Light, 2 Auto) —
    // this is what the Settings segment shows and what theme-persist
    // stores. `theme` above stays the RESOLVED 0/1 the Rust side
    // writes after resolving Auto against the OS; it alone drives
    // Theme.mode. Rust sets both in wire_theme.
    in-out property <int> theme-choice: 0;
    in-out property <int> pressed-index: -1;
    in-out property <int> selected-index: 5; // A4: index 5 = "Gear 3" (preview), not 0
    in property <[string]> button-actions: ["Shift up", "Shift down", "Horn", "Gear 1", "Gear 2", "Gear 3", "Gear 4", "Gear 5", "Gear 6", "Handbrake", "Not set", "Not set"];
    in property <string> selected-action: "Gear 3";
    // BU2: the selected tile's long-press action ("Not set" = none).
    in property <string> selected-long-action: "Not set";
    // UI-1 (v2.0.12): the rotary-knob card labels — driven from
    // Rust (`load_knobs`, which reads the real `knob_actions()`),
    // never literals. The old "Gear 1"/"Gear 2" literals here
    // claimed bindings that did not exist on a fresh install, and
    // a rebind never updated the card. "Not set" is the honest
    // default until the daemon's stored bindings arrive.
    in property <string> knob1-left: "Not set";
    in property <string> knob1-right: "Not set";
    in property <string> knob1-press: "Not set";
    in property <string> knob2-left: "Not set";
    in property <string> knob2-right: "Not set";
    in property <string> knob2-press: "Not set";
    in property <string> knob-row-action: "Not set";
    in property <bool> buttons-listening: false;
    in property <string> profile-name: "GT3 Sprint";
    in property <string> auto-profile-text: "No profile yet";
    in property <string> app-version: "2.0.13";
    in property <bool> daemon-live: false;
    // B5 (v2.0.2): the global busy strip reads these — Rust drives
    // them from busy_jobs (each start_*_job records its label, the
    // 1 Hz frame timer clears them); an empty label renders "Working…".
    in property <bool> busy: false;
    in property <string> busy-label: "";
    // P1-6: elapsed time on the running job ("0:07", "1:23") —
    // Rust writes it from the 1 Hz tick; empty while idle. Shown
    // next to the busy label in the StatusBar so a long backend
    // switch (UAC + service start) reads as progress, not a hang.
    in property <string> busy-elapsed: "";
    // DS-54: which job kind the strip shows, as a JobKind::order
    // value (-1 = idle) — screens disable + dim the button that
    // started it while its job runs.
    in property <int> busy-kind: -1;
    // P2 (v2.0.10 HID retest, Bug 1 retry storm): seconds left on
    // the post-failure backend-selector cooldown, 0 = idle. Rust
    // arms it for 30 s on ANY backend-switch failure and ticks it
    // on the 1 Hz timer; the Settings radios + wizard fallback
    // button disable while it is > 0.
    in property <int> backend-cooldown-secs: 0;
    // F27 (v2.0.3): true while the window is hidden to tray —
    // the busy spinner's Timer stops (see below), so no redraw
    // is scheduled on the hidden window. Set from Rust in the
    // close handler, cleared on show (`apply_page_request`).
    in property <bool> window-hidden: false;
    // M-2 (v2.0.2): the specific fatal reason from
    // read_daemon_status() (daemon-status.json) — empty while there
    // is none; the Overview shows it as an error banner instead of
    // the generic "not running" line. Set from Rust (mark_dead / sync).
    in property <string> daemon-error: "";
    // B01 (v2.0.8 retest): the bottom StatusBar replaces the
    // floating toast (DS-24, deleted) — every `notify_error` /
    // `notify_success` / `notify_toast` surfaces here, so a failure
    // is visible on the current screen without opening the bell
    // drawer. Lifetimes (Rust `set_toast*`): error 4 s, info and
    // success 4 s — UI-5 (v2.0.12): the old 1 s error flash was
    // too short to read (and tick-quantised to 0–2 s). P3-1: the
    // old "8 s" here was stale. `in-out`
    // so Rust drives it and the bar's own dismiss / Details callbacks
    // clear it / open the drawer; Rust clears it on expiry
    // (1 Hz tick). Empty `status-kind` = hidden (unless a job
    // is busy). FULL text, never truncated: the bar elides the
    // one line visually and the whole message lives in the drawer.
    // P1-3: kinds are "", "error", "success", "info" — info is the
    // neutral kind for `notify_toast` (panel background, plain
    // title, no icon), never the red error paint.
    in-out property <string> status-kind: ""; // "", "error", "success", "info"
    in-out property <string> status-title: "";
    in-out property <string> status-text: "";
    // Superseded-message counter: a new message replaces the
    // shown one; this counts how many were replaced (+N).
    in-out property <int> status-more: 0;
    callback status-dismiss();
    callback status-details();
    // B5 spinner step (0..11, driven by the strip's Timer).
    property <int> spin-step: 0;
    in property <bool> connected: true;
    in property <string> conn-label: "Disconnected";
    // D10: true while the wheel is not connected for a NON-fault
    // reason (not found / dropped / reconnecting) — the sidebar
    // dot is amber. False + !connected means a real fault (red).
    // Set from Rust via ConnectionState::is_fault().
    in property <bool> conn-warn: false;
    in property <string> conn-sub: "Not connected";
    in property <angle> steer-angle;
    in property <string> steer-text;
    in property <float> throttle;
    in property <float> brake;
    in property <float> clutch;
    in property <float> handbrake: 0;
    in property <string> gear: "—";
    in property <float> input-pct;
    in property <float> output-pct;
    in property <float> marker-vx;
    in property <float> marker-vy;
    in property <string> dashed-line;
    in property <string> crosshair;
    in property <string> curve-commands;
    in property <float> deadzone;
    in property <string> deadzone-text;
    in property <float> curve-val;
    in property <string> curve-text;
    in property <int> preset;
    // Steering Advanced (Bug 7): invert + lock + smoothing — the
    // old centre/raw-mV readouts are gone (steering.slint).
    in property <bool> steer-invert: false;
    in property <float> steer-lock: 1.0;
    in property <string> steer-lock-text: "900°";
    in property <float> steer-smoothing: 0.3;
    in property <string> steer-smoothing-text: "30%";
    // Steering per-module tuning (S2+S3): balance −20..+20%
    // (0.5 = even) and centre trim −5..+5% (0.5 = none).
    in property <float> steer-balance: 0.5;
    in property <string> steer-balance-text: "0%";
    in property <float> steer-trim: 0.5;
    in property <string> steer-trim-text: "0%";
    // Encoder tuning (E1/E2): pulse length + steps per click, on the
    // Buttons page (rotary knobs live there, not in a module of
    // their own) — from get_tuning("encoders"), never literals.
    in property <float> enc-pulse-ms: 50.0;
    in property <string> enc-pulse-text: "50 ms";
    in property <int> enc-counts: 4;
    // Encoder tuning (E3/E4): acceleration + per-knob invert.
    in property <bool> enc-accel: false;
    in property <float> enc-accel-sens: 1.0;
    in property <string> enc-accel-sens-text: "100%";
    in property <bool> enc-invert1: false;
    in property <bool> enc-invert2: false;
    // Button tuning (BU1/BU2): debounce + long-press threshold, on
    // the Buttons page — from get_tuning("buttons"), never literals.
    in property <float> btn-debounce-ms: 10.0;
    in property <string> btn-debounce-text: "10 ms";
    in property <float> btn-longpress-ms: 800.0;
    in property <string> btn-longpress-text: "800 ms";
    in property <float> btn-doublepress-ms: 300.0;
    in property <string> btn-doublepress-text: "300 ms";
    in property <string> throttle-raw-mv-text: "—";
    in property <string> brake-raw-mv-text: "—";
    in property <string> clutch-raw-mv-text: "—";
    // Steering centre (A22): pill only once set; button disabled
    // while the calibration backend is unavailable.
    in property <bool> centre-set: false;
    in property <bool> centre-available: false;
    in property <string> centre-reason: "RSH isn't running — reconnect to capture.";
    // Pedals (A1/A2): mV / feel / deadzone / curve / marker from Rust
    // (get_tuning), refreshed on startup, on swap-to-live and after
    // every pedal edit — never literals.
    in property <string> throttle-up-mv: "—";
    in property <string> throttle-down-mv: "—";
    in property <int> throttle-feel: 0;
    in property <float> throttle-deadzone: 0;
    in property <string> throttle-deadzone-text: "—";
    in property <string> throttle-curve: "M 6 104 L 104 6";
    in property <string> throttle-dashed: "M 6 104 L 104 6";
    in property <float> throttle-marker-x: 6;
    in property <float> throttle-marker-y: 104;
    in property <string> brake-up-mv: "—";
    in property <string> brake-down-mv: "—";
    in property <int> brake-feel: 0;
    in property <float> brake-deadzone: 0;
    in property <string> brake-deadzone-text: "—";
    in property <string> brake-curve: "M 6 104 L 104 6";
    in property <string> brake-dashed: "M 6 104 L 104 6";
    in property <float> brake-marker-x: 6;
    in property <float> brake-marker-y: 104;
    // --- Brake per-module tuning ---
    // B2 brake bite (0..1 of 50%) + B1 brake force (0.5..1.0).
    in property <float> brake-bite: 0;
    in property <string> brake-bite-text: "—";
    in property <float> brake-force: 1.0;
    in property <string> brake-force-text: "100%";
    in property <string> clutch-up-mv: "—";
    in property <string> clutch-down-mv: "—";
    in property <int> clutch-feel: 0;
    in property <float> clutch-deadzone: 0;
    in property <string> clutch-deadzone-text: "—";
    in property <float> clutch-bite: 0;
    in property <string> clutch-bite-text: "—";
    // --- Handbrake/clutch per-module tuning ---
    // C2 clutch slip zone (0..1 of 5..40%; the 15% default is 10/35).
    in property <float> clutch-bite-width: 0.2857;
    in property <string> clutch-bite-width-text: "15%";
    in property <string> clutch-curve: "M 6 104 L 104 6";
    in property <string> clutch-dashed: "";
    in property <float> clutch-marker-x: 6;
    in property <float> clutch-marker-y: 104;
    // --- Pedal ramps/curves per-module tuning ---
    in property <float> throttle-curve-value: 0.333;
    in property <string> throttle-curve-text: "1.00";
    in property <float> throttle-press-ms-value: 0.2;
    in property <string> throttle-press-ms-text: "100 ms";
    in property <float> throttle-release-ms-value: 0.1;
    in property <string> throttle-release-ms-text: "50 ms";
    in property <float> throttle-saturation-value: 1;
    in property <string> throttle-saturation-text: "100%";
    in property <float> brake-curve-value: 0.533;
    in property <string> brake-curve-text: "1.30";
    in property <float> brake-press-ms-value: 0.167;
    in property <string> brake-press-ms-text: "50 ms";
    in property <float> clutch-curve-value: 0.333;
    in property <string> clutch-curve-text: "1.00";
    in property <float> clutch-release-ms-value: 0.3;
    in property <string> clutch-release-ms-text: "300 ms";
    in property <bool> combine-pedals: false;
    in property <bool> pedal-set-disabled: true;
    // Extras (A6/A7): wired to set_tuning fields; "—" / 0 until the
    // wheel reports a value.
    in property <string> handbrake-up-mv: "—";
    in property <string> handbrake-down-mv: "—";
    in property <int> handbrake-feel: 0;
    in property <float> handbrake-deadzone: 0;
    in property <string> handbrake-deadzone-text: "—";
    in property <string> handbrake-curve: "M 6 104 L 104 6";
    in property <string> handbrake-dashed: "M 6 104 L 104 6";
    in property <float> handbrake-marker-x: 6;
    in property <float> handbrake-marker-y: 104;
    in property <int> handbrake-mode: 0;
    in property <bool> handbrake-pressed: false;
    // --- Handbrake/clutch per-module tuning ---
    // H1 latch, H2 grab speed (0..1 of 0..200 ms), H3 auto-release.
    in property <bool> handbrake-latch: false;
    in property <float> handbrake-grab-ms: 0;
    in property <string> handbrake-grab-ms-text: "0 ms";
    in property <bool> handbrake-auto-release: false;
    in property <bool> extras-calibration-disabled: true;
    in property <int> shifter-mode: 0;
    // Shifter tuning (SH1/SH2): sensitivity is a board-config
    // value (0..1 = 0..100%), read once from the board — disabled
    // with a reason until the read lands or no shifter is
    // configured; lockout is a `set_tuning` field (0..1 = 0..200 ms).
    in property <float> shifter-sensitivity: 0.5;
    in property <string> shifter-sensitivity-text: "50%";
    in property <bool> sensitivity-disabled: true;
    in property <string> shifter-sensitivity-reason: "Reading the shifter setting…";
    in property <float> shifter-lockout: 0.25;
    in property <string> shifter-lockout-text: "50 ms";
    in property <string> horn-button: "Not set";
    in property <bool> horn-learning: false;
    in property <bool> horn-pressed: false;
    in property <int> led-pattern: 1;
    in property <float> led-brightness: 0.8;
    in property <string> led-brightness-text: "—";
    in property <int> led-color: 3;
    in property <[color]> led-preview;
    // LED/horn per-module tuning (L1/L2/HO1/HO2): pattern-cycle
    // period in ms, custom-colour RGB channels (0..1) + hex text,
    // minimum honk in ms, honk mode (0 Momentary, 1 Latch).
    in property <float> led-period-ms: 1000;
    in property <string> led-period-text: "1000 ms";
    in property <float> led-red: 0.18;
    in property <float> led-green: 0.42;
    in property <float> led-blue: 1.0;
    in property <string> led-color-hex-text: "#2F6BFF";
    in property <float> horn-min-ms: 400;
    in property <string> horn-min-text: "400 ms";
    in property <int> horn-mode: 0;
    // Overview live values (A11/A12/A14): "—" until telemetry lands.
    in property <string> firmware-line: "—";
    in property <string> delay-text: "—";
    in property <string> jitter-text: "—";
    in property <string> lost-text: "—";
    in property <string> calibrated-label: "Not calibrated";
    in property <bool> calibrated-warn: true;
    in property <string> backend-name: "—";
    in property <bool> backend-ready: false;
    in property <[GameItem]> games;
    // Settings live values (A9/A10/C3/C6): seeded from the API.
    in-out property <bool> autostart-enabled: false;
    // M-7 (v2.0.2): two-way — Rust reads keep-in-tray for the close
    // handler and writes it back when set_close_to_tray fails, so the
    // switch never lies about the real state. Same for the Extras
    // module switches: Rust tracks the intended state in
    // module_states and reverts the prop on a failed toggle.
    in-out property <bool> keep-in-tray: true;
    in-out property <bool> extras-handbrake-on: true;
    in-out property <bool> extras-shifter-on: true;
    in-out property <bool> extras-horn-on: true;
    in-out property <bool> extras-leds-on: true;
    in property <string> firmware-text: "—";
    in property <string> app-update-text: "Auto-update is off — new versions are on GitHub Releases";
    in property <string> backup-text: "No backups yet";
    in property <[ProfileRow]> settings-profiles;
    // D19: Wi-Fi password state (Settings "Connection" card).
    in property <bool> wifi-password-set: false;
    in property <string> wifi-password-error: "";
    in property <string> wifi-password-message: "";
    in property <bool> wifi-password-busy: false;
    in-out property <string> wifi-password-new: "";
    in-out property <string> wifi-password-confirm: "";
    callback set-wifi-password();
    callback forget-wifi-password();
    // Profile popover (A8): Rust-owned model, opened from the top-bar
    // ProfileButton and the Overview profile box.
    in-out property <bool> popover-open: false;
    // Add/edit game dialog (manual games, no auto-scan): Rust-owned
    // model, opened from the Overview / wizard Add game buttons.
    in-out property <bool> game-dialog-open: false;
    in property <string> game-dialog-title: "Add game";
    in-out property <string> game-dialog-name: "";
    in-out property <string> game-dialog-exe: "";
    in property <string> game-dialog-profile-name: "No profile";
    // P2-9: the bound profile's 1-based position and the total
    // profile count (0 = no profile bound) — Rust drives these so
    // the dialog can show "Profile: X (2 of 5)".
    in property <int> game-dialog-profile-index: 0;
    in property <int> game-dialog-profile-count: 0;
    // P1-7: the last game-dialog save error, shown inline in the
    // dialog ("" = none) — set from Rust on a failed save, cleared
    // when the dialog opens or a new save starts.
    in property <string> game-dialog-error: "";
    in property <[ProfileItem]> popover-presets;
    in property <[ProfileItem]> popover-profiles;
    in property <bool> popover-show-prompt: false;
    in property <string> popover-pending-name: "";
    // Notification center (Phase 6): bell badge + drawer model.
    in-out property <bool> notif-open: false;
    in-out property <int> notif-unread: 0;
    in-out property <[NotificationItem]> notifications;
    // Setup wizard (compare-fix): shown instead of the shell layout
    // while first-time setup runs; --page setup opens it (main.rs).
    in-out property <bool> setup-mode: false;
    in-out property <int> setup-step: 0; // A15: setup starts at Connect
    // Wizard live state (v2.0.1 hotfix): Rust drives these from the
    // AppApi — connect-done from the live connection's reachability
    // (D15: board_reachable latch or Active — LinkUp alone does
    // not prove the board is there), centre/pedals-done from the
    // calibration backend, drivers from vjoy_status().
    in-out property <bool> setup-connect-done: false;
    // R2-19: why step 0 cannot advance (connection-error hint, or
    // "RSH isn't running" while the daemon is down) — shown on the
    // Connect step, which used to show no error at all.
    in-out property <string> setup-connect-hint: "";
    in-out property <bool> setup-centre-done: false;
    in-out property <bool> setup-pedals-done: false;
    in-out property <int> setup-transport: 0; // 0 Wi-Fi, 1 USB
    in-out property <bool> setup-wifi-joined: false;
    in-out property <bool> setup-usb-available: false;
    // D16: Wi-Fi scan/join state for Step 1 (the card performs the
    // join via the daemon) + vJoy install progress for Step 2
    // (-1 = indeterminate, `setup-vjoy-elapsed` carries "m:ss")
    // + live pedal levels for the Calibrate step's pedal graphs.
    in-out property <string> setup-wifi-ssid: "";
    in-out property <bool> setup-wifi-joining: false;
    in-out property <string> setup-wifi-error: "";
    in-out property <int> setup-vjoy-progress: -1;
    in-out property <string> setup-vjoy-elapsed: "";
    in-out property <float> setup-live-throttle: 0;
    in-out property <float> setup-live-brake: 0;
    in-out property <float> setup-live-clutch: 0;
    // L-2 (v2.0.2): live board address from connection().address —
    // Rust sets this in sync_overview (where the address is already
    // computed); empty/unknown renders as "—" in the wizard.
    in-out property <string> setup-address: "";
    in-out property <string> setup-games-text: "No games added yet.";
    in-out property <bool> setup-games-done: false;
    in-out property <bool> setup-vjoy-installed: false;
    in-out property <bool> setup-vjoy-installing: false;
    in-out property <string> setup-vjoy-version: "";
    in-out property <string> setup-vjoy-error: "";
    in-out property <bool> setup-vjoy-fallback: false;
    // FH4 wheel check (v2.0.14): synced with the vJoy status
    // above — see the SetupScreen props for the meanings.
    in-out property <bool> setup-vjoy-wheel-checked: false;
    in-out property <bool> setup-vjoy-wheel-ok: false;
    in-out property <string> setup-vjoy-wheel-line: "";
    in-out property <string> setup-vjoy-wheel-next: "";
    in-out property <bool> setup-calibration-available: false;
    in-out property <string> setup-calibration-reason: "RSH isn't running — reconnect to capture.";
    // Diagnostics drawer (v2.0.1 hotfix): right-edge overlay like the
    // notifications drawer; Rust syncs these values when it opens.
    in-out property <bool> diag-open: false;
    in-out property <string> diag-conn-label: "Disconnected";
    in-out property <bool> diag-daemon-live: false;
    in-out property <string> diag-app-version: "";
    in-out property <string> diag-firmware: "";
    in-out property <[string]> diag-events;
    in-out property <string> diag-steer-chart: "";
    in-out property <string> diag-pedals-chart: "";
    in-out property <string> diag-steer-readout: "—";
    in-out property <string> diag-pedals-readout: "—";
    in-out property <string> diag-delay-text: "—";
    in-out property <string> diag-jitter-text: "—";
    in-out property <string> diag-lost-text: "—";
    in-out property <string> diag-loop-rate-text: "—";
    in-out property <string> diag-tx-failures-text: "—";
    in-out property <string> diag-seq-gaps-text: "—";
    in-out property <string> diag-frame-p50-text: "—";
    in-out property <string> diag-frame-p99-text: "—";
    // R2-46: paint-completion p50/p99 (refresh start to Slint
    // AfterRendering) — "—" until a paint is observed.
    in-out property <string> diag-paint-p50-text: "—";
    in-out property <string> diag-paint-p99-text: "—";
    in-out property <string> diag-ipc-p50-text: "—";
    in-out property <string> diag-ipc-p99-text: "—";
    in-out property <[bool]> diag-buttons-pressed;
    // FH4 wheel check (v2.0.14): the Diagnostics drawer's
    // "Wheel setup: …" line — "—" until a check exists.
    in-out property <string> diag-wheel-text: "—";
    in-out property <bool> diag-wheel-ok: false;

    callback toggled-send();
    callback reconnect();
    callback deadzone-changed(float);
    callback curve-changed(float);
    callback deadzone-edited(string);
    callback curve-edited(string);
    callback invert-changed(bool);
    callback lock-changed(float);
    callback lock-edited(string);
    callback smoothing-changed(float);
    callback smoothing-edited(string);
    callback balance-changed(float);
    callback balance-edited(string);
    callback trim-changed(float);
    callback trim-edited(string);
